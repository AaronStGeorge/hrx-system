load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load(":clang_tidy.bzl", "iree_recursion_analysis")

package(default_visibility = ["//visibility:public"])

exports_files([
    "clang_tidy_config.yaml",
    "clang_tidy.bzl",
    "llvm_repo.bzl",
])

filegroup(
    name = "cmake_project",
    srcs = [
        "CMakeLists.txt",
        "README.md",
        "aggregate_recursion_summaries.py",
        "clang_tidy_config.yaml",
        "//build_tools/clang_tidy/iree:plugin_sources",
        "//build_tools/clang_tidy/test:testdata",
    ],
)

py_library(
    name = "aggregate_recursion_summaries_lib",
    srcs = ["aggregate_recursion_summaries.py"],
    imports = ["."],
    visibility = ["//build_tools/clang_tidy/test:__pkg__"],
)

py_binary(
    name = "aggregate_recursion_summaries",
    srcs = ["aggregate_recursion_summaries.py"],
    main = "aggregate_recursion_summaries.py",
)

py_library(
    name = "run_clang_tidy_action_lib",
    srcs = ["run_clang_tidy_action.py"],
    imports = ["."],
    visibility = ["//build_tools/clang_tidy/test:__pkg__"],
)

py_binary(
    name = "run_clang_tidy_action",
    srcs = ["run_clang_tidy_action.py"],
    main = "run_clang_tidy_action.py",
)

iree_recursion_analysis(
    name = "loom_recursion_inventory",
    testonly = True,
    allow_diagnostics = True,
    tags = ["manual"],
    targets = ["//loom/src/loom/tools/loom-compile"],
)
