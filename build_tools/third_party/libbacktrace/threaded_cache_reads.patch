@@ -66,6 +66,19 @@ backtrace_atomic_load_int (int *p)
   return i;
 }

+/* Do an atomic load of a size_t value.  */
+
+size_t
+backtrace_atomic_load_size_t (size_t *p)
+{
+  size_t v;
+
+  v = *p;
+  while (!__sync_bool_compare_and_swap (p, v, v))
+    v = *p;
+  return v;
+}
