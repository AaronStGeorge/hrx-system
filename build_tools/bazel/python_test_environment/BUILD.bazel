# Bazel test environment configuration has no CMake target surface.
# bazel-to-cmake: skip

load("@rules_python//python:defs.bzl", "py_library")
load("//build_tools/bazel:python.bzl", "iree_py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "python_test_environment",
    srcs = ["sitecustomize.py"],
    imports = ["."],
)

iree_py_test(
    name = "python_test_environment_test",
    srcs = [
        "python_test_environment_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = [
        "build_tools.bazel.python_test_environment.python_test_environment_test",
    ],
    main = "pytest_style_runner.py",
)
