load("//build_tools/bazel:cmake.bzl", "iree_cmake_extra_content")
load("//build_tools/bazel:generate.bzl", "iree_generated_sources")

filegroup(
    name = "header_inputs",
    srcs = ["//package:generated.h.in"],
)

iree_cmake_extra_content(
    content = "iree_py_library(NAME generator MAIN ../generator.py SRCS ../generator.py)",
    inline = True,
)

iree_generated_sources(
    name = "value",
    tool = ":generator",
    srcs = [":header_inputs"],
    args = ["--input=$(location //package:generated.h.in)"],
    outs = ["value.h"],
    output_args = {"value.h": "--output={path}"},
)
