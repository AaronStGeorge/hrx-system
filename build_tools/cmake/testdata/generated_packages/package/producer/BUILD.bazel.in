load("//build_tools/bazel:generate.bzl", "iree_generated_sources")
load("//build_tools/bazel:python.bzl", "iree_py_binary")

filegroup(
    name = "header_inputs",
    srcs = ["//package:generated.h.in"],
)

iree_py_binary(
    name = "generator",
    srcs = ["generator.py"],
)

iree_generated_sources(
    name = "value",
    tool = ":generator",
    srcs = [":header_inputs"],
    args = ["--input=$(location //package:generated.h.in)"],
    outs = ["value.h"],
    output_args = {"value.h": "--output={path}"},
)
