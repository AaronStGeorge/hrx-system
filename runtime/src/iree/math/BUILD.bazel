load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0 with LLVM Exceptions and MIT
)

iree_runtime_cc_library(
    name = "math",
    srcs = [
        "activation.c",
        "erfc_tail.h",
        "error_functions.c",
        "exponential.c",
        "exponential_reduction.h",
        "float_bits.h",
        "fma.c",
        "fma_software.c",
        "fma_software.h",
        "hyperbolic.c",
        "inverse_trigonometry.c",
        "logarithm.c",
        "logarithm_reduction.h",
        "roots.c",
        "roots_integer.h",
        "rounding.c",
        "scaling.c",
        "trigonometry.c",
    ],
    hdrs = [
        "activation.h",
        "error_functions.h",
        "exponential.h",
        "fma.h",
        "hyperbolic.h",
        "inverse_trigonometry.h",
        "logarithm.h",
        "roots.h",
        "rounding.h",
        "scaling.h",
        "trigonometry.h",
    ],
    # Each exported operation freezes one exact result mapping. Prevent an
    # embedding application's fast-math flags from changing that mapping and
    # preserve explicitly separate rounding points in the ordinary mappings.
    copts = select({
        "//build_tools/bazel:cc_compiler_clang": [
            "-fno-fast-math",
            "-fno-math-errno",
            "-ffp-contract=off",
            "-ffp-eval-method=source",
        ],
        "//build_tools/bazel:cc_compiler_clang_cl": [
            "/clang:-fno-fast-math",
            "/clang:-fno-math-errno",
            "/clang:-ffp-contract=off",
            "/clang:-ffp-eval-method=source",
        ],
        "//build_tools/bazel:cc_compiler_gcc": [
            "-fno-fast-math",
            "-fno-math-errno",
            "-ffp-contract=off",
        ],
        "//build_tools/bazel:cc_compiler_msvc": [
            "/fp:precise",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/base/internal",
    ],
)

iree_runtime_cc_test(
    name = "math_test",
    srcs = [
        "activation_test.cc",
        "elementary_test_util.h",
        "error_functions_test.cc",
        "exponential_test.cc",
        "fma_software.h",
        "fma_test.cc",
        "hyperbolic_test.cc",
        "inverse_trigonometry_test.cc",
        "logarithm_test.cc",
        "roots_integer.h",
        "roots_test.cc",
        "rounding_test.cc",
        "scaling_test.cc",
        "trigonometry_test.cc",
    ],
    deps = [
        ":math",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:fpu_state",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_benchmark(
    name = "math_benchmark",
    srcs = ["math_benchmark.cc"],
    deps = [
        ":math",
        "//runtime/src/iree/base/internal:fpu_state",
        "//runtime/src/iree/testing:benchmark",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)
