load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_fuzz.bzl", "iree_runtime_cc_fuzz")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

#===------------------------------------------------------------------------===#
# DFA Executor
#===------------------------------------------------------------------------===#

# Minimal runtime library for executing pre-compiled DFAs.
# This is the only regex code needed when DFAs are embedded at compile time.
iree_runtime_cc_library(
    name = "exec",
    srcs = ["exec.c"],
    hdrs = ["exec.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:unicode",
    ],
)

iree_runtime_cc_test(
    name = "exec_test",
    srcs = ["exec_test.cc"],
    deps = [
        ":exec",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_benchmark(
    name = "exec_benchmark",
    srcs = ["exec_benchmark.cc"],
    deps = [
        ":compile",
        ":exec",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)

#===------------------------------------------------------------------------===#
# Regex Compiler (Public API)
#===------------------------------------------------------------------------===#

# Full compiler for transforming regex patterns to DFA binary format.
# Includes lexer, parser, NFA/DFA construction, and serialization.
iree_runtime_cc_library(
    name = "compile",
    srcs = ["compile.c"],
    hdrs = ["compile.h"],
    deps = [
        ":exec",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/tokenizer/regex/internal:dfa",
        "//runtime/src/iree/tokenizer/regex/internal:nfa",
        "//runtime/src/iree/tokenizer/regex/internal:parser",
    ],
)

iree_runtime_cc_test(
    name = "compile_test",
    srcs = ["compile_test.cc"],
    deps = [
        ":compile",
        ":exec",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/tokenizer/regex/internal:parser",
    ],
)

iree_runtime_cc_benchmark(
    name = "compile_benchmark",
    srcs = ["compile_benchmark.cc"],
    deps = [
        ":compile",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)

#===------------------------------------------------------------------------===#
# End-to-End Regex Tests
#===------------------------------------------------------------------------===#

# Combined compile + execute tests for verifying regex matching behavior.
# For compiler-only tests, see compile_test.
# For executor-only tests with hand-built DFAs, see exec_test.
iree_runtime_cc_test(
    name = "regex_test",
    srcs = [
        "regex_branch_test.cc",
        "regex_test.cc",
    ],
    deps = [
        ":compile",
        ":exec",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:unicode",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

#===------------------------------------------------------------------------===#
# Fuzz Targets
#===------------------------------------------------------------------------===#

iree_runtime_cc_fuzz(
    name = "regex_fuzz",
    srcs = ["regex_fuzz.cc"],
    deps = [
        ":compile",
        ":exec",
        "//runtime/src/iree/base",
    ],
)
