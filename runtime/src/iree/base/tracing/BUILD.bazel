load("//build_tools/bazel:cmake.bzl", "iree_cmake_extra_content")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")
load("//runtime/build_tools/bazel:tracing.bzl", "iree_runtime_tracing_provider")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "disabled",
)

iree_runtime_cc_test(
    name = "disabled_test",
    srcs = ["disabled_test.cc"],
    target_compatible_with = select({
        "//runtime/config/base/tracing:provider_console": ["@platforms//:incompatible"],
        "//runtime/config/base/tracing:provider_tracy": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

alias(
    name = "provider",
    actual = select({
        "//runtime/config/base/tracing:provider_console": ":console",
        "//runtime/config/base/tracing:provider_tracy": ":tracy",
        "//conditions:default": ":disabled",
    }),
)

#===------------------------------------------------------------------------===#
# Console (stderr)
#===------------------------------------------------------------------------===#

iree_runtime_tracing_provider(
    name = "console",
    srcs = ["console.c"],
    hdrs = ["console.h"],
    header = "iree/base/tracing/console.h",
    deps = [
        "//build_tools/bazel:pthreads",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:time",
    ],
)

iree_runtime_cc_test(
    name = "console_test",
    srcs = ["console_test.cc"],
    target_compatible_with = select({
        "//runtime/config/base/tracing:provider_console": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":console",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/testing:gtest",
    ],
)

#===------------------------------------------------------------------------===#
# Tracy
#===------------------------------------------------------------------------===#

iree_runtime_tracing_provider(
    name = "tracy",
    srcs = ["tracy.cc"],
    hdrs = ["tracy.h"],
    copts = select({
        "//build_tools/bazel:cc_compiler_clang": [
            "-Wno-implicit-fallthrough",
            "-Wno-unused-result",
            "-Wno-unused-variable",
        ],
        "//build_tools/bazel:cc_compiler_gcc": [
            "-Wno-implicit-fallthrough",
            "-Wno-unused-result",
            "-Wno-unused-variable",
        ],
        "//conditions:default": [],
    }),
    header = "iree/base/tracing/tracy.h",
    target_compatible_with = select({
        "//runtime/config/base/tracing:provider_tracy": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//build_tools/bazel:dl",
        "//build_tools/bazel:pthreads",
        "//runtime/src/iree/base:core_headers",
        "@tracy_client//:runtime",
    ],
)

iree_runtime_cc_test(
    name = "tracy_test",
    srcs = ["tracy_test.cc"],
    target_compatible_with = select({
        "//runtime/config/base/tracing:provider_tracy": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":tracy",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "@tracy_client//:runtime",
    ],
)

iree_cmake_extra_content(
    content = "iree_runtime_configure_tracing()",
    inline = True,
)
