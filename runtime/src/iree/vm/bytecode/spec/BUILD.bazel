load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

iree_py_library(
    name = "schema",
    srcs = [
        "__init__.py",
        "schema.py",
        "version.py",
    ],
    imports = ["../../../.."],
)

iree_py_library(
    name = "specification",
    srcs = ["specification.py"],
    deps = [
        ":schema",
        "//runtime/src/iree/vm/bytecode/spec/isa",
        "//runtime/src/iree/vm/bytecode/spec/isa:validation",
        "//runtime/src/iree/vm/bytecode/spec/isa/core",
        "//runtime/src/iree/vm/bytecode/spec/module",
    ],
)

iree_py_library(
    name = "model",
    deps = [
        ":schema",
        ":specification",
    ],
)

iree_py_library(
    name = "generation",
    srcs = ["generation.py"],
)

iree_py_library(
    name = "runtime_renderer",
    deps = ["//runtime/src/iree/vm/bytecode/spec/render:runtime"],
)

iree_py_library(
    name = "conversion_test_renderer",
    testonly = True,
    srcs = ["conversion_test_vectors.py"],
    imports = ["../../../.."],
    deps = [":model"],
)

iree_py_library(
    name = "documentation_renderer",
    deps = ["//runtime/src/iree/vm/bytecode/spec/render:documentation"],
)

iree_py_library(
    name = "tooling_renderer",
    deps = ["//runtime/src/iree/vm/bytecode/spec/render:tooling"],
)

iree_py_library(
    name = "text_model",
    deps = ["//runtime/src/iree/vm/bytecode/spec/text:text_model"],
)

iree_py_binary(
    name = "generate_runtime",
    srcs = ["generate_runtime.py"],
    main = "generate_runtime.py",
    deps = [
        ":generation",
        ":model",
        ":runtime_renderer",
    ],
)

iree_py_binary(
    name = "generate_conversion_tests",
    testonly = True,
    srcs = ["generate_conversion_tests.py"],
    main = "generate_conversion_tests.py",
    deps = [
        ":conversion_test_renderer",
        ":generation",
        ":model",
    ],
)

iree_py_binary(
    name = "generate_documentation",
    srcs = ["generate_documentation.py"],
    main = "generate_documentation.py",
    deps = [
        ":documentation_renderer",
        ":generation",
        ":model",
    ],
)

iree_py_binary(
    name = "generate_tooling",
    srcs = ["generate_tooling.py"],
    main = "generate_tooling.py",
    deps = [
        ":generation",
        ":model",
        ":text_model",
        ":tooling_renderer",
    ],
)

iree_py_test(
    name = "spec_test",
    size = "small",
    srcs = ["spec_test.py"],
    deps = [":model"],
)

iree_py_test(
    name = "projection_test",
    size = "small",
    srcs = ["projection_test.py"],
    deps = [
        ":documentation_renderer",
        ":model",
        ":runtime_renderer",
        ":text_model",
        ":tooling_renderer",
    ],
)

iree_py_test(
    name = "text_test",
    size = "small",
    srcs = ["text_test.py"],
    deps = [":text_model"],
)

test_suite(
    name = "tests",
    tests = [
        ":projection_test",
        ":spec_test",
        ":text_test",
    ],
)
