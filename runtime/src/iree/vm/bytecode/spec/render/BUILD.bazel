load("//build_tools/bazel:python.bzl", "iree_py_library")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "render",
    srcs = ["__init__.py"],
)

iree_py_library(
    name = "runtime",
    srcs = ["c_runtime.py"],
    deps = [
        ":render",
        "//runtime/src/iree/vm/bytecode/spec:model",
    ],
)

iree_py_library(
    name = "documentation",
    srcs = ["markdown.py"],
    deps = [
        ":render",
        "//runtime/src/iree/vm/bytecode/spec:model",
    ],
)

iree_py_library(
    name = "tooling",
    srcs = [
        "c_assembler.py",
        "c_disassembler.py",
        "c_tooling.py",
    ],
    deps = [
        ":render",
        "//runtime/src/iree/vm/bytecode/spec:model",
        "//runtime/src/iree/vm/bytecode/spec:text_model",
    ],
)
