load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_library", "iree_py_test")

package(default_visibility = [
    "//loom/py/loom/gen:__subpackages__",
    "//loom/src/loom/import/cxx/binding:__pkg__",
])

iree_py_library(
    name = "intrinsics",
    srcs = [
        "__init__.py",
        "intrinsics.py",
    ],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/dialect/scalar",
        "//loom/py/loom/gen:bootstrap",
        "//loom/py/loom/gen/ops:model",
        "//loom/py/loom/gen/support",
    ],
)

iree_py_binary(
    name = "intrinsics_generator",
    main_module = "loom.gen.cxx.intrinsics",
    deps = [":intrinsics"],
)

iree_py_test(
    name = "intrinsics_test",
    srcs = [
        "intrinsics_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.gen.cxx.intrinsics_test"],
    main = "pytest_style_runner.py",
    deps = [":intrinsics"],
)
