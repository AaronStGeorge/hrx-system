{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loom model lock, version 1",
  "description": "Whole-file source commitments, independent of destinations and model configuration. Consumers use their bundled schema_version contract without fetching the editor schema.",
  "type": "object",
  "required": ["schema_version", "origins", "files"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "const": 1},
    "origins": {
      "type": "object",
      "propertyNames": {"$ref": "model-card.v1.schema.json#/$defs/name"},
      "additionalProperties": {
        "type": "object",
        "required": ["requested"],
        "properties": {
          "requested": {"$ref": "model-card.v1.schema.json#/$defs/originRoot"},
          "resolved": {"$ref": "#/$defs/resolved"}
        },
        "if": {"properties": {"requested": {"properties": {"kind": {"const": "hf"}}}}},
        "then": {"required": ["resolved"]},
        "else": {"not": {"required": ["resolved"]}},
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["origin", "size", "sha256"],
        "properties": {
          "origin": {"$ref": "model-card.v1.schema.json#/$defs/fileOrigin"},
          "size": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "resolved": {"$ref": "#/$defs/resolved"}
        },
        "if": {"properties": {"origin": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "hf"}}}}},
        "then": {"required": ["resolved"]},
        "else": {"not": {"required": ["resolved"]}},
        "additionalProperties": false
      },
      "description": "One record per logical source. Aliased roots carry their repository resolution once in origins. Normal fetches may select a subset; lock updates replace the exact requested set."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resolved": {
      "type": "object",
      "required": ["revision"],
      "properties": {"revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
      "additionalProperties": false
    }
  }
}
