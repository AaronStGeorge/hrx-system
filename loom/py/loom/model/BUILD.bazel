load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_library", "iree_py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "model-card.v1.schema.json",
    "model-lock.v1.schema.json",
])

iree_py_library(
    name = "manifest",
    srcs = [
        "__init__.py",
        "manifest.py",
    ],
    imports = ["../.."],
)

iree_py_library(
    name = "lock",
    srcs = ["lock.py"],
    deps = [":manifest"],
)

iree_py_library(
    name = "fetch_source",
    srcs = ["fetch_source.py"],
    deps = [
        ":lock",
        ":manifest",
    ],
)

iree_py_library(
    name = "fetch_hf",
    srcs = ["fetch_hf.py"],
    deps = [
        ":fetch_source",
        ":manifest",
    ],
)

iree_py_library(
    name = "fetch_storage",
    srcs = ["fetch_storage.py"],
    deps = [
        ":fetch_hf",
        ":fetch_source",
        ":lock",
        ":manifest",
    ],
)

iree_py_library(
    name = "fetch",
    srcs = ["fetch.py"],
    deps = [
        ":fetch_hf",
        ":fetch_source",
        ":fetch_storage",
        ":lock",
        ":manifest",
    ],
)

iree_py_library(
    name = "fetch_console",
    srcs = ["fetch_console.py"],
    deps = [
        ":fetch_hf",
        ":fetch_source",
    ],
)

iree_py_library(
    name = "fetch_cli",
    srcs = ["fetch_main.py"],
    deps = [
        ":fetch",
        ":fetch_console",
        ":fetch_hf",
        ":fetch_source",
        ":fetch_storage",
        ":manifest",
    ],
)

iree_py_binary(
    name = "loom-fetch",
    srcs = ["fetch_main.py"],
    main = "fetch_main.py",
    deps = [":fetch_cli"],
)

iree_py_test(
    name = "fetch_test",
    srcs = [
        "fetch_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.model.fetch_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":fetch",
        ":fetch_source",
        ":fetch_storage",
        ":lock",
        ":manifest",
    ],
)

iree_py_test(
    name = "fetch_storage_test",
    srcs = [
        "fetch_storage_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.model.fetch_storage_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":fetch_source",
        ":fetch_storage",
        ":lock",
        ":manifest",
    ],
)

iree_py_test(
    name = "lock_test",
    srcs = [
        "lock_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.model.lock_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":lock",
        ":manifest",
    ],
)

iree_py_test(
    name = "fetch_source_test",
    srcs = [
        "fetch_source_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.model.fetch_source_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":fetch_source",
        ":manifest",
    ],
)

iree_py_test(
    name = "manifest_test",
    srcs = [
        "manifest_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.model.manifest_test"],
    data = [
        "testdata/moonshine.json",
        "//loom/src/loom/serve/fixture/text:native.card.json",
    ],
    main = "pytest_style_runner.py",
    deps = [":manifest"],
)

iree_py_binary(
    name = "inline_file",
    srcs = ["inline_file.py"],
    main = "inline_file.py",
    deps = [":manifest"],
)

iree_py_binary(
    name = "build",
    srcs = ["build.py"],
    main = "build.py",
    deps = [":manifest"],
)

iree_py_test(
    name = "build_test",
    srcs = [
        "build.py",
        "build_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.model.build_test"],
    data = ["//loom/src/loom/serve/fixture/text:native.card.json"],
    main = "pytest_style_runner.py",
    deps = [":manifest"],
)
