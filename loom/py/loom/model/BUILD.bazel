load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_library", "iree_py_test")

package(default_visibility = ["//visibility:public"])

exports_files(["model-card.v1.schema.json"])

iree_py_library(
    name = "manifest",
    srcs = [
        "__init__.py",
        "manifest.py",
    ],
    imports = ["../.."],
)

iree_py_test(
    name = "manifest_test",
    srcs = [
        "manifest_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.model.manifest_test"],
    data = [
        "testdata/moonshine.json",
        "//loom/src/loom/serve/fixture/text:native.card.json",
    ],
    main = "pytest_style_runner.py",
    deps = [":manifest"],
)

iree_py_binary(
    name = "inline_file",
    srcs = ["inline_file.py"],
    main = "inline_file.py",
    deps = [":manifest"],
)

iree_py_binary(
    name = "build",
    srcs = ["build.py"],
    main = "build.py",
    deps = [":manifest"],
)

iree_py_test(
    name = "build_test",
    srcs = [
        "build.py",
        "build_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.model.build_test"],
    data = ["//loom/src/loom/serve/fixture/text:native.card.json"],
    main = "pytest_style_runner.py",
    deps = [":manifest"],
)
