load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")
load("//loom/build_tools/bazel:build_defs.bzl", "iree_cmake_extra_content", "iree_select")
load("//loom/py/loom/importers/tilelang/testdata:sources.bzl", TILELANG_IMPORT_SOURCES = "IMPORT_SOURCES", TILELANG_UNIT_SOURCES = "UNIT_SOURCES")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

_TILELANG_IMPORTER_COMPATIBLE = iree_select({
    "//loom/config/import:tilelang": [],
    "//conditions:default": ["@platforms//:incompatible"],
}) + iree_select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

iree_py_library(
    name = "core",
    srcs = [
        "abi.py",
        "analysis.py",
        "buffers.py",
        "context.py",
        "converter.py",
        "coverage.py",
        "model.py",
        "nodes.py",
        "types.py",
    ],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom:package",
        "//loom/py/loom/importers/core",
    ],
)

iree_py_library(
    name = "oracle",
    srcs = [
        "differential.py",
        "oracle.py",
    ],
    deps = [
        ":core",
        "//loom/py/loom/tools:amdgpu_asm",
    ],
)

# Keep oracle capture out of the minimal importer library. Source/code-object
# oracle paths may need local TileLang codegen hooks and ROCm/LLVM tools; the
# semantic importer must remain usable without those capabilities.
iree_py_library(
    name = "tilelang",
    srcs = [
        "__init__.py",
        "defaults.py",
        "importer.py",
    ],
    deps = [
        ":core",
        "//loom/py/loom/importers/tilelang/ops",
    ],
)

iree_py_library(
    name = "tilelang_packages",
)

iree_cmake_extra_content(
    content = """
if(LOOM_IMPORT_TILELANG)
""",
    inline = True,
)

iree_py_test(
    name = "tilelang_test",
    srcs = [
        "analysis_test.py",
        "calls_test.py",
        "context_test.py",
        "corpus_test.py",
        "coverage_test.py",
        "differential_test.py",
        "oracle_test.py",
        "types_test.py",
    ] + TILELANG_UNIT_SOURCES + ["//loom/py/loom/tools:pytest_style_runner.py"],
    args = [
        "loom.importers.tilelang.analysis_test",
        "loom.importers.tilelang.calls_test",
        "loom.importers.tilelang.context_test",
        "loom.importers.tilelang.corpus_test",
        "loom.importers.tilelang.coverage_test",
        "loom.importers.tilelang.differential_test",
        "loom.importers.tilelang.oracle_test",
        "loom.importers.tilelang.types_test",
    ],
    main = "pytest_style_runner.py",
    target_compatible_with = _TILELANG_IMPORTER_COMPATIBLE,
    deps = [
        ":oracle",
        ":tilelang",
        ":tilelang_packages",
        "//loom/py/loom/importers/check/tilelang",
    ],
)

iree_py_test(
    name = "tilelang_import_test",
    srcs = ["//loom/py/loom/importers/check:import_test.py"],
    args = [
        "tilelang",
        "--fail-on-skip",
        "--loom-opt=$(location //loom/src/loom/tools/loom-opt:loom-opt)",
    ] + ["$(location %s)" % source for source in TILELANG_IMPORT_SOURCES],
    data = TILELANG_IMPORT_SOURCES + ["//loom/src/loom/tools/loom-opt"],
    main = "import_test.py",
    target_compatible_with = _TILELANG_IMPORTER_COMPATIBLE,
    deps = [
        ":tilelang_packages",
        "//loom/py/loom/importers/check",
        "//loom/py/loom/importers/check/mlir",
        "//loom/py/loom/importers/check/tilelang",
    ],
)

iree_cmake_extra_content(
    content = """
endif()
""",
    inline = True,
)
