load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//loom/binding/c/test:__pkg__"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_check_test_suite(
    name = "diagnostic_types_test",
    srcs = glob(["*.loom-test"]),
)

iree_c_embed_data(
    name = "diagnostic_types",
    testonly = True,
    srcs = glob(["*.loom-test"]),
    c_file_output = "diagnostic_type_testdata.c",
    flatten = True,
    h_file_output = "diagnostic_type_testdata.h",
    identifier = "loomc_diagnostic_type_testdata",
)
