// The benchmark expands the outer loop during setup. Each segment then owns a
// live runtime loop, so loop_count scales compiler input rather than GPU work
// alone. These config values are benchmark sweep controls.

config.decl @benchmark.loop_count : %value: index where [range(%value, 1, 512)]

config.decl @benchmark.pipeline_depth : %value: index where [range(%value, 1, 4)]

kernel.def export("segmented_read_ahead") @segmented_read_ahead() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %length: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %segment_length = index.constant 64 : index
  %loop_count = config.get @benchmark.loop_count : index
  %depth = config.get @benchmark.pipeline_depth : index
  %end = index.assume %length [range(%length, 0, 64)] : index
  %initial = scalar.constant 0.0 : f32
  %byte_offset = index.constant 0 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%byte_offset] : buffer -> view<32768xf32>
  %result = scf.for %segment = [%begin to %loop_count step %step](%accumulator = %initial : f32) -> (f32) unroll {
    %base = index.mul %segment, %segment_length : index
    %partial = scf.for %i = [%begin to %end step %step](%sum = %accumulator : f32) -> (f32) pipeline(%depth) {
      %position = index.add %base, %i : index
      %value = view.load %input_view[%position] : view<32768xf32> -> f32
      %next = scalar.addf %sum, %value : f32
      scf.yield %next : f32
    }
    scf.yield %partial : f32
  }
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %output_view = buffer.view %output_aligned[%byte_offset] : buffer -> view<1xf32>
  view.store %result, %output_view[0] : f32, view<1xf32>
  kernel.return
}
