load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files([
    "packed_table_lookup_u4.loom",
    "paired_matrix_helpers.loom",
    "paired_scoped_matrix_helpers.loom",
    "segmented_guarded_read_ahead.loom",
])

iree_c_embed_data(
    name = "synthetic_i32_chain_smoke",
    testonly = True,
    srcs = ["i32_memory_chain.loom"],
    c_file_output = "synthetic_i32_chain_smoke.c",
    flatten = True,
    h_file_output = "synthetic_i32_chain_smoke.h",
    identifier = "loomc_benchmark_synthetic_i32_chain_smoke",
)

iree_c_embed_data(
    name = "synthetic_paired_matrix_smoke",
    testonly = True,
    srcs = [
        "paired_matrix_helpers.loom",
        "paired_scoped_matrix_helpers.loom",
    ],
    c_file_output = "synthetic_paired_matrix_smoke.c",
    flatten = True,
    h_file_output = "synthetic_paired_matrix_smoke.h",
    identifier = "loomc_benchmark_synthetic_paired_matrix_smoke",
)

iree_c_embed_data(
    name = "synthetic_packed_table_lookup_smoke",
    testonly = True,
    srcs = ["packed_table_lookup_u4.loom"],
    c_file_output = "synthetic_packed_table_lookup_smoke.c",
    flatten = True,
    h_file_output = "synthetic_packed_table_lookup_smoke.h",
    identifier = "loomc_benchmark_synthetic_packed_table_lookup_smoke",
)

iree_c_embed_data(
    name = "synthetic_pipeline_smoke",
    testonly = True,
    srcs = [
        "segmented_guarded_read_ahead.loom",
        "segmented_read_ahead.loom",
    ],
    c_file_output = "synthetic_pipeline_smoke.c",
    flatten = True,
    h_file_output = "synthetic_pipeline_smoke.h",
    identifier = "loomc_benchmark_synthetic_pipeline_smoke",
)

iree_c_embed_data(
    name = "synthetic_unroll_smoke",
    testonly = True,
    srcs = ["unroll_recurrence.loom"],
    c_file_output = "synthetic_unroll_smoke.c",
    flatten = True,
    h_file_output = "synthetic_unroll_smoke.h",
    identifier = "loomc_benchmark_synthetic_unroll_smoke",
