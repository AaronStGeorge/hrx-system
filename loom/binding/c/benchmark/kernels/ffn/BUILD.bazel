load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files(["gate_up_quadratic_bf16_xdna.loom"])

iree_c_embed_data(
    name = "gate_up_smoke",
    testonly = True,
    srcs = [
        "gate_up_quadratic_bf16_amdgpu.loom",
        "gate_up_quadratic_bf16_xdna.loom",
        "gate_up_quadratic_f32_amdgpu.loom",
        "gate_up_quadratic_f32_spirv.loom",
    ],
    c_file_output = "ffn_gate_up_smoke.c",
    flatten = True,
    h_file_output = "ffn_gate_up_smoke.h",
    identifier = "loomc_benchmark_ffn_gate_up_smoke",
)

iree_c_embed_data(
    name = "routed_gate_up_smoke",
    testonly = True,
    srcs = ["routed_gate_up_swiglu_q4k_q8_amdgpu.loom"],
    c_file_output = "ffn_routed_gate_up_smoke.c",
    flatten = True,
    h_file_output = "ffn_routed_gate_up_smoke.h",
    identifier = "loomc_benchmark_ffn_routed_gate_up_smoke",
)
