load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_benchmark", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

_IMPORT_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/import:cxx",
    "//loom/config/import/cxx:embed_includes_enabled",
])

_AMDGPU_TARGET_COMPATIBLE_WITH = _IMPORT_COMPATIBLE_WITH + loom_config_compatible_with([
    "//loom/config/arch:amdgpu",
])

_AMDGPU_COMPATIBLE_WITH = _IMPORT_COMPATIBLE_WITH + loom_config_compatible_with([
    "//loom/config/emit:amdgpu_elf",
])

loom_cc_benchmark(
    name = "q8s32_selection_benchmark",
    srcs = ["q8s32_selection_benchmark.cc"],
    target_compatible_with = _AMDGPU_TARGET_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/benchmark:compile_throughput_benchmark_harness",
        "//loom/binding/c/benchmark/import/cxx/inputs:q8s32_sources",
        "//loom/binding/c/import/cxx",
        "//loom/binding/c/target/amdgpu",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)

loom_cc_benchmark(
    name = "source_to_hsaco_benchmark",
    srcs = ["source_to_hsaco_benchmark.cc"],
    args = ["--benchmark_min_time=1x"],
    target_compatible_with = _AMDGPU_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/benchmark:compile_throughput_benchmark_harness",
        "//loom/binding/c/benchmark/import/cxx/inputs:kernels",
        "//loom/binding/c/import/cxx",
        "//loom/binding/c/target/amdgpu",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)

loom_cc_benchmark(
    name = "source_to_module_benchmark",
    srcs = ["source_to_module_benchmark.cc"],
    target_compatible_with = _IMPORT_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/benchmark:compile_throughput_benchmark_harness",
        "//loom/binding/c/benchmark/import/cxx/inputs:pipeline_sources",
        "//loom/binding/c/benchmark/import/cxx/inputs:q8s32_sources",
        "//loom/binding/c/import/cxx",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)
