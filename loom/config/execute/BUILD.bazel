load("@bazel_skylib//lib:selects.bzl", "selects")
load("//build_tools/bazel:settings.bzl", "iree_string_list_flag")
load(
    "//loom/config:capabilities.bzl",
    "LOOM_DEFAULT_EXECUTION_SUBSTRATES",
    "LOOM_EXECUTION_SUBSTRATES",
)

package(default_visibility = ["//visibility:public"])

iree_string_list_flag(
    name = "enable",
    build_setting_default = LOOM_DEFAULT_EXECUTION_SUBSTRATES,
    values = LOOM_EXECUTION_SUBSTRATES,
)

[
    config_setting(
        name = value,
        flag_values = {
            ":enable": value,
        },
    )
    for value in LOOM_EXECUTION_SUBSTRATES
]

selects.config_setting_group(
    name = "amdgpu_driver",
    match_any = [
        "//runtime/config/hal:driver_amd_gpu",
        "//runtime/config/hal:driver_amdgpu",
    ],
)

selects.config_setting_group(
    name = "amdgpu_hal",
    match_all = [
        ":iree_hal",
        ":amdgpu_driver",
        "//loom/config/emit:amdgpu_elf",
    ],
)

selects.config_setting_group(
    name = "spirv_vulkan_hal",
    match_all = [
        ":iree_hal",
        "//runtime/config/hal:driver_vulkan",
        "//loom/config/emit:spirv_binary",
    ],
)

selects.config_setting_group(
    name = "aie2p_xdna_hal",
    match_all = [
        ":iree_hal",
        "//runtime/config/hal:driver_amd_xdna",
        "//loom/config/emit:aie2p_elf",
    ],
)

selects.config_setting_group(
    name = "x86_task_hal",
    match_all = [
        ":iree_hal",
        "//runtime/config/hal:driver_task",
        "//runtime/config/hal:executable_loader_embedded_elf",
        "//loom/config/emit:x86_elf",
    ],
)

selects.config_setting_group(
    name = "vm_iree_vm",
    match_all = [
        ":iree_vm",
        "//loom/config/emit:vm_binary",
    ],
)

selects.config_setting_group(
    name = "wasm_hosted",
    match_all = [
        ":wasm_host",
        "//loom/config/emit:wasm_binary",
    ],
)
