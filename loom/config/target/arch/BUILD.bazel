load("@bazel_skylib//lib:selects.bzl", "selects")
load("//build_tools/bazel:settings.bzl", "iree_string_list_flag")
load(
    "//loom/config/target:targets.bzl",
    "LOOM_SPLIT_ARTIFACT_TARGETS",
    "LOOM_TARGETS",
)

package(default_visibility = ["//visibility:public"])

# Advanced target-architecture slices for targets with independently selectable
# artifact emitters. Public //loom/config/target values also imply these
# effective settings.
DEFAULT_ENABLED = []

iree_string_list_flag(
    name = "enable",
    build_setting_default = DEFAULT_ENABLED,
    values = LOOM_SPLIT_ARTIFACT_TARGETS,
)

[
    config_setting(
        name = "explicit_" + value,
        flag_values = {
            ":enable": value,
        },
    )
    for value in LOOM_SPLIT_ARTIFACT_TARGETS
]

[
    selects.config_setting_group(
        name = value,
        match_any = [
            "//loom/config/target:" + value,
            ":explicit_" + value,
        ],
    )
    for value in LOOM_SPLIT_ARTIFACT_TARGETS
]

# VM and x86 have no independently selectable artifact emitters. Preserve the
# architecture-level dependency labels while deriving them directly from the
# public product capabilities instead of admitting redundant configuration
# states.
[
    selects.config_setting_group(
        name = value,
        match_all = ["//loom/config/target:" + value],
    )
    for value in LOOM_TARGETS
    if value not in LOOM_SPLIT_ARTIFACT_TARGETS
]
