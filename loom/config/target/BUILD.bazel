load("//build_tools/bazel:settings.bzl", "iree_string_list_flag")
load(":targets.bzl", "LOOM_TARGETS")

package(default_visibility = ["//visibility:public"])

# Public Loom target product capabilities. Enabling one of these values means
# the build contains the target architecture and production artifact emission
# needed to compile for that backend.
DEFAULT_ENABLED = [
    "amdgpu",
    "spirv",
    "vm",
    "xdna",
    "x86",
]

iree_string_list_flag(
    name = "enable",
    build_setting_default = DEFAULT_ENABLED,
    values = LOOM_TARGETS,
)

[
    config_setting(
        name = value,
        flag_values = {
            ":enable": value,
        },
    )
    for value in LOOM_TARGETS
]
