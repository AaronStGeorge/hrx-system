load("@bazel_skylib//lib:selects.bzl", "selects")
load("//build_tools/bazel:settings.bzl", "iree_string_list_flag")
load("//loom/config/target:targets.bzl", "LOOM_SPLIT_ARTIFACT_TARGETS")

package(default_visibility = ["//visibility:public"])

# Advanced artifact-family slices. Public //loom/config/target values imply the
# emitters required for that target.
DEFAULT_ENABLED = []

iree_string_list_flag(
    name = "enable",
    build_setting_default = DEFAULT_ENABLED,
    values = LOOM_SPLIT_ARTIFACT_TARGETS,
)

[
    config_setting(
        name = "explicit_" + value,
        flag_values = {
            ":enable": value,
        },
    )
    for value in LOOM_SPLIT_ARTIFACT_TARGETS
]

[
    selects.config_setting_group(
        name = value,
        match_any = [
            "//loom/config/target:" + value,
            ":explicit_" + value,
        ],
    )
    for value in LOOM_SPLIT_ARTIFACT_TARGETS
]

# Complete artifact capabilities combine an emitter with the architecture data
# it consumes. Source embedders can select these advanced leaves independently
# of the public production target settings.
[
    selects.config_setting_group(
        name = value + "_artifacts",
        match_all = [
            "//loom/config/target/arch:" + value,
            ":" + value,
        ],
    )
    for value in LOOM_SPLIT_ARTIFACT_TARGETS
]

selects.config_setting_group(
    name = "spirv_vulkan_artifacts",
    match_all = [
        ":spirv_artifacts",
        "//runtime/config/hal:driver_vulkan",
    ],
)
