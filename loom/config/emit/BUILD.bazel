load("@bazel_skylib//lib:selects.bzl", "selects")
load("//build_tools/bazel:settings.bzl", "iree_string_list_flag")
load(
    "//loom/config:capabilities.bzl",
    "LOOM_ARTIFACT_FORMATS",
    "LOOM_DEFAULT_ARTIFACT_FORMATS",
)

package(default_visibility = ["//visibility:public"])

iree_string_list_flag(
    name = "enable",
    build_setting_default = LOOM_DEFAULT_ARTIFACT_FORMATS,
    values = LOOM_ARTIFACT_FORMATS,
)

[
    config_setting(
        name = value,
        flag_values = {
            ":enable": value,
        },
    )
    for value in LOOM_ARTIFACT_FORMATS
]

# Complete artifact capabilities combine one architecture with its selected
# serialized format. Consumers name the supported intersection instead of
# recovering a product identity from either leaf.
[
    selects.config_setting_group(
        name = architecture + "_elf",
        match_all = [
            "//loom/config/arch:" + architecture,
            ":elf",
        ],
    )
    for architecture in [
        "aie2p",
        "amdgpu",
        "x86",
    ]
]

# Internal native-emission joins describe implementation reuse across artifact
# providers. They are derived facts rather than user-configurable capabilities.
_NATIVE_ELF_ARTIFACTS = [
    ":aie2p_elf",
    ":amdgpu_elf",
    ":x86_elf",
]

_NATIVE_OBJECT_ELF_ARTIFACTS = [
    ":aie2p_elf",
    ":x86_elf",
]

[
    selects.config_setting_group(
        name = name,
        match_any = artifacts,
    )
    for name, artifacts in [
        ("native", _NATIVE_ELF_ARTIFACTS),
        ("native_elf", _NATIVE_ELF_ARTIFACTS),
        ("native_object", _NATIVE_OBJECT_ELF_ARTIFACTS),
        ("native_object_elf", _NATIVE_OBJECT_ELF_ARTIFACTS),
    ]
]

[
    selects.config_setting_group(
        name = format + "_binary",
        match_all = [
            "//loom/config/arch:" + format,
            ":" + format,
        ],
    )
    for format in [
        "spirv",
        "vm",
        "wasm",
    ]
]
