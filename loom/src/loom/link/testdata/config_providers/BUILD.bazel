load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")

package(
    default_visibility = ["//loom/src/loom/link:__pkg__"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_c_embed_data(
    name = "config_providers",
    testonly = True,
    srcs = glob(["*.loom"]),
    c_file_output = "config_providers_testdata.c",
    flatten = True,
    h_file_output = "config_providers_testdata.h",
    identifier = "loom_link_config_providers_testdata",
)
