load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")

package(
    default_visibility = ["//loom/src/loom/link:__pkg__"],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files(
    [
        "direct.loom",
        "transitive.loom",
        "unused.loom",
    ],
    visibility = ["//loom/src/loom/tools/loom-link:__pkg__"],
)

iree_c_embed_data(
    name = "provider_roots",
    testonly = True,
    srcs = glob(["*.loom"]),
    c_file_output = "provider_roots_testdata.c",
    flatten = True,
    h_file_output = "provider_roots_testdata.h",
    identifier = "loom_link_provider_roots_testdata",
    visibility = ["//loom/binding/c/test:__pkg__"],
)
