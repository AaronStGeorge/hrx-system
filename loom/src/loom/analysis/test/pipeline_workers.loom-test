// ----
execution=worker block_counts=exact streams=0

// ====

// An unknown replay count cannot become a fixed transport repetition.
func.def @worker(%source: channel<tile<4xi32>>, %other: channel<tile<4xi32>>, %left: channel<tile<4xi32>>, %right: channel<tile<4xi32>>, %limit: index, %condition: i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %initial = channel.accept %source : channel<tile<4xi32>> -> read<tile<4xi32>>
  cfg.br ^header(%c0: index, %initial: read<tile<4xi32>>)
^header(%i: index, %read: read<tile<4xi32>>):
  %more = index.cmp ult, %i, %limit : index
  cfg.cond_br %more, ^copy, ^done
^copy:
  %keep, %outgoing = channel.fanout %read : read<tile<4xi32>> -> (read<tile<4xi32>>, read<tile<4xi32>>)
  %write, %payload = channel.reserve %left : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  channel.copy %outgoing -> %write : read<tile<4xi32>>, write<tile<4xi32>>
  %next = index.add %i, %c1 : index
  cfg.br ^header(%next: index, %keep: read<tile<4xi32>>)
^done:
  channel.release %read : read<tile<4xi32>>
  func.return
}

