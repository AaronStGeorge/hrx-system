// RUN: emit pipeline-workers @test

// Two records remain distinct through nested fanout and loop-carried reads.
// Two admissions per site feed three complete replays before final release.
func.def @worker(%source: channel<tile<4xi32>>, %other: channel<tile<4xi32>>, %left: channel<tile<4xi32>>, %right: channel<tile<4xi32>>, %limit: index, %condition: i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  cfg.br ^panels(%c0: index)
^panels(%panel: index):
  %more_panels = index.cmp ult, %panel, %c2 : index
  cfg.cond_br %more_panels, ^acquire, ^done
^acquire:
  %first, %first_view = channel.acquire %source : channel<tile<4xi32>> -> (read<tile<4xi32>>, view<4xi32>)
  %second = channel.accept %source : channel<tile<4xi32>> -> read<tile<4xi32>>
  cfg.br ^replays(%c0: index, %first: read<tile<4xi32>>, %second: read<tile<4xi32>>)
^replays(%replay: index, %a: read<tile<4xi32>>, %b: read<tile<4xi32>>):
  %more_replays = index.cmp ult, %replay, %c3 : index
  cfg.cond_br %more_replays, ^copy, ^release
^copy:
  %a_keep, %a_copy = channel.fanout %a : read<tile<4xi32>> -> (read<tile<4xi32>>, read<tile<4xi32>>)
  %a_left, %a_right = channel.fanout %a_copy : read<tile<4xi32>> -> (read<tile<4xi32>>, read<tile<4xi32>>)
  %al, %al_view = channel.reserve %left : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  channel.copy %a_left -> %al : read<tile<4xi32>>, write<tile<4xi32>>
  %ar, %ar_view = channel.reserve %right : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  channel.copy %a_right -> %ar : read<tile<4xi32>>, write<tile<4xi32>>
  %b_keep, %b_left, %b_right = channel.fanout %b : read<tile<4xi32>> -> (read<tile<4xi32>>, read<tile<4xi32>>, read<tile<4xi32>>)
  %bl, %bl_view = channel.reserve %left : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  channel.copy %b_left -> %bl : read<tile<4xi32>>, write<tile<4xi32>>
  %br, %br_view = channel.reserve %right : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  channel.copy %b_right -> %br : read<tile<4xi32>>, write<tile<4xi32>>
  %next_replay = index.add %replay, %c1 : index
  cfg.br ^replays(%next_replay: index, %a_keep: read<tile<4xi32>>, %b_keep: read<tile<4xi32>>)
^release:
  channel.release %a : read<tile<4xi32>>
  channel.release %b : read<tile<4xi32>>
  %next_panel = index.add %panel, %c1 : index
  cfg.br ^panels(%next_panel: index)
^done:
  func.return
}

pipeline.def @test(%pool: pool, %limit: index, %condition: i1) run() {
  %c0 = index.constant 0 : offset
  %c2 = index.constant 2 : index
  %bytes = index.constant 32 : offset
  %a = buffer.alloca<workgroup> pool(%pool) align(16) %bytes : buffer
  %b = buffer.alloca<workgroup> pool(%pool) align(16) %bytes : buffer
  %c = buffer.alloca<workgroup> pool(%pool) align(16) %bytes : buffer
  %d = buffer.alloca<workgroup> pool(%pool) align(16) %bytes : buffer
  %av = buffer.view %a[%c0] : buffer -> view<2x4xi32>
  %bv = buffer.view %b[%c0] : buffer -> view<2x4xi32>
  %cv = buffer.view %c[%c0] : buffer -> view<2x4xi32>
  %dv = buffer.view %d[%c0] : buffer -> view<2x4xi32>
  %source = channel.bind<fifo> %av, %c2 : view<2x4xi32>, index -> channel<tile<4xi32>>
  %other = channel.bind<fifo> %bv, %c2 : view<2x4xi32>, index -> channel<tile<4xi32>>
  %left = channel.bind<fifo> %cv, %c2 : view<2x4xi32>, index -> channel<tile<4xi32>>
  %right = channel.bind<fifo> %dv, %c2 : view<2x4xi32>, index -> channel<tile<4xi32>>
  pipeline.strand workers([0], [1], [1]) {
    func.call @worker(%source, %other, %left, %right, %limit, %condition) : (channel<tile<4xi32>>, channel<tile<4xi32>>, channel<tile<4xi32>>, channel<tile<4xi32>>, index, i1)
  }
}

// ----
execution=transport block_counts=exact streams=0
batch 0: records=2 replays=3
  record first from source: admissions=2 transfers=6 release=first
    to left reservation=al copy=first -> al
    to right reservation=ar copy=first -> ar
  record second from source: admissions=2 transfers=6 release=second
    to left reservation=bl copy=second -> bl
    to right reservation=br copy=second -> br

// ====

// Copies consume one-shot records without requiring a separate final release.
func.def @worker(%source: channel<tile<4xi32>>, %other: channel<tile<4xi32>>, %left: channel<tile<4xi32>>, %right: channel<tile<4xi32>>, %limit: index, %condition: i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %a = channel.accept %source : channel<tile<4xi32>> -> read<tile<4xi32>>
  %b = channel.accept %source : channel<tile<4xi32>> -> read<tile<4xi32>>
  %first, %first_view = channel.reserve %left : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  channel.copy %a -> %first : read<tile<4xi32>>, write<tile<4xi32>>
  %second, %second_view = channel.reserve %left : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  channel.copy %b -> %second : read<tile<4xi32>>, write<tile<4xi32>>
  func.return
}

