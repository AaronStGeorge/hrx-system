// ----
execution=transport block_counts=exact streams=0
batch 0: records=1 replays=1
  record a from source: admissions=1 transfers=1 release=none
    to left reservation=first copy=a -> first
batch 1: records=1 replays=1
  record b from other: admissions=1 transfers=1 release=none
    to left reservation=second copy=b -> second

// ====

// The same destinations in a different order require separate batches.
func.def @worker(%source: channel<tile<4xi32>>, %other: channel<tile<4xi32>>, %left: channel<tile<4xi32>>, %right: channel<tile<4xi32>>, %limit: index, %condition: i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %a = channel.accept %source : channel<tile<4xi32>> -> read<tile<4xi32>>
  %b = channel.accept %source : channel<tile<4xi32>> -> read<tile<4xi32>>
  %al, %ar = channel.fanout %a : read<tile<4xi32>> -> (read<tile<4xi32>>, read<tile<4xi32>>)
  %first_left, %first_left_view = channel.reserve %left : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  channel.copy %al -> %first_left : read<tile<4xi32>>, write<tile<4xi32>>
  %first_right, %first_right_view = channel.reserve %right : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  channel.copy %ar -> %first_right : read<tile<4xi32>>, write<tile<4xi32>>
  %bl, %br = channel.fanout %b : read<tile<4xi32>> -> (read<tile<4xi32>>, read<tile<4xi32>>)
  %second_right, %second_right_view = channel.reserve %right : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  channel.copy %br -> %second_right : read<tile<4xi32>>, write<tile<4xi32>>
  %second_left, %second_left_view = channel.reserve %left : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  channel.copy %bl -> %second_left : read<tile<4xi32>>, write<tile<4xi32>>
  func.return
}

