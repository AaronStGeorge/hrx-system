// ====

// Equal payloads and destinations do not merge different source channels.
func.def @worker(%source: channel<tile<4xi32>>, %other: channel<tile<4xi32>>, %left: channel<tile<4xi32>>, %right: channel<tile<4xi32>>, %limit: index, %condition: i1) {
  %c0 = index.constant 0 : index
