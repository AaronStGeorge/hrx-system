execution=worker block_counts=exact streams=0

// ====

// Equal exact trip counts do not establish one common replay scope.
// One retained record crosses both loops and has only one final release.
func.def @worker(%source: channel<tile<4xi32>>, %other: channel<tile<4xi32>>, %left: channel<tile<4xi32>>, %right: channel<tile<4xi32>>, %limit: index, %condition: i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %initial = channel.accept %source : channel<tile<4xi32>> -> read<tile<4xi32>>
  cfg.br ^left_header(%c0: index, %initial: read<tile<4xi32>>)
^left_header(%i: index, %left_read: read<tile<4xi32>>):
  %left_more = index.cmp ult, %i, %c3 : index
  cfg.cond_br %left_more, ^left_copy, ^left_done
^left_copy:
  %left_keep, %left_outgoing = channel.fanout %left_read : read<tile<4xi32>> -> (read<tile<4xi32>>, read<tile<4xi32>>)
  %left_write, %left_payload = channel.reserve %left : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  channel.copy %left_outgoing -> %left_write : read<tile<4xi32>>, write<tile<4xi32>>
  %next_i = index.add %i, %c1 : index
  cfg.br ^left_header(%next_i: index, %left_keep: read<tile<4xi32>>)
^left_done:
  cfg.br ^right_header(%c0: index, %left_read: read<tile<4xi32>>)
^right_header(%j: index, %right_read: read<tile<4xi32>>):
  %right_more = index.cmp ult, %j, %c3 : index
  cfg.cond_br %right_more, ^right_copy, ^right_done
^right_copy:
  %right_keep, %right_outgoing = channel.fanout %right_read : read<tile<4xi32>> -> (read<tile<4xi32>>, read<tile<4xi32>>)
  %right_write, %right_payload = channel.reserve %right : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  channel.copy %right_outgoing -> %right_write : read<tile<4xi32>>, write<tile<4xi32>>
  %next_j = index.add %j, %c1 : index
  cfg.br ^right_header(%next_j: index, %right_keep: read<tile<4xi32>>)
^right_done:
  channel.release %right_read : read<tile<4xi32>>
  func.return
}

pipeline.def @test(%pool: pool, %limit: index, %condition: i1) run() {
  %c0 = index.constant 0 : offset
  %c2 = index.constant 2 : index
  %bytes = index.constant 32 : offset
  %a = buffer.alloca<workgroup> pool(%pool) align(16) %bytes : buffer
  %b = buffer.alloca<workgroup> pool(%pool) align(16) %bytes : buffer
  %c = buffer.alloca<workgroup> pool(%pool) align(16) %bytes : buffer
  %d = buffer.alloca<workgroup> pool(%pool) align(16) %bytes : buffer
  %av = buffer.view %a[%c0] : buffer -> view<2x4xi32>
  %bv = buffer.view %b[%c0] : buffer -> view<2x4xi32>
  %cv = buffer.view %c[%c0] : buffer -> view<2x4xi32>
  %dv = buffer.view %d[%c0] : buffer -> view<2x4xi32>
  %source = channel.bind<fifo> %av, %c2 : view<2x4xi32>, index -> channel<tile<4xi32>>
  %other = channel.bind<fifo> %bv, %c2 : view<2x4xi32>, index -> channel<tile<4xi32>>
  %left = channel.bind<fifo> %cv, %c2 : view<2x4xi32>, index -> channel<tile<4xi32>>
  %right = channel.bind<fifo> %dv, %c2 : view<2x4xi32>, index -> channel<tile<4xi32>>
  pipeline.strand workers([0], [1], [1]) {
    func.call @worker(%source, %other, %left, %right, %limit, %condition) : (channel<tile<4xi32>>, channel<tile<4xi32>>, channel<tile<4xi32>>, channel<tile<4xi32>>, index, i1)
  }
}

