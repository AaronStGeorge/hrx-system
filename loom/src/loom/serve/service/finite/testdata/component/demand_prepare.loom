func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @source(%directory: buffer, %path: buffer) -> (i32)

func.def public @prepare(%directory: buffer, %options: buffer) -> (i64, i64, i64, i64, buffer, buffer, buffer) {
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %c16 = scalar.constant 16 : i64
  %c20 = scalar.constant 20 : i64
  %c80 = scalar.constant 80 : i64
  %producer = buffer.constant utf8("produce") : buffer
  %consumer = buffer.constant utf8("consume") : buffer
  %first = func.call @stage(%producer, %c0) : (buffer, i64) -> (i32)
  %second = func.call @stage(%consumer, %c1) : (buffer, i64) -> (i32)
  %checkpoint = buffer.constant utf8("weights.safetensors") : buffer
  %source = func.call @source(%directory, %checkpoint) : (buffer, buffer) -> (i32)
  %empty = buffer.constant utf8("") : buffer
  %name = buffer.constant utf8("demand-component") : buffer
  func.return %c1, %c20, %c80, %c16, %empty, %name, %directory : i64, i64, i64, i64, buffer, buffer, buffer
}
