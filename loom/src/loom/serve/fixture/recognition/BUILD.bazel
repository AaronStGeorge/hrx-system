load("//loom/build_tools/bazel:loom_library.bzl", "loom_library")
load("//loom/build_tools/bazel:loom_model.bzl", "loom_model")
load(":sources.bzl", "SOURCE_FILES")

package(default_visibility = ["//visibility:private"])

exports_files(
    SOURCE_FILES + ["card.json"],
    visibility = ["//visibility:public"],
)

loom_library(
    name = "generate_module",
    srcs = ["generate.loom"],
)

loom_model(
    name = "card_model",
    card = "card.json",
    configuration = "default",
    files = {
        ":generate_module": "generate.loombc",
        "control.loom": "control.loom",
        "prepare.loom": "prepare.loom",
    },
    model_name = "recognition",
    tags = ["skip-bazel_to_cmake"],
    visibility = ["//visibility:public"],
)

loom_model(
    name = "card_model_text",
    card = "card.json",
    configuration = "default",
    encoding = "text",
    files = {
        ":generate_module": "generate.loombc",
        "control.loom": "control.loom",
        "prepare.loom": "prepare.loom",
    },
    model_name = "recognition",
    tags = ["skip-bazel_to_cmake"],
    visibility = ["//visibility:public"],
)
