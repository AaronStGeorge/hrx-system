load("//loom/build_tools/bazel:build_defs.bzl", "loom_generated_file")
load("//loom/build_tools/bazel:loom_model.bzl", "loom_model")
load(":sources.bzl", "SOURCE_FILES")

package(default_visibility = ["//visibility:private"])

exports_files(
    SOURCE_FILES + [
        "card.json",
        "portable_chat.loom",
        "tokenizer_merging.json",
    ],
    visibility = ["//visibility:public"],
)

loom_generated_file(
    name = "card_weights",
    args = [
        "--card=$(rootpath :card.json)",
        "--file=weights.safetensors",
    ],
    generator = "//loom/py/loom/model:inline_file",
    inputs = ["card.json"],
    output = "weights.safetensors",
    output_flag = "--output=",
)

loom_model(
    name = "card_model",
    assets = {
        ":weights.safetensors": "weights.safetensors",
        "tokenizer.json": "tokenizer.json",
    },
    card = "card.json",
    configuration = "default",
    files = {
        "advance.loom": "program/advance.loom",
        "control.loom": "program/control.loom",
        "prepare.loom": "program/prepare.loom",
        "weights.loom": "program/weights.loom",
    },
    model_name = "fixture-text",
    tags = ["skip-bazel_to_cmake"],
    visibility = ["//visibility:public"],
)
