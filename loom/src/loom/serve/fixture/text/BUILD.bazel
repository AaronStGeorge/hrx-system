load("//build_tools/bazel:python.bzl", "iree_py_binary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_generated_file")
load("//loom/build_tools/bazel:loom_library.bzl", "loom_library")
load("//loom/build_tools/bazel:loom_model.bzl", "loom_model")
load(":sources.bzl", "SOURCE_FILES")

package(default_visibility = ["//visibility:private"])

exports_files(
    SOURCE_FILES + [
        "portable_chat.loom",
        "tokenizer_merging.json",
        "service.loom",
        "native.card.json",
        "native.source.json",
        "native.archive.json",
        "native.mixed.json",
        "native.development.json",
    ],
    visibility = ["//visibility:public"],
)

loom_library(
    name = "service_module",
    srcs = [
        "control.loom",
        "prepare.loom",
        "service.loom",
    ],
)

loom_library(
    name = "control_module",
    srcs = ["control.loom"],
)

loom_library(
    name = "advance_module",
    srcs = ["advance.loom"],
)

filegroup(
    name = "native_card_assets",
    srcs = [
        "native.card.json",
        "tokenizer.json",
        "weights.loom",
        ":bias.data",
        ":metadata.safetensors",
    ],
)

filegroup(
    name = "native_source_files",
    srcs = [
        "advance.loom",
        "control.loom",
        "prepare.loom",
        "service.loom",
        ":native_card_assets",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "native_archive_files",
    srcs = [
        ":advance_module",
        ":native_card_assets",
        ":service_module",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "native_mixed_files",
    srcs = [
        "prepare.loom",
        "service.loom",
        ":advance_module",
        ":control_module",
        ":native_card_assets",
    ],
    visibility = ["//visibility:public"],
)

iree_py_binary(
    name = "parameters",
    srcs = ["parameters.py"],
)

loom_generated_file(
    name = "metadata_shard",
    args = [
        "--key=unused",
        "--value=0",
    ],
    generator = ":parameters",
    output = "metadata.safetensors",
    output_flag = "--output=",
)

loom_generated_file(
    name = "bias_shard",
    args = [
        "--key=bias",
        "--value=2",
    ],
    generator = ":parameters",
    output = "bias.data",
    output_flag = "--output=",
    visibility = ["//visibility:public"],
)

loom_model(
    name = "card_model",
    assets = {
        ":bias.data": "bias.data",
        ":metadata.safetensors": "metadata.safetensors",
        "tokenizer.json": "tokenizer.json",
        "weights.loom": "weights.loom",
    },
    card = "native.card.json",
    configuration = "check",
    files = {
        "advance.loom": "advance.loom",
        "control.loom": "control.loom",
        "prepare.loom": "prepare.loom",
        "service.loom": "service.loom",
    },
    model_name = "fixture-text",
    tags = ["skip-bazel_to_cmake"],
    visibility = ["//visibility:public"],
)

loom_model(
    name = "card_model_mixed",
    assets = {
        ":bias.data": "bias.data",
        ":metadata.safetensors": "metadata.safetensors",
        "tokenizer.json": "tokenizer.json",
        "weights.loom": "weights.loom",
    },
    card = "native.card.json",
    configuration = "check",
    encoding = "preserve",
    files = {
        ":advance_module": "advance_module.loombc",
        ":control_module": "control_module.loombc",
        "prepare.loom": "prepare.loom",
        "service.loom": "service.loom",
    },
    model_name = "fixture-text",
    programs = "mixed",
    tags = ["skip-bazel_to_cmake"],
    visibility = ["//visibility:public"],
)
