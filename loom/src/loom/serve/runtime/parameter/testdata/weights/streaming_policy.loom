func.decl import("weights") @input(%source: i32, %key: buffer, %offset: i64, %length: i64, %alignment: i64) -> (i64)

func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @config_i64(%stage: i32, %key: buffer, %value: i64)

// combine_wide / wide_first_offset / wide_second_offset
global.rodata.def @root = bytes("636f6d62696e655f77696465")

global.rodata.def @first_offset = bytes("776964655f66697273745f6f6666736574")

global.rodata.def @second_offset = bytes("776964655f7365636f6e645f6f6666736574")

func.def public @prepare_weight(%key: buffer) -> (i64) {
  %origin = index.constant 0 : offset
  %letter = buffer.load.i8.u %key[%origin]
  %w = scalar.constant 119 : i32
  %wide = scalar.cmpi eq, %letter, %w : i32
  %c0 = scalar.constant 0 : i64
  %bytes = scf.if %wide -> (i64) {
    %first_source = scalar.constant 0 : i32
    %second_source = scalar.constant 1 : i32
    %half = scalar.constant 1048592 : i64
    %alignment = scalar.constant 64 : i64
    %first = func.call @input(%first_source, %key, %c0, %half, %alignment) : (i32, buffer, i64, i64, i64) -> (i64)
    %second = func.call @input(%second_source, %key, %half, %half, %alignment) : (i32, buffer, i64, i64, i64) -> (i64)
    %root = global.load @root : buffer
    %stage = func.call @stage(%root, %c0) : (buffer, i64) -> (i32)
    %first_key = global.load @first_offset : buffer
    %second_key = global.load @second_offset : buffer
    func.call @config_i64(%stage, %first_key, %first) : (i32, buffer, i64)
    func.call @config_i64(%stage, %second_key, %second) : (i32, buffer, i64)
    %bytes = scalar.constant 2097184 : i64
    scf.yield %bytes : i64
  } else {
    scf.yield %c0 : i64
  }
  func.return %bytes : i64
}
