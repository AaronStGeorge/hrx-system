load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "pipeline_workers",
    testonly = True,
    srcs = ["pipeline_workers.c"],
    hdrs = ["pipeline_workers.h"],
    visibility = ["//loom/src/loom/tools/loom-check:__pkg__"],
    deps = [
        "//loom/src/loom/analysis:channel_plan",
        "//loom/src/loom/analysis:pipeline_resources",
        "//loom/src/loom/analysis:pipeline_workers",
        "//loom/src/loom/analysis:source_storage_packing",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:type_registry",
        "//loom/src/loom/ops/channel",
        "//loom/src/loom/ops/pipeline",
        "//loom/src/loom/tools/loom-check:execute",
        "//loom/src/loom/util:fact_table",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_check_test_suite(
    name = "core_test",
    srcs = [
        "checks.loom-test",
        "emit.loom-test",
        "low_asm.loom-test",
        "low_report.loom-test",
        "pass.loom-test",
        "requires.loom-test",
        "roundtrip.loom-test",
        "verify.loom-test",
    ],
)

# The shipping tool includes test dialect syntax without synthetic target
# passes. A non-idempotent path map also checks that diagnostics keep the case's
# logical identity instead of remapping it a second time during admission.
loom_check_test(
    name = "verify_tool",
    src = "verify.loom-test",
    args = ["--source-prefix-map==logical/"],
    runner = "//loom/src/loom/tools/loom-check:loom-check",
)

test_suite(
    name = "test",
    tests = [
        ":core_test",
        ":verify_tool",
    ],
)
