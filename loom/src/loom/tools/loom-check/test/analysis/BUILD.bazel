    name = "providers",
    testonly = True,
    srcs = ["pipeline_transport.c"],
    hdrs = ["providers.h"],
    visibility = ["//loom/src/loom/tools/loom-check:__pkg__"],
    deps = [
        "//loom/src/loom/analysis:pipeline_resources",
        "//loom/src/loom/analysis:pipeline_workers",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:type_registry",
        "//loom/src/loom/ops/pipeline",
        "//loom/src/loom/tools/loom-check:execute",
        "//loom/src/loom/util:fact_table",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)
