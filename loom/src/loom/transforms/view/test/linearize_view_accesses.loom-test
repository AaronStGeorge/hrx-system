// Transposed layouts remain ranked for direct source-memory lowering.
func.def @leave_transposed_accesses_ranked(%input: buffer, %origin: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %column = index.assume %column0 [range(%column0, 0, 12)] : index
  %layout = encoding.layout.strided [1, 8] : encoding<layout>
  %source = buffer.view %input[%origin] : buffer -> view<8x16xf32, %layout>
  %scalar = view.load %source[%row, %column] : view<8x16xf32, %layout> -> f32
  %vector = vector.load %source[%row, %column] : view<8x16xf32, %layout> -> vector<4xf32>
  test.use %scalar, %vector : f32, vector<4xf32>
  func.return
}

// ----
func.def @leave_transposed_accesses_ranked(%input: buffer, %origin: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %column = index.assume %column0 [range(%column0, 0, 12)] : index
  %source = buffer.view %input[%origin] : buffer -> view<8x16xf32, #encoding.layout.strided<strides=[1, 8]>>
  %scalar = view.load %source[%row, %column] : view<8x16xf32, #encoding.layout.strided<strides=[1, 8]>> -> f32
  %vector = vector.load %source[%row, %column] : view<8x16xf32, #encoding.layout.strided<strides=[1, 8]>> -> vector<4xf32>
  test.use %scalar, %vector : f32, vector<4xf32>
  func.return
}

