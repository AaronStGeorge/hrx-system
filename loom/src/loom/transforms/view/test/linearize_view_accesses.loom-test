func.def @linearize_dense_vector_load_store_with_ssa_layout(%input: buffer, %output: buffer, %zero_bytes: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %column = index.assume %column0 [range(%column0, 0, 12)] : index
  %layout = encoding.layout.dense : encoding<layout>
  %input_view = buffer.view %input[%zero_bytes] : buffer -> view<8x16xf32, %layout>
  %output_view = buffer.view %output[%zero_bytes] : buffer -> view<8x16xf32, %layout>
  %value = vector.load %input_view[%row, %column] {cache_scope = device, cache_temporal = non_temporal} : view<8x16xf32, %layout> -> vector<4xf32>
  vector.store %value, %output_view[%row, %column] {cache_scope = system, cache_temporal = bypass} : vector<4xf32>, view<8x16xf32, %layout>
  func.return
}

// ----
func.def @linearize_dense_vector_load_store_with_ssa_layout(%input: buffer, %output: buffer, %zero_bytes: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %column = index.assume %column0 [range(%column0, 0, 12)] : index
  %input_view = buffer.view %input[%zero_bytes] : buffer -> view<128xf32>
  %output_view = buffer.view %output[%zero_bytes] : buffer -> view<128xf32>
  %11 = index.constant 16 : index
  %12 = index.madd %row, %11, %column : index
  %value = vector.load %input_view[%12] {cache_scope = device, cache_temporal = non_temporal} : view<128xf32> -> vector<4xf32>
  vector.store %value, %output_view[%12] {cache_scope = system, cache_temporal = bypass} : vector<4xf32>, view<128xf32>
  func.return
}

