func.def @leave_rank1_and_unproved_views(%input: buffer, %zero_bytes: offset, %row: index, %column: index) {
  %dense_view = buffer.view %input[%zero_bytes] : buffer -> view<128xf32>
  %strided_layout = encoding.layout.strided [64, 1] : encoding<layout>
  %strided_view = buffer.view %input[%zero_bytes] : buffer -> view<8x16xf32, %strided_layout>
  %dense = view.load %dense_view[%row] : view<128xf32> -> f32
  %strided = view.load %strided_view[%row, %column] : view<8x16xf32, %strided_layout> -> f32
  test.use %dense, %strided : f32, f32
  func.return
}

// ----
func.def @leave_rank1_and_unproved_views(%input: buffer, %zero_bytes: offset, %row: index, %column: index) {
  %dense_view = buffer.view %input[%zero_bytes] : buffer -> view<128xf32>
  %strided_view = buffer.view %input[%zero_bytes] : buffer -> view<8x16xf32, #encoding.layout.strided<strides=[64, 1]>>
  %dense = view.load %dense_view[%row] : view<128xf32> -> f32
  %strided = view.load %strided_view[%row, %column] : view<8x16xf32, #encoding.layout.strided<strides=[64, 1]>> -> f32
  test.use %dense, %strided : f32, f32
  func.return
}

