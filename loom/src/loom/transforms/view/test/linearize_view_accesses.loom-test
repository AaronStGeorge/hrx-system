  %16 = vector.load %source[%15] : view<156xf32> -> vector<4xf32>
  vector.store %14, %destination[%13] : vector<4xf32>, view<156xf32>
  vector.store %16, %destination[%15] : vector<4xf32>, view<156xf32>
  func.return
}

