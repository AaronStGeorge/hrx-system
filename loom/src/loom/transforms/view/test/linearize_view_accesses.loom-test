// ====

// Exact dynamic stride facts define a fixed physical span. A genuinely
// runtime stride leaves the ranked address and its materialization intact.
func.def @linearize_only_exact_dynamic_strides(%exact_input: buffer, %dynamic_input: buffer, %origin: offset, %exact_stride0: index, %dynamic_stride0: index, %row0: index, %column0: index) {
  %exact_stride = index.assume %exact_stride0 [range(%exact_stride0, 20, 20)] : index
  %dynamic_stride = index.assume %dynamic_stride0 [range(%dynamic_stride0, 20, 24)] : index
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %column = index.assume %column0 [range(%column0, 0, 15)] : index
  %exact_layout = encoding.layout.strided [%exact_stride, 1] : encoding<layout>
  %dynamic_layout = encoding.layout.strided [%dynamic_stride, 1] : encoding<layout>
  %exact_view = buffer.view %exact_input[%origin] : buffer -> view<8x16xf32, %exact_layout>
  %dynamic_view = buffer.view %dynamic_input[%origin] : buffer -> view<8x16xf32, %dynamic_layout>
  %exact = view.load %exact_view[%row, %column] : view<8x16xf32, %exact_layout> -> f32
  %dynamic = view.load %dynamic_view[%row, %column] : view<8x16xf32, %dynamic_layout> -> f32
  test.use %exact, %dynamic : f32, f32
  func.return
}

// ----
func.def @linearize_only_exact_dynamic_strides(%exact_input: buffer, %dynamic_input: buffer, %origin: offset, %exact_stride0: index, %dynamic_stride0: index, %row0: index, %column0: index) {
  %dynamic_stride = index.assume %dynamic_stride0 [range(%dynamic_stride0, 20, 24)] : index
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %column = index.assume %column0 [range(%column0, 0, 15)] : index
  %dynamic_layout = encoding.layout.strided [%dynamic_stride, 1] : encoding<layout>
  %exact_view = buffer.view %exact_input[%origin] : buffer -> view<156xf32>
  %dynamic_view = buffer.view %dynamic_input[%origin] : buffer -> view<8x16xf32, %dynamic_layout>
  %17 = index.constant 20 : index
  %18 = index.madd %row, %17, %column : index
  %exact = view.load %exact_view[%18] : view<156xf32> -> f32
  %dynamic = view.load %dynamic_view[%row, %column] : view<8x16xf32, %dynamic_layout> -> f32
  test.use %exact, %dynamic : f32, f32
  func.return
}

// ====

// Replacing the address layout of composed physical storage must retain its
// exact payload schema.
func.def @linearize_exact_composed_storage(%input: buffer, %origin: offset, %row_stride0: index, %row0: index, %column0: index) {
  %row_stride = index.assume %row_stride0 [range(%row_stride0, 8, 8)] : index
  %row = index.assume %row0 [range(%row0, 0, 1)] : index
  %column = index.assume %column0 [range(%column0, 0, 3)] : index
  %layout = encoding.layout.strided [%row_stride, 1] : encoding<layout>
  %schema = encoding.define #encoding.f8e4m3fnuz : encoding<schema>
  %storage = encoding.define #encoding.storage {layout = %layout : encoding<layout>, schema = %schema : encoding<schema>} : encoding<storage>
  %source = buffer.view %input[%origin] : buffer -> view<2x4xf8E4M3, %storage>
  %value = view.load %source[%row, %column] : view<2x4xf8E4M3, %storage> -> f8E4M3
  test.use %value : f8E4M3
  func.return
}

// ----
func.def @linearize_exact_composed_storage(%input: buffer, %origin: offset, %row_stride0: index, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 1)] : index
  %column = index.assume %column0 [range(%column0, 0, 3)] : index
  %source = buffer.view %input[%origin] : buffer -> view<12xf8E4M3, #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.f8e4m3fnuz>>
  %13 = index.constant 8 : index
  %14 = index.madd %row, %13, %column : index
  %value = view.load %source[%14] : view<12xf8E4M3, #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.f8e4m3fnuz>> -> f8E4M3
  test.use %value : f8E4M3
  func.return
}

// ====
// RUN: pass linearize-view-accesses,canonicalize,cse

// Rebuilding a multidimensional view must preserve reduced alignment instead
// of silently adopting the new type's natural default.
func.def @linearize_packed_load(%input: buffer, %origin: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 3)] : index
  %column = index.assume %column0 [range(%column0, 0, 127)] : index
  %view = buffer.view %input[%origin] : buffer -> view<4x128xf16, align(1)>
  %value = view.load %view[%row, %column] : view<4x128xf16, align(1)> -> f16
  test.use %value : f16
  func.return
}

// ----
func.def @linearize_packed_load(%input: buffer, %origin: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 3)] : index
  %column = index.assume %column0 [range(%column0, 0, 127)] : index
  %view = buffer.view %input[%origin] : buffer -> view<512xf16, align(1)>
  %8 = index.constant 128 : index
  %9 = index.madd %row, %8, %column : index
  %value = view.load %view[%9] : view<512xf16, align(1)> -> f16
  test.use %value : f16
  func.return
}

// ====

// Unproved coordinates must remain ranked; a view type declares the bounds,
// but does not establish that the caller's coordinates satisfy them.
func.def @preserve_unproved_scalar_accesses(%input: buffer, %output: buffer, %origin: offset, %row: index, %column: index) {
  %source = buffer.view %input[%origin] : buffer -> view<8x16xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<8x16xf32>
  %value = view.load %source[%row, %column] : view<8x16xf32> -> f32
  view.store %value, %destination[%row, %column] : f32, view<8x16xf32>
  func.return
}

// ====

func.def @preserve_unproved_vector_accesses(%input: buffer, %output: buffer, %origin: offset, %row0: index, %column: index) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %source = buffer.view %input[%origin] : buffer -> view<8x16xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<8x16xf32>
  %value = vector.load %source[%row, %column] : view<8x16xf32> -> vector<4xf32>
  vector.store %value, %destination[%row, %column] : vector<4xf32>, view<8x16xf32>
  func.return
}

// ====

// The origin fits, but the second tile row does not. No row load, slice,
// partial store, or rank-1 view may be emitted before this is established.
func.def @preserve_unproved_tile_footprint(%input: buffer, %output: buffer, %origin: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %column = index.assume %column0 [range(%column0, 0, 12)] : index
  %source = buffer.view %input[%origin] : buffer -> view<8x16xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<8x16xf32>
  %value = vector.load %source[%row, %column] : view<8x16xf32> -> vector<2x4xf32>
  vector.store %value, %destination[%row, %column] : vector<2x4xf32>, view<8x16xf32>
  func.return
}

// ====

func.def @linearize_rank3_boundary_tile(%input: buffer, %output: buffer, %origin: offset, %plane0: index, %row0: index) {
  %plane = index.assume %plane0 [range(%plane0, 0, 2)] : index
  %row = index.assume %row0 [range(%row0, 0, 6)] : index
  %source = buffer.view %input[%origin] : buffer -> view<4x8x16xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<4x8x16xf32>
  %value = vector.load %source[%plane, %row, 12] : view<4x8x16xf32> -> vector<2x2x4xf32>
  vector.store %value, %destination[%plane, %row, 12] : vector<2x2x4xf32>, view<4x8x16xf32>
  func.return
}

// ----
func.def @linearize_rank3_boundary_tile(%input: buffer, %output: buffer, %origin: offset, %plane0: index, %row0: index) {
  %plane = index.assume %plane0 [range(%plane0, 0, 2)] : index
  %row = index.assume %row0 [range(%row0, 0, 6)] : index
  %source = buffer.view %input[%origin] : buffer -> view<512xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<512xf32>
  %11 = index.constant 16 : index
  %12 = index.mul %row, %11 : index
  %13 = index.constant 128 : index
  %14 = index.madd %plane, %13, %12 : index
  %15 = index.constant 12 : index
  %16 = index.add %14, %15 : index
  %17 = vector.load %source[%16] : view<512xf32> -> vector<4xf32>
  %18 = index.constant 28 : index
  %19 = index.add %14, %18 : index
  %20 = vector.load %source[%19] : view<512xf32> -> vector<4xf32>
  %21 = index.constant 140 : index
  %22 = index.add %14, %21 : index
  %23 = vector.load %source[%22] : view<512xf32> -> vector<4xf32>
  %24 = index.constant 156 : index
  %25 = index.add %14, %24 : index
  %26 = vector.load %source[%25] : view<512xf32> -> vector<4xf32>
  vector.store %17, %destination[%16] : vector<4xf32>, view<512xf32>
  vector.store %20, %destination[%19] : vector<4xf32>, view<512xf32>
  vector.store %23, %destination[%22] : vector<4xf32>, view<512xf32>
  vector.store %26, %destination[%25] : vector<4xf32>, view<512xf32>
  func.return
}

// ====

// These coordinates compensate in a flattened address, but still violate
// the original per-axis contract and must not be erased by linearization.
func.def @preserve_compensating_coordinates(%input: buffer, %origin: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 1, 7)] : index
  %column = index.assume %column0 [range(%column0, -1, 14)] : index
  %source = buffer.view %input[%origin] : buffer -> view<8x16xf32>
  %value = view.load %source[%row, %column] : view<8x16xf32> -> f32
  test.use %value : f32
  func.return
}

// ====

// RUN: pass linearize-view-accesses,canonicalize,vector-memory-footprint

// A nonstrict quotient guard permits row 73. At g=2336 the 16-element
// access starts immediately past the buffer. Scalar casts must not hide it.
func.def @reject_nonstrict_quotient_guard(%input: buffer, %output: buffer, %raw: i32) {
  %base = index.constant 0 : offset
  %linear = scalar.assume %raw [range(%raw, 0, 2367)] : i32
  %width = index.constant 16 : index
  %scale = scalar.constant 32 : i32
  %capacity = scalar.constant 73 : i32
  %quotient = scalar.divui %linear, %scale : i32
  %remainder = scalar.remui %linear, %scale : i32
  %row = index.cast %quotient : i32 to index
  %group = index.cast %remainder : i32 to index
  %column = index.mul %group, %width : index
  %inputs = buffer.view %input[%base] : buffer -> view<73x512xbf16>
  %outputs = buffer.view %output[%base] : buffer -> view<73x512xbf16>
  %condition = scalar.cmpi ule, %quotient, %capacity : i32
  scf.if %condition {
    // ERROR@+1: SUBRANGE/011 {op_name="vector.load", view_axis="0"}
    %value = vector.load %inputs[%row, %column] : view<73x512xbf16> -> vector<16xbf16>
    // ERROR@+1: SUBRANGE/011 {op_name="vector.store", view_axis="0"}
    vector.store %value, %outputs[%row, %column] : vector<16xbf16>, view<73x512xbf16>
  }
  func.return
}

// ====

// RUN: pass linearize-view-accesses,canonicalize,scf-to-cfg,vector-memory-footprint

func.def @reject_partial_tile_guard(%input: buffer, %output: buffer, %base: offset, %row0: index, %external: i1) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %source = buffer.view %input[%base] : buffer -> view<8x16xf32>
  %destination = buffer.view %output[%base] : buffer -> view<8x16xf32>
  scf.if %external {
    // ERROR@+1: SUBRANGE/010 {op_name="vector.load", vector_extent="2", view_axis="0"}
    %value = vector.load %source[%row, 12] : view<8x16xf32> -> vector<2x4xf32>
    // ERROR@+1: SUBRANGE/010 {op_name="vector.store", vector_extent="2", view_axis="0"}
    vector.store %value, %destination[%row, 12] : vector<2x4xf32>, view<8x16xf32>
  }
  func.return
}

// ====

// RUN: pass specialize-target-callgraph,linearize-view-accesses,dce

// Target-bound powers of two are shifts immediately. Memory effects and cache
// policy remain on each access even when its address computation is shared.
test.target<quirky> @target32

test.target<low_core> @target64

func.def target(@target32) @share_vector_address(%input: buffer, %output: buffer, %origin: offset, %row0: index) {
  %row = index.assume %row0 [range(%row0, 0, 63)] : index
  %source = buffer.view %input[%origin] : buffer -> view<64x4xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<64x4xi32>
  %value = vector.load<volatile> %source[%row, 0] {cache_scope = system, cache_temporal = bypass} : view<64x4xi32> -> vector<4xi32>
  vector.store<volatile> %value, %destination[%row, 0] {cache_scope = device, cache_temporal = writeback} : vector<4xi32>, view<64x4xi32>
  func.return
}

func.def target(@target64) @share_scalar_address(%input: buffer, %output: buffer, %origin: offset, %row0: index) {
  %row = index.assume %row0 [range(%row0, 0, 63)] : index
  %source = buffer.view %input[%origin] : buffer -> view<64x4xf16>
  %destination = buffer.view %output[%origin] : buffer -> view<64x4xf16>
  %value = view.load %source[%row, 0] : view<64x4xf16> -> f16
  view.store %value, %destination[%row, 0] : f16, view<64x4xf16>
  func.return
}

// ----
test.target<quirky> @target32

test.target<low_core> @target64

func.def target(@target32) @share_vector_address(%input: buffer, %output: buffer, %origin: offset, %row0: index) {
  %row = index.assume %row0 [range(%row0, 0, 63)] : index
  %source = buffer.view %input[%origin] : buffer -> view<256xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<256xi32>
  %16 = index.constant 2 : index
  %17 = index.shli %row, %16 : index
  %value = vector.load<volatile> %source[%17] {cache_scope = system, cache_temporal = bypass} : view<256xi32> -> vector<4xi32>
  vector.store<volatile> %value, %destination[%17] {cache_scope = device, cache_temporal = writeback} : vector<4xi32>, view<256xi32>
  func.return
}

func.def target(@target64) @share_scalar_address(%input: buffer, %output: buffer, %origin: offset, %row0: index) {
  %row = index.assume %row0 [range(%row0, 0, 63)] : index
  %source = buffer.view %input[%origin] : buffer -> view<256xf16>
  %destination = buffer.view %output[%origin] : buffer -> view<256xf16>
  %21 = index.constant 2 : index
  %22 = index.shli %row, %21 : index
  %value = view.load %source[%22] : view<256xf16> -> f16
  view.store %value, %destination[%22] : f16, view<256xf16>
  func.return
}

// ====

// RUN: pass linearize-view-accesses,dce

// A non-power-of-two scale and each row displacement are shared across tile
// load/store materialization, without building them once per row and access.
func.def @share_strided_tile_address(%input: buffer, %output: buffer, %origin: offset, %row0: index) {
  %row = index.assume %row0 [range(%row0, 0, 5)] : index
  %source = buffer.view %input[%origin] : buffer -> view<8x4xi16, #encoding.layout.strided<strides=[7, 1]>>
  %destination = buffer.view %output[%origin] : buffer -> view<8x4xi16, #encoding.layout.strided<strides=[7, 1]>>
  %value = vector.load %source[%row, 0] : view<8x4xi16, #encoding.layout.strided<strides=[7, 1]>> -> vector<3x4xi16>
  vector.store %value, %destination[%row, 0] : vector<3x4xi16>, view<8x4xi16, #encoding.layout.strided<strides=[7, 1]>>
  func.return
}

// ----
func.def @share_strided_tile_address(%input: buffer, %output: buffer, %origin: offset, %row0: index) {
  %row = index.assume %row0 [range(%row0, 0, 5)] : index
  %source = buffer.view %input[%origin] : buffer -> view<53xi16>
  %destination = buffer.view %output[%origin] : buffer -> view<53xi16>
  %9 = index.constant 7 : index
  %10 = index.mul %row, %9 : index
  %11 = vector.load %source[%10] : view<53xi16> -> vector<4xi16>
  %12 = index.add %10, %9 : index
  %13 = vector.load %source[%12] : view<53xi16> -> vector<4xi16>
  %14 = index.constant 14 : index
  %15 = index.add %10, %14 : index
  %16 = vector.load %source[%15] : view<53xi16> -> vector<4xi16>
  %17 = vector.concat<0> %11, %13, %16 : vector<4xi16>, vector<4xi16>, vector<4xi16> -> vector<12xi16>
  %value = vector.bitcast %17 : vector<12xi16> to vector<3x4xi16>
  %20 = vector.bitcast %value : vector<3x4xi16> to vector<12xi16>
  %21 = vector.slice %20[0] : vector<12xi16> -> vector<4xi16>
  vector.store %21, %destination[%10] : vector<4xi16>, view<53xi16>
  %22 = vector.slice %20[4] : vector<12xi16> -> vector<4xi16>
  vector.store %22, %destination[%12] : vector<4xi16>, view<53xi16>
  %23 = vector.slice %20[8] : vector<12xi16> -> vector<4xi16>
  vector.store %23, %destination[%15] : vector<4xi16>, view<53xi16>
  func.return
}

// ====

// RUN: pass linearize-view-accesses,dce

// Reuse never crosses sibling or nested blocks. Returning to the outer block
// still reuses its earlier producer, which dominates the final access.
func.def @scope_address_reuse(%input: buffer, %origin: offset, %row0: index, %condition: i1) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %source = buffer.view %input[%origin] : buffer -> view<8x4xi32>
  %before = view.load<volatile> %source[%row, 0] : view<8x4xi32> -> i32
  scf.if %condition {
    %left = view.load<volatile> %source[%row, 0] : view<8x4xi32> -> i32
    test.use %left : i32
  } else {
    %right = view.load<volatile> %source[%row, 0] : view<8x4xi32> -> i32
    test.use %right : i32
  }
  %after = view.load<volatile> %source[%row, 0] : view<8x4xi32> -> i32
  test.use %before, %after : i32, i32
  func.return
}

// ----
func.def @scope_address_reuse(%input: buffer, %origin: offset, %row0: index, %condition: i1) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %source = buffer.view %input[%origin] : buffer -> view<32xi32>
  %10 = index.constant 4 : index
  %11 = index.mul %row, %10 : index
  %before = view.load<volatile> %source[%11] : view<32xi32> -> i32
  scf.if %condition {
    %14 = index.constant 4 : index
    %15 = index.mul %row, %14 : index
    %left = view.load<volatile> %source[%15] : view<32xi32> -> i32
    test.use %left : i32
  } else {
    %17 = index.constant 4 : index
    %18 = index.mul %row, %17 : index
    %right = view.load<volatile> %source[%18] : view<32xi32> -> i32
    test.use %right : i32
  }
  %after = view.load<volatile> %source[%11] : view<32xi32> -> i32
  test.use %before, %after : i32, i32
  func.return
}

// ====

// RUN: pass linearize-view-accesses,dce

// A zero stride needs no arithmetic, but still needs its coordinate proof.
func.def @zero_stride_keeps_footprint_proof(%input: buffer, %origin: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %column = index.assume %column0 [range(%column0, 0, 15)] : index
  %source = buffer.view %input[%origin] : buffer -> view<8x16xf32, #encoding.layout.strided<strides=[0, 1]>>
  %proved = view.load %source[%row, %column] : view<8x16xf32, #encoding.layout.strided<strides=[0, 1]>> -> f32
  %unproved = view.load %source[%row0, %column] : view<8x16xf32, #encoding.layout.strided<strides=[0, 1]>> -> f32
  test.use %proved, %unproved : f32, f32
  func.return
}

// ----
func.def @zero_stride_keeps_footprint_proof(%input: buffer, %origin: offset, %row0: index, %column0: index) {
  %column = index.assume %column0 [range(%column0, 0, 15)] : index
  %source$6 = buffer.view %input[%origin] : buffer -> view<8x16xf32, #encoding.layout.strided<strides=[0, 1]>>
  %source$9 = buffer.view %input[%origin] : buffer -> view<16xf32>
  %proved = view.load %source$9[%column] : view<16xf32> -> f32
  %unproved = view.load %source$6[%row0, %column] : view<8x16xf32, #encoding.layout.strided<strides=[0, 1]>> -> f32
  test.use %proved, %unproved : f32, f32
  func.return
}

// ====

// RUN: pass linearize-view-accesses,dce

// Both CFG blocks reuse the flat view, but address expressions are only shared
// within a block. Cross-block availability belongs to the ordinary CSE pass.
func.def @separate_cfg_addresses(%input: buffer, %origin: offset, %row0: index) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %source = buffer.view %input[%origin] : buffer -> view<8x4xi32>
  cfg.br ^first_access
^first_access:
  %initial = view.load<volatile> %source[%row, 0] : view<8x4xi32> -> i32
  test.use %initial : i32
  cfg.br ^following_access
^following_access:
  %first = view.load<volatile> %source[%row, 0] : view<8x4xi32> -> i32
  %second = view.load<volatile> %source[%row, 0] : view<8x4xi32> -> i32
  test.use %first, %second : i32, i32
  func.return
}

// ----
func.def @separate_cfg_addresses(%input: buffer, %origin: offset, %row0: index) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %source = buffer.view %input[%origin] : buffer -> view<32xi32>
  cfg.br ^first_access
^first_access:
  %8 = index.constant 4 : index
  %9 = index.mul %row, %8 : index
  %initial = view.load<volatile> %source[%9] : view<32xi32> -> i32
  test.use %initial : i32
  cfg.br ^following_access
^following_access:
  %12 = index.constant 4 : index
  %13 = index.mul %row, %12 : index
  %first = view.load<volatile> %source[%13] : view<32xi32> -> i32
  %second = view.load<volatile> %source[%13] : view<32xi32> -> i32
  test.use %first, %second : i32, i32
  func.return
}

// ====

// RUN: pass specialize-target-callgraph,linearize-view-accesses,dce

// Forming a shift respects each worker's carrier width, not its enclosing
// pipeline's target. A shift by 32 is only valid in the 64-bit worker.
test.target<low_core> @target32 {index_bitwidth = 32}

test.target<low_core> @target64 {index_bitwidth = 64}

pipeline.def public target(@target64) @worker_scales() run(%input: buffer, %origin: offset, %row0: index) {
  pipeline.strand target(@target32) workers([0], [1], [1]) {
    %row32 = index.assume %row0 [range(%row0, 0, 1)] : index
    %source32 = buffer.view %input[%origin] : buffer -> view<2x4294967296xi8>
    %value32 = view.load<volatile> %source32[%row32, 0] : view<2x4294967296xi8> -> i8
    test.use %value32 : i8
  }
  pipeline.strand target(@target64) workers([1], [1], [1]) {
    %row64 = index.assume %row0 [range(%row0, 0, 1)] : index
    %source64 = buffer.view %input[%origin] : buffer -> view<2x4294967296xi8>
    %value64 = view.load<volatile> %source64[%row64, 0] : view<2x4294967296xi8> -> i8
    test.use %value64 : i8
  }
}

// ----
test.target<low_core> @target32 {index_bitwidth = 32}

test.target<low_core> @target64 {index_bitwidth = 64}

pipeline.def public target(@target64) @worker_scales() run(%input: buffer, %origin: offset, %row0: index) {
  pipeline.strand target(@target32) workers([0], [1], [1]) {
    %row32 = index.assume %row0 [range(%row0, 0, 1)] : index
    %source32 = buffer.view %input[%origin] : buffer -> view<8589934592xi8>
    %9 = index.constant 4294967296 : index
    %10 = index.mul %row32, %9 : index
    %value32 = view.load<volatile> %source32[%10] : view<8589934592xi8> -> i8
    test.use %value32 : i8
  }
  pipeline.strand target(@target64) workers([1], [1], [1]) {
    %row64 = index.assume %row0 [range(%row0, 0, 1)] : index
    %source64 = buffer.view %input[%origin] : buffer -> view<8589934592xi8>
    %13 = index.constant 32 : index
    %14 = index.shli %row64, %13 : index
    %value64 = view.load<volatile> %source64[%14] : view<8589934592xi8> -> i8
    test.use %value64 : i8
  }
}
