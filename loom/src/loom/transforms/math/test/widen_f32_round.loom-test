// RUN: pass legalize-math

test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

// The recipe widens directly from the source of an exact extension.
func.def target(@math_target) @scalar_source_extension(%x: f8E4M3, %scale: bf16) -> (bf16) {
  %extended = scalar.extf %x : f8E4M3 to bf16
  %result = scalar.mulf %extended, %scale : bf16
  func.return %result : bf16
}

// ----
test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

func.def target(@math_target) @scalar_source_extension(%x: f8E4M3, %scale: bf16) -> (bf16) {
  %extended = scalar.extf %x : f8E4M3 to bf16
  %5 = scalar.extf %x : f8E4M3 to f32
  %6 = scalar.extf %scale : bf16 to f32
  %7 = scalar.mulf %5, %6 : f32
  %result = scalar.fptrunc %7 : f32 to bf16
  func.return %result : bf16
}

// ====

test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

// A relaxed extension remains in the rewritten graph because projecting
// through it would discard its input-flush behavior.
func.def target(@math_target) @scalar_relaxed_source_extension(%x: f8E4M3, %scale: bf16) -> (bf16) {
  %extended = scalar.extf<daz> %x : f8E4M3 to bf16
  %result = scalar.mulf %extended, %scale : bf16
  func.return %result : bf16
}

// ----
test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

func.def target(@math_target) @scalar_relaxed_source_extension(%x: f8E4M3, %scale: bf16) -> (bf16) {
  %extended = scalar.extf<daz> %x : f8E4M3 to bf16
  %5 = scalar.extf %extended : bf16 to f32
  %6 = scalar.extf %scale : bf16 to f32
  %7 = scalar.mulf %5, %6 : f32
  %result = scalar.fptrunc %7 : f32 to bf16
  func.return %result : bf16
}

// ====

test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

// The same source projection applies to lane-wise vector extensions.
func.def target(@math_target) @vector_source_extension(%x: vector<4xf8E4M3>, %scale: vector<4xbf16>) -> (vector<4xbf16>) {
  %extended = vector.extf %x : vector<4xf8E4M3> to vector<4xbf16>
  %result = vector.mulf %extended, %scale : vector<4xbf16>
  func.return %result : vector<4xbf16>
}

// ----
test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

func.def target(@math_target) @vector_source_extension(%x: vector<4xf8E4M3>, %scale: vector<4xbf16>) -> (vector<4xbf16>) {
  %extended = vector.extf %x : vector<4xf8E4M3> to vector<4xbf16>
  %5 = vector.extf %x : vector<4xf8E4M3> to vector<4xf32>
  %6 = vector.extf %scale : vector<4xbf16> to vector<4xf32>
  %7 = vector.mulf %5, %6 : vector<4xf32>
  %result = vector.fptrunc %7 : vector<4xf32> to vector<4xbf16>
  func.return %result : vector<4xbf16>
}

// ====

test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

func.def target(@math_target) @vector_relaxed_source_extension(%x: vector<4xf8E4M3>, %scale: vector<4xbf16>) -> (vector<4xbf16>) {
  %extended = vector.extf<daz> %x : vector<4xf8E4M3> to vector<4xbf16>
  %result = vector.mulf %extended, %scale : vector<4xbf16>
  func.return %result : vector<4xbf16>
}

// ----
test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

func.def target(@math_target) @vector_relaxed_source_extension(%x: vector<4xf8E4M3>, %scale: vector<4xbf16>) -> (vector<4xbf16>) {
  %extended = vector.extf<daz> %x : vector<4xf8E4M3> to vector<4xbf16>
  %5 = vector.extf %extended : vector<4xbf16> to vector<4xf32>
  %6 = vector.extf %scale : vector<4xbf16> to vector<4xf32>
  %7 = vector.mulf %5, %6 : vector<4xf32>
  %result = vector.fptrunc %7 : vector<4xf32> to vector<4xbf16>
  func.return %result : vector<4xbf16>
}

// ====

test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

// Uniform vectors remain scalar conversions followed by splats. The nested
// source extension is exact and projects through to the original FP8 value.
func.def target(@math_target) @vector_uniform_source_extension(%x: f8E4M3, %scale: bf16) -> (vector<4xbf16>) {
  %extended = scalar.extf %x : f8E4M3 to bf16
  %uniform = vector.splat %extended : vector<4xbf16>
  %uniform_scale = vector.splat %scale : vector<4xbf16>
  %result = vector.mulf %uniform, %uniform_scale : vector<4xbf16>
  func.return %result : vector<4xbf16>
}

// ----
test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

func.def target(@math_target) @vector_uniform_source_extension(%x: f8E4M3, %scale: bf16) -> (vector<4xbf16>) {
  %extended = scalar.extf %x : f8E4M3 to bf16
  %uniform = vector.splat %extended : vector<4xbf16>
  %uniform_scale = vector.splat %scale : vector<4xbf16>
  %7 = scalar.extf %x : f8E4M3 to f32
  %8 = vector.splat %7 : vector<4xf32>
  %9 = scalar.extf %scale : bf16 to f32
  %10 = vector.splat %9 : vector<4xf32>
  %11 = vector.mulf %8, %10 : vector<4xf32>
  %result = vector.fptrunc %11 : vector<4xf32> to vector<4xbf16>
  func.return %result : vector<4xbf16>
}

// ====

test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

// Widening preserves reciprocal permission, including its absence.
func.def target(@math_target) @scalar_division(%x: f16, %y: f16) -> (f16, f16) {
  %strict = scalar.divf %x, %y : f16
  %approximate = scalar.divf<arcp> %x, %y : f16
  func.return %strict, %approximate : f16, f16
}

// ----
test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

func.def target(@math_target) @scalar_division(%x: f16, %y: f16) -> (f16, f16) {
  %10 = scalar.extf %x : f16 to f32
  %11 = scalar.extf %y : f16 to f32
  %12 = scalar.divf %10, %11 : f32
  %strict = scalar.fptrunc %12 : f32 to f16
  %6 = scalar.extf %x : f16 to f32
  %7 = scalar.extf %y : f16 to f32
  %8 = scalar.divf<arcp> %6, %7 : f32
  %approximate = scalar.fptrunc %8 : f32 to f16
  func.return %strict, %approximate : f16, f16
}

// ====

test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

func.def target(@math_target) @vector_division(%x: vector<3xbf16>, %y: vector<3xbf16>) -> (vector<3xbf16>) {
  %quotient = vector.divf<arcp> %x, %y : vector<3xbf16>
  func.return %quotient : vector<3xbf16>
}

// ----
test.target<low_core> @math_target {contract_set_key = "test.math.widen_f32_round"}

func.def target(@math_target) @vector_division(%x: vector<3xbf16>, %y: vector<3xbf16>) -> (vector<3xbf16>) {
  %4 = vector.extf %x : vector<3xbf16> to vector<3xf32>
  %5 = vector.extf %y : vector<3xbf16> to vector<3xf32>
  %6 = vector.divf<arcp> %4, %5 : vector<3xf32>
  %quotient = vector.fptrunc %6 : vector<3xf32> to vector<3xbf16>
  func.return %quotient : vector<3xbf16>
}
