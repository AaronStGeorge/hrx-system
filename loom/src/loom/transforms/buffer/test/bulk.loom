func.def public @bulk_fill_f8E4M3(%target: buffer, %target_offset: offset, %length: offset, %bits: i64) {
  %raw = scalar.trunci %bits : i64 to i8
  %pattern = scalar.bitcast %raw : i8 to f8E4M3
  buffer.fill %pattern, %target[%target_offset], %length : f8E4M3
  func.return
}

