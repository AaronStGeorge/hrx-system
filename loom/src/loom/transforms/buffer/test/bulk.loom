func.def public @bulk_copy(%source: buffer, %source_offset: offset, %target: buffer, %target_offset: offset, %length: offset) {
  buffer.copy %source[%source_offset], %target[%target_offset], %length
  func.return
}

func.def public @bulk_fill_i8(%target: buffer, %target_offset: offset, %length: offset, %bits: i64) {
  %raw = scalar.trunci %bits : i64 to i8
  buffer.fill %raw, %target[%target_offset], %length : i8
  func.return
}

func.def public @bulk_fill_i16(%target: buffer, %target_offset: offset, %length: offset, %bits: i64) {
