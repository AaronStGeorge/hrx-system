// A source remains borrowed from issue, even before the transfer is grouped.
func.def @rejects_transitive_source_write(%input: buffer, %value: i8) {
  %base = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
