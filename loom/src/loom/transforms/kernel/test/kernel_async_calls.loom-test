func.def noinline @recursive_read(%values: view<16xi8>, %count: i32) -> (i8) {
  %stop_count = scalar.constant 0 : i32
  %decrement = scalar.constant 1 : i32
  %done = scalar.cmpi eq, %count, %stop_count : i32
  %value = scf.if %done -> (i8) {
    %loaded = view.load %values[0] : view<16xi8> -> i8
    scf.yield %loaded : i8
  } else {
    %next = scalar.subi %count, %decrement : i32
    %nested = func.call @recursive_read(%values, %next) : (view<16xi8>, i32) -> (i8)
    scf.yield %nested : i8
  }
  func.return %value : i8
}

func.def @rejects_recursive_destination_read(%input: buffer) -> (i8) {
  %base = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %depth = scalar.constant 1 : i32
  %global = buffer.assume.memory_space<global> %input : buffer
  %source = buffer.view %global[%base] : buffer -> view<16xi8>
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %dest = buffer.view %scratch[%base] : buffer -> view<16xi8>
  %copy = kernel.async.copy %source to %dest {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi8> to view<16xi8> -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  // ERROR@+1: LOWERING/028 {op_name="func.call", phase_name="kernel-synchronization-legality"}
  %loaded = func.call @recursive_read(%dest, %depth) : (view<16xi8>, i32) -> (i8)
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  func.return %loaded : i8
}

