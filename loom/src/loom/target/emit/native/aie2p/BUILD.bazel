load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "elf_compiler_provider",
    srcs = ["elf_compiler_provider.c"],
    hdrs = ["elf_compiler_provider.h"],
    visibility = [
        "//loom/binding/c/target/amd/xdna:__pkg__",
        "//loom/src/loom/target/configured:__pkg__",
    ],
    deps = [
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/amd/xdna/aie2p:provider",
        "//loom/src/loom/target/arch/amd/xdna/aie2p:target_facts",
        "//loom/src/loom/target/arch/amd/xdna/aie2p/emit:artifact",
    ],
)

loom_cc_library(
    name = "check_provider",
    srcs = ["check_provider.c"],
    hdrs = ["check_provider.h"],
    visibility = ["//loom/src/loom/tools/loom-check:__pkg__"],
    deps = [
        "//loom/src/loom/target/arch/amd/xdna/aie2p/check:artifact",
        "//loom/src/loom/tools/loom-check:provider",
        "//runtime/src/iree/base",
    ],
)
