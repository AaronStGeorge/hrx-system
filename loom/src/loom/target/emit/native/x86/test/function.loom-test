// ====

// K spill/reload selects mask-register transport independently of the GPR
// conversions that produce and consume the mask.
// RUN: emit x86-native-bytes @k_storage
x86.target<avx512> @target

low.func.def target<x86.avx512.core>(@target) @k_storage(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %slot = storage {byte_alignment = 1, byte_length = 8} : low.storage<stack>
  %mask = avx512.kmovq.k.gpr64 %input
  low.spill %mask, %slot : reg<x86.k>, low.storage<stack>
  %restored = low.reload %slot : low.storage<stack> -> reg<x86.k>
  %word = avx512.kmovq.gpr64.k %restored
  mov.store.gpr64 %word, %output {disp32 = 0}
  return
}

