// ====

// Equal descriptor-branch successors collapse to their shared fallthrough
// without materializing the comparison or a conditional transfer.
// RUN: emit x86-native-bytes @same_descriptor_successor
x86.target<scalar> @target

low.func.def target<x86.scalar.core>(@target) @same_descriptor_successor(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) asm {
  low.op.cond_br<x86.scalar.cmp.branch.gpr32>(%lhs, %rhs) {predicate = 2}, ^exit, ^exit : (reg<x86.gpr32>, reg<x86.gpr32>)
^exit:
  return
}

