// ====

// Synchronous call transport keeps a stored argument out of the allocatable
// register set even when pure setup remains between its reload and the call.
// RUN: emit x86-frame @stored_call strategy=pressure x86.gpr64=1
x86.target<scalar> @target

low.func.decl pure target<x86.scalar.core>(@target) @consume_stored(%value: reg<x86.gpr64>, %setup: reg<x86.gpr32>)

low.func.def target<x86.scalar.core>(@target) @stored_call(%input: reg<x86.gpr64>) -> (reg<x86.gpr32>) asm {
  %slot = storage {byte_alignment = 8, byte_length = 8} : low.storage<stack>
  low.spill %input, %slot : reg<x86.gpr64>, low.storage<stack>
  %loaded = low.reload %slot : low.storage<stack> -> reg<x86.gpr64>
  %constant = mov.imm32 1
  low.func.call pure @consume_stored(%loaded, %constant) : (reg<x86.gpr64>, reg<x86.gpr32>)
  return %constant
}

// ----
callee-preserved: none
stack: 8 bytes, alignment 16

// ====

// Every SysV SIMD register is volatile. The profile-wide ZMM clobber range
// aliases this live YMM value, which needs a spill and reload across the call.
// RUN: emit x86-native-bytes @vector_call_clobbers
x86.target<avx512> @target

low.func.decl target<x86.avx512.core>(@target) @volatile_callee(%output: reg<x86.gpr64>) -> (reg<x86.gpr64>)

low.func.def target<x86.avx512.core>(@target) @vector_call_clobbers(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %vector = vmovdqu32.load.ymm %input {disp32 = 0}
  %returned_output = low.func.call @volatile_callee(%output) : (reg<x86.gpr64>) -> (reg<x86.gpr64>)
  vmovdqu32.store.ymm %vector, %returned_output {disp32 = 0}
  return
}

