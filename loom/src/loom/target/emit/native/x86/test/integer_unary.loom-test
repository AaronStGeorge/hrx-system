// RUN: emit x86-native-bytes @absolute_xmm
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @absolute_xmm(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %bytes = vpabsb.xmm %input
  %words = vpabsw.xmm %bytes
  %dwords = vpabsd.xmm %words
  return %dwords
}

