// RUN: emit x86-native-bytes @absolute_evex_xmm
x86.target<avx512> @target

low.func.def target<x86.avx512.core>(@target) @absolute_evex_xmm(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %bytes = avx512.vpabsb.xmm %input
  %words = avx512.vpabsw.xmm %bytes
  %dwords = avx512.vpabsd.xmm %words
  %qwords = avx512.vpabsq.xmm %dwords
  return %qwords
}

