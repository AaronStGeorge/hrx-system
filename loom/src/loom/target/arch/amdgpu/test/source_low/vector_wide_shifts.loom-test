// RUN: emit source-low target=amdgpu:gfx942 output=low

func.def @wide_counts(%value: vector<3xi64>, %count: vector<3xi64>) -> (vector<3xi64>, vector<3xi64>, vector<3xi64>) {
  %left = vector.shli %value, %count : vector<3xi64>
  %logical = vector.shrui %value, %count : vector<3xi64>
  %arithmetic = vector.shrsi %value, %count : vector<3xi64>
  func.return %left, %logical, %arithmetic : vector<3xi64>, vector<3xi64>, vector<3xi64>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @wide_counts(%value: reg<amdgpu.vgpr x6>, %count: reg<amdgpu.vgpr x6>) -> (reg<amdgpu.vgpr x6>, reg<amdgpu.vgpr x6>, reg<amdgpu.vgpr x6>) asm {
  %13 = slice %count[0] : reg<amdgpu.vgpr x6> -> reg<amdgpu.vgpr>
  %14 = slice %count[2] : reg<amdgpu.vgpr x6> -> reg<amdgpu.vgpr>
  %15 = slice %count[4] : reg<amdgpu.vgpr x6> -> reg<amdgpu.vgpr>
  %18 = slice %value[0] : reg<amdgpu.vgpr x6> -> reg<amdgpu.vgpr x2>
  %19 = v_lshlrev_b64 %13, %18
  %21 = slice %value[2] : reg<amdgpu.vgpr x6> -> reg<amdgpu.vgpr x2>
  %22 = v_lshlrev_b64 %14, %21
  %24 = slice %value[4] : reg<amdgpu.vgpr x6> -> reg<amdgpu.vgpr x2>
  %25 = v_lshlrev_b64 %15, %24
  %left = concat(%19, %22, %25) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x6>
  %33 = v_lshrrev_b64 %13, %18
  %36 = v_lshrrev_b64 %14, %21
  %39 = v_lshrrev_b64 %15, %24
  %logical = concat(%33, %36, %39) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x6>
  %47 = v_ashrrev_i64 %13, %18
  %50 = v_ashrrev_i64 %14, %21
  %53 = v_ashrrev_i64 %15, %24
  %arithmetic = concat(%47, %50, %53) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x6>
  return %left, %logical, %arithmetic
}

// ====

func.def @extended_counts(%value: vector<2xi64>, %count: vector<2xi32>) -> (vector<2xi64>) {
  %extended = vector.extui %count : vector<2xi32> to vector<2xi64>
  %result = vector.shli %value, %extended : vector<2xi64>
  func.return %result : vector<2xi64>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @extended_counts(%value: reg<amdgpu.vgpr x4>, %count: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x4>) asm {
  %9 = slice %count[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %10 = slice %count[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %16 = slice %value[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %17 = v_lshlrev_b64 %9, %16
  %19 = slice %value[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %20 = v_lshlrev_b64 %10, %19
  %result = concat(%17, %20) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  return %result
}
