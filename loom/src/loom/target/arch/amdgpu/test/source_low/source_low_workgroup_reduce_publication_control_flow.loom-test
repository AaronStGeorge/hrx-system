// RUN: pass scf-to-cfg,cfg-simplify,source-to-low,low-dce

amdgpu.target<gfx11-generic> @target

// Every path to the result use crosses the workitem-zero edge. Arbitrary
// diamonds and cycles after that edge preserve leader-only publication.
kernel.def target(@target) @workgroup_reduce_leader_cfg_cycle() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %flags: buffer) {
  %tid = kernel.workitem.id<x> : index
  %start = index.constant 0 : offset
  %leader_index = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %loop_end = index.constant 4 : index
  %c0 = scalar.constant 0 : i32
  %input_view = buffer.view %input[%start] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%start] : buffer -> view<1xf32>
  %flags_view = buffer.view %flags[%start] : buffer -> view<1xi32>
  %value = view.load %input_view[%tid] : view<64xf32> -> f32
  %sum = kernel.workgroup.reduce<addf> %value : f32
  %flag = view.load %flags_view[%leader_index] : view<1xi32> -> i32
  %condition = scalar.cmpi ne, %flag, %c0 : i32
  %is_leader = index.cmp eq, %tid, %leader_index : index
  scf.if %is_leader {
    scf.for %iteration = [%leader_index to %loop_end step %loop_step] {
      scf.if %condition {
        view.store %sum, %output_view[%leader_index] : f32, view<1xf32>
      } else {
        view.store %sum, %output_view[%leader_index] : f32, view<1xf32>
      }
    }
  }
  kernel.return
}

// ----
amdgpu.target<gfx11-generic> @target

low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @workgroup_reduce_leader_cfg_cycle() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %flags_view = resource<hal_binding> {extent = 4, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %leader_index = s_mov_b32 0
  %loop_step = s_mov_b32 1
  %31 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_b32_saddr %31, %input_view
  %33 = v_and_b32_src0_inline %tid, 31
  %34 = storage {byte_alignment = 4, byte_length = 8} : low.storage<workgroup>
  %35 = storage_address %34 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %36 = v_add_f32_dpp16 %value, %value {dpp_ctrl = 177}
  %37 = v_add_f32_dpp16 %36, %36 {dpp_ctrl = 78}
  %38 = v_add_f32_dpp16 %37, %37 {dpp_ctrl = 321}
  %39 = v_add_f32_dpp16 %38, %38 {dpp_ctrl = 320}
  %40 = v_permlanex16_b32_src12_inline %39, 0, 0
  %41 = v_add_f32 %39, %40
  %42 = v_lshrrev_b32_src0_inline %tid, 5
  %43 = v_lshlrev_b32_src0_inline %42, 2
  %44 = v_mov_b32 1
  %45 = v_cmp_lt_u32 %33, %44
  %46, %47 = s_and_saveexec_b64 %45
  %48 = v_add_u32 %35, %43
  ds_write_b32 %48, %41
  s_mov_b64_exec %46
  s_barrier
  %49 = v_mov_b32 2
  %50 = v_cmp_lt_u32 %tid, %49
  %51, %52 = s_and_saveexec_b64 %50
  %53 = v_lshlrev_b32_src0_inline %33, 2
  %54 = v_add_u32 %35, %53
  %55 = ds_read_b32 %54
  %sum = v_add_f32_dpp16 %55, %55 {dpp_ctrl = 177}
  s_mov_b64_exec %51
  s_barrier
  %57 = v_mov_b32 0
  %flag = global_load_b32_saddr %57, %flags_view
  %condition = v_cmp_ne_i32_src1_inline %flag {rhs = 0}
  %is_leader = v_cmp_eq_i32_src1_inline %tid {rhs = 0}
  %61, %62 = s_and_saveexec_b64 %is_leader
  low.cond_br %62, ^_bb1, ^_bb7 : reg<amdgpu.scc>
^_bb1:
  %63 = v_mov_b32_copy %leader_index
  low.br ^_bb2(%63: reg<amdgpu.vgpr>)
^_bb2(%iteration: reg<amdgpu.vgpr>):
  %64 = v_cmp_lt_i32_src1_inline %iteration {rhs = 4}
  %65 = s_mov_b64_exec_read
  %66, %67 = s_and_b64_scc %64, %65
  low.cond_br %67, ^_bb3, ^_bb7 : reg<amdgpu.scc>
^_bb3:
  %68 = s_mov_b64_exec_read
  %69, %70 = s_and_b64_scc %condition, %68
  low.cond_br %70, ^_bb4, ^_bb5 : reg<amdgpu.scc>
^_bb4:
  %71 = v_mov_b32 0
  global_store_b32_saddr %71, %sum, %output_view
  low.br ^_bb6
^_bb5:
  %72 = v_mov_b32 0
  global_store_b32_saddr %72, %sum, %output_view
  low.br ^_bb6
^_bb6:
  %73 = v_add_u32 %loop_step, %iteration
  low.br ^_bb2(%73: reg<amdgpu.vgpr>)
^_bb7:
  s_mov_b64_exec %61
  low.br ^_bb8
^_bb8:
  return
}

// ====

amdgpu.target<gfx11-generic> @target

// The bypass reaches the result use without crossing the workitem-zero edge,
// so the reduction must publish its result for all workitems.
kernel.def target(@target) @workgroup_reduce_cfg_unguarded_bypass() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %flags: buffer) {
  %tid = kernel.workitem.id<x> : index
  %start = index.constant 0 : offset
  %leader_index = index.constant 0 : index
  %c0 = scalar.constant 0 : i32
  %input_view = buffer.view %input[%start] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%start] : buffer -> view<1xf32>
  %flags_view = buffer.view %flags[%start] : buffer -> view<1xi32>
  %value = view.load %input_view[%tid] : view<64xf32> -> f32
  %sum = kernel.workgroup.reduce<addf> %value : f32
  %flag = view.load %flags_view[%leader_index] : view<1xi32> -> i32
  %condition = scalar.cmpi ne, %flag, %c0 : i32
  %is_leader = index.cmp eq, %tid, %leader_index : index
  scf.if %condition {
    scf.if %is_leader {
      view.store %sum, %output_view[%leader_index] : f32, view<1xf32>
    }
  } else {
    view.store %sum, %output_view[%leader_index] : f32, view<1xf32>
  }
  kernel.return
}

// ----
amdgpu.target<gfx11-generic> @target

low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @workgroup_reduce_cfg_unguarded_bypass() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %flags_view = resource<hal_binding> {extent = 4, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %21 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_b32_saddr %21, %input_view
  %23 = v_and_b32_src0_inline %tid, 31
  %24 = storage {byte_alignment = 4, byte_length = 8} : low.storage<workgroup>
  %25 = storage_address %24 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %26 = v_add_f32_dpp16 %value, %value {dpp_ctrl = 177}
  %27 = v_add_f32_dpp16 %26, %26 {dpp_ctrl = 78}
  %28 = v_add_f32_dpp16 %27, %27 {dpp_ctrl = 321}
  %29 = v_add_f32_dpp16 %28, %28 {dpp_ctrl = 320}
  %30 = v_permlanex16_b32_src12_inline %29, 0, 0
  %31 = v_add_f32 %29, %30
  %32 = v_lshrrev_b32_src0_inline %tid, 5
  %33 = v_lshlrev_b32_src0_inline %32, 2
  %34 = v_mov_b32 1
  %35 = v_cmp_lt_u32 %23, %34
  %36, %37 = s_and_saveexec_b64 %35
  %38 = v_add_u32 %25, %33
  ds_write_b32 %38, %31
  s_mov_b64_exec %36
  s_barrier
  %39 = v_mov_b32 2
  %40 = v_cmp_lt_u32 %23, %39
  %41, %42 = s_and_saveexec_b64 %40
  %43 = v_lshlrev_b32_src0_inline %23, 2
  %44 = v_add_u32 %25, %43
  %45 = ds_read_b32 %44
  %46 = v_add_f32_dpp16 %45, %45 {dpp_ctrl = 177}
  s_mov_b64_exec %41
  %47 = v_mov_b32 0
  %sum = ds_bpermute_b32 %47, %46
  s_barrier
  %49 = v_mov_b32 0
  %flag = global_load_b32_saddr %49, %flags_view
  %condition = v_cmp_ne_i32_src1_inline %flag {rhs = 0}
  %is_leader = v_cmp_eq_i32_src1_inline %tid {rhs = 0}
  %53 = s_mov_b64_exec_read
  %54, %55 = s_and_b64_scc %condition, %53
  low.cond_br %55, ^_bb1, ^_bb3 : reg<amdgpu.scc>
^_bb1:
  %56, %57 = s_and_saveexec_b64 %is_leader
  low.cond_br %57, ^_bb2, ^_bb4 : reg<amdgpu.scc>
^_bb2:
  %58 = v_mov_b32 0
  global_store_b32_saddr %58, %sum, %output_view
  low.br ^_bb4
^_bb3:
  %59 = v_mov_b32 0
  global_store_b32_saddr %59, %sum, %output_view
  low.br ^_bb5
^_bb4:
  s_mov_b64_exec %56
  low.br ^_bb5
^_bb5:
  return
}
