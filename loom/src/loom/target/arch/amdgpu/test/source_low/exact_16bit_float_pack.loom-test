// RUN: emit source-low output=low

amdgpu.target<gfx1100> @target

func.def target(@target) @exact_i8_to_bf16(%input: vector<3xi8>) -> (vector<3xbf16>) {
  %wide = vector.sitofp %input : vector<3xi8> to vector<3xf32>
  %narrow = vector.fptrunc %wide : vector<3xf32> to vector<3xbf16>
  func.return %narrow : vector<3xbf16>
}

// ----
low.func.def target<amdgpu.rdna3.core>(@target) abi(hal_kernel) @exact_i8_to_bf16(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %9 = v_bfe_i32_offset_width_inline %input {offset = 0, width = 8}
  %10 = v_cvt_f32_i32 %9
  %11 = v_bfe_i32_offset_width_inline %input {offset = 8, width = 8}
  %12 = v_cvt_f32_i32 %11
  %13 = v_bfe_i32_offset_width_inline %input {offset = 16, width = 8}
  %14 = v_cvt_f32_i32 %13
  %18 = v_perm_b32_src2_lit %10, %12, 50464518
  %20 = v_lshrrev_b32_src0_inline %14, 16
  %narrow = concat(%18, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %narrow
}

