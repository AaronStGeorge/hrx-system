// ----
low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @exact_i8_to_bf16_without_literal_permute(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %9 = v_mov_b32_sdwa %input {dst_sel = 6, dst_unused = 0, src0_sel = 0, src0_sext = 1}
  %10 = v_cvt_f32_i32 %9
  %11 = v_mov_b32_sdwa %input {dst_sel = 6, dst_unused = 0, src0_sel = 1, src0_sext = 1}
  %12 = v_cvt_f32_i32 %11
  %13 = v_mov_b32_sdwa %input {dst_sel = 6, dst_unused = 0, src0_sel = 2, src0_sext = 1}
  %14 = v_cvt_f32_i32 %13
  %18 = v_lshrrev_b32_src0_inline %10, 16
  %19 = v_and_b32_lit %12, 4294901760
  %20 = v_or_b32 %18, %19
  %22 = v_lshrrev_b32_src0_inline %14, 16
  %narrow = concat(%20, %22) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %narrow
}

