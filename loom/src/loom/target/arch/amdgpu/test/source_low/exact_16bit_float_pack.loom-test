  %10 = v_cvt_f32_i32 %9
  %11 = v_ashrrev_i32_src0_inline %input, 16
  %12 = v_cvt_f32_i32 %11
  %16 = v_lshrrev_b32_src0_inline %10, 16
  %17 = v_and_b32_src0_inline %16, 1
  %18 = v_add3_u32_src2_lit %10, %17, 32767
  %19 = v_lshrrev_b32_src0_inline %18, 16
  %20 = v_lshrrev_b32_src0_inline %12, 16
  %21 = v_and_b32_src0_inline %20, 1
  %22 = v_add3_u32_src2_lit %12, %21, 32767
  %23 = v_lshrrev_b32_src0_inline %22, 16
  %narrow = v_cvt_pk_u16_u32 %19, %23
  return %narrow
}

