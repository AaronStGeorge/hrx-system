low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "row_count_input"}, direct_arg_offsets = [8], direct_arg_parameter_indices = [1], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(16, 2, 1) workgroup_count(1, 1, 1) @workgroup_complete_offset(%row_count: reg<amdgpu.sgpr>) asm {
  %packed_tid = live_in<amdgpu.workitem_id.packed.xy> : reg<amdgpu.vgpr>
  %destination = resource<hal_binding> {extent = 128, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %37 = storage {byte_alignment = 16, byte_length = 2048} : low.storage<workgroup>
  %x = v_and_b32_lit %packed_tid, 1023
  %39 = v_lshrrev_b32_src0_inline %packed_tid, 10
  %y = v_and_b32_lit %39, 1023
  %41 = v_lshl_add_u32_shift_imm %y, %x, 4
  %42 = v_lshlrev_b32_src0_inline %41, 2
  %begin = s_mov_b32 0
  %end = s_mov_b32 8
  %step = s_mov_b32 1
  %47 = v_mov_b32 0
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %47: reg<amdgpu.vgpr>, %42: reg<amdgpu.vgpr>)
^_bb1(%row: reg<amdgpu.sgpr>, %total: reg<amdgpu.vgpr>, %34: reg<amdgpu.vgpr>):
  %48 = s_cmp_lt_i32 %row, %end
  low.cond_br %48, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  ds_write_b32<volatile> %34, %total
  %value = ds_read_b32<volatile> %34
  %50 = v_add_u32_lit %34, 128
  %next = v_add_u32 %total, %value
  %52 = s_add_u32 %row, %step
  low.br ^_bb1(%52: reg<amdgpu.sgpr>, %next: reg<amdgpu.vgpr>, %50: reg<amdgpu.vgpr>)
^_bb3:
  global_store_b32_saddr %42, %total, %destination
  return
}

// ====
// RUN: emit source-low target=amdgpu:gfx1151 output=low

// Private scratch consumes the same carried byte offset through its VADDR
// packet form; no resource operand is retained for the realized address.
kernel.def @private_complete_offset() {
  %unit = index.constant 1 : index
  %lane_count = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lane_count, %unit, %unit) : index
} launch(%output: buffer, %row_count_input: index) {
  %lane = kernel.workitem.id<x> : index
  %row_count = index.assume %row_count_input [range(%row_count_input, 8, 16)] : index
  %base = index.constant 0 : offset
  %byte_count = index.constant 2048 : offset
  %scratch = buffer.alloca<private> align(16) %byte_count : buffer
  %rows = buffer.view %scratch[%base] : buffer -> view<[%row_count]x32xi32>
  %destination = buffer.view %output[%base] : buffer -> view<32xi32>
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %initial = scalar.constant 0 : i32
  %sum = scf.for %row = [%begin to %end step %step](%total = %initial : i32) -> (i32) {
    view.store<volatile> %total, %rows[%row, %lane] : i32, view<[%row_count]x32xi32>
    %value = view.load<volatile> %rows[%row, %lane] : view<[%row_count]x32xi32> -> i32
    %next = scalar.addi %total, %value : i32
    scf.yield %next : i32
  }
  view.store %sum, %destination[%lane] : i32, view<32xi32>
  kernel.return
}

