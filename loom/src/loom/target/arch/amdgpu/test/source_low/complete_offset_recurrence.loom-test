  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %destination = resource<hal_binding> {extent = 128, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %32 = storage {byte_alignment = 16, byte_length = 2048} : low.storage<private>
  %33 = v_lshlrev_b32_src0_inline %lane, 2
  %begin = s_mov_b32 0
  %end = s_mov_b32 8
  %step = s_mov_b32 1
  %38 = v_mov_b32 0
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %38: reg<amdgpu.vgpr>, %33: reg<amdgpu.vgpr>)
^_bb1(%row: reg<amdgpu.sgpr>, %total: reg<amdgpu.vgpr>, %29: reg<amdgpu.vgpr>):
  %39 = s_cmp_lt_i32 %row, %end
  low.cond_br %39, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  scratch_store_b32_vaddr<volatile> %29, %total
  %value = scratch_load_b32_vaddr<volatile> %29
  %41 = v_add_u32_lit %29, 128
  %next = v_add_u32 %total, %value
  %43 = s_add_u32 %row, %step
  low.br ^_bb1(%43: reg<amdgpu.sgpr>, %next: reg<amdgpu.vgpr>, %41: reg<amdgpu.vgpr>)
^_bb3:
