low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "row_count_input"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @cdna_complete_offset(%row_count: reg<amdgpu.sgpr>) asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %32 = v_lshlrev_b32_src0_inline %lane, 2
  %begin = s_mov_b32 0
  %end = s_mov_b32 8
  %step = s_mov_b32 1
  %37 = v_mov_b32 0
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %37: reg<amdgpu.vgpr>, %32: reg<amdgpu.vgpr>)
^_bb1(%row: reg<amdgpu.sgpr>, %total: reg<amdgpu.vgpr>, %28: reg<amdgpu.vgpr>):
  %38 = s_cmp_lt_i32 %row, %end
  low.cond_br %38, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %value = global_load_dword_saddr<volatile> %28, %source : reg<amdgpu.vgpr>
  %40 = v_add_u32_lit %28, 256
  %next = v_add_u32 %total, %value
  %42 = s_add_u32 %row, %step
  low.br ^_bb1(%42: reg<amdgpu.sgpr>, %next: reg<amdgpu.vgpr>, %40: reg<amdgpu.vgpr>)
^_bb3:
  global_store_dword_saddr %32, %total, %destination
  return
}

// ====
// RUN: emit source-low target=amdgpu:gfx1151 output=low

// The same carried VADDR serves both sides of a workgroup-memory round trip.
// A two-dimensional workgroup keeps the address out of the DS add-thread-id
// form without interposing an authored address producer.
kernel.def @workgroup_complete_offset() {
  %unit = index.constant 1 : index
  %x_count = index.constant 16 : index
  %y_count = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x_count, %y_count, %unit) : index
} launch(%output: buffer, %row_count_input: index) {
  %x = kernel.workitem.id<x> : index
  %y = kernel.workitem.id<y> : index
  %row_count = index.assume %row_count_input [range(%row_count_input, 8, 16)] : index
  %base = index.constant 0 : offset
  %byte_count = index.constant 2048 : offset
  %scratch = buffer.alloca<workgroup> align(16) %byte_count : buffer
  %rows = buffer.view %scratch[%base] : buffer -> view<[%row_count]x2x16xi32>
  %destination = buffer.view %output[%base] : buffer -> view<2x16xi32>
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %initial = scalar.constant 0 : i32
  %sum = scf.for %row = [%begin to %end step %step](%total = %initial : i32) -> (i32) {
    view.store<volatile> %total, %rows[%row, %y, %x] : i32, view<[%row_count]x2x16xi32>
    %value = view.load<volatile> %rows[%row, %y, %x] : view<[%row_count]x2x16xi32> -> i32
    %next = scalar.addi %total, %value : i32
    scf.yield %next : i32
  }
  view.store %sum, %destination[%y, %x] : i32, view<2x16xi32>
  kernel.return
}

