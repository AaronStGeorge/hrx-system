// RUN: emit source-low target=amdgpu:gfx1151 output=low

// Scalar-memory packets share their dynamic SOFFSET expression.
func.def @scalar_memory_load(%input: buffer, %row: index) {
  %bounded_row = index.assume %row [range(%row, 0, 1023)] : index
  %row_bytes = index.constant 131072 : offset
  %row_offset = index.scale %bounded_row, %row_bytes : index, offset -> offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %constant_input = buffer.assume.memory_space<constant> %aligned : buffer
  %source = buffer.view %constant_input[%row_offset] : buffer -> view<16xi32>
  %value = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @scalar_memory_load(%bounded_row: reg<amdgpu.sgpr>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = s_lshl_b32_rhs_inline %bounded_row, 17
  %14 = s_load_dwordx4<volatile> %source, %13
  %24 = s_load_dwordx4<volatile> %source, %13 {offset = 16}
  %34 = s_load_dwordx4<volatile> %source, %13 {offset = 32}
  %44 = s_load_dwordx4<volatile> %source, %13 {offset = 48}
  return
}

// ====

// Dynamic descriptor packets share their descriptor, VADDR, and SOFFSET.
func.def @descriptor_dynamic_load(%input: buffer, %row: index) {
  %bounded_row = index.assume %row [range(%row, 0, 1023)] : index
  %row_bytes = index.constant 131072 : offset
  %row_offset = index.scale %bounded_row, %row_bytes : index, offset -> offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %descriptor_input = buffer.assume.memory_space<descriptor> %aligned : buffer
  %source = buffer.view %descriptor_input[%row_offset] : buffer -> view<16xi32>
  %value = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @descriptor_dynamic_load(%bounded_row: reg<amdgpu.sgpr>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %row_bytes = s_mov_b32 131072
  %row_offset = s_mul_i32 %bounded_row, %row_bytes
  %13 = v_mov_b32 0
  %14 = s_lshl_b32_rhs_inline %bounded_row, 17
  %15 = s_mov_b32 64
  %16 = s_add_u32 %row_offset, %15
  %23 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = s_mov_b32 65535
  %26 = s_and_b32 %24, %25
  %27 = concat(%23, %26) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %28 = s_mov_b32 822173696
  %29 = concat(%27, %16, %28) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %18 = buffer_load_b128<volatile> %29, %13, %14
  %19 = buffer_load_b128<volatile> %29, %13, %14 {offset = 16}
  %20 = buffer_load_b128<volatile> %29, %13, %14 {offset = 32}
  %21 = buffer_load_b128<volatile> %29, %13, %14 {offset = 48}
  return
}

// ====

// Descriptor stores use the same shared address path as loads.
func.def @descriptor_dynamic_store(%output: buffer, %row: index) {
  %bounded_row = index.assume %row [range(%row, 0, 1023)] : index
  %row_bytes = index.constant 131072 : offset
  %row_offset = index.scale %bounded_row, %row_bytes : index, offset -> offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %descriptor_output = buffer.assume.memory_space<descriptor> %aligned : buffer
  %destination = buffer.view %descriptor_output[%row_offset] : buffer -> view<16xi32>
  %value = vector.constant 1 : vector<16xi32>
  vector.store<volatile> %value, %destination[0] : vector<16xi32>, view<16xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @descriptor_dynamic_store(%bounded_row: reg<amdgpu.sgpr>) asm {
  %destination = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %row_bytes = s_mov_b32 131072
  %row_offset = s_mul_i32 %bounded_row, %row_bytes
  %13 = v_mov_b32 1
  %value = concat(%13, %13, %13, %13, %13, %13, %13, %13, %13, %13, %13, %13, %13, %13, %13, %13) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x16>
  %30 = slice %value[0] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  %31 = v_mov_b32 0
  %32 = s_lshl_b32_rhs_inline %bounded_row, 17
  %33 = s_mov_b32 64
  %34 = s_add_u32 %row_offset, %33
  %39 = slice %destination[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %40 = slice %destination[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %41 = s_mov_b32 65535
  %42 = s_and_b32 %40, %41
  %43 = concat(%39, %42) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %44 = s_mov_b32 822173696
  %45 = concat(%43, %34, %44) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  buffer_store_b128<volatile> %30, %45, %31, %32
  %36 = slice %value[4] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  buffer_store_b128<volatile> %36, %45, %31, %32 {offset = 16}
  %37 = slice %value[8] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  buffer_store_b128<volatile> %37, %45, %31, %32 {offset = 32}
  %38 = slice %value[12] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  buffer_store_b128<volatile> %38, %45, %31, %32 {offset = 48}
  return
}
