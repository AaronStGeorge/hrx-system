// ----
low.func.def target<amdgpu.rdna3.core> abi(hal_kernel) @vector_double(%input: reg<amdgpu.vgpr x4>, %power: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x4>) asm {
  %13 = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %14 = v_frexp_mant_f64 %13
  %15 = slice %input[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %16 = v_frexp_mant_f64 %15
  %fraction = concat(%14, %16) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %19 = v_frexp_exp_i32_f64 %13
  %21 = v_frexp_exp_i32_f64 %15
  %exponent = concat(%19, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %24 = slice %power[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %25 = v_ldexp_f64 %13, %24
  %27 = slice %power[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %28 = v_ldexp_f64 %15, %27
  %scaled = concat(%25, %28) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  return %fraction, %exponent, %scaled
}

