// RUN: emit source-low target=amdgpu:gfx1100 output=low
func.def @packed_half_tail(%input: vector<3xf16>, %power: vector<3xi32>) -> (vector<3xf16>, vector<3xi32>, vector<3xf16>) {
  %fraction, %exponent = vector.frexpf %input : vector<3xf16>, vector<3xi32>
  %scaled = vector.ldexpf %input, %power : vector<3xf16>, vector<3xi32>
  func.return %fraction, %exponent, %scaled : vector<3xf16>, vector<3xi32>, vector<3xf16>
}

// ----
low.func.def target<amdgpu.rdna3.core> abi(hal_kernel) @packed_half_tail(%input: reg<amdgpu.vgpr x2>, %power: reg<amdgpu.vgpr x3>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x3>, reg<amdgpu.vgpr x2>) asm {
  %20 = slice %input[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %21 = v_cvt_f32_f16 %20
  %23 = v_cvt_f32_f16_input_high %20
  %24 = slice %input[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %25 = v_cvt_f32_f16 %24
  %28 = v_frexp_mant_f32 %21
  %30 = v_frexp_mant_f32 %23
  %32 = v_frexp_mant_f32 %25
  %35 = v_frexp_exp_i32_f32 %21
  %37 = v_frexp_exp_i32_f32 %23
  %39 = v_frexp_exp_i32_f32 %25
  %exponent = concat(%35, %37, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %42 = v_cvt_f16_f32 %28
  %43 = v_bfe_u32_offset_0_width_inline_low16 %42
  %45 = v_cvt_f16_f32 %30
  %46 = v_bfe_u32_offset_0_width_inline_low16 %45
  %47 = v_lshl_add_u32_shift_imm %46, %43, 16
  %49 = v_cvt_f16_f32 %32
  %50 = v_bfe_u32_offset_0_width_inline_low16 %49
  %fraction = concat(%47, %50) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %53 = slice %power[0] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %54 = v_ldexp_f32 %21, %53
  %56 = slice %power[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %57 = v_ldexp_f32 %23, %56
  %59 = slice %power[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %60 = v_ldexp_f32 %25, %59
  %63 = v_cvt_f16_f32 %54
  %64 = v_bfe_u32_offset_0_width_inline_low16 %63
  %66 = v_cvt_f16_f32 %57
  %67 = v_bfe_u32_offset_0_width_inline_low16 %66
  %68 = v_lshl_add_u32_shift_imm %67, %64, 16
  %70 = v_cvt_f16_f32 %60
  %71 = v_bfe_u32_offset_0_width_inline_low16 %70
  %scaled = concat(%68, %71) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %fraction, %exponent, %scaled
}

// ====
// RUN: emit source-low target=amdgpu:gfx90a output=low
// Both uniform operands still obey the one-scalar-source packet limit.
func.def @scale_uniform(%bits: i64, %power: i32) -> (f64) {
  %input = scalar.bitcast %bits : i64 to f64
  %scaled = scalar.ldexpf %input, %power : f64, i32
  func.return %scaled : f64
}

// ----
low.func.def target<amdgpu.cdna2.core> abi(hal_kernel) @scale_uniform(%input: reg<amdgpu.sgpr x2>, %power: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %8 = v_mov_b32_copy %power
  %scaled = v_ldexp_f64 %input, %8
  return %scaled
}
