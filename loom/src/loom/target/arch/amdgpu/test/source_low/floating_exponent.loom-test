  %fraction, %exponent = vector.frexpf %input : vector<2xf32>, vector<2xi32>
  %scaled = vector.ldexpf %input, %power : vector<2xf32>, vector<2xi32>
  func.return %fraction, %exponent, %scaled : vector<2xf32>, vector<2xi32>, vector<2xf32>
}

// ----
low.func.def target<amdgpu.rdna3.core> abi(hal_kernel) @vector_single(%input: reg<amdgpu.vgpr x2>, %power: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %13 = slice %input[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = v_frexp_mant_f32 %13
  %15 = slice %input[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %16 = v_frexp_mant_f32 %15
  %fraction = concat(%14, %16) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %19 = v_frexp_exp_i32_f32 %13
  %21 = v_frexp_exp_i32_f32 %15
  %exponent = concat(%19, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %24 = slice %power[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %25 = v_ldexp_f32 %13, %24
  %27 = slice %power[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %28 = v_ldexp_f32 %15, %27
  %scaled = concat(%25, %28) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %fraction, %exponent, %scaled
}

