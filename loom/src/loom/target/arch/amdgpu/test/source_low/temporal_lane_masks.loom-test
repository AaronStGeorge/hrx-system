// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target {subgroup_size = 32}

kernel.def target(@target) @loop_masks_i32() {
  %unit = index.constant 1 : index
  %size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%output: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %lane = kernel.subgroup.lane.id : index
  %parity = index.andi %lane, %step : index
  %even = index.cmp eq, %parity, %begin : index
  %width = index.constant 32 : index
  %ballot_position = index.add %lane, %width : index
  %view = buffer.view %output[%base] : buffer -> view<64xi32>
  cfg.br ^header(%begin: index)
^header(%counter: index):
  %active = kernel.subgroup.active.mask : i32
  %ballot = kernel.subgroup.vote.ballot %even : i1 -> i32
  %more = index.cmp ult, %counter, %lane : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %next = index.add %counter, %step : index
  cfg.br ^header(%next: index)
^exit:
  view.store %active, %view[%lane] : i32, view<64xi32>
  view.store %ballot, %view[%ballot_position] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @loop_masks_i32() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %parity = v_and_b32 %step, %lane
  %even = v_cmp_eq_i32_src1_inline %parity {rhs = 0}
  %25 = v_mov_b32_copy %begin
  %34 = s_mov_b64_exec_read
  low.br ^header(%25: reg<amdgpu.vgpr>)
^header(%counter: reg<amdgpu.vgpr>):
  %26 = s_mov_b64_exec_read
  %27 = slice %26[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %active = v_mov_b32_copy %27
  %30 = s_and_b64 %even, %26
  %31 = slice %30[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %ballot = v_mov_b32_copy %31
  %more = v_cmp_lt_u32 %counter, %lane
  %35, %36 = s_and_saveexec_b64 %more
  low.cond_br %36, ^body, ^_bb3 : reg<amdgpu.scc>
^body:
  %next = v_add_u32 %step, %counter
  low.br ^header(%next: reg<amdgpu.vgpr>)
^_bb3:
  s_mov_b64_exec %34
  %38 = v_lshlrev_b32_src0_inline %lane, 2
  global_store_b32_saddr %38, %active, %view
  global_store_b32_saddr %38, %ballot, %view {offset = 128}
  return
}

