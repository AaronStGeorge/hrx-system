low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @loop_masks_i64_wave32() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %view = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %parity = v_and_b32 %step, %lane
  %even = v_cmp_eq_i32_src1_inline %parity {rhs = 0}
  %25 = v_mov_b32_copy %begin
  %40 = s_mov_b64_exec_read
  low.br ^header(%25: reg<amdgpu.vgpr>)
^header(%counter: reg<amdgpu.vgpr>):
  %26 = s_mov_b64_exec_read
  %27 = slice %26[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %28 = v_mov_b32_copy %27
  %active = concat(%28, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %33 = s_and_b64 %even, %26
  %34 = slice %33[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %35 = v_mov_b32_copy %34
  %ballot = concat(%35, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %more = v_cmp_lt_u32 %counter, %lane
  %41, %42 = s_and_saveexec_b64 %more
  low.cond_br %42, ^body, ^_bb3 : reg<amdgpu.scc>
^body:
  %next = v_add_u32 %step, %counter
  low.br ^header(%next: reg<amdgpu.vgpr>)
^_bb3:
  s_mov_b64_exec %40
  %44 = v_lshlrev_b32_src0_inline %lane, 3
  global_store_b64_saddr %44, %active, %view
  global_store_b64_saddr %44, %ballot, %view {offset = 256}
  return
}

