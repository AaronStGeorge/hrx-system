  %159 = v_mov_b32_copy %141
  %local_y = concat(%159, %148) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %162 = v_mov_b32_copy %144
  %local_z = concat(%162, %148) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %165 = v_mov_b32_copy %146
  %local_flat = concat(%165, %148) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %168 = s_load_dword_offset_only %135 {offset = 12}
