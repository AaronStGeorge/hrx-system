  %213 = s_lshl_b32_rhs_inline %212, 1
  %214 = v_mov_b32_copy %208
  %count_x = concat(%214, %187) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
