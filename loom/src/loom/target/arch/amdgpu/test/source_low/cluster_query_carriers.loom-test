  %173 = s_lshr_b32_rhs_inline %170, 16
  %174 = s_lshl_b32_rhs_inline %173, 1
  %175 = v_mov_b32_copy %169
  %count_x = concat(%175, %148) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %178 = v_mov_b32_copy %172
  %count_y = concat(%178, %148) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %181 = v_mov_b32_copy %174
