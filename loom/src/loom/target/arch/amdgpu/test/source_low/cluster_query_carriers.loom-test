  %150 = v_mov_b32_copy %140
  %cluster_y = concat(%150, %148) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %153 = v_mov_b32_copy %143
