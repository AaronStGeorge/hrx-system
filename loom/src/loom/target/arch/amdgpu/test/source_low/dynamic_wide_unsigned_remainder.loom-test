  %82 = v_lshlrev_b32_src0_inline %80, 8
  %83 = v_add_u32 %82, %81
  %84 = v_mul_hi_u32 %83, %67
  %85 = v_mul_lo_u32 %84, %149
  %86 = v_sub_u32 %83, %85
  %88, %89 = v_sub_co_u32 %86, %149
  %91 = v_cndmask_b32 %88, %86, %89
  %93, %94 = v_sub_co_u32 %91, %149
  %96 = v_cndmask_b32 %93, %91, %94
  %97 = v_lshrrev_b32_src0_inline %151, 16
  %98 = v_and_b32_lit %97, 255
  %99 = v_lshlrev_b32_src0_inline %96, 8
