  %122, %123 = v_sub_co_u32 %120, %149
  %125 = v_cndmask_b32 %122, %120, %123
  %127, %128 = v_sub_co_u32 %125, %149
  %130 = v_cndmask_b32 %127, %125, %128
  %131 = v_and_b32_lit %151, 255
  %132 = v_lshlrev_b32_src0_inline %130, 8
