// ====

// RUN: emit source-low @wide_index target=amdgpu:gfx11-generic output=low

// Wide index coordinates may still use runtime extents whose remainders fit
// the target's signed 32-bit index carrier.
func.def @wide_index(%dividend0: index, %divisor0: index) -> (index) where [range(%dividend0, 4294967296, 8589934591), range(%divisor0, 1, 2147483648)] {
  %dividend = index.assume %dividend0 [range(%dividend0, 4294967296, 8589934591)] : index
  %divisor = index.assume %divisor0 [range(%divisor0, 1, 2147483648)] : index
  %remainder = index.rem %dividend, %divisor : index
  func.return %remainder : index
}

