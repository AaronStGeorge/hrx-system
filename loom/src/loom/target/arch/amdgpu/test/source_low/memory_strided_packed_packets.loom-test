// RUN: emit source-low target=amdgpu:gfx1151 output=low

kernel.def @strided_i8_1() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %constant_input = buffer.assume.memory_space<constant> %aligned : buffer
  %layout = encoding.layout.strided [4] : encoding<layout>
  %view = buffer.view %constant_input[%base] : buffer -> view<4xi8, %layout>
  %value = vector.load %view[0] : view<4xi8, %layout> -> vector<4xi8>
  %result = buffer.view %output[%base] : buffer -> view<4xi8>
  vector.store %value, %result[0] : vector<4xi8>, view<4xi8>
  kernel.return
}

