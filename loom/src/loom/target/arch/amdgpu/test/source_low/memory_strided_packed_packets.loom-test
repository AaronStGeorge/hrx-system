  %result = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %12 = v_mov_b32 0
  %13 = global_load_u8_saddr %12, %view
  %14 = global_load_u8_saddr %12, %view {offset = 4}
  %15 = v_lshlrev_b32_src0_inline %14, 8
  %16 = v_or_b32 %13, %15
  %17 = global_load_u8_saddr %12, %view {offset = 8}
  %18 = v_lshlrev_b32_src0_inline %17, 16
  %19 = v_or_b32 %16, %18
  %20 = global_load_u8_saddr %12, %view {offset = 12}
  %21 = v_lshlrev_b32_src0_inline %20, 24
