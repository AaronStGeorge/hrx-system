// RUN: emit source-low output=none

amdgpu.target<gfx1151> @target

// A loop-local reference used by both a nested guard and its surviving body is
// rematerialized after the guard. The two lane-varying exits share a forwarding
// path to the loop latch and must become one representable masked region.
func.def target(@target) @nested_divergent_loop_exits(%conditions: vector<2xi32>, %buffer: buffer, %iteration_count: i32) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %base = index.constant 0 : offset
  %outer_value = vector.extract %conditions[0] : vector<2xi32> -> i32
  %inner_value = vector.extract %conditions[1] : vector<2xi32> -> i32
  %outer = scalar.cmpi ne, %outer_value, %c0 : i32
  %inner = scalar.cmpi ne, %inner_value, %c0 : i32
  cfg.br ^header(%c0: i32)
^header(%iteration: i32):
  %running = scalar.cmpi slt, %iteration, %iteration_count : i32
  cfg.cond_br %running, ^body, ^exit
^body:
  cfg.cond_br %outer, ^shared, ^decision
^decision:
  %view = buffer.view %buffer[%base] : buffer -> view<1xi32>
  %value = view.load %view[0] : view<1xi32> -> i32
  cfg.cond_br %inner, ^shared, ^selected
^selected:
  view.store %value, %view[0] : i32, view<1xi32>
  cfg.br ^latch
^shared:
  cfg.br ^latch
^latch:
  %next = scalar.addi %iteration, %c1 : i32
  cfg.br ^header(%next: i32)
^exit:
  func.return
}
