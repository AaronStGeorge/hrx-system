// RUN: emit source-low target=spirv:vulkan1.3+bda+hal output=low control-flow=structured-low

kernel.def @execution_queries(%groups_x: index, %groups_y: index, %groups_z: index) {
  %threads = index.constant 128 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups_x, %groups_y, %groups_z) workgroup_size(%threads, %unit, %unit) : index
} launch(%output: buffer) {
  %groups_x = kernel.workgroup.count<x> : index
  %groups_y = kernel.workgroup.count<y> : index
  %groups_z = kernel.workgroup.count<z> : index
  %subgroup = kernel.subgroup.id : index
  %subgroup_count = kernel.subgroup.count : index
  %width = kernel.subgroup.size : index
  %lane = kernel.subgroup.lane.id : index
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<128x7xi32>
  %thread = kernel.workitem.id<x> : index
  %groups_x_word = index.cast %groups_x : index to i32
  %groups_y_word = index.cast %groups_y : index to i32
  %groups_z_word = index.cast %groups_z : index to i32
  %subgroup_word = index.cast %subgroup : index to i32
  %subgroup_count_word = index.cast %subgroup_count : index to i32
  %width_word = index.cast %width : index to i32
  %lane_word = index.cast %lane : index to i32
  view.store %groups_x_word, %view[%thread, 0] : i32, view<128x7xi32>
  view.store %groups_y_word, %view[%thread, 1] : i32, view<128x7xi32>
  view.store %groups_z_word, %view[%thread, 2] : i32, view<128x7xi32>
  view.store %subgroup_word, %view[%thread, 3] : i32, view<128x7xi32>
  view.store %subgroup_count_word, %view[%thread, 4] : i32, view<128x7xi32>
  view.store %width_word, %view[%thread, 5] : i32, view<128x7xi32>
  view.store %lane_word, %view[%thread, 6] : i32, view<128x7xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer) -> ()}) workgroup_size(128, 1, 1) @execution_queries() asm {
  %aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %groups_x = OpLoadBuiltin.num_workgroups.x
  %groups_y = OpLoadBuiltin.num_workgroups.y
  %groups_z = OpLoadBuiltin.num_workgroups.z
  %subgroup = OpLoadBuiltin.subgroup_id
  %subgroup_count = OpLoadBuiltin.num_subgroups
  %width = OpLoadBuiltin.subgroup_size
  %lane = OpLoadBuiltin.subgroup_local_invocation_id
  %thread = OpLoadBuiltin.local_invocation_id.x
  %groups_x_word = OpCopyObject.i32 %groups_x
  %groups_y_word = OpCopyObject.i32 %groups_y
  %groups_z_word = OpCopyObject.i32 %groups_z
  %subgroup_word = OpCopyObject.i32 %subgroup
  %subgroup_count_word = OpCopyObject.i32 %subgroup_count
  %width_word = OpCopyObject.i32 %width
  %lane_word = OpCopyObject.i32 %lane
  %55 = OpSConvert.i32.offset64 %thread
  %56 = OpConstant.offset64 28
  %57 = OpIMul.offset64 %55, %56
  %58 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %57
  OpStore.storage_buffer.i32 %58, %groups_x_word
  %62 = OpConstant.offset64 4
  %63 = OpIAdd.offset64 %57, %62
  %64 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %63
  OpStore.storage_buffer.i32 %64, %groups_y_word
  %68 = OpConstant.offset64 8
  %69 = OpIAdd.offset64 %57, %68
  %70 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %69
  OpStore.storage_buffer.i32 %70, %groups_z_word
  %74 = OpConstant.offset64 12
  %75 = OpIAdd.offset64 %57, %74
  %76 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %75
  OpStore.storage_buffer.i32 %76, %subgroup_word
  %80 = OpConstant.offset64 16
  %81 = OpIAdd.offset64 %57, %80
  %82 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %81
  OpStore.storage_buffer.i32 %82, %subgroup_count_word
  %86 = OpConstant.offset64 20
  %87 = OpIAdd.offset64 %57, %86
  %88 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %87
  OpStore.storage_buffer.i32 %88, %width_word
  %92 = OpConstant.offset64 24
  %93 = OpIAdd.offset64 %57, %92
  %94 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %93
  OpStore.storage_buffer.i32 %94, %lane_word
  return
}

// ====
// RUN: emit source-low target=spirv:vulkan1.3+bda+subgroup32+ballot+hal output=low control-flow=structured-low

// A fixed execution width does not identify which lane runs a small workgroup
// or how many partially occupied subgroups the implementation dispatches.
kernel.def @partial_subgroup_queries() {
  %unit = index.constant 1 : index
  %threads = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%output: buffer) {
  %thread = kernel.workitem.id<x> : index
  %lane = kernel.subgroup.lane.id : index
  %subgroup = kernel.subgroup.id : index
  %count = kernel.subgroup.count : index
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<3x3xi32>
  %lane_word = index.cast %lane : index to i32
  %subgroup_word = index.cast %subgroup : index to i32
  %count_word = index.cast %count : index to i32
  view.store %lane_word, %view[%thread, 0] : i32, view<3x3xi32>
  view.store %subgroup_word, %view[%thread, 1] : i32, view<3x3xi32>
  view.store %count_word, %view[%thread, 2] : i32, view<3x3xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer) -> ()}) workgroup_size(3, 1, 1) workgroup_count(1, 1, 1) @partial_subgroup_queries() asm {
  %output = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %thread = OpLoadBuiltin.local_invocation_id.x
  %lane = OpLoadBuiltin.subgroup_local_invocation_id
  %subgroup = OpLoadBuiltin.subgroup_id
  %count = OpLoadBuiltin.num_subgroups
  %lane_word = OpCopyObject.i32 %lane
  %subgroup_word = OpCopyObject.i32 %subgroup
  %count_word = OpCopyObject.i32 %count
  %27 = OpSConvert.i32.offset64 %thread
  %28 = OpConstant.offset64 12
  %29 = OpIMul.offset64 %27, %28
  %30 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %29
  OpStore.storage_buffer.i32 %30, %lane_word
  %34 = OpConstant.offset64 4
  %35 = OpIAdd.offset64 %29, %34
  %36 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %35
  OpStore.storage_buffer.i32 %36, %subgroup_word
  %40 = OpConstant.offset64 8
  %41 = OpIAdd.offset64 %29, %40
  %42 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %41
  OpStore.storage_buffer.i32 %42, %count_word
  return
}
