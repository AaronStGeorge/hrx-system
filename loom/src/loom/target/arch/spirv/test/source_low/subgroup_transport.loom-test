// RUN: emit spirv-low target=spirv:vulkan1.3+bda features=BFLOAT16_TYPE_KHR,-INT16,-SUBGROUP_EXTENDED_TYPES,GROUP_NON_UNIFORM,GROUP_NON_UNIFORM_SHUFFLE,GROUP_NON_UNIFORM_SHUFFLE_RELATIVE,GROUP_NON_UNIFORM_BALLOT,STORAGE_BUFFER_16BIT_ACCESS limits=SUBGROUP_SIZE:32

// Native BF16 group operations are unavailable. Three components exercise
// pair packing and odd padding without requiring Int16 or extended types.
kernel.def @odd_bfloat_broadcast() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32x3xbf16>
  %destination = buffer.view %output[%base] : buffer -> view<32x3xbf16>
  %value = vector.load %source[%lane, 0] : view<32x3xbf16> -> vector<3xbf16>
  %result = kernel.subgroup.broadcast.first %value : vector<3xbf16>
  vector.store %result, %destination[%lane, 0] : vector<3xbf16>, view<32x3xbf16>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @odd_bfloat_broadcast() asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %lane = OpLoadBuiltin.subgroup_local_invocation_id
  %38 = OpSConvert.i32.offset64 %lane
  %39 = OpConstant.offset64 6
  %40 = OpIMul.offset64 %38, %39
  %41 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %input, %40
  %42 = OpLoad.storage_buffer.bf16 %41
  %46 = OpConstant.offset64 2
  %47 = OpIAdd.offset64 %40, %46
  %48 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %input, %47
  %49 = OpLoad.storage_buffer.bf16 %48
  %53 = OpConstant.offset64 4
  %54 = OpIAdd.offset64 %40, %53
  %55 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %input, %54
  %56 = OpLoad.storage_buffer.bf16 %55
  %value = OpCompositeConstruct.v3bf16 %42, %49, %56
  %58 = OpCompositeExtract.v3bf16.bf16 %value, 0 : reg<spirv.id>
  %59 = OpCompositeExtract.v3bf16.bf16 %value, 1 : reg<spirv.id>
  %60 = OpCompositeExtract.v3bf16.bf16 %value, 2 : reg<spirv.id>
  %61 = OpCompositeConstruct.v4bf16 %58, %59, %60, %60 : reg<spirv.id>
  %62 = OpBitcast.v4bf16.v2i32 %61 : reg<spirv.id>
  %63 = OpGroupNonUniformBroadcastFirst.v2i32 %62 : reg<spirv.id>
  %64 = OpBitcast.v2i32.v4bf16 %63 : reg<spirv.id>
  %65 = OpCompositeExtract.v4bf16.bf16 %64, 0 : reg<spirv.id>
  %66 = OpCompositeExtract.v4bf16.bf16 %64, 1 : reg<spirv.id>
  %67 = OpCompositeExtract.v4bf16.bf16 %64, 2 : reg<spirv.id>
  %result = OpCompositeConstruct.v3bf16 %65, %66, %67
  %69 = OpCompositeExtract.v3bf16.bf16 %result, 0
  %70 = OpCompositeExtract.v3bf16.bf16 %result, 1
  %71 = OpCompositeExtract.v3bf16.bf16 %result, 2
  %72 = OpSConvert.i32.offset64 %lane
  %73 = OpConstant.offset64 6
  %74 = OpIMul.offset64 %72, %73
  %75 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %74
  OpStore.storage_buffer.bf16 %75, %69
  %79 = OpConstant.offset64 2
  %80 = OpIAdd.offset64 %74, %79
  %81 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %80
  OpStore.storage_buffer.bf16 %81, %70
  %85 = OpConstant.offset64 4
  %86 = OpIAdd.offset64 %74, %85
  %87 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %86
  OpStore.storage_buffer.bf16 %87, %71
  return
}

// ====
// RUN: emit spirv-low target=spirv:vulkan1.3+bda features=BFLOAT16_TYPE_KHR,-INT16,-SUBGROUP_EXTENDED_TYPES,GROUP_NON_UNIFORM,GROUP_NON_UNIFORM_SHUFFLE,GROUP_NON_UNIFORM_SHUFFLE_RELATIVE,GROUP_NON_UNIFORM_BALLOT,STORAGE_BUFFER_16BIT_ACCESS limits=SUBGROUP_SIZE:32

// Wider native BF16 payloads reuse the four-element composite representation.
// The final singleton has defined padding and shares the first packet's validity.
kernel.def @wide_native_bfloat_transport() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %validity: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32x5xbf16>
  %destination = buffer.view %output[%base] : buffer -> view<32x5xbf16>
  %validity_view = buffer.view %validity[%base] : buffer -> view<32xi32>
  %value = vector.load<volatile> %source[%lane, 0] : view<32x5xbf16> -> vector<5xbf16>
  %distance = scalar.constant 1 : i32
  %width = scalar.constant 32 : i32
  %result, %valid = kernel.subgroup.shuffle<xor> %value, %distance, %width : vector<5xbf16>, i32, i32
  vector.store %result, %destination[%lane, 0] : vector<5xbf16>, view<32x5xbf16>
  %valid_integer = scalar.extui %valid : i1 to i32
  view.store %valid_integer, %validity_view[%lane] : i32, view<32xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer, buffer) -> ()}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @wide_native_bfloat_transport() asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %validity = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %lane = OpLoadBuiltin.subgroup_local_invocation_id
  %74 = OpSConvert.i32.offset64 %lane
  %75 = OpConstant.offset64 10
  %76 = OpIMul.offset64 %74, %75
  %77 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %input, %76
  %78 = OpLoad.storage_buffer.bf16<volatile> %77
  %82 = OpConstant.offset64 2
  %83 = OpIAdd.offset64 %76, %82
  %84 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %input, %83
  %85 = OpLoad.storage_buffer.bf16<volatile> %84
  %89 = OpConstant.offset64 4
  %90 = OpIAdd.offset64 %76, %89
  %91 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %input, %90
  %92 = OpLoad.storage_buffer.bf16<volatile> %91
  %96 = OpConstant.offset64 6
  %97 = OpIAdd.offset64 %76, %96
  %98 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %input, %97
  %99 = OpLoad.storage_buffer.bf16<volatile> %98
  %103 = OpConstant.offset64 8
  %104 = OpIAdd.offset64 %76, %103
  %105 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %input, %104
  %106 = OpLoad.storage_buffer.bf16<volatile> %105
  %distance = OpConstant.i32 1
  %width = OpConstant.i32 32
  %109 = OpCompositeConstruct.v4bf16 %78, %85, %92, %99
  %110 = OpBitcast.v4bf16.v2i32 %109 : reg<spirv.id>
  %111 = OpBitcast.i32.u32 %distance
  %112 = OpGroupNonUniformShuffleXor.v2i32 %110, %111 : reg<spirv.id>
  %113 = OpBitcast.v2i32.v4bf16 %112
  %114 = OpLoadBuiltin.subgroup_local_invocation_id : reg<spirv.id>
  %115 = OpBitwiseXor %114, %distance : reg<spirv.id>
  %116 = OpBitcast.i32.u32 %width
  %117 = OpULessThan.u32 %111, %116 : reg<spirv.id>
  %118 = OpBitcast.i32.u32 %115
  %119 = OpULessThan.u32 %118, %116 : reg<spirv.id>
  %120 = OpLogicalAnd.bool %117, %119 : reg<spirv.id>
  %121 = OpSelect %120, %115, %114 : reg<spirv.id>
  %122 = OpBitcast.i32.u32 %121
  %123 = OpConstantTrue.bool : reg<spirv.id>
  %124 = OpGroupNonUniformBallot.v4u32 %123
  %125 = OpGroupNonUniformBallotBitExtract.bool %124, %122 : reg<spirv.id>
  %valid = OpLogicalAnd.bool %120, %125
  %127 = OpCompositeConstruct.v2bf16 %106, %106 : reg<spirv.id>
  %128 = OpBitcast.v2bf16.i32 %127 : reg<spirv.id>
  %129 = OpBitcast.i32.u32 %distance
  %130 = OpGroupNonUniformShuffleXor.i32 %128, %129 : reg<spirv.id>
  %131 = OpBitcast.i32.v2bf16 %130 : reg<spirv.id>
  %132 = OpCompositeExtract.v2bf16.bf16 %131, 0
  %133 = OpCompositeExtract.v4bf16.bf16 %113, 0
  %134 = OpCompositeExtract.v4bf16.bf16 %113, 1
  %135 = OpCompositeExtract.v4bf16.bf16 %113, 2
  %136 = OpCompositeExtract.v4bf16.bf16 %113, 3
  %137 = OpSConvert.i32.offset64 %lane
  %138 = OpConstant.offset64 10
  %139 = OpIMul.offset64 %137, %138
  %140 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %139
  OpStore.storage_buffer.bf16 %140, %133
  %144 = OpConstant.offset64 2
  %145 = OpIAdd.offset64 %139, %144
  %146 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %145
  OpStore.storage_buffer.bf16 %146, %134
  %150 = OpConstant.offset64 4
  %151 = OpIAdd.offset64 %139, %150
  %152 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %151
  OpStore.storage_buffer.bf16 %152, %135
  %156 = OpConstant.offset64 6
  %157 = OpIAdd.offset64 %139, %156
  %158 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %157
  OpStore.storage_buffer.bf16 %158, %136
  %162 = OpConstant.offset64 8
  %163 = OpIAdd.offset64 %139, %162
  %164 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %163
  OpStore.storage_buffer.bf16 %164, %132
  %165 = OpConstant.i32 0
  %valid_integer = OpSelect %valid, %distance, %165
  %169 = OpIMul.offset64 %137, %150
  %170 = OpPtrAccessChain.storage_buffer.i32.byte_offset %validity, %169
  OpStore.storage_buffer.i32 %170, %valid_integer
  return
}
