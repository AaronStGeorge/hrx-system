// RUN: emit source-low output=low control-flow=structured-low

// Vulkan shader plus StorageBuffer8BitAccess, deliberately without Int8.
spirv.target<vulkan1_3> @target {contract_feature_bits = 130}

func.def target(@target) @copy(%source: buffer, %source_offset: offset, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.copy %source[%source_offset], %target[%target_offset], %byte_length
  func.return
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @copy(%source: reg<spirv.ptr.storage_buffer>, %source_offset: reg<spirv.offset64>, %target: reg<spirv.ptr.storage_buffer>, %target_offset: reg<spirv.offset64>, %byte_length: reg<spirv.offset64>) asm {
  %16 = OpConstant.offset64 0
  %17 = OpConstant.offset64 1
  low.scf.for unsigned [%16 to %byte_length step %17] do(%18: reg<spirv.offset64>) {
    %19 = OpIAdd.offset64 %source_offset, %18
    %20 = OpPtrAccessChain.storage_buffer.raw_u8.byte_offset %source, %19
    %21 = OpLoad.storage_buffer.raw_u8 %20
    %22 = OpUConvert.raw_u8.u32 %21
    %23 = OpBitcast.u32.i32 %22
    %24 = OpIAdd.offset64 %target_offset, %18
    %25 = OpPtrAccessChain.storage_buffer.raw_u8.byte_offset %target, %24
    %26 = OpBitcast.i32.u32 %23
    %27 = OpUConvert.u32.raw_u8 %26
    OpStore.storage_buffer.raw_u8 %25, %27
  }
  return
}

// ====

// Vulkan shader plus StorageBuffer8BitAccess, deliberately without Int8.
spirv.target<vulkan1_3> @target {contract_feature_bits = 130}

func.def target(@target) @fill(%pattern: i32, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.fill %pattern, %target[%target_offset], %byte_length : i32
  func.return
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @fill(%pattern: reg<spirv.id : i32>, %target: reg<spirv.ptr.storage_buffer>, %target_offset: reg<spirv.offset64>, %byte_length: reg<spirv.offset64>) asm {
  %19 = OpConstant.offset64 0
  %20 = OpConstant.offset64 1
  %21 = OpConstant.i32 8
  %22 = OpConstant.i32 24
  %25 = low.scf.for unsigned [%19 to %byte_length step %20] iter_args(%pattern: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) do(%23: reg<spirv.offset64>, %24: reg<spirv.id : i32>) {
    %26 = OpIAdd.offset64 %target_offset, %23
    %27 = OpPtrAccessChain.storage_buffer.raw_u8.byte_offset %target, %26
    %28 = OpBitcast.i32.u32 %24
    %29 = OpUConvert.u32.raw_u8 %28
    OpStore.storage_buffer.raw_u8 %27, %29
    %30 = OpShiftRightLogical %24, %21
    %31 = OpShiftLeftLogical %24, %22
    %32 = OpBitwiseOr %30, %31
    low.scf.yield %32 : reg<spirv.id : i32>
  }
  return
}

// ====

// Vulkan shader plus StorageBuffer8BitAccess, deliberately without Int8.
spirv.target<vulkan1_3> @target {contract_feature_bits = 130}

func.def target(@target) @compare(%lhs: buffer, %lhs_offset: offset, %rhs: buffer, %rhs_offset: offset, %byte_length: offset) -> (i32) {
  %order = buffer.compare %lhs[%lhs_offset], %rhs[%rhs_offset], %byte_length
  func.return %order : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @compare(%lhs: reg<spirv.ptr.storage_buffer>, %lhs_offset: reg<spirv.offset64>, %rhs: reg<spirv.ptr.storage_buffer>, %rhs_offset: reg<spirv.offset64>, %byte_length: reg<spirv.offset64>) -> (reg<spirv.id : i32>) asm {
  %40 = OpConstant.offset64 0
  %41 = OpConstant.i32 0
  %42 = OpConstant.i32 -1
  %43 = OpConstant.i32 1
  %44 = OpConstant.offset64 1
  %48, %49, %50 = low.scf.while(%45 = %40 : reg<spirv.offset64>, %46 = %41 : reg<spirv.id : i32>, %47 = %41 : reg<spirv.id : i32>) -> (reg<spirv.offset64>, reg<spirv.id : i32>, reg<spirv.id : i32>) {
    %54 = OpULessThan.offset64 %45, %byte_length
    %55 = OpIEqual %46, %47
    %56 = OpLogicalAnd.bool %54, %55
    low.scf.condition %56, %45, %46, %47 : reg<spirv.id : i1>, reg<spirv.offset64>, reg<spirv.id : i32>, reg<spirv.id : i32>
  } do(%51: reg<spirv.offset64>, %52: reg<spirv.id : i32>, %53: reg<spirv.id : i32>) {
    %57 = OpIAdd.offset64 %lhs_offset, %51
    %58 = OpPtrAccessChain.storage_buffer.raw_u8.byte_offset %lhs, %57
    %59 = OpLoad.storage_buffer.raw_u8 %58
    %60 = OpUConvert.raw_u8.u32 %59
    %61 = OpBitcast.u32.i32 %60
    %62 = OpIAdd.offset64 %rhs_offset, %51
    %63 = OpPtrAccessChain.storage_buffer.raw_u8.byte_offset %rhs, %62
    %64 = OpLoad.storage_buffer.raw_u8 %63
    %65 = OpUConvert.raw_u8.u32 %64
    %66 = OpBitcast.u32.i32 %65
    %67 = OpIAdd.offset64 %51, %44
    low.scf.yield %67, %61, %66 : reg<spirv.offset64>, reg<spirv.id : i32>, reg<spirv.id : i32>
  }
  %68 = OpIEqual %49, %50
  %69 = OpBitcast.i32.u32 %49
  %70 = OpBitcast.i32.u32 %50
  %71 = OpULessThan.u32 %69, %70
  %72 = OpSelect %71, %42, %43
  %order = OpSelect %68, %41, %72
  return %order
}
