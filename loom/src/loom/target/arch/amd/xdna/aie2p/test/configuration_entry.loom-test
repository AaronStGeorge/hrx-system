// RUN: emit source-low output=none

aie2p.target<configuration> @configuration {device_profile = "amd.xdna.strix.17f0_10"}

// ERROR@+1: XDNA/051 {requirement="a static one-workgroup, one-workitem configuration launch"}
kernel.def target(@configuration) @multiple() {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  kernel.launch.config workgroups(%c2, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

// ----

// ====
// RUN: emit source-low output=none

aie2p.target<configuration> @configuration {device_profile = "amd.xdna.strix.17f0_10"}

// ERROR@+1: XDNA/051 {requirement="buffer arguments addressed through configuration binding ordinals"}
kernel.def target(@configuration) @direct_access() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%output: buffer) {
  %c0 = index.constant 0 : offset
  %value = scalar.constant 7 : i32
  %view = buffer.view %output[%c0] : buffer -> view<1xi32>
  view.store %value, %view[0] : i32, view<1xi32>
  kernel.return
}

