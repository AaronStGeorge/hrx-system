// Generated move routes retain exact target encodings for each distinct native
// mechanism: factored scalar resources, scalar pairs, dimension aggregates,
// accumulator halves, and FIFO halves.

// RUN: emit aie2p-leaf @scalar_cross_bank report=code

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @scalar_cross_bank(%source: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.es>) asm {
  %copy = copy %source {detached = true} : reg<aie2p.er> -> reg<aie2p.es>
  return %source, %copy
}

