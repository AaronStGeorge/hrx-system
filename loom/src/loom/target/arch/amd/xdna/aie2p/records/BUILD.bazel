load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "record_defs",
    hdrs = ["target_records.h"],
    visibility = ["//loom/src/loom/target/arch/amd/xdna/aie2p:implementation"],
    deps = ["//loom/src/loom/target:types"],
)

loom_cc_library(
    name = "target_records",
    srcs = ["target_records.c"],
    hdrs = ["target_records.h"],
    visibility = ["//loom/src/loom/target/arch/amd/xdna/aie2p:implementation"],
    deps = [
        "//loom/src/loom/target:types",
        "//runtime/src/iree/base",
    ],
)
