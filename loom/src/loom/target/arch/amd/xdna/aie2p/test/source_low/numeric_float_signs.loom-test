func.def @vector_f32_4_signs(%magnitude: vector<4xf32>, %sign: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>) {
  %absolute = vector.absf %magnitude : vector<4xf32>
  %negated = vector.negf %magnitude : vector<4xf32>
  %copied = vector.copysignf %magnitude, %sign : vector<4xf32>
  func.return %absolute, %negated, %copied : vector<4xf32>, vector<4xf32>, vector<4xf32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @vector_f32_4_signs(%magnitude: reg<aie2p.vec256 x2>, %sign: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %13 = mov.i32 2147483647
  %14 = vbcst.32 %13
  %absolute = vband %magnitude, %14
  %16 = mov.i32 -2147483648
  %17 = vbcst.32 %16
  %18 = vbor %magnitude, %17
  %19 = vband %magnitude, %17
  %negated = vsub.32 %18, %19
  %26 = vband %sign, %17
  %copied = vbor %absolute, %26
  return %absolute, %negated, %copied
}

