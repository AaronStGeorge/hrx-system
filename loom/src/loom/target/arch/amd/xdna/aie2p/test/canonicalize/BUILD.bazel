load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

_XDNA_TARGET_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/arch:aie2p",
])

loom_check_test_suite(
    name = "loom_check_test",
    srcs = [
        "adjacent_add.loom-test",
    ],
    target_compatible_with = _XDNA_TARGET_COMPATIBLE_WITH,
)
