// ====

// Copies with one fixed external address keep direct invocation relocation.
// The descriptor and relocation are each initialized once, and neither issue
// needs an external-address patch.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @fixed_snapshot() run(%output_arg: buffer) {
  %output = buffer.assume.alignment %output_arg {minimum_alignment = 4} : buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %capacity = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x1xi32>
  %records = channel.bind<fifo> %slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %write, %destination = channel.reserve %records : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %initial = scalar.constant 11 : i32
    view.store %initial, %destination[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
    %read, %source = channel.acquire<mutable> %records : channel<tile<1xi32>> -> (read<tile<1xi32>, mutable>, view<1xi32>)
    %external = buffer.view %output[%origin] : buffer -> view<1xi32>
    %first = kernel.async.copy %source to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %first_group = kernel.async.group %first : kernel.async.token -> kernel.async.group
    kernel.async.wait %first_group {newer_groups = 0} : kernel.async.group
    %final = scalar.constant 22 : i32
    view.store %final, %source[0] : i32, view<1xi32>
    %second = kernel.async.copy %source to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %second_group = kernel.async.group %second : kernel.async.token -> kernel.async.group
    kernel.async.wait %second_group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<1xi32>, mutable>
  }
}

