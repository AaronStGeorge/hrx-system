// RUN: pass target-legalize{mode=eager}

aie2p.target<core> @target

func.def target(@target) @multiply_on_left(%a: i32, %b: i32, %c: i32) -> (i32) {
  %product = scalar.muli %a, %b : i32
  %result = scalar.addi %product, %c : i32
  func.return %result : i32
}

func.def target(@target) @multiply_on_right(%a: i32, %b: i32, %c: i32) -> (i32) {
  %product = scalar.muli %a, %b : i32
  %result = scalar.addi %c, %product : i32
  func.return %result : i32
}

// ----
aie2p.target<core> @target

func.def target(@target) @multiply_on_left(%a: i32, %b: i32, %c: i32) -> (i32) {
  %result = scalar.fmai %a, %b, %c : i32
  func.return %result : i32
}

func.def target(@target) @multiply_on_right(%a: i32, %b: i32, %c: i32) -> (i32) {
  %result = scalar.fmai %a, %b, %c : i32
  func.return %result : i32
}

// ====

// No-wrap contracts describe the authored intermediate operation and cannot be
// transferred to a fused operation with no intermediate overflow check.
aie2p.target<core> @target

func.def target(@target) @flagged_multiply(%a: i32, %b: i32, %c: i32) -> (i32) {
  %product = scalar.muli<nuw> %a, %b : i32
  %result = scalar.addi %product, %c : i32
  func.return %result : i32
}

func.def target(@target) @flagged_add(%a: i32, %b: i32, %c: i32) -> (i32) {
  %product = scalar.muli %a, %b : i32
  %result = scalar.addi<nsw> %product, %c : i32
  func.return %result : i32
}

// ====

// A second ordinary observer keeps the independently useful product.
aie2p.target<core> @target

func.def target(@target) @shared_product(%a: i32, %b: i32, %c: i32) -> (i32, i32) {
  %product = scalar.muli %a, %b : i32
  %result = scalar.addi %product, %c : i32
  func.return %product, %result : i32, i32
}

// ====

// Embedded predicates observe the product without contributing an ordinary
// operand use.
aie2p.target<core> @target

func.def target(@target) @attribute_observer(%a: i32, %b: i32, %c: i32) -> (i32) {
  %product = scalar.muli %a, %b : i32
  %result = scalar.addi %product, %c : i32
  %observed = scalar.assume %result [multiple_of(%product, 4)] : i32
  func.return %observed : i32
}
