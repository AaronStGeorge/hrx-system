load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_generated_source")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_generated_source(
    name = "tables_gen",
    generator = "//loom/py/loom/gen/target/arch/amd/xdna/aie2p:encoding_tables",
    output = "encoding_tables.inl",
    output_flag = "--encoding-output",
)

loom_cc_library(
    name = "encoding",
    srcs = ["encoding.c"],
    hdrs = ["encoding.h"],
    textual_hdrs = [":encoding_tables.inl"],
    visibility = ["//visibility:public"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_test(
    name = "encoding_test",
    srcs = ["encoding_test.cc"],
    deps = [
        ":encoding",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
