// The first constant shares its issue packet with an unrelated load. The
// second constant is published after the first matrix operation, but its
// physical issue packet shares that operation's cycle. No concurrent
// instruction writes its register, so the prior value remains available and
// the repeated write disappears without changing any issue cycle.
// RUN: emit aie2p-leaf @same fixed=%first_control:physical_register:253:1 fixed=%second_control:physical_register:253:1 report=code

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @same(%input: reg<aie2p.ep>, %accumulator: reg<aie2p.mbms x4>, %lhs: reg<aie2p.mexa>, %rhs: reg<aie2p.mexa>) -> (reg<aie2p.mbms x4>, reg<aie2p.vec256 x2>) asm {
  %first_control = mova.i32 780
  %loaded = vlda.512.i32x16 %input, 0
  %first = mma.bfp16ebs8.m8n8k8 %accumulator, %lhs, %rhs, %first_control
  %second_control = mova.i32 780
  %second = mma.bfp16ebs8.m8n8k8 %first, %lhs, %rhs, %second_control
  return %second, %loaded
}

// ----
code: 3c 68 09 00 80 61 48 29 00 00 00 00 00 00 48 29 00 00 18 00 28 10 00 00 00 00 00 00 00 00 00 00

// ====

// A different constant in the same physical register remains an observable
// write. It stays coissued with the first matrix operation for the following
// operation to consume.
// RUN: emit aie2p-leaf @different fixed=%first_control:physical_register:253:1 fixed=%second_control:physical_register:253:1 report=code

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @different(%accumulator: reg<aie2p.mbms x4>, %lhs: reg<aie2p.mexa>, %rhs: reg<aie2p.mexa>) -> (reg<aie2p.mbms x4>) asm {
  %first_control = mova.i32 780
  %first = mma.bfp16ebs8.m8n8k8 %accumulator, %lhs, %rhs, %first_control
  %second_control = mova.i32 781
  %second = mma.bfp16ebs8.m8n8k8 %first, %lhs, %rhs, %second_control
  return %second
}

// ----
code: 18 00 0c 03 62 29 00 00 04 00 a0 61 00 00 00 00 48 29 00 00 18 00 28 10 00 00 00 00 00 00 00 00 00 00

// ====

// Equal constants assigned to different physical destinations remain distinct
// writes even though their descriptor and immediate are identical.
// RUN: emit aie2p-leaf @different_destination fixed=%first_control:physical_register:253:1 fixed=%second_control:physical_register:254:1 report=code

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @different_destination(%accumulator: reg<aie2p.mbms x4>, %lhs: reg<aie2p.mexa>, %rhs: reg<aie2p.mexa>) -> (reg<aie2p.mbms x4>) asm {
  %first_control = mova.i32 780
  %first = mma.bfp16ebs8.m8n8k8 %accumulator, %lhs, %rhs, %first_control
  %second_control = mova.i32 780
  %second = mma.bfp16ebs8.m8n8k8 %first, %lhs, %rhs, %second_control
  return %second
}

