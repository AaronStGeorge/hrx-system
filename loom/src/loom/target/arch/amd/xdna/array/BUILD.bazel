load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "facts",
    srcs = ["facts.c"],
    hdrs = ["facts.h"],
    textual_hdrs = ["//loom/src/loom/target/arch/amd/xdna:array_facts_tables.inl"],
    visibility = ["//visibility:public"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "registers",
    srcs = ["registers.c"],
    hdrs = ["registers.h"],
    textual_hdrs = [
        "//loom/src/loom/target/arch/amd/xdna:array_register_field_ids.inl",
        "//loom/src/loom/target/arch/amd/xdna:array_register_tables.inl",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":facts",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "facts_test",
    srcs = ["facts_test.cc"],
    deps = [
        ":facts",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "registers_test",
    srcs = ["registers_test.cc"],
    deps = [
        ":facts",
        ":registers",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
