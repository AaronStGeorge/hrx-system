load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "profile",
    srcs = ["profile.c"],
    hdrs = ["profile.h"],
    textual_hdrs = ["//loom/src/loom/target/arch/amd/xdna:device_profile_tables.inl"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/target/arch/amd/xdna/array:facts",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "profile_test",
    srcs = ["profile_test.cc"],
    deps = [
        ":profile",
        "//loom/src/loom/target/arch/amd/xdna/array:facts",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
