load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_generated_cc_library",
    "loom_generated_source_family",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_generated_cc_library(
    name = "error_defs",
    args = [
        "--catalog-symbol=loom_xdna_error_catalog",
        "--fallback-catalog-symbol=loom_error_catalog_core",
        "--fallback-public-header=loom/error/error_catalog.h",
        "--public-header=loom/target/arch/amd/xdna/error_catalog.h",
        "--shard=xdna",
    ],
    generated_hdr_flags = ["--header"],
    generated_hdrs = ["error_catalog.h"],
    generator = "//loom/py/loom/gen/error:c_errors",
    source = "error_catalog.c",
    visibility = ["//loom/src/loom/target/arch/amd/xdna:__subpackages__"],
    deps = ["//loom/src/loom/error:error_defs"],
)

loom_generated_source_family(
    name = "hardware_tables_gen",
    generator = "//loom/py/loom/gen/target/arch/amd/xdna:hardware_tables",
    output_flags = [
        "--array-output",
        "--register-output",
        "--register-field-output",
        "--profile-output",
        "--aie2p-profile-output",
    ],
    outputs = [
        "array_facts_tables.inl",
        "array_register_tables.inl",
        "array_register_field_ids.inl",
        "device_profile_tables.inl",
        "aie2p_profile_tables.inl",
    ],
    visibility = ["//loom/src/loom/target/arch/amd/xdna:__subpackages__"],
)
