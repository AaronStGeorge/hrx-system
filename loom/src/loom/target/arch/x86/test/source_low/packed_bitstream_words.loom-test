// RUN: emit source-low target=x86:avx2 output=low

// The AVX2 policy assembles packed streams in 64-bit words while retaining
// the two-lane plus one-lane partition of a three-byte source tail.
func.def @unpack_q3(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<3xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<8xi32>
  %source = vector.load %input_view[0] : view<3xi8> -> vector<3xi8>
  %result = vector.bitunpacku<3> %source : vector<3xi8> -> vector<8xi32>
  vector.store %result, %output_view[0] : vector<8xi32>, view<8xi32>
  func.return
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @unpack_q3(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %42 = movzx.load.u8.gpr64 %input {disp32 = 0}
  %43 = movzx.load.u8.gpr64 %input {disp32 = 1}
  %44 = movzx.load.u8.gpr64 %input {disp32 = 2}
  %45 = copy %43 : reg<x86.gpr64> -> reg<x86.gpr64>
  %46 = shl.imm.gpr64 %45 {shift = 8}
  %47 = copy %42 : reg<x86.gpr64> -> reg<x86.gpr64>
  %48 = or.gpr64 %47, %46
  %49 = copy %44 : reg<x86.gpr64> -> reg<x86.gpr64>
  %50 = shl.imm.gpr64 %49 {shift = 16}
  %51 = copy %48 : reg<x86.gpr64> -> reg<x86.gpr64>
  %52 = or.gpr64 %51, %50
  %53 = copy %52 : reg<x86.gpr64> -> reg<x86.gpr64>
  %54 = shl.imm.gpr64 %53 {shift = 20}
  %55 = copy %52 : reg<x86.gpr64> -> reg<x86.gpr64>
  %56 = or.gpr64 %55, %54
  %57 = mov.imm64 17587891081215
  %58 = copy %56 : reg<x86.gpr64> -> reg<x86.gpr64>
  %59 = and.gpr64 %58, %57
  %60 = copy %59 : reg<x86.gpr64> -> reg<x86.gpr64>
  %61 = shl.imm.gpr64 %60 {shift = 10}
  %62 = copy %59 : reg<x86.gpr64> -> reg<x86.gpr64>
  %63 = or.gpr64 %62, %61
  %64 = mov.imm64 17733194119839807
  %65 = copy %63 : reg<x86.gpr64> -> reg<x86.gpr64>
  %66 = and.gpr64 %65, %64
  %67 = copy %66 : reg<x86.gpr64> -> reg<x86.gpr64>
  %68 = shl.imm.gpr64 %67 {shift = 5}
  %69 = copy %66 : reg<x86.gpr64> -> reg<x86.gpr64>
  %70 = or.gpr64 %69, %68
  %71 = mov.imm64 506381209866536711
  %72 = copy %70 : reg<x86.gpr64> -> reg<x86.gpr64>
  %73 = and.gpr64 %72, %71
  %74 = vmovq.xmm.gpr64 %73
  %75 = avx2.vpbroadcastq.xmm %74
  %result = vpmovzxbd.ymm %75
  vmovdqu32.store.ymm %result, %output {disp32 = 0}
  return
}
