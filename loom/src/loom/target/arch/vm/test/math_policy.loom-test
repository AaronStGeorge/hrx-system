// ====

vm.target<core> @vm

func.def target(@vm) @ordinary_narrow_hyperbolic(%value: bf16) -> (bf16) {
  %result = scalar.tanhf %value : bf16
  func.return %result : bf16
}

// ----
vm.target<core> @vm

low.func.def target<vm.core>(@vm) abi(vm_function) @ordinary_narrow_hyperbolic(%value: reg<vm.value : bf16>) -> (reg<vm.value : bf16>) asm {
  %2 = conversion.float.extend %value, "bf16.to.f32" : reg<vm.value : f32>
  %3 = float.math.unary.f32 %2, "tanh"
  %result = conversion.float.truncate %3, "f32.to.bf16" : reg<vm.value : bf16>
  return %result
}
