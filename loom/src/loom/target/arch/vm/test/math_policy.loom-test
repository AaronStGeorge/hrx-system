  %sinh = float.math.unary.f32 %value, "sinh"
  %cosh = float.math.unary.f32 %value, "cosh"
  %tanh = float.math.unary.f32 %value, "tanh"
  %asinh = float.math.unary.f32 %value, "asinh"
  %acosh = float.math.unary.f32 %value, "acosh"
  %atanh = float.math.unary.f32 %value, "atanh"
  return %sinh, %cosh, %tanh, %asinh, %acosh, %atanh
}

