vm.target<core> @vm

func.def target(@vm) @elementary_f32(%value: f32) -> (f32, f32, f32, f32) {
  %root = scalar.sqrtf %value : f32
  %inverse = scalar.rsqrtf %value : f32
  %natural = scalar.expf %value : f32
  %base_two = scalar.exp2f %value : f32
  func.return %root, %inverse, %natural, %base_two : f32, f32, f32, f32
}

// ----
vm.target<core> @vm

low.func.def target<vm.core>(@vm) abi(vm_function) @elementary_f32(%value: reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>) asm {
  %root = float.math.unary.f32 %value, "sqrt"
  %inverse = float.math.unary.f32 %value, "rsqrt"
  %natural = float.math.unary.f32 %value, "exp"
  %base_two = float.math.unary.f32 %value, "exp2"
  return %root, %inverse, %natural, %base_two
}

