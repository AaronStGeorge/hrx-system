// ====

// Narrow inputs evaluate at F32 and round once to the authored format. Both
// FP8 encodings and both 16-bit formats share the elementary operation policy.
vm.target<core> @vm

func.def target(@vm) @narrow_elementary(%e4m3: f8E4M3, %e5m2: f8E5M2, %half: f16, %brain: bf16) -> (f8E4M3, f8E5M2, f16, bf16) {
  %root = scalar.sqrtf %e4m3 : f8E4M3
  %inverse = scalar.rsqrtf %e5m2 : f8E5M2
  %natural = scalar.expf %half : f16
  %base_two = scalar.exp2f %brain : bf16
  func.return %root, %inverse, %natural, %base_two : f8E4M3, f8E5M2, f16, bf16
}

// ----
vm.target<core> @vm

low.func.def target<vm.core>(@vm) abi(vm_function) @narrow_elementary(%e4m3: reg<vm.value : f8E4M3>, %e5m2: reg<vm.value : f8E5M2>, %half: reg<vm.value : f16>, %brain: reg<vm.value : bf16>) -> (reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f16>, reg<vm.value : bf16>) asm {
  %8 = conversion.float.extend %e4m3, "f8e4m3.to.f32" : reg<vm.value : f32>
  %9 = float.math.unary.f32 %8, "sqrt"
  %root = conversion.float.truncate %9, "f32.to.f8e4m3" : reg<vm.value : f8E4M3>
  %11 = conversion.float.extend %e5m2, "f8e5m2.to.f32" : reg<vm.value : f32>
  %12 = float.math.unary.f32 %11, "rsqrt"
  %inverse = conversion.float.truncate %12, "f32.to.f8e5m2" : reg<vm.value : f8E5M2>
  %14 = conversion.float.extend %half, "f16.to.f32" : reg<vm.value : f32>
  %15 = float.math.unary.f32 %14, "exp"
  %natural = conversion.float.truncate %15, "f32.to.f16" : reg<vm.value : f16>
  %17 = conversion.float.extend %brain, "bf16.to.f32" : reg<vm.value : f32>
  %18 = float.math.unary.f32 %17, "exp2"
  %base_two = conversion.float.truncate %18, "f32.to.bf16" : reg<vm.value : bf16>
  return %root, %inverse, %natural, %base_two
}

// ====

vm.target<core> @vm

func.def target(@vm) @cube_roots(%input0: f8E4M3, %input1: f8E5M2, %input2: f16, %input3: bf16, %input4: f32, %input5: f64) -> (f8E4M3, f8E5M2, f16, bf16, f32, f64) {
  %root0 = scalar.cbrtf %input0 : f8E4M3
  %root1 = scalar.cbrtf %input1 : f8E5M2
  %root2 = scalar.cbrtf %input2 : f16
  %root3 = scalar.cbrtf %input3 : bf16
  %root4 = scalar.cbrtf %input4 : f32
  %root5 = scalar.cbrtf %input5 : f64
  func.return %root0, %root1, %root2, %root3, %root4, %root5 : f8E4M3, f8E5M2, f16, bf16, f32, f64
}

// ----
vm.target<core> @vm

low.func.def target<vm.core>(@vm) abi(vm_function) @cube_roots(%input0: reg<vm.value : f8E4M3>, %input1: reg<vm.value : f8E5M2>, %input2: reg<vm.value : f16>, %input3: reg<vm.value : bf16>, %input4: reg<vm.value : f32>, %input5: reg<vm.value : f64>) -> (reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f16>, reg<vm.value : bf16>, reg<vm.value : f32>, reg<vm.value : f64>) asm {
  %12 = conversion.float.extend %input0, "f8e4m3.to.f32" : reg<vm.value : f32>
  %13 = float.math.unary.f32 %12, "cbrt"
  %root0 = conversion.float.truncate %13, "f32.to.f8e4m3" : reg<vm.value : f8E4M3>
  %15 = conversion.float.extend %input1, "f8e5m2.to.f32" : reg<vm.value : f32>
  %16 = float.math.unary.f32 %15, "cbrt"
  %root1 = conversion.float.truncate %16, "f32.to.f8e5m2" : reg<vm.value : f8E5M2>
  %18 = conversion.float.extend %input2, "f16.to.f32" : reg<vm.value : f32>
  %19 = float.math.unary.f32 %18, "cbrt"
  %root2 = conversion.float.truncate %19, "f32.to.f16" : reg<vm.value : f16>
  %21 = conversion.float.extend %input3, "bf16.to.f32" : reg<vm.value : f32>
  %22 = float.math.unary.f32 %21, "cbrt"
  %root3 = conversion.float.truncate %22, "f32.to.bf16" : reg<vm.value : bf16>
  %root4 = float.math.unary.f32 %input4, "cbrt"
  %root5 = float.math.unary.f64 %input5, "cbrt"
  return %root0, %root1, %root2, %root3, %root4, %root5
}

// ====
// Every narrow carrier uses the same F32 evaluation and final format rounding.
vm.target<core> @vm

func.def target(@vm) @narrow_logarithms(%a: f8E4M3, %b: f8E5M2, %c: f16, %d: bf16) -> (f8E4M3, f8E5M2, f16, bf16) {
  %natural = scalar.logf %a : f8E4M3
  %base_two = scalar.log2f %b : f8E5M2
  %base_ten = scalar.log10f %c : f16
  %increment = scalar.log1pf %d : bf16
  func.return %natural, %base_two, %base_ten, %increment : f8E4M3, f8E5M2, f16, bf16
}

// ----
vm.target<core> @vm

low.func.def target<vm.core>(@vm) abi(vm_function) @narrow_logarithms(%a: reg<vm.value : f8E4M3>, %b: reg<vm.value : f8E5M2>, %c: reg<vm.value : f16>, %d: reg<vm.value : bf16>) -> (reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f16>, reg<vm.value : bf16>) asm {
  %8 = conversion.float.extend %a, "f8e4m3.to.f32" : reg<vm.value : f32>
  %9 = float.math.unary.f32 %8, "log"
  %natural = conversion.float.truncate %9, "f32.to.f8e4m3" : reg<vm.value : f8E4M3>
  %11 = conversion.float.extend %b, "f8e5m2.to.f32" : reg<vm.value : f32>
  %12 = float.math.unary.f32 %11, "log2"
  %base_two = conversion.float.truncate %12, "f32.to.f8e5m2" : reg<vm.value : f8E5M2>
  %14 = conversion.float.extend %c, "f16.to.f32" : reg<vm.value : f32>
  %15 = float.math.unary.f32 %14, "log10"
  %base_ten = conversion.float.truncate %15, "f32.to.f16" : reg<vm.value : f16>
  %17 = conversion.float.extend %d, "bf16.to.f32" : reg<vm.value : f32>
  %18 = float.math.unary.f32 %17, "log1p"
  %increment = conversion.float.truncate %18, "f32.to.bf16" : reg<vm.value : bf16>
  return %natural, %base_two, %base_ten, %increment
}

// ====
vm.target<core> @vm

func.def target(@vm) @wide_logarithms(%values: vector<2xf64>) -> (vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>) {
  %natural = vector.logf %values : vector<2xf64>
  %base_two = vector.log2f %values : vector<2xf64>
  %base_ten = vector.log10f %values : vector<2xf64>
  %increment = vector.log1pf %values : vector<2xf64>
  func.return %natural, %base_two, %base_ten, %increment : vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>
}

// ----
vm.target<core> @vm

low.func.def target<vm.core>(@vm) abi(vm_function) @wide_logarithms(%0: reg<vm.value : f64>, %1: reg<vm.value : f64>) -> (reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>) asm {
  %10 = float.math.unary.f64 %0, "log"
  %11 = float.math.unary.f64 %1, "log"
  %12 = float.math.unary.f64 %0, "log2"
  %13 = float.math.unary.f64 %1, "log2"
  %14 = float.math.unary.f64 %0, "log10"
  %15 = float.math.unary.f64 %1, "log10"
  %16 = float.math.unary.f64 %0, "log1p"
  %17 = float.math.unary.f64 %1, "log1p"
  return %10, %11, %12, %13, %14, %15, %16, %17
}

// ====
vm.target<core> @vm

func.def target(@vm) @exponential_difference(%small: vector<2xbf16>, %single: f32, %wide: f64) -> (vector<2xbf16>, f32, f64) {
  %narrow = vector.expm1f %small : vector<2xbf16>
  %native = scalar.expm1f %single : f32
  %double_width = scalar.expm1f %wide : f64
  func.return %narrow, %native, %double_width : vector<2xbf16>, f32, f64
}

// ----
vm.target<core> @vm

low.func.def target<vm.core>(@vm) abi(vm_function) @exponential_difference(%0: reg<vm.value : bf16>, %1: reg<vm.value : bf16>, %single: reg<vm.value : f32>, %wide: reg<vm.value : f64>) -> (reg<vm.value : bf16>, reg<vm.value : bf16>, reg<vm.value : f32>, reg<vm.value : f64>) asm {
  %native = float.math.unary.f32 %single, "expm1"
  %double_width = float.math.unary.f64 %wide, "expm1"
  %10 = conversion.float.extend %0, "bf16.to.f32" : reg<vm.value : f32>
  %11 = float.math.unary.f32 %10, "expm1"
  %12 = conversion.float.truncate %11, "f32.to.bf16" : reg<vm.value : bf16>
  %13 = conversion.float.extend %1, "bf16.to.f32" : reg<vm.value : f32>
  %14 = float.math.unary.f32 %13, "expm1"
  %15 = conversion.float.truncate %14, "f32.to.bf16" : reg<vm.value : bf16>
  return %12, %15, %native, %double_width
}

// ====

vm.target<core> @vm

func.def target(@vm) @real_powers(%bases: vector<2xf16>, %exponents: vector<2xf16>, %single: f32, %wide: f64) -> (vector<2xf16>, f32, f64) {
  %narrow = vector.powf %bases, %exponents : vector<2xf16>
  %native = scalar.powf %single, %single : f32
  %double_width = scalar.powf %wide, %wide : f64
  func.return %narrow, %native, %double_width : vector<2xf16>, f32, f64
}

// ----
vm.target<core> @vm

low.func.def target<vm.core>(@vm) abi(vm_function) @real_powers(%0: reg<vm.value : f16>, %1: reg<vm.value : f16>, %2: reg<vm.value : f16>, %3: reg<vm.value : f16>, %single: reg<vm.value : f32>, %wide: reg<vm.value : f64>) -> (reg<vm.value : f16>, reg<vm.value : f16>, reg<vm.value : f32>, reg<vm.value : f64>) asm {
  %native = float.math.binary.f32 %single, %single, "pow"
  %double_width = float.math.binary.f64 %wide, %wide, "pow"
  %12 = conversion.float.extend %0, "f16.to.f32" : reg<vm.value : f32>
  %13 = conversion.float.extend %2, "f16.to.f32" : reg<vm.value : f32>
  %14 = float.math.binary.f32 %12, %13, "pow"
  %15 = conversion.float.truncate %14, "f32.to.f16" : reg<vm.value : f16>
  %16 = conversion.float.extend %1, "f16.to.f32" : reg<vm.value : f32>
  %17 = conversion.float.extend %3, "f16.to.f32" : reg<vm.value : f32>
  %18 = float.math.binary.f32 %16, %17, "pow"
  %19 = conversion.float.truncate %18, "f32.to.f16" : reg<vm.value : f16>
  return %15, %19, %native, %double_width
}

