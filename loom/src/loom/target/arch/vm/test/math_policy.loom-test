  %sinh = scalar.sinhf %value : f32
  %cosh = scalar.coshf %value : f32
  %tanh = scalar.tanhf %value : f32
  %asinh = scalar.asinhf %value : f32
  %acosh = scalar.acoshf %value : f32
  %atanh = scalar.atanhf %value : f32
  func.return %sinh, %cosh, %tanh, %asinh, %acosh, %atanh : f32, f32, f32, f32, f32, f32
}

