  // ERROR@+1: LOWERING/036 {op_name="scalar.sinf", phase_name="legalize-math", policy_name="vm-math", math_op="sinf", lane_domain="scalar", element_type="f32", constraint_key="math.recipe.afn_f32"}
  %result = scalar.sinf %value : f32
  func.return %result : f32
}

