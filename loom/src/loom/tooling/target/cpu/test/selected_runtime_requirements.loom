// Executable selection, not source-module membership, owns device services.
template.decl @identity(%condition: i1) -> (i1)

template.def<@identity> @identity_provider(%condition: i1) -> (i1) {
  template.return %condition : i1
}

kernel.def @clean() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch() {
  %condition = scalar.constant true : i1
  %result = template.apply<@identity>(%condition) : (i1) -> (i1)
  kernel.return
}

func.def @assertion_helper(%condition: i1) {
  sanitizer.assert.op %condition [ne(%condition, 0)] : i1
  func.return
}

template.decl @checked_identity(%condition: i1) -> (i1)

template.def<@checked_identity> @checked_provider(%condition: i1) -> (i1) {
  func.call @assertion_helper(%condition) : (i1)
  template.return %condition : i1
}

template.decl @nested_identity(%condition: i1) -> (i1)

template.def<@nested_identity> @nested_provider(%condition: i1) -> (i1) {
  %result = template.apply<@checked_identity>(%condition) : (i1) -> (i1)
  template.return %result : i1
}

kernel.def @requires_feedback() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch() {
  %condition = scalar.constant false : i1
  func.call @assertion_helper(%condition) : (i1)
  kernel.return
}

kernel.def @template_feedback() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch() {
  %condition = scalar.constant false : i1
  %result = template.apply<@nested_identity>(%condition) : (i1) -> (i1)
  kernel.return
}

kernel.def @direct_feedback() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch() {
  %condition = scalar.constant false : i1
  kernel.assert %condition : i1
  kernel.return
}

// This assertion belongs to a host oracle, not the HAL target. Unchecked
// benchmarking must neither run it nor provision a device feedback channel.
func.def @oracle_with_assertion() {
  %condition = scalar.constant false : i1
  func.call @assertion_helper(%condition) : (i1)
  func.return
}

command.program.def @clean_program() launch() {
  kernel.launch @clean() : ()
  command.return
}

command.program.def @feedback_program() launch() {
  kernel.launch @requires_feedback() : ()
  command.return
}

check.case @clean_case {
  kernel.launch @clean() : ()
  check.return
}

check.case @feedback_case {
  kernel.launch @requires_feedback() : ()
  check.return
}

check.scenario @clean_scenario {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    check.invoke<@clean_program>() : () -> ()
  }
  check.return
}

check.scenario @feedback_scenario {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    check.invoke<@feedback_program>() : () -> ()
  }
  check.return
}

check.scenario @host_oracle_scenario {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    check.compare<@clean, @oracle_with_assertion>() : () -> () {
    }
  }
  check.return
}

check.benchmark<@clean_case> @clean_kernel_latency

check.benchmark<@clean_case> @clean_kernel_alias_latency

check.benchmark<@feedback_case> @feedback_kernel_latency

check.benchmark<@clean_scenario> @clean_program_latency

check.benchmark<@clean_scenario> @clean_program_alias_latency

check.benchmark<@feedback_scenario> @feedback_program_latency

check.benchmark<@host_oracle_scenario> @host_oracle_latency
