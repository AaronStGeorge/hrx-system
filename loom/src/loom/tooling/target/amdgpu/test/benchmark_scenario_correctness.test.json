{
  "version": 1,
  "cases": [
    {
      "name": "native target differs from its independent VM oracle",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../testbench/testdata/benchmark_scenarios.loom", "--device=amdgpu", "--benchmark=@wrong_latency", "--output-format=jsonl", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "exit": {"nonzero": true},
      "stdout": {
        "contains": {"unordered": ["EXPECT/001", "\"sample_count\":1,\"failed_sample_count\":1"]},
        "not_contains": ["\"passed\":true", "\"operation_timing_ns\""]
      }
    },
    {
      "name": "native target agrees with its independent VM oracle",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../testbench/testdata/benchmark_scenarios.loom", "--device=amdgpu", "--benchmark=@right_latency", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "stdout": {
        "contains": {"unordered": ["\"state\":\"ok\"", "\"sample_count\":1,\"failed_sample_count\":0"]}
      }
    },
    {
      "name": "invoke-only trials reject unhandled device assertions before timing",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../testbench/testdata/benchmark_device_events.loom", "--device=amdgpu", "--sanitizer=ubsan", "--sanitizer-reporting=report-only", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "exit": {"nonzero": true},
      "stdout": {
        "contains": {"unordered": ["\"action\":\"invoke\"", "\"unhandled_error_count\":1", "\"sample_count\":1,\"failed_sample_count\":1"]},
        "not_contains": ["\"state\":\"ok\""]
      }
    }
  ]
}
