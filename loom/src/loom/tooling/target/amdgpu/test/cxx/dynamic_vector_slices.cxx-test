// RUN: emit source-low @sum_packets target=amdgpu:gfx1151 output=low

#include <loomcxx/kernel.h>
#include <loomcxx/vector.h>

using Values = unsigned __attribute__((ext_vector_type(16)));
using Packet = unsigned __attribute__((ext_vector_type(4)));

[[loom::config("dynamic_slice.packet_count")]] const unsigned packet_count = 4u;

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]] void sum_packets(const unsigned* input, Packet* output) {
  Values values = {input[0],  input[1],  input[2],  input[3],
                   input[4],  input[5],  input[6],  input[7],
                   input[8],  input[9],  input[10], input[11],
                   input[12], input[13], input[14], input[15]};
  Packet sum = {};
  [[loom::unroll]]
  for (unsigned index = 0; index < packet_count; ++index) {
    sum += loom::vector::slice<Packet>(values, index * 4u);
  }
  output[0] = sum;
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @sum_packets() asm {
  %input = resource<hal_binding> {extent = 64, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %332 = v_mov_b32 0
  %333 = global_load_b32_saddr %332, %input
  %335 = global_load_b32_saddr %332, %input {offset = 4}
  %337 = global_load_b32_saddr %332, %input {offset = 8}
  %339 = global_load_b32_saddr %332, %input {offset = 12}
  %341 = global_load_b32_saddr %332, %input {offset = 16}
  %343 = global_load_b32_saddr %332, %input {offset = 20}
  %345 = global_load_b32_saddr %332, %input {offset = 24}
  %347 = global_load_b32_saddr %332, %input {offset = 28}
  %349 = global_load_b32_saddr %332, %input {offset = 32}
  %351 = global_load_b32_saddr %332, %input {offset = 36}
  %353 = global_load_b32_saddr %332, %input {offset = 40}
  %355 = global_load_b32_saddr %332, %input {offset = 44}
  %357 = global_load_b32_saddr %332, %input {offset = 48}
  %359 = global_load_b32_saddr %332, %input {offset = 52}
  %361 = global_load_b32_saddr %332, %input {offset = 56}
  %363 = global_load_b32_saddr %332, %input {offset = 60}
  %368 = v_add_u32 %333, %341
  %371 = v_add_u32 %335, %343
  %374 = v_add_u32 %337, %345
  %377 = v_add_u32 %339, %347
  %382 = v_add_u32 %368, %349
  %385 = v_add_u32 %371, %351
  %388 = v_add_u32 %374, %353
  %391 = v_add_u32 %377, %355
  %396 = v_add_u32 %382, %357
  %399 = v_add_u32 %385, %359
  %402 = v_add_u32 %388, %361
  %405 = v_add_u32 %391, %363
  %sum_3 = concat(%396, %399, %402, %405) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %332, %sum_3, %output
  return
}
