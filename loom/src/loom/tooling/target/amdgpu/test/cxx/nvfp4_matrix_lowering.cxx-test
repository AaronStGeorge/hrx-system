  %360 = v_lshlrev_b32_src0_inline %359, 2
  %361 = v_lshrrev_b32_src0_inline %lane, 4
  %362 = v_lshl_add_u32_shift_imm %361, %360, 8
  %363 = slice %result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %362, %363, %output_view
  %364 = slice %result[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %362, %364, %output_view {offset = 64}
  %365 = slice %result[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %362, %365, %output_view {offset = 128}
  %366 = slice %result[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %362, %366, %output_view {offset = 192}
  return
}
