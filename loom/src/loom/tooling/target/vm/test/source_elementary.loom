func.def @inverse_trigonometry_f32(%y: f32, %x: f32) -> (f32, f32, f32, f32) {
  %asin = scalar.asinf %y : f32
  %acos = scalar.acosf %y : f32
  %atan = scalar.atanf %y : f32
  %atan2 = scalar.atan2f %y, %x : f32
  func.return %asin, %acos, %atan, %atan2 : f32, f32, f32, f32
}

check.case public @ordinary_inverse_trigonometry_f32 {
  %y = check.literal value(0.5) : f32
  %x = check.literal value(-0.75) : f32
  %asin, %acos, %atan, %atan2 = func.call @inverse_trigonometry_f32(%y, %x) : (f32, f32) -> (f32, f32, f32, f32)
