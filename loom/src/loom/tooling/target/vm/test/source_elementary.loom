// Ordinary source operations compile into direct VM math selectors. The same
// cases run before and after linking to Loom bytecode, without native imports.
func.def @power_f32(%base: f32, %exponent: f32) -> (f32) {
  %result = scalar.powf %base, %exponent : f32
  func.return %result : f32
}

func.def @power_f64(%base: f64, %exponent: f64) -> (f64) {
  %result = scalar.powf %base, %exponent : f64
  func.return %result : f64
}

func.def @exponential_difference_f64(%input: f64) -> (f64) {
  %result = scalar.expm1f %input : f64
  func.return %result : f64
}

func.def @exponential_difference_f32(%input: f32) -> (f32) {
  %result = scalar.expm1f %input : f32
  func.return %result : f32
}

func.def @elementary_f32(%value: f32) -> (f32, f32, f32, f32) {
  %root = scalar.sqrtf %value : f32
  %inverse = scalar.rsqrtf %value : f32
  %natural = scalar.expf %value : f32
  %base_two = scalar.exp2f %value : f32
  func.return %root, %inverse, %natural, %base_two : f32, f32, f32, f32
}

func.def @elementary_f64(%value: f64) -> (f64, f64, f64, f64) {
  %root = scalar.sqrtf %value : f64
  %inverse = scalar.rsqrtf %value : f64
  %natural = scalar.expf %value : f64
  %base_two = scalar.exp2f %value : f64
  func.return %root, %inverse, %natural, %base_two : f64, f64, f64, f64
}

func.def @logarithms_f32(%value: f32) -> (f32, f32, f32, f32) {
  %natural = scalar.logf %value : f32
  %base_two = scalar.log2f %value : f32
  %base_ten = scalar.log10f %value : f32
  %increment = scalar.log1pf %value : f32
  func.return %natural, %base_two, %base_ten, %increment : f32, f32, f32, f32
}

func.def @logarithms_f64(%value: f64) -> (f64, f64, f64, f64) {
  %natural = scalar.logf %value : f64
  %base_two = scalar.log2f %value : f64
  %base_ten = scalar.log10f %value : f64
  %increment = scalar.log1pf %value : f64
  func.return %natural, %base_two, %base_ten, %increment : f64, f64, f64, f64
}

check.case public @ordinary_f32 {
  %input = check.literal value(0.5) : f32
  %power = func.call @power_f32(%input, %input) : (f32, f32) -> (f32)
  %root, %inverse, %natural, %base_two = func.call @elementary_f32(%input) : (f32) -> (f32, f32, f32, f32)
  %sqrt_half = check.literal value(0.70710676908493042) : f32
  check.expect.approximate actual(%power) expected(%sqrt_half) atol(5.9604644775390625e-08) rtol(0.0) nan(different) : f32, f32
  %sqrt_two = check.literal value(1.4142135381698608) : f32
  %exp_half = check.literal value(1.6487212181091309) : f32
  check.expect.equal actual(%root) expected(%sqrt_half) : f32
  check.expect.approximate actual(%inverse) expected(%sqrt_two) atol(1.1999999999999999e-07) rtol(0.0) nan(different) : f32, f32
  check.expect.approximate actual(%natural) expected(%exp_half) atol(1.1999999999999999e-07) rtol(0.0) nan(different) : f32, f32
  check.expect.approximate actual(%base_two) expected(%sqrt_two) atol(1.1999999999999999e-07) rtol(0.0) nan(different) : f32, f32
  %log, %log2, %log10, %log1p = func.call @logarithms_f32(%input) : (f32) -> (f32, f32, f32, f32)
  %ln_half = check.literal value(-0.69314718246459961) : f32
  %minus_one = check.literal value(-1.0) : f32
  %log10_half = check.literal value(-0.30103000998497009) : f32
  %ln_one_half = check.literal value(0.40546509623527527) : f32
  check.expect.approximate actual(%log) expected(%ln_half) atol(5.9604644775390625e-08) rtol(0.0) nan(different) : f32, f32
  check.expect.equal actual(%log2) expected(%minus_one) : f32
  check.expect.approximate actual(%log10) expected(%log10_half) atol(5.9604644775390625e-08) rtol(0.0) nan(different) : f32, f32
  check.expect.approximate actual(%log1p) expected(%ln_one_half) atol(5.9604644775390625e-08) rtol(0.0) nan(different) : f32, f32
  %difference = func.call @exponential_difference_f32(%input) : (f32) -> (f32)
  %expected_difference = check.literal value(0.64872127771377563) : f32
  check.expect.approximate actual(%difference) expected(%expected_difference) atol(5.9604644775390625e-08) rtol(0.0) nan(different) : f32, f32
  check.return
}

check.case public @ordinary_f64 {
  %input = check.literal value(0.5) : f64
  %power = func.call @power_f64(%input, %input) : (f64, f64) -> (f64)
  %root, %inverse, %natural, %base_two = func.call @elementary_f64(%input) : (f64) -> (f64, f64, f64, f64)
  %sqrt_half = check.literal value(0.70710678118654757) : f64
  check.expect.approximate actual(%power) expected(%sqrt_half) atol(1.1102230246251565e-16) rtol(0.0) nan(different) : f64, f64
  %sqrt_two = check.literal value(1.4142135623730951) : f64
  %exp_half = check.literal value(1.6487212707001282) : f64
  check.expect.equal actual(%root) expected(%sqrt_half) : f64
  check.expect.approximate actual(%inverse) expected(%sqrt_two) atol(2.2999999999999999e-16) rtol(0.0) nan(different) : f64, f64
  check.expect.approximate actual(%natural) expected(%exp_half) atol(2.2999999999999999e-16) rtol(0.0) nan(different) : f64, f64
  check.expect.approximate actual(%base_two) expected(%sqrt_two) atol(2.2999999999999999e-16) rtol(0.0) nan(different) : f64, f64
  %log, %log2, %log10, %log1p = func.call @logarithms_f64(%input) : (f64) -> (f64, f64, f64, f64)
  %ln_half = check.literal value(-0.69314718055994529) : f64
  %minus_one = check.literal value(-1.0) : f64
  %log10_half = check.literal value(-0.3010299956639812) : f64
  %ln_one_half = check.literal value(0.40546510810816438) : f64
  check.expect.approximate actual(%log) expected(%ln_half) atol(1.1102230246251565e-16) rtol(0.0) nan(different) : f64, f64
  check.expect.equal actual(%log2) expected(%minus_one) : f64
  check.expect.approximate actual(%log10) expected(%log10_half) atol(1.1102230246251565e-16) rtol(0.0) nan(different) : f64, f64
  check.expect.approximate actual(%log1p) expected(%ln_one_half) atol(1.1102230246251565e-16) rtol(0.0) nan(different) : f64, f64
  %difference = func.call @exponential_difference_f64(%input) : (f64) -> (f64)
  %expected_difference = check.literal value(0.64872127070012819) : f64
  check.expect.approximate actual(%difference) expected(%expected_difference) atol(1.1102230246251565e-16) rtol(0.0) nan(different) : f64, f64
  check.return
}

func.def @hyperbolic_f32(%input: f32, %domain: f32) -> (f32, f32, f32, f32, f32, f32) {
  %sinh = scalar.sinhf %input : f32
  %cosh = scalar.coshf %input : f32
  %tanh = scalar.tanhf %input : f32
  %asinh = scalar.asinhf %input : f32
  %acosh = scalar.acoshf %domain : f32
  %atanh = scalar.atanhf %input : f32
  func.return %sinh, %cosh, %tanh, %asinh, %acosh, %atanh : f32, f32, f32, f32, f32, f32
}

check.case public @ordinary_hyperbolic_f32 {
  %input = check.literal value(0.5) : f32
  %domain = check.literal value(1.5) : f32
  %sinh, %cosh, %tanh, %asinh, %acosh, %atanh = func.call @hyperbolic_f32(%input, %domain) : (f32, f32) -> (f32, f32, f32, f32, f32, f32)
  %sinh_reference = check.literal value(0.52109527587890625) : f32
  check.expect.approximate actual(%sinh) expected(%sinh_reference) atol(0.0) rtol(1.1920928955078125e-07) nan(different) : f32, f32
  %cosh_reference = check.literal value(1.1276259422302246) : f32
  check.expect.approximate actual(%cosh) expected(%cosh_reference) atol(0.0) rtol(1.1920928955078125e-07) nan(different) : f32, f32
  %tanh_reference = check.literal value(0.46211716532707214) : f32
  check.expect.approximate actual(%tanh) expected(%tanh_reference) atol(0.0) rtol(1.1920928955078125e-07) nan(different) : f32, f32
  %asinh_reference = check.literal value(0.48121181130409241) : f32
  check.expect.approximate actual(%asinh) expected(%asinh_reference) atol(0.0) rtol(1.1920928955078125e-07) nan(different) : f32, f32
  %acosh_reference = check.literal value(0.96242362260818481) : f32
  check.expect.approximate actual(%acosh) expected(%acosh_reference) atol(0.0) rtol(1.1920928955078125e-07) nan(different) : f32, f32
  %atanh_reference = check.literal value(0.54930615425109863) : f32
  check.expect.approximate actual(%atanh) expected(%atanh_reference) atol(0.0) rtol(1.1920928955078125e-07) nan(different) : f32, f32
  check.return
}

func.def @hyperbolic_f64(%input: f64, %domain: f64) -> (f64, f64, f64, f64, f64, f64) {
  %sinh = scalar.sinhf %input : f64
  %cosh = scalar.coshf %input : f64
  %tanh = scalar.tanhf %input : f64
  %asinh = scalar.asinhf %input : f64
  %acosh = scalar.acoshf %domain : f64
  %atanh = scalar.atanhf %input : f64
  func.return %sinh, %cosh, %tanh, %asinh, %acosh, %atanh : f64, f64, f64, f64, f64, f64
}

check.case public @ordinary_hyperbolic_f64 {
  %input = check.literal value(0.5) : f64
  %domain = check.literal value(1.5) : f64
  %sinh, %cosh, %tanh, %asinh, %acosh, %atanh = func.call @hyperbolic_f64(%input, %domain) : (f64, f64) -> (f64, f64, f64, f64, f64, f64)
  %sinh_reference = check.literal value(0.52109530549374738) : f64
  check.expect.approximate actual(%sinh) expected(%sinh_reference) atol(0.0) rtol(2.2204460492503131e-16) nan(different) : f64, f64
  %cosh_reference = check.literal value(1.1276259652063807) : f64
  check.expect.approximate actual(%cosh) expected(%cosh_reference) atol(0.0) rtol(2.2204460492503131e-16) nan(different) : f64, f64
  %tanh_reference = check.literal value(0.46211715726000974) : f64
  check.expect.approximate actual(%tanh) expected(%tanh_reference) atol(0.0) rtol(2.2204460492503131e-16) nan(different) : f64, f64
  %asinh_reference = check.literal value(0.48121182505960347) : f64
  check.expect.approximate actual(%asinh) expected(%asinh_reference) atol(0.0) rtol(2.2204460492503131e-16) nan(different) : f64, f64
  %acosh_reference = check.literal value(0.96242365011920694) : f64
  check.expect.approximate actual(%acosh) expected(%acosh_reference) atol(0.0) rtol(2.2204460492503131e-16) nan(different) : f64, f64
  %atanh_reference = check.literal value(0.54930614433405489) : f64
  check.expect.approximate actual(%atanh) expected(%atanh_reference) atol(0.0) rtol(2.2204460492503131e-16) nan(different) : f64, f64
  check.return
}
