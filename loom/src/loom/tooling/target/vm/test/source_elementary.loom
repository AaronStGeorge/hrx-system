  %gelu_tanh_reference = check.literal value(-0.15428599715232849) : f32
  check.expect.approximate actual(%gelu_tanh) expected(%gelu_tanh_reference) atol(0.0) rtol(1.9999999999999999e-06) nan(different) : f32, f32
  %gelu_logistic_reference = check.literal value(-0.14961156249046326) : f32
  check.expect.approximate actual(%gelu_logistic) expected(%gelu_logistic_reference) atol(0.0) rtol(1.9999999999999999e-06) nan(different) : f32, f32
  check.return
}

func.def @activations_f64(%input: f64) -> (f64, f64, f64, f64, f64, f64) {
  %logistic = scalar.logisticf %input : f64
  %silu = scalar.siluf %input : f64
  %softplus = scalar.softplusf %input : f64
  %gelu_erf = scalar.geluf<erf> %input : f64
  %gelu_tanh = scalar.geluf<tanh> %input : f64
  %gelu_logistic = scalar.geluf<logistic> %input {scale = -0.125} : f64
  func.return %logistic, %silu, %softplus, %gelu_erf, %gelu_tanh, %gelu_logistic : f64, f64, f64, f64, f64, f64
}

check.case public @ordinary_activations_f64 {
  %input = check.literal value(-0.5) : f64
  %logistic, %silu, %softplus, %gelu_erf, %gelu_tanh, %gelu_logistic = func.call @activations_f64(%input) : (f64) -> (f64, f64, f64, f64, f64, f64)
  %logistic_reference = check.literal value(0.37754066879814546) : f64
  check.expect.approximate actual(%logistic) expected(%logistic_reference) atol(0.0) rtol(4.0000000000000003e-15) nan(different) : f64, f64
  %silu_reference = check.literal value(-0.18877033439907273) : f64
  check.expect.approximate actual(%silu) expected(%silu_reference) atol(0.0) rtol(4.0000000000000003e-15) nan(different) : f64, f64
  %softplus_reference = check.literal value(0.47407698418010669) : f64
  check.expect.approximate actual(%softplus) expected(%softplus_reference) atol(0.0) rtol(4.0000000000000003e-15) nan(different) : f64, f64
  %gelu_erf_reference = check.literal value(-0.15426876936299344) : f64
  check.expect.approximate actual(%gelu_erf) expected(%gelu_erf_reference) atol(0.0) rtol(4.0000000000000003e-15) nan(different) : f64, f64
  %gelu_tanh_reference = check.literal value(-0.15428599017485609) : f64
  check.expect.approximate actual(%gelu_tanh) expected(%gelu_tanh_reference) atol(0.0) rtol(4.0000000000000003e-15) nan(different) : f64, f64
  %gelu_logistic_reference = check.literal value(-0.25780995786150779) : f64
  check.expect.approximate actual(%gelu_logistic) expected(%gelu_logistic_reference) atol(0.0) rtol(4.0000000000000003e-15) nan(different) : f64, f64
  check.return
}

// The scale is an F64 attribute rounded directly to F32, not through F16.
func.def @narrow_scaled_gelu(%input: f16) -> (f16) {
  %result = scalar.geluf<logistic> %input {scale = 1.702} : f16
  func.return %result : f16
}

check.case public @ordinary_activations_narrow {
  %input = check.literal value(-5.0) : f16
  %result = func.call @narrow_scaled_gelu(%input) : (f16) -> (f16)
  %expected = check.literal value(-0.001007080078125) : f16
  check.expect.equal actual(%result) expected(%expected) : f16
  check.return
}

func.def @rounding_f32(%input: f32) -> (f32, f32, f32, f32, f32) {
  %ceil = scalar.ceilf %input : f32
  %floor = scalar.floorf %input : f32
  %trunc = scalar.truncf %input : f32
  %roundeven = scalar.roundevenf %input : f32
  %round = scalar.roundf %input : f32
  func.return %ceil, %floor, %trunc, %roundeven, %round : f32, f32, f32, f32, f32
}

check.case public @ordinary_rounding_f32 {
  %input = check.literal value(-2.5) : f32
  %ceil, %floor, %trunc, %roundeven, %round = func.call @rounding_f32(%input) : (f32) -> (f32, f32, f32, f32, f32)
  %toward_zero = check.literal value(-2.0) : f32
  %away = check.literal value(-3.0) : f32
  check.expect.bitwise actual(%ceil) expected(%toward_zero) : f32
  check.expect.bitwise actual(%floor) expected(%away) : f32
  check.expect.bitwise actual(%trunc) expected(%toward_zero) : f32
  check.expect.bitwise actual(%roundeven) expected(%toward_zero) : f32
  check.expect.bitwise actual(%round) expected(%away) : f32
  check.return
}

func.def @rounding_f64(%input: f64) -> (f64, f64, f64, f64, f64) {
  %ceil = scalar.ceilf %input : f64
  %floor = scalar.floorf %input : f64
  %trunc = scalar.truncf %input : f64
  %roundeven = scalar.roundevenf %input : f64
  %round = scalar.roundf %input : f64
  func.return %ceil, %floor, %trunc, %roundeven, %round : f64, f64, f64, f64, f64
}

check.case public @ordinary_rounding_f64 {
  %input = check.literal value(-2.5) : f64
  %ceil, %floor, %trunc, %roundeven, %round = func.call @rounding_f64(%input) : (f64) -> (f64, f64, f64, f64, f64)
  %toward_zero = check.literal value(-2.0) : f64
  %away = check.literal value(-3.0) : f64
  check.expect.bitwise actual(%ceil) expected(%toward_zero) : f64
  check.expect.bitwise actual(%floor) expected(%away) : f64
  check.expect.bitwise actual(%trunc) expected(%toward_zero) : f64
  check.expect.bitwise actual(%roundeven) expected(%toward_zero) : f64
  check.expect.bitwise actual(%round) expected(%away) : f64
  check.return
}

func.def @scaling_f32(%input: f32, %power: i32) -> (f32, i32, f32) {
  %fraction, %exponent = scalar.frexpf %input : f32, i32
  %scaled = scalar.ldexpf %input, %power : f32, i32
  func.return %fraction, %exponent, %scaled : f32, i32, f32
}

func.def @fraction_f32(%input: f32) -> (f32) {
  %fraction, %exponent = scalar.frexpf %input : f32, i32
  func.return %fraction : f32
}

func.def @exponent_f32(%input: f32) -> (i32) {
  %fraction, %exponent = scalar.frexpf %input : f32, i32
  func.return %exponent : i32
}

check.case public @ordinary_scaling_f32 {
  %input = check.literal value(-1.5) : f32
  %power = check.literal value(-2) : i32
  %fraction, %exponent, %scaled = func.call @scaling_f32(%input, %power) : (f32, i32) -> (f32, i32, f32)
  %fraction_only = func.call @fraction_f32(%input) : (f32) -> (f32)
  %exponent_only = func.call @exponent_f32(%input) : (f32) -> (i32)
  %expected_fraction = check.literal value(-0.75) : f32
  %expected_exponent = check.literal value(1) : i32
  %expected_scaled = check.literal value(-0.375) : f32
  check.expect.bitwise actual(%fraction) expected(%expected_fraction) : f32
  check.expect.equal actual(%exponent) expected(%expected_exponent) : i32
  check.expect.bitwise actual(%scaled) expected(%expected_scaled) : f32
  check.expect.bitwise actual(%fraction_only) expected(%expected_fraction) : f32
  check.expect.equal actual(%exponent_only) expected(%expected_exponent) : i32
  check.return
}

func.def @scaling_f64(%input: f64, %power: i32) -> (f64, i32, f64) {
  %fraction, %exponent = scalar.frexpf %input : f64, i32
  %scaled = scalar.ldexpf %input, %power : f64, i32
  func.return %fraction, %exponent, %scaled : f64, i32, f64
}

func.def @fraction_f64(%input: f64) -> (f64) {
  %fraction, %exponent = scalar.frexpf %input : f64, i32
  func.return %fraction : f64
}

func.def @exponent_f64(%input: f64) -> (i32) {
  %fraction, %exponent = scalar.frexpf %input : f64, i32
  func.return %exponent : i32
}

check.case public @ordinary_scaling_f64 {
  %input = check.literal value(-1.5) : f64
  %power = check.literal value(-2) : i32
  %fraction, %exponent, %scaled = func.call @scaling_f64(%input, %power) : (f64, i32) -> (f64, i32, f64)
  %fraction_only = func.call @fraction_f64(%input) : (f64) -> (f64)
  %exponent_only = func.call @exponent_f64(%input) : (f64) -> (i32)
  %expected_fraction = check.literal value(-0.75) : f64
  %expected_exponent = check.literal value(1) : i32
  %expected_scaled = check.literal value(-0.375) : f64
  check.expect.bitwise actual(%fraction) expected(%expected_fraction) : f64
  check.expect.equal actual(%exponent) expected(%expected_exponent) : i32
  check.expect.bitwise actual(%scaled) expected(%expected_scaled) : f64
  check.expect.bitwise actual(%fraction_only) expected(%expected_fraction) : f64
  check.expect.equal actual(%exponent_only) expected(%expected_exponent) : i32
  check.return
}
