func.def @activations_f32(%input: f32) -> (f32, f32, f32, f32, f32, f32) {
  %logistic = scalar.logisticf %input : f32
  %silu = scalar.siluf %input : f32
  %softplus = scalar.softplusf %input : f32
  %gelu_erf = scalar.geluf<erf> %input : f32
  %gelu_tanh = scalar.geluf<tanh> %input : f32
  %gelu_logistic = scalar.geluf<logistic> %input {scale = 1.702} : f32
  func.return %logistic, %silu, %softplus, %gelu_erf, %gelu_tanh, %gelu_logistic : f32, f32, f32, f32, f32, f32
}

