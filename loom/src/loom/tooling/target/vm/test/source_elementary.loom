func.def @trigonometry_f32(%input: f32) -> (f32, f32, f32, f32, f32) {
  %sin = scalar.sinf %input : f32
  %cos = scalar.cosf %input : f32
  %tan = scalar.tanf %input : f32
  %sinturns = scalar.sinturnsf %input : f32
  %costurns = scalar.costurnsf %input : f32
  func.return %sin, %cos, %tan, %sinturns, %costurns : f32, f32, f32, f32, f32
}

