// RUN: pass canonicalize,cse,dce
#include <loomcxx/buffer.h>

const unsigned char* raw() { return loom::buffer::constant<16>("a\0\xff"); }
const unsigned char* text() { return loom::buffer::constant(u8"café 🧵"); }
const unsigned char* empty() { return loom::buffer::constant(""); }
const unsigned char* zero() { return loom::buffer::constant(u8"\0"); }

// ----
func.def public @raw() -> (buffer, offset) {
  %2 = buffer.constant align(16) bytes("6100ff") : buffer
  %3 = index.constant 0 : offset
  func.return %2, %3 : buffer, offset
}

func.def public @text() -> (buffer, offset) {
  %6 = buffer.constant align(1) utf8("café 🧵") : buffer
  %7 = index.constant 0 : offset
  func.return %6, %7 : buffer, offset
}

func.def public @empty() -> (buffer, offset) {
  %10 = buffer.constant align(1) bytes("") : buffer
  %11 = index.constant 0 : offset
  func.return %10, %11 : buffer, offset
}

func.def public @zero() -> (buffer, offset) {
  %14 = buffer.constant align(1) utf8("\u0000") : buffer
  %15 = index.constant 0 : offset
  func.return %14, %15 : buffer, offset
}

// ====
// RUN: pass canonicalize,cse,dce
#include <loomcxx/buffer.h>
unsigned initialized(unsigned position, unsigned replacement) {
  auto* first = loom::buffer::alloca_init<loom::memory_space::private_, 8>("abcd");
  auto* second = loom::buffer::alloca_init<loom::memory_space::private_, 8>("abcd");
  first[position] = replacement;
  return first[position] + second[position];
}

// ----
func.def public @initialized(%position: i32, %replacement: i32) -> (i32) {
  %first = buffer.alloca.init<private> align(8) bytes("61626364") : buffer
  %second = buffer.alloca.init<private> align(8) bytes("61626364") : buffer
  %7 = scalar.trunci %replacement : i32 to i8
  %8 = scalar.extui %position : i32 to i64
  %13 = scalar.assume %8 [range(%8, 0, 9223372036854775807)] : i64
  %14 = index.cast %13 : i64 to offset
  %15 = index.assume %14 [range(%14, 0, 3)] : offset
  %16 = buffer.view %first[%15] : buffer -> view<1xi8>
  view.store %7, %16[0] : i8, view<1xi8>
  %26 = view.load %16[0] : view<1xi8> -> i8
  %27 = scalar.extui %26 : i8 to i32
  %36 = buffer.view %second[%15] : buffer -> view<1xi8>
  %37 = view.load %36[0] : view<1xi8> -> i8
  %38 = scalar.extui %37 : i8 to i32
  %39 = scalar.addi %27, %38 : i32
  func.return %39 : i32
}

// ====
// RUN: verify
#include <loomcxx/buffer.h>
const unsigned char* dynamic() {
  const char input[] = "abc";
  // ERROR@+1: LOWERING/059 "buffer payload requires a string literal"
  return loom::buffer::constant(input);
}

// ====
// RUN: verify
#include <loomcxx/buffer.h>
const unsigned char* invalid_utf8() {
  // ERROR@+1: LOWERING/059 "utf8 buffer payload must be valid UTF-8"
  return loom::buffer::constant(u8"\xff");
}

// ====
// RUN: verify
#include <loomcxx/buffer.h>
const unsigned char* alignment() {
  // ERROR@+1: LOWERING/059 "buffer.constant alignment must be a positive power-of-two byte count"
  return loom::buffer::constant<3>("abcd");
}

// ====
// RUN: verify
#include <loomcxx/buffer.h>
unsigned char* readonly_space() {
  // ERROR@+1: LOWERING/059 "buffer.alloca.init requires an allocatable memory space: global, workgroup, private, host, or generic"
  return loom::buffer::alloca_init<loom::memory_space::constant>("abcd");
}

// ====
// INPUT: cxx std=c++17
// RUN: pass canonicalize,cse,dce
#include <loomcxx/buffer.h>
const unsigned char* compatibility() { return loom::buffer::constant("abc"); }

// ----
func.def public @compatibility() -> (buffer, offset) {
  %2 = buffer.constant align(1) bytes("616263") : buffer
  %3 = index.constant 0 : offset
  func.return %2, %3 : buffer, offset
}

// ====
// RUN: pass kernel-synchronization-legality
#include <loomcxx/buffer.h>
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(4, 1, 1)]]
void divergent() {
  if (static_cast<unsigned>(loom::kernel::workitem::id.x) != 0) {
    // ERROR@+1: STRUCTURE/038 "buffer.alloca.init" "workgroup"
    auto* shared = loom::buffer::alloca_init<loom::memory_space::workgroup>("abc");
  }
}
