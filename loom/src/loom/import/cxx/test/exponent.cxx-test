// RUN: roundtrip
#include <loomcxx/scalar.h>

double scale(double value, int exponent) {
  return loom::scalar::ldexpf(value, exponent);
}

loom::scalar::frexpf_result<double> decompose(double value) {
  return loom::scalar::frexpf(value);
}

template <class Float>
int exponent(Float value) {
  return loom::scalar::frexpf(value).exponent;
}
int half(_Float16 value) { return exponent(value); }
int bfloat(__bf16 value) { return exponent(value); }
int single(float value) { return exponent(value); }
int e4m3(__float8_e4m3fn value) { return exponent(value); }
int e5m2(__float8_e5m2 value) { return exponent(value); }

// ----
func.def public @scale(%value: f64, %exponent: i32) -> (f64) {
  %3 = scalar.ldexpf %value, %exponent : f64, i32
  func.return %3 : f64
}

func.def public @decompose(%value: f64) -> (f64, i32) {
  %7, %8 = scalar.frexpf %value : f64, i32
  func.return %7, %8 : f64, i32
}

func.def public @half(%value: f16) -> (i32) {
  %11 = func.call pure @exponent__Float16(%value) : (f16) -> (i32)
  func.return %11 : i32
}

func.def public @bfloat(%value: bf16) -> (i32) {
  %14 = func.call pure @exponent___bf16(%value) : (bf16) -> (i32)
  func.return %14 : i32
}

func.def public @single(%value: f32) -> (i32) {
  %17 = func.call pure @exponent_float(%value) : (f32) -> (i32)
  func.return %17 : i32
}

func.def public @e4m3(%value: f8E4M3) -> (i32) {
  %20 = func.call pure @exponent___float8_e4m3fn(%value) : (f8E4M3) -> (i32)
  func.return %20 : i32
}

func.def public @e5m2(%value: f8E5M2) -> (i32) {
  %23 = func.call pure @exponent___float8_e5m2(%value) : (f8E5M2) -> (i32)
  func.return %23 : i32
}

func.def @exponent__Float16(%value: f16) -> (i32) {
  %26, %27 = scalar.frexpf %value : f16, i32
  func.return %27 : i32
}

func.def @exponent___bf16(%value: bf16) -> (i32) {
  %30, %31 = scalar.frexpf %value : bf16, i32
  func.return %31 : i32
}

func.def @exponent_float(%value: f32) -> (i32) {
  %34, %35 = scalar.frexpf %value : f32, i32
  func.return %35 : i32
}

func.def @exponent___float8_e4m3fn(%value: f8E4M3) -> (i32) {
  %38, %39 = scalar.frexpf %value : f8E4M3, i32
  func.return %39 : i32
}

func.def @exponent___float8_e5m2(%value: f8E5M2) -> (i32) {
  %42, %43 = scalar.frexpf %value : f8E5M2, i32
  func.return %43 : i32
}

// ====
// RUN: roundtrip
double builtin(double value, int power, int* exponent) {
  return __builtin_ldexp(__builtin_frexp(value, exponent), power);
}
float builtin_float(float value, int power, int* exponent) {
  return __builtin_ldexpf(__builtin_frexpf(value, exponent), power);
}
void exponent_only(double value, int* exponent) {
  __builtin_frexp(value, exponent);
}

// ----
func.def public @builtin(%value: f64, %power: i32, %exponent: buffer, %exponent_byte_offset: offset) -> (f64) {
  %5, %6 = scalar.frexpf %value : f64, i32
  %7 = buffer.view %exponent[%exponent_byte_offset] : buffer -> view<1xi32>
  view.store %6, %7[0] : i32, view<1xi32>
  %8 = scalar.ldexpf %5, %power : f64, i32
  func.return %8 : f64
}

func.def public @builtin_float(%value: f32, %power: i32, %exponent: buffer, %exponent_byte_offset: offset) -> (f32) {
  %14, %15 = scalar.frexpf %value : f32, i32
  %16 = buffer.view %exponent[%exponent_byte_offset] : buffer -> view<1xi32>
  view.store %15, %16[0] : i32, view<1xi32>
  %17 = scalar.ldexpf %14, %power : f32, i32
  func.return %17 : f32
}

func.def public @exponent_only(%value: f64, %exponent: buffer, %exponent_byte_offset: offset) {
  %21, %22 = scalar.frexpf %value : f64, i32
  %23 = buffer.view %exponent[%exponent_byte_offset] : buffer -> view<1xi32>
  view.store %22, %23[0] : i32, view<1xi32>
  func.return
}

// ====
// RUN: verify
// ERROR@+1: LOWERING/059 "fixed i32 intrinsic fields must be signed 32-bit integers"
[[loom::op("scalar.ldexpf")]] float scale(float, unsigned);

// ====
// RUN: verify
struct WrongExponent {
  // Floating result remains correctly typed.
  float fraction;
  // Intentionally invalid exponent width.
  short exponent;
};
// ERROR@+1: LOWERING/059 "fixed i32 intrinsic fields must be signed 32-bit integers"
[[loom::op("scalar.frexpf")]] WrongExponent decompose(float);

// ====
// RUN: verify
// ERROR@+1: LOWERING/059 "intrinsic result must be a record with one member per result"
[[loom::op("scalar.frexpf")]] float decompose(float);

// ====
// RUN: verify
struct Nested {
  struct Fraction {
    // Nested scalar must not masquerade as a direct result member.
    float value;
  };
  // Intentionally invalid nested result.
  Fraction fraction;
  // Correct exponent type isolates the structural diagnostic.
  int exponent;
};
// ERROR@+1: LOWERING/059 "intrinsic result members must be scalar values"
[[loom::op("scalar.frexpf")]] Nested decompose(float);

// ====
// RUN: verify
struct Pair {
  // Intentionally differs from the operand type.
  double fraction;
  // Fixed signed exponent.
  int exponent;
};
// ERROR@+1: LOWERING/059 "intrinsic operands must have the result's type"
[[loom::op("scalar.frexpf")]] Pair decompose(float);

// ====
// RUN: verify
double unsupported(double value, int* exponent) {
  // ERROR@+1: LOWERING/059 "unsupported C++ type: long double"
  return __builtin_frexpl(value, exponent);
}
