    %6 = scalar.constant 0 : i32
    %7 = scalar.cmpi ne, %second, %6 : i32
    scf.if %7 {
      %8 = scalar.constant 1 : i32
      %9 = scalar.constant 1 : i1
      func.exit %9 : i1 {
        func.return %8 : i32
      }
    }
    %first = scalar.constant 2 : i32
    scf.yield %first : i32
  } else {
    scf.yield %first$0 : i32
  }
  %11 = scalar.addi %first$5, %second : i32
  func.return %11 : i32
}

// ====
// Switch clauses may return while ordinary clauses reach the shared tail.
int classify(int value) {
  switch (value) {
    case 1: return 4;
    case 2: value += 3; break;
    default: return -1;
  }
  return value;
}

