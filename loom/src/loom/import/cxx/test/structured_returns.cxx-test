    %8 = scalar.constant 0 : i32
    %9 = scalar.cmpi eq, %count$7, %8 : i32
    %count$10 = scf.if %9 -> (i32) {
      %11 = scalar.constant 1 : i1
      func.exit %11 : i1 {
