// ====
// Aggregate return values cross the exit without an inactive placeholder.
struct Result {
  unsigned index;
  float value;
};
Result find_result(const float* values, unsigned count) {
  for (unsigned index = 0; index < count; ++index) {
    if (values[index] != 0.0f) return {index, values[index]};
  }
  return {~0u, 0.0f};
}

