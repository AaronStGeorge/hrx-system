    %10 = scalar.extsi %9 : i32 to i64
    %11 = scalar.constant 8 : i64
    %12 = scalar.muli %10, %11 : i64
    %13 = index.cast %values_byte_offset : offset to i64
    %14 = scalar.addi %13, %12 : i64
    %15 = scalar.assume %14 [range(%14, 0, 9223372036854775807)] : i64
    %16 = index.cast %15 : i64 to offset
    %17 = buffer.view %values[%16] : buffer -> view<1xf64>
    %18 = view.load %17[0] : view<1xf64> -> f64
    %19 = scalar.constant 0.0 : f64
    %20 = scalar.cmpf olt, %18, %19 : f64
    scf.if %20 {
      %21 = scalar.constant 1 : i1
      func.exit %21 : i1 {
        func.return %9 : i32
      }
    }
  }
  %22 = scalar.constant 1 : i32
  %23 = scalar.constant 0 : i32
  %24 = scalar.subi %23, %22 : i32
  func.return %24 : i32
}

// ====
// Post-test loops preserve a taken exit and the mutated fallthrough value.
int post_test(int value) {
  do {
    if (value == 0) return 7;
    --value;
  } while (value > 0);
  return value;
}

