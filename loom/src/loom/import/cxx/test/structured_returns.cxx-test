      %7 = scalar.constant 7 : i32
      %8 = scalar.constant 1 : i1
      func.exit %8 : i1 {
        func.return %7 : i32
      }
    }
    %9 = scalar.constant 1 : i32
    %value$10 = scalar.subi %value$2, %9 : i32
    %11 = scalar.constant 0 : i32
    %12 = scalar.cmpi sgt, %value$10, %11 : i32
    scf.condition %12, %value$10 : i1, i32
  } do(%value: i32) {
    scf.yield %value : i32
  }
  func.return %value$4 : i32
}

// ====
// Void runtime functions carry an empty return through structured control.
void stop(unsigned count) {
  while (count) {
    if (--count == 0u) return;
  }
}

