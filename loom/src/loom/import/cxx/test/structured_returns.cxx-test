// ====
// Kernel exits use the enclosing kernel's return contract.
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void first_nonzero(const unsigned* input, unsigned* output, unsigned count) {
  for (unsigned index = 0; index < count; ++index) {
    if (input[index] != 0u) {
      output[0] = index;
      return;
    }
  }
  output[0] = ~0u;
}

