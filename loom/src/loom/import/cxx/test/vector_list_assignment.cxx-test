// RUN: roundtrip
using Int4 = int __attribute__((ext_vector_type(4)));
void entry(Int4* output, int first) { *output = {first, 1, 2, 3}; }

// ----
func.def public @entry(%output: buffer, %output_byte_offset: offset, %first: i32) {
  %3 = vector.constanti [0, 1, 2, 3] : vector<4xi32>
  %4 = vector.insert %first into %3[0] : i32, vector<4xi32>
  %5 = buffer.view %output[%output_byte_offset] : buffer -> view<4xi32>
  vector.store %4, %5[0] : vector<4xi32>, view<4xi32>
  func.return
}

// ====
using Int4 = int __attribute__((ext_vector_type(4)));
Int4 entry(int first) {
  Int4 result{11, 12, 13, 14};
  result = {first};
  return result;
}

// ----
func.def public @entry(%first: i32) -> (vector<4xi32>) {
  %result$2 = vector.constanti [11, 12, 13, 14] : vector<4xi32>
  %3 = scalar.constant 0 : i32
  %result$4 = vector.from_elements %first, %3, %3, %3 : vector<4xi32>
  func.return %result$4 : vector<4xi32>
}

// ====
using Int4 = int __attribute__((ext_vector_type(4)));
struct State {
  // The vector member is updated as a value projection.
  Int4 value;
};
Int4 entry(int first) {
  State state{};
  state.value = {first, 9};
  return state.value;
}

// ----
func.def public @entry(%first: i32) -> (vector<4xi32>) {
  %state_value$2 = vector.constanti [0, 0, 0, 0] : vector<4xi32>
  %3 = vector.constanti [0, 9, 0, 0] : vector<4xi32>
  %state_value$4 = vector.insert %first into %3[0] : i32, vector<4xi32>
  func.return %state_value$4 : vector<4xi32>
}

// ====
using UInt4 = unsigned __attribute__((vector_size(16)));
void entry(volatile UInt4* output) { *output = {}; }

// ----
func.def public @entry(%output: buffer, %output_byte_offset: offset) {
  %2 = vector.constanti [0, 0, 0, 0] : vector<4xi32>
  %3 = buffer.view %output[%output_byte_offset] : buffer -> view<4xi32>
  vector.store<volatile> %2, %3[0] : vector<4xi32>, view<4xi32>
  func.return
}

// ====
using Int4 = int __attribute__((ext_vector_type(4)));
static constexpr Int4 first_two(int first, int second) {
  Int4 value{};
  value = {first, second};
  return value;
}
static constexpr Int4 identity(Int4 value) { return value; }
static constexpr int sum(Int4 value) {
  return value[0] + value[1] + value[2] + value[3];
}
static_assert(sum({1, 2, 3, 4}) == 10);
static_assert(sum({7}) == 7);
static_assert(sum({}) == 0);
static_assert(first_two(7, 9)[3] == 0);
Int4 entry(int first) { return identity({first, 9}); }

// ----
func.def public @entry(%first: i32) -> (vector<4xi32>) {
  %2 = vector.constanti [0, 9, 0, 0] : vector<4xi32>
  %3 = vector.insert %first into %2[0] : i32, vector<4xi32>
  %4 = func.call pure @identity(%3) : (vector<4xi32>) -> (vector<4xi32>)
  func.return %4 : vector<4xi32>
}

func.def @identity(%value: vector<4xi32>) -> (vector<4xi32>) {
  func.return %value : vector<4xi32>
}

// ====
using Int4 = int __attribute__((ext_vector_type(4)));
using Float4 = float __attribute__((ext_vector_type(4)));
static constexpr int choose(Int4 value) { return 1; }
static constexpr int choose(Float4 value) { return 2; }
static_assert(choose({1, 2, 3, 4}) == 1);
static_assert(choose({1.0f, 2.0f, 3.0f, 4.0f}) == 2);
int entry() { return choose({1, 2, 3, 4}); }

// ----
func.def public @entry() -> (i32) {
  %1 = vector.constanti [1, 2, 3, 4] : vector<4xi32>
  %2 = func.call pure @choose(%1) : (vector<4xi32>) -> (i32)
  func.return %2 : i32
}

func.def @choose(%value: vector<4xi32>) -> (i32) {
  %5 = scalar.constant 1 : i32
  func.return %5 : i32
}
