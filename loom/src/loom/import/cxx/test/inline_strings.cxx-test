// RUN: pass canonicalize,cse,dce
// Every literal retains its source code units and terminator.
const char* empty() { return ""; }
const char* ordinary() { return "Loom"; }
const char* concatenated() { return "one" " two"; }
const char* raw() { return R"(one\two)"; }
const char* embedded_nul() { return "a\0b"; }
const char* binary() { return "\xff"; }
const char8_t* unicode() { return u8"café 🧵"; }
const char8_t* binary_utf8() { return u8"\xff"; }
const char16_t* utf16() { return u"L\U0001F9F5"; }
const char32_t* utf32() { return U"L\U0001F9F5"; }
const wchar_t* wide() { return L"Loom"; }

// ----
func.def public @empty() -> (buffer, offset) {
  %2 = buffer.constant align(1) utf8("\u0000") : buffer
  %3 = index.constant 0 : offset
  func.return %2, %3 : buffer, offset
}

func.def public @ordinary() -> (buffer, offset) {
  %7 = buffer.constant align(1) utf8("Loom\u0000") : buffer
  %8 = index.constant 0 : offset
  func.return %7, %8 : buffer, offset
}

func.def public @concatenated() -> (buffer, offset) {
  %12 = buffer.constant align(1) utf8("one two\u0000") : buffer
  %13 = index.constant 0 : offset
  func.return %12, %13 : buffer, offset
}

func.def public @raw() -> (buffer, offset) {
  %17 = buffer.constant align(1) utf8("one\\two\u0000") : buffer
  %18 = index.constant 0 : offset
  func.return %17, %18 : buffer, offset
}

func.def public @embedded_nul() -> (buffer, offset) {
  %22 = buffer.constant align(1) utf8("a\u0000b\u0000") : buffer
  %23 = index.constant 0 : offset
  func.return %22, %23 : buffer, offset
}

func.def public @binary() -> (buffer, offset) {
  %27 = buffer.constant align(1) bytes("ff00") : buffer
  %28 = index.constant 0 : offset
  func.return %27, %28 : buffer, offset
}

func.def public @unicode() -> (buffer, offset) {
  %32 = buffer.constant align(1) utf8("café 🧵\u0000") : buffer
  %33 = index.constant 0 : offset
  func.return %32, %33 : buffer, offset
}

func.def public @binary_utf8() -> (buffer, offset) {
  %37 = buffer.constant align(1) bytes("ff00") : buffer
  %38 = index.constant 0 : offset
  func.return %37, %38 : buffer, offset
}

func.def public @utf16() -> (buffer, offset) {
  %42 = buffer.constant align(2) bytes("4c003ed8f5dd0000") : buffer
  %43 = index.constant 0 : offset
  func.return %42, %43 : buffer, offset
}

func.def public @utf32() -> (buffer, offset) {
  %47 = buffer.constant align(4) bytes("4c000000f5f9010000000000") : buffer
  %48 = index.constant 0 : offset
  func.return %47, %48 : buffer, offset
}

func.def public @wide() -> (buffer, offset) {
  %52 = buffer.constant align(4) bytes("4c0000006f0000006f0000006d00000000000000") : buffer
  %53 = index.constant 0 : offset
  func.return %52, %53 : buffer, offset
}

// ====
// RUN: pass canonicalize,cse,dce
// INPUT: cxx data-model=llp64
const wchar_t* wide_windows() { return L"L\uffff"; }
unsigned wide_load(unsigned position) { return L"\uffffL"[position % 3u]; }

// ----
func.def public @wide_windows() -> (buffer, offset) {
  %2 = buffer.constant align(2) bytes("4c00ffff0000") : buffer
  %3 = index.constant 0 : offset
  func.return %2, %3 : buffer, offset
}

func.def public @wide_load(%position: i32) -> (i32) {
  %7 = buffer.constant align(2) bytes("ffff4c000000") : buffer
  %8 = index.constant 0 : offset
  %9 = buffer.view %7[%8] : buffer -> view<3xi16>
  %10 = scalar.constant 3 : i32
  %11 = scalar.remui %position, %10 : i32
  %12 = scalar.extui %11 : i32 to i64
  %13 = scalar.assume %12 [range(%12, 0, 2)] : i64
  %14 = index.cast %13 : i64 to index
  %15 = view.load %9[%14] : view<3xi16> -> i16
  %16 = scalar.extui %15 : i16 to i32
  func.return %16 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Array references and pointers to the whole literal preserve its extent.
unsigned references(unsigned position) {
  const auto& text = "abc";
  auto* whole = &"def";
  return static_cast<unsigned char>(text[position & 3u]) +
         static_cast<unsigned char>((*whole)[position & 3u]);
}

// ----
func.def public @references(%position: i32) -> (i32) {
  %2 = buffer.constant align(1) utf8("abc\u0000") : buffer
  %3 = index.constant 0 : offset
  %4 = buffer.view %2[%3] : buffer -> view<4xi8>
  %whole = buffer.constant align(1) utf8("def\u0000") : buffer
  %7 = buffer.view %whole[%3] : buffer -> view<4xi8>
  %8 = scalar.constant 3 : i32
  %9 = scalar.andi %position, %8 : i32
  %10 = scalar.extui %9 : i32 to i64
  %11 = scalar.assume %10 [range(%10, 0, 3)] : i64
  %12 = index.cast %11 : i64 to index
  %13 = view.load %4[%12] : view<4xi8> -> i8
  %14 = scalar.extui %13 : i8 to i32
  %20 = view.load %7[%12] : view<4xi8> -> i8
  %21 = scalar.extui %20 : i8 to i32
  %22 = scalar.addi %14, %21 : i32
  func.return %22 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
unsigned writable(unsigned position, unsigned replacement) {
  alignas(16) char first[8] = "abc";
  const char second[8] = {"abc"};
  first[position & 7u] = replacement;
  return static_cast<unsigned char>(first[position & 7u]) +
         256u * static_cast<unsigned char>(second[position & 7u]);
}

// ----
func.def public @writable(%position: i32, %replacement: i32) -> (i32) {
  %first_storage = buffer.alloca.init<private> align(16) utf8("abc\u0000\u0000\u0000\u0000\u0000") : buffer
  %first_storage_byte_offset = index.constant 0 : offset
  %first_view = buffer.view %first_storage[%first_storage_byte_offset] : buffer -> view<8xi8>
  %second_storage = buffer.alloca.init<private> align(1) utf8("abc\u0000\u0000\u0000\u0000\u0000") : buffer
  %second_view = buffer.view %second_storage[%first_storage_byte_offset] : buffer -> view<8xi8>
  %9 = scalar.trunci %replacement : i32 to i8
  %10 = scalar.constant 7 : i32
  %11 = scalar.andi %position, %10 : i32
  %12 = scalar.extui %11 : i32 to i64
  %13 = scalar.assume %12 [range(%12, 0, 7)] : i64
  %14 = index.cast %13 : i64 to index
  view.store %9, %first_view[%14] : i8, view<8xi8>
  %20 = view.load %first_view[%14] : view<8xi8> -> i8
  %21 = scalar.extui %20 : i8 to i32
  %28 = view.load %second_view[%14] : view<8xi8> -> i8
  %29 = scalar.extui %28 : i8 to i32
  %32 = scalar.constant 8 : i32
  %33 = scalar.shli %29, %32 : i32
  %31 = scalar.addi %21, %33 : i32
  func.return %31 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
unsigned nested(unsigned row, unsigned position) {
  struct Record { char label[4]; unsigned value; };
  Record record = {"abc", 7};
  char nested[2][4] = {"def", "ghi"};
  return static_cast<unsigned char>(record.label[position & 3u]) +
         static_cast<unsigned char>(nested[row & 1u][position & 3u]) + record.value;
}

// ----
func.def public @nested(%row: i32, %position: i32) -> (i32) {
  %3 = index.constant 8 : offset
  %record_storage = buffer.alloca<private> align(4) %3 : buffer
  %81 = index.constant 0 : offset
  %9 = buffer.constant align(4) utf8("abc\u0000") : buffer
  %11 = index.constant 4 : offset
  buffer.copy %9[%81], %record_storage[%81], %11
  %14 = scalar.constant 7 : i32
  %16 = buffer.view %record_storage[%11] : buffer -> view<1xi32>
  view.store %14, %16[0] : i32, view<1xi32>
  %nested_storage = buffer.alloca<private> align(1) %3 : buffer
  %21 = buffer.constant align(1) utf8("def\u0000") : buffer
  buffer.copy %21[%81], %nested_storage[%81], %11
  %26 = buffer.constant align(1) utf8("ghi\u0000") : buffer
  buffer.copy %26[%81], %nested_storage[%11], %11
  %31 = scalar.constant 3 : i32
  %32 = scalar.andi %position, %31 : i32
  %33 = scalar.extui %32 : i32 to i64
  %38 = scalar.assume %33 [range(%33, 0, 9223372036854775807)] : i64
  %39 = index.cast %38 : i64 to offset
  %40 = index.assume %39 [range(%39, 0, 7)] : offset
  %41 = buffer.view %record_storage[%40] : buffer -> view<1xi8>
  %42 = view.load %41[0] : view<1xi8> -> i8
  %43 = scalar.extui %42 : i8 to i32
  %44 = scalar.constant 1 : i32
  %45 = scalar.andi %row, %44 : i32
  %76 = scalar.constant 2 : i32
  %77 = scalar.shli %45, %76 : i32
  %78 = scalar.extui %77 : i32 to i64
  %51 = scalar.assume %78 [range(%78, 0, 9223372036854775807)] : i64
  %52 = index.cast %51 : i64 to offset
  %58 = index.cast %52 : offset to i64
  %59 = scalar.addi %58, %38 : i64
  %60 = scalar.assume %59 [range(%59, 0, 9223372036854775807)] : i64
  %61 = index.cast %60 : i64 to offset
  %62 = index.assume %61 [range(%61, 0, 7)] : offset
  %63 = buffer.view %nested_storage[%62] : buffer -> view<1xi8>
  %64 = view.load %63[0] : view<1xi8> -> i8
  %65 = scalar.extui %64 : i8 to i32
  %66 = scalar.addi %43, %65 : i32
  %value = view.load %16[0] : view<1xi32> -> i32
  %72 = scalar.addi %66, %value : i32
  func.return %72 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
unsigned volatile_string(unsigned position) {
  volatile char text[3] = "ab";
  return static_cast<unsigned char>(text[position % 3u]);
}

// ----
func.def public @volatile_string(%position: i32) -> (i32) {
  %2 = index.constant 3 : offset
  %text_storage = buffer.alloca<private> align(1) %2 : buffer
  %text_storage_byte_offset = index.constant 0 : offset
  %text_view = buffer.view %text_storage[%text_storage_byte_offset] : buffer -> view<3xi8>
  %6 = scalar.constant 97 : i8
  %8 = buffer.view %text_storage[%text_storage_byte_offset] : buffer -> view<1xi8>
  view.store<volatile> %6, %8[0] : i8, view<1xi8>
  %9 = scalar.constant 98 : i8
  %27 = index.constant 1 : offset
  %13 = buffer.view %text_storage[%27] : buffer -> view<1xi8>
  view.store<volatile> %9, %13[0] : i8, view<1xi8>
  %14 = scalar.constant 0 : i8
  %26 = index.constant 2 : offset
  %18 = buffer.view %text_storage[%26] : buffer -> view<1xi8>
  view.store<volatile> %14, %18[0] : i8, view<1xi8>
  %19 = scalar.constant 3 : i32
  %20 = scalar.remui %position, %19 : i32
  %21 = scalar.extui %20 : i32 to i64
  %22 = scalar.assume %21 [range(%21, 0, 2)] : i64
  %23 = index.cast %22 : i64 to index
  %24 = view.load<volatile> %text_view[%23] : view<3xi8> -> i8
  %25 = scalar.extui %24 : i8 to i32
  func.return %25 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// A single clause initializes the first inner array, not the whole outer array.
unsigned one_row(unsigned position) {
  char table[1][4] = {"abc"};
  volatile char observed[1][4] = {"def"};
  return table[0][position & 3u] + observed[0][position & 3u];
}

// ----
func.def public @one_row(%position: i32) -> (i32) {
  %2 = index.constant 4 : offset
  %table_storage = buffer.alloca<private> align(1) %2 : buffer
  %table_storage_byte_offset = index.constant 0 : offset
  %6 = buffer.constant align(1) utf8("abc\u0000") : buffer
  buffer.copy %6[%table_storage_byte_offset], %table_storage[%table_storage_byte_offset], %2
  %observed_storage = buffer.alloca<private> align(1) %2 : buffer
  %13 = scalar.constant 100 : i8
  %15 = buffer.view %observed_storage[%table_storage_byte_offset] : buffer -> view<1xi8>
  view.store<volatile> %13, %15[0] : i8, view<1xi8>
  %16 = scalar.constant 101 : i8
  %76 = index.constant 1 : offset
  %20 = buffer.view %observed_storage[%76] : buffer -> view<1xi8>
  view.store<volatile> %16, %20[0] : i8, view<1xi8>
  %21 = scalar.constant 102 : i8
  %75 = index.constant 2 : offset
  %25 = buffer.view %observed_storage[%75] : buffer -> view<1xi8>
  view.store<volatile> %21, %25[0] : i8, view<1xi8>
  %26 = scalar.constant 0 : i8
  %74 = index.constant 3 : offset
  %30 = buffer.view %observed_storage[%74] : buffer -> view<1xi8>
  view.store<volatile> %26, %30[0] : i8, view<1xi8>
  %39 = scalar.constant 3 : i32
  %40 = scalar.andi %position, %39 : i32
  %41 = scalar.extui %40 : i32 to i64
  %46 = scalar.assume %41 [range(%41, 0, 9223372036854775807)] : i64
  %47 = index.cast %46 : i64 to offset
  %48 = index.assume %47 [range(%47, 0, 3)] : offset
  %49 = buffer.view %table_storage[%48] : buffer -> view<1xi8>
  %50 = view.load %49[0] : view<1xi8> -> i8
  %51 = scalar.extsi %50 : i8 to i32
  %70 = buffer.view %observed_storage[%48] : buffer -> view<1xi8>
  %71 = view.load<volatile> %70[0] : view<1xi8> -> i8
  %72 = scalar.extsi %71 : i8 to i32
  %73 = scalar.addi %51, %72 : i32
  func.return %73 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
unsigned character_arrays(unsigned position) {
  signed char signed_bytes[] = "\xff";
  unsigned char unsigned_bytes[] = {"\xff"};
  char8_t utf8[4] = u8"é";
  char16_t utf16[4] = u"\U0001F9F5";
  char32_t utf32[4] = U"\U0001F9F5";
  wchar_t wide[4] = L"\U0001F9F5";
  return signed_bytes[position & 1u] + unsigned_bytes[position & 1u] +
         utf8[position & 3u] + utf16[position & 3u] +
         utf32[position & 3u] + wide[position & 3u];
}

// ----
func.def public @character_arrays(%position: i32) -> (i32) {
  %signed_bytes_storage = buffer.alloca.init<private> align(1) bytes("ff00") : buffer
  %signed_bytes_storage_byte_offset = index.constant 0 : offset
  %signed_bytes_view = buffer.view %signed_bytes_storage[%signed_bytes_storage_byte_offset] : buffer -> view<2xi8>
  %unsigned_bytes_storage = buffer.alloca.init<private> align(1) bytes("ff00") : buffer
  %unsigned_bytes_view = buffer.view %unsigned_bytes_storage[%signed_bytes_storage_byte_offset] : buffer -> view<2xi8>
  %utf8_storage = buffer.alloca.init<private> align(1) utf8("é\u0000\u0000") : buffer
  %utf8_view = buffer.view %utf8_storage[%signed_bytes_storage_byte_offset] : buffer -> view<4xi8>
  %utf16_storage = buffer.alloca.init<private> align(2) bytes("3ed8f5dd00000000") : buffer
  %utf16_view = buffer.view %utf16_storage[%signed_bytes_storage_byte_offset] : buffer -> view<4xi16>
  %utf32_storage = buffer.alloca.init<private> align(4) bytes("f5f90100000000000000000000000000") : buffer
  %utf32_view = buffer.view %utf32_storage[%signed_bytes_storage_byte_offset] : buffer -> view<4xi32>
  %wide_storage = buffer.alloca.init<private> align(4) bytes("f5f90100000000000000000000000000") : buffer
  %wide_view = buffer.view %wide_storage[%signed_bytes_storage_byte_offset] : buffer -> view<4xi32>
  %20 = scalar.constant 1 : i32
  %21 = scalar.andi %position, %20 : i32
  %22 = scalar.extui %21 : i32 to i64
  %23 = scalar.assume %22 [range(%22, 0, 1)] : i64
  %24 = index.cast %23 : i64 to index
  %25 = view.load %signed_bytes_view[%24] : view<2xi8> -> i8
  %26 = scalar.extsi %25 : i8 to i32
  %32 = view.load %unsigned_bytes_view[%24] : view<2xi8> -> i8
  %33 = scalar.extui %32 : i8 to i32
  %34 = scalar.addi %26, %33 : i32
  %35 = scalar.constant 3 : i32
  %36 = scalar.andi %position, %35 : i32
  %37 = scalar.extui %36 : i32 to i64
  %38 = scalar.assume %37 [range(%37, 0, 3)] : i64
  %39 = index.cast %38 : i64 to index
  %40 = view.load %utf8_view[%39] : view<4xi8> -> i8
  %41 = scalar.extui %40 : i8 to i32
  %42 = scalar.addi %34, %41 : i32
  %48 = view.load %utf16_view[%39] : view<4xi16> -> i16
  %49 = scalar.extui %48 : i16 to i32
  %50 = scalar.addi %42, %49 : i32
  %56 = view.load %utf32_view[%39] : view<4xi32> -> i32
  %57 = scalar.addi %50, %56 : i32
  %63 = view.load %wide_view[%39] : view<4xi32> -> i32
  %64 = scalar.addi %57, %63 : i32
  func.return %64 : i32
}
