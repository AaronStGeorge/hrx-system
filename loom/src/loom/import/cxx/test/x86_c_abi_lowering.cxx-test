  %17 = storage_address %16 : low.storage<private> -> reg<x86.gpr64>
  mov.store.gpr32 %value_first, %17 {disp32 = 0}
  mov.store.gpr32 %value_second, %17 {disp32 = 4}
  %18 = low.reload %16 : low.storage<private> -> reg<x86.gpr64>
  %19 = low.func.call @external_pair(%18) : (reg<x86.gpr64>) -> (reg<x86.gpr64>)
  %20 = storage {byte_alignment = 4, byte_length = 8} : low.storage<private>
  %21 = storage_address %20 : low.storage<private> -> reg<x86.gpr64>
  low.spill %19, %20 : reg<x86.gpr64>, low.storage<private>
  %22 = mov.load.gpr32 %21 {disp32 = 0}
  %23 = mov.load.gpr32 %21 {disp32 = 4}
  return %22, %23
}

