  %20 = add.imm.gpr64 %19 {imm32 = 12}
  %21 = storage {byte_alignment = 8, byte_length = 8} : low.storage<private>
  %22 = storage_address %21 : low.storage<private> -> reg<x86.gpr64>
  %23 = copy %base : reg<x86.gpr64> -> reg<x86.gpr64>
