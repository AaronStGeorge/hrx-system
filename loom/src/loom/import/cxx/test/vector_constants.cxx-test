// RUN: roundtrip
using Int4 = int __attribute__((ext_vector_type(4)));
constexpr Int4 values{1, 2};
static_assert(values[0] == 1 && values[2] == 0);
Int4 entry() { return values; }

// ----
func.def public @entry() -> (vector<4xi32>) {
  %values = vector.constanti [1, 2, 0, 0] : vector<4xi32>
  func.return %values : vector<4xi32>
}

// ====
using Int4 = int __attribute__((ext_vector_type(4)));
constexpr Int4 values{};
static_assert(values[3] == 0);
Int4 entry() { return values; }

// ----
func.def public @entry() -> (vector<4xi32>) {
  %values = vector.constanti [0, 0, 0, 0] : vector<4xi32>
  func.return %values : vector<4xi32>
}

// ====
using Int4 = int __attribute__((ext_vector_type(4)));
constexpr Int4 first{7};
constexpr Int4 splat = 9;
static_assert(first[0] == 7 && first[3] == 0);
static_assert(splat[0] == 9 && splat[3] == 9);
Int4 entry() { return first + splat; }

// ----
func.def public @entry() -> (vector<4xi32>) {
  %first = vector.constanti [7, 0, 0, 0] : vector<4xi32>
  %splat = vector.constanti [9, 9, 9, 9] : vector<4xi32>
  %3 = vector.addi %first, %splat : vector<4xi32>
  func.return %3 : vector<4xi32>
}

// ====
using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
constexpr Bytes4 values{0, 127, 128, 255};
static_assert(values[2] == 128 && values[3] == 255);
Bytes4 entry() { return values; }

// ----
func.def public @entry() -> (vector<4xi8>) {
  %values = vector.constanti [0, 127, -128, -1] : vector<4xi8>
  func.return %values : vector<4xi8>
}

// ====
using Float8x4 = __float8_e4m3fn __attribute__((ext_vector_type(4)));
constexpr Float8x4 values{__float8_e4m3fn(0x1.1000000000001p0),
                         __float8_e4m3fn(-0.0)};
static_assert(values[0] == 1.125 && values[3] == 0.0);
Float8x4 entry() { return values; }

// ----
func.def public @entry() -> (vector<4xf8E4M3>) {
  %1 = scalar.constant 1.125 : f8E4M3
  %2 = scalar.constant -0.0 : f8E4M3
  %3 = scalar.constant 0.0 : f8E4M3
  %4 = scalar.constant 0.0 : f8E4M3
  %values = vector.from_elements %1, %2, %3, %4 : vector<4xf8E4M3>
  func.return %values : vector<4xf8E4M3>
}

// ====
using Int4 = int __attribute__((ext_vector_type(4)));
constexpr Int4 values{1, 2, 3, 4};
static constexpr int change_copy(Int4 value) {
  value[0] = 8;
  return value[0];
}
static_assert(change_copy(values) == 8);
static_assert(values[0] == 1);
static constexpr int change_local_copy() {
  auto copy = values;
  copy[0] = 9;
  return copy[0];
}
static_assert(change_local_copy() == 9);
static_assert(values[0] == 1);
int entry() { return values[0]; }

// ----
func.def public @entry() -> (i32) {
  %values = vector.constanti [1, 2, 3, 4] : vector<4xi32>
  %2 = scalar.constant 0 : i32
  %3 = index.cast %2 : i32 to index
  %4 = vector.extract %values[%3] : vector<4xi32> -> i32
  func.return %4 : i32
}

// ====
using Int4 = int __attribute__((ext_vector_type(4)));
Int4 entry(int input) { return Int4{input, 2, 3, 4}; }

// ----
func.def public @entry(%input: i32) -> (vector<4xi32>) {
  %2 = scalar.constant 2 : i32
  %3 = scalar.constant 3 : i32
  %4 = scalar.constant 4 : i32
  %5 = vector.from_elements %input, %2, %3, %4 : vector<4xi32>
  func.return %5 : vector<4xi32>
}
