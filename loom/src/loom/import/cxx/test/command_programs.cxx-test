// RUN: roundtrip
#include <loomcxx/buffer.h>
#include <loomcxx/view.h>

namespace loomt = loom::type;
using Parameters = loomt::buffer<const unsigned char>;
using MutableBytes = loomt::buffer<unsigned char>;

[[loom::command_program, loom::symbol("decode.static")]] void decode_static(unsigned variant, [[loom::launch]] Parameters parameters, MutableBytes output) {
  (void)variant;
  (void)parameters;
  (void)output;
}

// ----
command.program.def public @decode.static(%variant: i32) launch(%parameters: buffer, %output: buffer) {
  command.return
}

// ====
// Dynamic view extents and encodings remain specializations while the final
// handle occupies the launch-binding suffix. Predicates resolve against the
// same retained source/native component permutation.
// RUN: roundtrip
#include <loomcxx/buffer.h>
#include <loomcxx/view.h>

namespace loomt = loom::type;
using Parameters = loomt::buffer<const unsigned char>;
using Output = loomt::view<loomt::shape<loomt::dynamic, 4>, float, loomt::encoding<loom::encoding::role::layout, 2>>;

[[loom::command_program, loom::symbol("decode.dynamic")]] void decode_dynamic(unsigned tokens, [[loom::launch]] Parameters parameters, Output output) [[loom::where(tokens > 0u)]] {
  (void)parameters;
  (void)output;
}

// ----
command.program.def public @decode.dynamic(%tokens: i32, %output_dim0: index, %output_layout: encoding<layout>) launch(%parameters: buffer, %output: view<[%output_dim0]x4xf32, %output_layout>) where [ne(%tokens, 0)] {
  command.return
}

// ====
// A program without a boundary has a specialization-only signature.
// RUN: roundtrip
[[loom::command_program]] void prepare(unsigned count) { (void)count; }

// ----
command.program.def public @prepare(%count: i32) launch() {
  command.return
}
