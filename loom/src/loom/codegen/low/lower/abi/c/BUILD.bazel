load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "projection",
    srcs = ["projection.c"],
    hdrs = ["projection.h"],
    visibility = ["//loom/src/loom/target/arch/x86/lower:__pkg__"],
    deps = [
        "//loom/src/loom/codegen/low:builder",
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/low:op_defs",
        "//loom/src/loom/target:registers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_test(
    name = "projection_test",
    srcs = ["projection_test.cc"],
    deps = [
        ":projection",
        "//loom/src/loom/target:registers",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
