// A sparse register range still owns spill contents across its entire block
// interval. An intervening path must not overwrite inactive-lane contents.
// RUN: emit low-allocation-query @sparse_path spill-count materialize-spills test.i32=2

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @sparse_path(%condition: reg<test.i32>) -> (reg<test.i32>) asm {
  %retained = test.const.i32 41
  low.cond_br %condition, ^other, ^read : reg<test.i32>
^other:
  %a = test.const.i32 1
  %b = test.const.i32 2
  %c = test.const.i32 3
  %ab = test.add.i32 %a, %b
  %abc = test.add.i32 %ab, %c
  return %abc
^read:
  %d = test.const.i32 4
  %e = test.const.i32 5
  %de = test.add.i32 %d, %e
  %sum = test.add.i32 %de, %retained
  return %sum
}

// ----
spills: 2
storage: 2 reservations, 8 bytes
traffic: 2 stores, 2 reloads
errors: 0

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @sparse_path(%condition: reg<test.i32>) -> (reg<test.i32>) asm {
  %sparse_path_spill_storage_0 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %sparse_path_spill_storage_1 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %retained = test.const.i32 41
  low.spill %retained, %sparse_path_spill_storage_1 : reg<test.i32>, low.storage<private>
  low.cond_br %condition, ^other, ^read : reg<test.i32>
^other:
  %a = test.const.i32 1
  %b = test.const.i32 2
  %c = test.const.i32 3
  low.spill %c, %sparse_path_spill_storage_0 : reg<test.i32>, low.storage<private>
  %ab = test.add.i32 %a, %b
  %14 = low.reload %sparse_path_spill_storage_0 : low.storage<private> -> reg<test.i32>
  %abc = test.add.i32 %ab, %14
  return %abc
^read:
  %d = test.const.i32 4
  %e = test.const.i32 5
  %de = test.add.i32 %d, %e
  %15 = low.reload %sparse_path_spill_storage_1 : low.storage<private> -> reg<test.i32>
  %sum = test.add.i32 %de, %15
  return %sum
}
