// A spilled loop argument occupies its incoming-store blocks, including the
// backedge, even when its register lifetime ends in the header.
// RUN: emit low-allocation-query @loop_edges spill-count materialize-spills test.i32=2

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @loop_edges(%condition: reg<test.i32>) -> (reg<test.i32>) asm {
  %seed = test.const.i32 0
  low.br.identity(0, 1) ^loop(%seed: reg<test.i32>)
^loop(%state: reg<test.i32>):
  %a = test.const.i32 1
  %b = test.const.i32 2
  %c = test.const.i32 3
  %ab = test.add.i32 %a, %b
  %abc = test.add.i32 %ab, %c
  %next = test.add.i32 %abc, %state
  low.cond_br %condition, ^backedge, ^exit : reg<test.i32>
^backedge:
  %d = test.const.i32 4
  %e = test.const.i32 5
  %f = test.const.i32 6
  %de = test.add.i32 %d, %e
  %def = test.add.i32 %de, %f
  %updated = test.add.i32 %def, %next
  low.br.identity(0, 1) ^loop(%updated: reg<test.i32>)
^exit:
  return %next
}

// ----
spills: 5
storage: 4 reservations, 16 bytes
traffic: 6 stores, 6 reloads
errors: 0

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @loop_edges(%condition: reg<test.i32>) -> (reg<test.i32>) asm {
  %loop_edges_spill_storage_0 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %loop_edges_spill_storage_1 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %loop_edges_spill_storage_2 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %loop_edges_spill_storage_3 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  low.spill %condition, %loop_edges_spill_storage_0 : reg<test.i32>, low.storage<private>
  %seed = test.const.i32 0
  low.spill %seed, %loop_edges_spill_storage_1 : reg<test.i32>, low.storage<private>
  low.br ^loop
^loop:
  %a = test.const.i32 1
  %b = test.const.i32 2
  %c = test.const.i32 3
  low.spill %c, %loop_edges_spill_storage_2 : reg<test.i32>, low.storage<private>
  %ab = test.add.i32 %a, %b
  %20 = low.reload %loop_edges_spill_storage_2 : low.storage<private> -> reg<test.i32>
  %abc = test.add.i32 %ab, %20
  %21 = low.reload %loop_edges_spill_storage_1 : low.storage<private> -> reg<test.i32>
  %next = test.add.i32 %abc, %21
  low.spill %next, %loop_edges_spill_storage_3 : reg<test.i32>, low.storage<private>
  %22 = low.reload %loop_edges_spill_storage_0 : low.storage<private> -> reg<test.i32>
  low.cond_br %22, ^backedge, ^exit : reg<test.i32>
^backedge:
  %d = test.const.i32 4
  %e = test.const.i32 5
  %f = test.const.i32 6
  low.spill %f, %loop_edges_spill_storage_2 : reg<test.i32>, low.storage<private>
  %de = test.add.i32 %d, %e
  %23 = low.reload %loop_edges_spill_storage_2 : low.storage<private> -> reg<test.i32>
  %def = test.add.i32 %de, %23
  %24 = low.reload %loop_edges_spill_storage_3 : low.storage<private> -> reg<test.i32>
  %updated = test.add.i32 %def, %24
  low.spill %updated, %loop_edges_spill_storage_1 : reg<test.i32>, low.storage<private>
  low.br ^loop
^exit:
  %25 = low.reload %loop_edges_spill_storage_3 : low.storage<private> -> reg<test.i32>
  return %25
}

// ====

// A sparse register range still owns spill contents across its entire block
// interval. An intervening path must not overwrite inactive-lane contents.
// RUN: emit low-allocation-query @sparse_path spill-count materialize-spills test.i32=2

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @sparse_path(%condition: reg<test.i32>) -> (reg<test.i32>) asm {
  %retained = test.const.i32 41
  low.cond_br %condition, ^other, ^read : reg<test.i32>
^other:
  %a = test.const.i32 1
  %b = test.const.i32 2
  %c = test.const.i32 3
  %ab = test.add.i32 %a, %b
  %abc = test.add.i32 %ab, %c
  return %abc
^read:
  %d = test.const.i32 4
  %e = test.const.i32 5
  %de = test.add.i32 %d, %e
  %sum = test.add.i32 %de, %retained
  return %sum
}

// ----
spills: 2
storage: 2 reservations, 8 bytes
traffic: 2 stores, 2 reloads
errors: 0

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @sparse_path(%condition: reg<test.i32>) -> (reg<test.i32>) asm {
  %sparse_path_spill_storage_0 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %sparse_path_spill_storage_1 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %retained = test.const.i32 41
  low.spill %retained, %sparse_path_spill_storage_1 : reg<test.i32>, low.storage<private>
  low.cond_br %condition, ^other, ^read : reg<test.i32>
^other:
  %a = test.const.i32 1
  %b = test.const.i32 2
  %c = test.const.i32 3
  low.spill %c, %sparse_path_spill_storage_0 : reg<test.i32>, low.storage<private>
  %ab = test.add.i32 %a, %b
  %14 = low.reload %sparse_path_spill_storage_0 : low.storage<private> -> reg<test.i32>
  %abc = test.add.i32 %ab, %14
  return %abc
^read:
  %d = test.const.i32 4
  %e = test.const.i32 5
  %de = test.add.i32 %d, %e
  %15 = low.reload %sparse_path_spill_storage_1 : low.storage<private> -> reg<test.i32>
  %sum = test.add.i32 %de, %15
  return %sum
}
