  low.spill %abc, %output : reg<test.i32>, low.storage<private>
  low.br ^call
^call:
  %result = low.func.call @produce() : () -> (reg<test.i32>)
  low.spill %result, %callable_cells_spill_storage_2 : reg<test.i32>, low.storage<private>
  %d = test.const.i32 4
  %e = test.const.i32 5
  %de = test.add.i32 %d, %e
  %24 = low.reload %callable_cells_spill_storage_2 : low.storage<private> -> reg<test.i32>
  %combined = test.add.i32 %de, %24
  low.spill %combined, %output : reg<test.i32>, low.storage<private>
  low.br ^last
^last:
