// ====

// Every candidate in the unspillable physical class is occupied. Moving an
// incoming value cannot create capacity for another live scalar.
// RUN: emit low-allocation @entry_physical_shortage entry=0:test.explicit32:physical_register:0 entry=1:test.explicit32:physical_register:1 entry=2:test.explicit32:physical_register:2 entry=3:test.explicit32:physical_register:3

test.target<low_core> @target

// ERROR@+1: BACKEND/005 {function_name="entry_physical_shortage", value_class="test.explicit32", budget="4", peak="5", failure_code="unspillable-register-exhausted"}
low.func.def target<test.low.core>(@target) @entry_physical_shortage(%a: reg<test.explicit32>, %b: reg<test.explicit32>, %c: reg<test.explicit32>, %d: reg<test.explicit32>, %e: reg<test.explicit32>) -> (reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>) asm {
  return %a, %b, %c, %d, %e
}
