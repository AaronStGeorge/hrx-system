// RUN: emit low-allocation @unused_entry

test.target<low_core> @target

// Unused signature parameters consume neither registers nor spill slots.
low.func.def target<test.low.core>(@target) @unused_entry(%before: reg<test.i32>, %used: reg<test.i32>, %after: reg<test.i32>) -> (reg<test.i32>) asm {
  return %used
}

// ----
low-allocation @unused_entry
target: target
descriptor_set: test.low.core
mode: virtual
assignments: 1
remarks: 0
spills: 0
copies: coalesced=0 materialized=0
classes:
  test.i32: assignments=1 units=1 target_ids=1 physical=0 spill_slots=0 unassigned=0

// ====

// RUN: emit low-allocation @unused_branch

test.target<low_core> @target

// The live handoff still coalesces when the same payload also feeds a dead argument.
low.func.def target<test.low.core>(@target) @unused_branch(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^exit(%input: reg<test.i32>, %input: reg<test.i32>)
^exit(%unused: reg<test.i32>, %used: reg<test.i32>):
  return %used
}

// ----
low-allocation @unused_branch
target: target
descriptor_set: test.low.core
mode: virtual
assignments: 2
remarks: 0
spills: 0
copies: coalesced=0 materialized=0
classes:
  test.i32: assignments=2 units=2 target_ids=1 physical=0 spill_slots=0 unassigned=0

// ====

// RUN: emit low-allocation @empty_handoff

test.target<low_core> @target

// Empty edge groups must not consume the following branch's copy group.
low.func.def target<test.low.core>(@target) @empty_handoff(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^middle(%input: reg<test.i32>)
^middle(%unused: reg<test.i32>):
  low.br ^exit(%input: reg<test.i32>)
^exit(%used: reg<test.i32>):
  return %used
}

// ----
low-allocation @empty_handoff
target: target
descriptor_set: test.low.core
mode: virtual
assignments: 2
remarks: 0
spills: 0
copies: coalesced=0 materialized=0
classes:
  test.i32: assignments=2 units=2 target_ids=1 physical=0 spill_slots=0 unassigned=0

// ====

// RUN: emit low-allocation @unused_result

test.target<low_core> @target

// An instruction still writes its result even when the result is unused.
low.func.def target<test.low.core>(@target) @unused_result(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  %discarded = test.add.i32 %input, %input
  return %input
}

// ----
low-allocation @unused_result
target: target
descriptor_set: test.low.core
mode: virtual
assignments: 2
remarks: 0
spills: 0
copies: coalesced=0 materialized=0
classes:
  test.i32: assignments=2 units=2 target_ids=2 physical=0 spill_slots=0 unassigned=0

// ====

// RUN: with-checks emit low-allocation-json @implicit_counter

test.target<low_core> @target

// The induction value is read by the implicit backedge even without body uses.
low.func.def target<test.low.core>(@target) @implicit_counter(%lo: reg<test.i32>, %hi: reg<test.i32>, %step: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.for signed [%lo to %hi step %step] iter_args(%seed: reg<test.i32>) -> (reg<test.i32>) do(%iv: reg<test.i32>, %state: reg<test.i32>) {
    %next = test.add.i32 %state, %step
    low.scf.yield %next : reg<test.i32>
  }
  return %result
}

// ----
CHECK: *"name":"iv","type":"reg<test.i32>"},"class":{"type_kind":12,"type_kind_name":"register","element_type":0,"element_type_name":null,"register_class":"test.i32"},"start_point":1,"end_point":4,*

// ====

// RUN: emit low-allocation @attribute_use

test.target<low_core> @target

// Predicate references keep a parameter live without an ordinary operand use.
low.func.def target<test.low.core>(@target) @attribute_use(%bound: reg<test.i32>, %input: reg<test.i32>) -> (reg<test.i32>) asm {
  %assumed = low.assume %input [eq(%bound, 7)] : reg<test.i32>
  return %assumed
}

// ----
low-allocation @attribute_use
target: target
descriptor_set: test.low.core
mode: virtual
assignments: 3
remarks: 0
spills: 0
copies: coalesced=0 materialized=0
classes:
  test.i32: assignments=3 units=3 target_ids=2 physical=0 spill_slots=0 unassigned=0

// ====

// RUN: with-checks emit liveness-json @type_use

// A parameter's dependent type reads its extent even when its data is unused.
func.def @type_use(%extent: index, %unused: vector<[%extent]xi32>) {
  func.return
}

// ----
CHECK: *"name":"extent","type":"index"},"class":{"type_kind":1,"type_kind_name":"scalar","element_type":1,"element_type_name":"index","register_descriptor_set":null,"register_class_id":null},"start_point":0,"end_point":1,*

// ====

// The four-register bank fits three scalars and the demanded half of the pair.
// The unread half must not reserve a fifth register.
// RUN: emit low-allocation-query @demanded_entry_units spill-count values=%guard0,%guard1,%guard2,%pair,%high

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @demanded_entry_units(%guard0: reg<test.explicit32>, %guard1: reg<test.explicit32>, %guard2: reg<test.explicit32>, %pair: reg<test.explicit32 x2>) -> (reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>) asm {
  %high = slice %pair[1] : reg<test.explicit32 x2> -> reg<test.explicit32>
  return %guard0, %guard1, %guard2, %high
}

// ----
spills: 0
value %guard0: test.explicit32 -> physical_register[0:1]
value %guard1: test.explicit32 -> physical_register[1:1]
value %guard2: test.explicit32 -> physical_register[3:1]
value %pair: test.explicit32 -> physical_register[4:2]
value %high: test.explicit32 -> physical_register[2:1]

// ====

// Five simultaneous units cannot fit in the four-register spillable bank.
// Repacking can change the victim, but it cannot eliminate the spill.
// RUN: emit low-allocation @entry_capacity_shortage

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @entry_capacity_shortage(%first: reg<test.explicit_range32>, %second: reg<test.explicit_range32>, %third: reg<test.explicit_range32>, %pair: reg<test.explicit_range32 x2>) -> (reg<test.explicit_range32>, reg<test.explicit_range32>, reg<test.explicit_range32>, reg<test.explicit_range32 x2>) asm {
  return %first, %second, %third, %pair
}

// ----
low-allocation @entry_capacity_shortage
target: target
descriptor_set: test.low.core
mode: virtual
assignments: 4
remarks: 1
spills: 1
copies: coalesced=0 materialized=0
classes:
  test.explicit_range32: assignments=4 units=5 target_ids=0 physical=3 spill_slots=2 unassigned=0

// ====

// Short-lived aggregates separate two surviving scalars in the eight-register
// bank. Repacking must preserve the alias and leave room for the later quad.
// RUN: emit low-allocation-query @entry_shared_identity spill-count values=%left,%alias,%right,%quad

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @entry_shared_identity(%pair: reg<test.pressure.alias32 x2>, %left: reg<test.pressure.alias32>, %triple_input: reg<test.i32 x3>, %scalar_input: reg<test.i32>, %quad_input: reg<test.i32 x4>) -> (reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32 x4>, reg<test.i32 x2>, reg<test.i32 x3>) asm {
  %triple = copy %triple_input : reg<test.i32 x3> -> reg<test.pressure.alias32 x3>
  %right = copy %scalar_input : reg<test.i32> -> reg<test.pressure.alias32>
  %pair_result = copy %pair : reg<test.pressure.alias32 x2> -> reg<test.i32 x2>
  %triple_result = copy %triple : reg<test.pressure.alias32 x3> -> reg<test.i32 x3>
  %quad = copy %quad_input : reg<test.i32 x4> -> reg<test.pressure.alias32 x4>
  %alias = low.assume %left [range(%left, 0, 1024)] : reg<test.pressure.alias32>
  return %alias, %right, %quad, %pair_result, %triple_result
}

// ----
spills: 0
value %left: test.pressure.alias32 -> physical_register[6:1]
value %alias: test.pressure.alias32 -> physical_register[6:1]
value %right: test.pressure.alias32 -> physical_register[5:1]
value %quad: test.pressure.alias32 -> physical_register[0:4]

// ====

