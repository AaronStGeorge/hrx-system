// At 41 units the first allocation still predicts one wide spill. Packing the
// scalar above the wide live ranges removes its spill from that first plan.
// This query precedes spill materialization and subsequent reallocation; it
// does not describe the final traffic needed to reach a spill-free allocation.
// RUN: emit low-allocation-query @partial_fragmentation_repair spill-count spill-plans=%rhs1 test.i32=41

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @partial_fragmentation_repair(%pointer: reg<test.ptr>, %condition: reg<test.i32>, %rhs0: reg<test.i32 x8>, %rhs1: reg<test.i32 x8>, %acc0: reg<test.i32 x8>, %acc1: reg<test.i32 x8>, %acc2: reg<test.i32 x8>) -> (reg<test.i32 x8>, reg<test.i32 x8>, reg<test.i32 x8>) asm {
  low.br ^loop(%acc0: reg<test.i32 x8>, %acc1: reg<test.i32 x8>, %acc2: reg<test.i32 x8>)
^loop(%carried0: reg<test.i32 x8>, %carried1: reg<test.i32 x8>, %carried2: reg<test.i32 x8>):
  %lhs0_low = test.load.v4i32 %pointer
  %lhs0_high = test.load.v4i32 %pointer
  %lhs0 = concat(%lhs0_low, %lhs0_high) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  %next0 = test.accumulate.v8i32 %lhs0, %rhs0, %carried0
  %lhs1_low = test.load.v4i32 %pointer
  %lhs1_high = test.load.v4i32 %pointer
  %lhs1 = concat(%lhs1_low, %lhs1_high) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  %next1 = test.accumulate.v8i32 %lhs1, %rhs1, %carried1
  %lhs2_low = test.load.v4i32 %pointer
  %lhs2_high = test.load.v4i32 %pointer
  %lhs2 = concat(%lhs2_low, %lhs2_high) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  %next2 = test.accumulate.v8i32 %lhs2, %rhs0, %carried2
  low.cond_br %condition, ^backedge, ^exit_edge : reg<test.i32>
^backedge:
  low.br ^loop(%next0: reg<test.i32 x8>, %next1: reg<test.i32 x8>, %next2: reg<test.i32 x8>)
^exit_edge:
  low.br ^exit(%next0: reg<test.i32 x8>, %next1: reg<test.i32 x8>, %next2: reg<test.i32 x8>)
^exit(%result0: reg<test.i32 x8>, %result1: reg<test.i32 x8>, %result2: reg<test.i32 x8>):
  return %result0, %result1, %result2
}

// ----
spills: 1
spill %rhs1: private[0] bytes=32 align=16 stores=1 reloads=1

// ====

// Four registers cannot hold the tuple and live scalar together. This first
// allocation retains the two predicted spills when packing cannot reduce
// traffic; it does not exercise the subsequent spill materialization.
// RUN: emit low-allocation-query @shared_reload_exceeds_capacity spill-count test.i32=4

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @shared_reload_exceeds_capacity(%blocker: reg<test.i32>, %wide: reg<test.i32 x4>) -> (reg<test.i32>) asm {
  %storage = storage {byte_alignment = 16, byte_length = 16} : low.storage<private>
  low.spill %wide, %storage : reg<test.i32 x4>, low.storage<private>
  %pressure = test.add.i32 %blocker, %blocker
  %reloaded = low.reload %storage : low.storage<private> -> reg<test.i32 x4>
  %head = slice %reloaded[0] : reg<test.i32 x4> -> reg<test.i32 x3>
  %first = slice %head[0] : reg<test.i32 x3> -> reg<test.i32>
  %second = slice %head[1] : reg<test.i32 x3> -> reg<test.i32>
  %sum = test.add.i32 %first, %second
  %tail = slice %reloaded[2] : reg<test.i32 x4> -> reg<test.i32 x2>
  %third = slice %tail[0] : reg<test.i32 x2> -> reg<test.i32>
  %fourth = slice %tail[1] : reg<test.i32 x2> -> reg<test.i32>
  %sum1 = test.add.i32 %sum, %third
  %sum2 = test.add.i32 %sum1, %fourth
  %out = test.add.i32 %sum2, %pressure
  return %out
}

// ----
spills: 2

// ====

// Both spill operands require registers. The scalar and seven-unit tuple fill
// the physical class's eight registers without recursively spilling either.
// RUN: emit low-allocation-query @required_tuple assignment-count spill-count values=%scalar,%wide

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @required_tuple(%scalar: reg<test.pressure.alias32>, %wide: reg<test.pressure.alias32 x7>) asm {
  %storage = storage {byte_alignment = 16, byte_length = 32} : low.storage<private>
  low.spill %scalar, %storage {offset = 28} : reg<test.pressure.alias32>, low.storage<private>
  low.spill %wide, %storage : reg<test.pressure.alias32 x7>, low.storage<private>
  return
}

// ----
assignments: 2
spills: 0
value %scalar: test.pressure.alias32 -> physical_register[0:1]
value %wide: test.pressure.alias32 -> physical_register[1:7]

// ====

// A scalar and eight-unit tuple exceed the same class's capacity. A spill
// operand cannot be assigned another spill slot to resolve the shortage.
// RUN: emit low-allocation-query @required_tuple_shortage

test.target<low_core> @target

// ERROR@+1: BACKEND/005 "spill-traffic-register-exhausted"
low.func.def target<test.low.core>(@target) @required_tuple_shortage(%scalar: reg<test.pressure.alias32>, %wide: reg<test.pressure.alias32 x8>) asm {
  %storage = storage {byte_alignment = 16, byte_length = 48} : low.storage<private>
  low.spill %scalar, %storage {offset = 32} : reg<test.pressure.alias32>, low.storage<private>
  low.spill %wide, %storage : reg<test.pressure.alias32 x8>, low.storage<private>
  return
}

// ====

// A victim with its own low4 use cannot be recolored above that window, even
// with an available high register. The required %current value still takes
// register 3, but %d must spill instead of receiving an out-of-range register
// assignment.
// RUN: emit low-allocation-query @bounded_victim_spill values=%a,%b,%c,%d,%e,%f,%g,%history,%current spill-count

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @bounded_victim_spill() -> (reg<test.i32>) asm {
  %history_storage = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %current_storage = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %a = test.const.zero.i32
  %b = test.const.zero.i32
  %c = test.const.zero.i32
  %d = test.const.zero.i32
  %e = test.const.zero.i32
  %f = test.const.zero.i32
  %g = test.const.zero.i32
  %history = test.add.i32 %a, %b
  low.spill %history, %history_storage : reg<test.i32>, low.storage<private>
  %current = test.add.low4.i32 %d, %c
  %narrow = test.add.low4.i32 %current, %g
  low.spill %current, %current_storage : reg<test.i32>, low.storage<private>
  %sum0 = test.add.i32 %narrow, %a
  %sum1 = test.add.i32 %sum0, %b
  %sum2 = test.add.i32 %sum1, %c
  %sum3 = test.add.i32 %sum2, %d
  %sum4 = test.add.i32 %sum3, %e
  %sum5 = test.add.i32 %sum4, %f
  %sum6 = test.add.i32 %sum5, %g
  return %sum6
}

// ----
spills: 1
value %a: test.i32 -> target_id[0:1]
value %b: test.i32 -> target_id[1:1]
value %c: test.i32 -> target_id[2:1]
value %d: test.i32 -> spill_slot[0:1]
value %e: test.i32 -> target_id[4:1]
value %f: test.i32 -> target_id[5:1]
value %g: test.i32 -> target_id[6:1]
value %history: test.i32 -> target_id[7:1]
value %current: test.i32 -> target_id[3:1]

// ====

// A reload already materializes its storage. Two scalar transfers compete for
// the remaining physical unit and must spill an ordinary value, not the reload.
// RUN: emit low-allocation-query @reload_across_pressure values=%loaded,%left,%right,%sum,%result spill-count

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @reload_across_pressure(%input: reg<test.pressure.alias32 x7>, %seed0: reg<test.i32>, %seed1: reg<test.i32>) -> (reg<test.i32>, reg<test.i32 x7>) asm {
  %storage = storage {byte_alignment = 4, byte_length = 28} : low.storage<stack>
  low.spill %input, %storage : reg<test.pressure.alias32 x7>, low.storage<stack>
  %loaded = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias32 x7>
  %left = copy %seed0 : reg<test.i32> -> reg<test.pressure.alias32>
  %right = copy %seed1 : reg<test.i32> -> reg<test.pressure.alias32>
  %left_value = copy %left : reg<test.pressure.alias32> -> reg<test.i32>
  %right_value = copy %right : reg<test.pressure.alias32> -> reg<test.i32>
  %sum = test.add.i32 %left_value, %right_value
  %result = copy %loaded : reg<test.pressure.alias32 x7> -> reg<test.i32 x7>
  return %sum, %result
}

// ----
spills: 1
value %loaded: test.pressure.alias32 -> physical_register[0:7]
value %left: test.pressure.alias32 -> physical_register[7:1]
value %right: test.pressure.alias32 -> spill_slot[0:1]
value %sum: test.i32 -> target_id[0:1]
value %result: test.i32 -> target_id[1:7]

// ====

// A required alias inherits its source's reservation. Its later spill use
// still requires registers when victim search considers the tied assignment.
// RUN: emit low-allocation-query @tied_spill_source_across_pressure values=%source,%alias,%left,%right,%sum spill-count

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @tied_spill_source_across_pressure(%source: reg<test.pressure.alias32 x7>, %seed0: reg<test.i32>, %seed1: reg<test.i32>) -> (reg<test.i32>) asm {
  %storage = storage {byte_alignment = 4, byte_length = 28} : low.storage<stack>
  %alias = low.assume %source [] : reg<test.pressure.alias32 x7>
  %left = copy %seed0 : reg<test.i32> -> reg<test.pressure.alias32>
  %right = copy %seed1 : reg<test.i32> -> reg<test.pressure.alias32>
  %left_value = copy %left : reg<test.pressure.alias32> -> reg<test.i32>
  %right_value = copy %right : reg<test.pressure.alias32> -> reg<test.i32>
  %sum = test.add.i32 %left_value, %right_value
  low.spill %alias, %storage : reg<test.pressure.alias32 x7>, low.storage<stack>
  return %sum
}

// ----
spills: 1
value %source: test.pressure.alias32 -> physical_register[0:7]
value %alias: test.pressure.alias32 -> physical_register[0:7]
value %left: test.pressure.alias32 -> physical_register[7:1]
value %right: test.pressure.alias32 -> spill_slot[0:1]
value %sum: test.i32 -> target_id[0:1]

// ====

// Two fixed scalars fragment the six-unit bank. Splitting only the first
// one frees the four-unit load; another split would add an unnecessary copy.
// RUN: emit low-allocation-query @first_cut_frees_wide_slot spill-free spill-count copy-count test.i32=6 fixed=%first:target_id:2:1 fixed=%second:target_id:0:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @first_cut_frees_wide_slot(%first: reg<test.i32>, %second: reg<test.i32>, %address: reg<test.ptr>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32 x4>) asm {
  %wide = test.load.v4i32 %address
  return %first, %second, %wide
}

// ----
spills: 0
materialized traffic: stores=0 reloads=0
copies: coalesced=0 materialized=1

// ====

// The same repair is required when the first fixed scalar occupies the
// upper wide slot instead of the lower one.
// RUN: emit low-allocation-query @first_cut_at_upper_slot spill-free spill-count copy-count test.i32=6 fixed=%first:target_id:4:1 fixed=%second:target_id:0:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @first_cut_at_upper_slot(%first: reg<test.i32>, %second: reg<test.i32>, %address: reg<test.ptr>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32 x4>) asm {
  %wide = test.load.v4i32 %address
  return %first, %second, %wide
}

// ----
spills: 0
materialized traffic: stores=0 reloads=0
copies: coalesced=0 materialized=1

// ====

// Free units alone do not remove fragmentation. Reallocation after one
// split discovers that the other fixed scalar can stay in place.
// RUN: emit low-allocation-query @first_cut_with_spare_capacity spill-free spill-count copy-count test.i32=8 fixed=%first:target_id:4:1 fixed=%second:target_id:0:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @first_cut_with_spare_capacity(%first: reg<test.i32>, %second: reg<test.i32>, %address: reg<test.ptr>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32 x4>) asm {
  %wide = test.load.v4i32 %address
  return %first, %second, %wide
}

// ----
spills: 0
materialized traffic: stores=0 reloads=0
copies: coalesced=0 materialized=1

// ====

// A four-unit slot is already free: the complete repair path emits no
// transfers when both fixed scalars can remain in their incoming locations.
// RUN: emit low-allocation-query @fixed_values_already_fit spill-free spill-count copy-count test.i32=8 fixed=%first:target_id:2:1 fixed=%second:target_id:0:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fixed_values_already_fit(%first: reg<test.i32>, %second: reg<test.i32>, %address: reg<test.ptr>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32 x4>) asm {
  %wide = test.load.v4i32 %address
  return %first, %second, %wide
}

// ----
spills: 0
materialized traffic: stores=0 reloads=0
copies: coalesced=0 materialized=0
