// RUN: emit low-allocation-query @compact_concat_uses_other_fallback_slot strategy=source spill-count copy-count values=%historical,%blocker,%lane0,%lane1,%lane2,%lane3,%values fixed=%seed:physical_register:6:1 fixed=%occupy0:physical_register:0:1 fixed=%occupy1:physical_register:1:1 fixed=%occupy3:physical_register:3:1 fixed=%historical:physical_register:4:1 fixed=%values:physical_register:0:4 fixed=%lane3:physical_register:3:1

test.target<low_core> @target

// The fixed occupiers force %blocker into lane 2's result slice, then die
// before the concat sources. Lane 2's ordinary fallback is v4, but %historical
// occupied it earlier in the blocker's lifetime. V5 remains legal inside the
// register extent already established by %seed.
low.func.def target<test.low.core>(@target) @compact_concat_uses_other_fallback_slot(%seed: reg<test.phys>) -> (reg<test.phys x4>) asm {
  %occupy0 = test.add.phys %seed, %seed
  %occupy1 = test.add.phys %seed, %seed
  %occupy3 = test.add.phys %seed, %seed
  %historical = test.add.phys %seed, %seed
  %blocker = test.add.phys %seed, %seed
  %occupy0_end = test.add.phys %occupy0, %occupy0
  %occupy1_end = test.add.phys %occupy1, %occupy1
  %occupy3_end = test.add.phys %occupy3, %occupy3
  %historical_end = test.add.phys %historical, %historical
  %lane0 = test.add.phys %seed, %seed
  %lane1 = test.add.phys %seed, %seed
  %lane2 = test.add.phys %seed, %seed
  %lane3 = test.add.phys %blocker, %seed
  %values = concat(%lane0, %lane1, %lane2, %lane3) : (reg<test.phys>, reg<test.phys>, reg<test.phys>, reg<test.phys>) -> reg<test.phys x4>
  return %values
}

