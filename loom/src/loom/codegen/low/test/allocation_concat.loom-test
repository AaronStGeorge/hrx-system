// RUN: emit low-allocation-query @nested_concat_backedge spill-count values=%state,%lane0,%lane1,%low,%lane2,%lane3,%high,%tuple

test.target<low_core> @target

// The loop state is assigned before the leaf producers. Its location reaches
// both nested pairs. The high pair is produced first but still uses the high
// state units instead of claiming the first free registers.
low.func.def schedule(locked) target<test.low.core>(@target) @nested_concat_backedge(%condition: reg<test.i32>, %initial: reg<test.phys x4>, %seed: reg<test.phys>) -> (reg<test.phys x4>) asm {
  low.br ^loop(%initial: reg<test.phys x4>)
^loop(%state: reg<test.phys x4>):
  low.cond_br %condition, ^produce, ^exit : reg<test.i32>
^produce:
  %lane2 = test.add.phys %seed, %seed
  %lane3 = test.add.phys %seed, %seed
  %high = concat(%lane2, %lane3) : (reg<test.phys>, reg<test.phys>) -> reg<test.phys x2>
  %lane0 = test.add.phys %seed, %seed
  %lane1 = test.add.phys %seed, %seed
  %low = concat(%lane0, %lane1) : (reg<test.phys>, reg<test.phys>) -> reg<test.phys x2>
  %tuple = concat(%low, %high) : (reg<test.phys x2>, reg<test.phys x2>) -> reg<test.phys x4>
  low.br ^loop(%tuple: reg<test.phys x4>)
^exit:
  return %state
}

