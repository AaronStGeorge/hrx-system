// Saving the guard releases l0 after the blocker has taken r1. The loop-live
// constant reserves that pair before choosing its own storage in r3. Without
// early reservation, it claims r0 and neither declared pair remains available.
low.func.def schedule(locked) target<test.low.core>(@target) @loop_live_source_reserves_concat(%condition: reg<test.i32>, %guard: reg<test.explicit32 x2>, %blocker: reg<test.explicit32>) -> (reg<test.explicit32>, reg<test.i32 x2>) asm {
  %saved_guard = copy %guard : reg<test.explicit32 x2> -> reg<test.i32 x2>
  %source = test.const.explicit32 23
  low.br ^loop
^loop:
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  %high = copy %source : reg<test.explicit32> -> reg<test.explicit32>
  %low = test.const.explicit32 11
  %pair = concat(%low, %high) : (reg<test.explicit32>, reg<test.explicit32>) -> reg<test.explicit32 x2>
  low.br ^loop
^exit:
  return %blocker, %saved_guard
}

