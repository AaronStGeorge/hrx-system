// RUN: emit low-allocation-query @compact_concat_lane3_last strategy=resource-stall spill-count values=%temporary0,%temporary1,%temporary2,%temporary3,%lane0,%lane1,%lane2,%lane3,%values fixed=%seed:physical_register:2:1 fixed=%values:physical_register:0:4 fixed=%lane3:physical_register:3:1

