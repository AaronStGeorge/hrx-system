  %lower = copy %seed : reg<test.explicit32> -> reg<test.explicit32>
  %upper = copy %seed : reg<test.explicit32> -> reg<test.explicit32>
  %tuple = concat(%lower, %upper) : (reg<test.explicit32>, reg<test.explicit32>) -> reg<test.explicit32 x2>
  return %tuple
}

