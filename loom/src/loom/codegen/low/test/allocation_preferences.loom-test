// Detached transfers prefer distinct storage, but the target's one-register
// class leaves only a reusable source location.
// RUN: emit low-allocation-query @detached_copy_reuses_only_register values=%source,%result copies=%result

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @detached_copy_reuses_only_register(%source: reg<test.fixed.r0>) -> (reg<test.fixed.r0>) asm {
  %result = copy %source {detached = true} : reg<test.fixed.r0> -> reg<test.fixed.r0>
  return %result
}

// ----
value %source: test.fixed.r0 -> physical_register[0:1]
value %result: test.fixed.r0 -> physical_register[0:1]
copy %source -> %result: coalesced

// ====

// RUN: emit low-allocation-query @detached_move_reuses_only_register values=%source,%result

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @detached_move_reuses_only_register(%source: reg<test.fixed.r0>) -> (reg<test.fixed.r0>) asm {
  %result = move %source {detached = true} : reg<test.fixed.r0> -> reg<test.fixed.r0>
  return %result
}

// ----
value %source: test.fixed.r0 -> physical_register[0:1]
value %result: test.fixed.r0 -> physical_register[0:1]

// ====

// The two-register class can satisfy the preference without spilling.
// RUN: emit low-allocation-query @detached_copy_uses_spare_register values=%source,%result copies=%result

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @detached_copy_uses_spare_register(%source: reg<test.packed.narrow>) -> (reg<test.packed.narrow>) asm {
  %result = copy %source {detached = true} : reg<test.packed.narrow> -> reg<test.packed.narrow>
  return %result
}

// ----
value %source: test.packed.narrow -> physical_register[0:1]
value %result: test.packed.narrow -> physical_register[1:1]
copy %source -> %result: materialized

// ====

// RUN: emit low-allocation-query @detached_move_uses_spare_register values=%source,%result

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @detached_move_uses_spare_register(%source: reg<test.packed.narrow>) -> (reg<test.packed.narrow>) asm {
  %result = move %source {detached = true} : reg<test.packed.narrow> -> reg<test.packed.narrow>
  return %result
}

// ----
value %source: test.packed.narrow -> physical_register[0:1]
value %result: test.packed.narrow -> physical_register[1:1]

// ====

// Unbounded virtual IDs retain the same preference without a physical bank.
// RUN: emit low-allocation-query @detached_copy_without_budget values=%source,%result copies=%result

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @detached_copy_without_budget(%source: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = copy %source {detached = true} : reg<test.i32> -> reg<test.i32>
  return %result
}

// ----
value %source: test.i32 -> target_id[0:1]
value %result: test.i32 -> target_id[1:1]
copy %source -> %result: materialized

// ====

// RUN: emit low-allocation-query @detached_move_without_budget values=%source,%result

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @detached_move_without_budget(%source: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = move %source {detached = true} : reg<test.i32> -> reg<test.i32>
  return %result
}

// ----
value %source: test.i32 -> target_id[0:1]
value %result: test.i32 -> target_id[1:1]

// ====

// RUN: emit low-allocation-query @ordinary_move_reuses_storage values=%source,%result

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @ordinary_move_reuses_storage(%source: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = move %source : reg<test.i32> -> reg<test.i32>
  return %result
}

// ----
value %source: test.i32 -> target_id[0:1]
value %result: test.i32 -> target_id[0:1]
