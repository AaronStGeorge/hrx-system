// Wide reconstructed payloads reuse the header's unchanged units.
// RUN: emit low-allocation-query @wide_identity values=%current,%alias,%same

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @wide_identity(%condition: reg<test.i32>, %seed: reg<test.i32 x32>) -> (reg<test.i32 x32>) asm {
  low.br ^loop(%seed: reg<test.i32 x32>)
^loop(%current: reg<test.i32 x32>):
  %alias = low.assume %current [range(%current, 0, 1024)] : reg<test.i32 x32>
  %first = slice %alias[0] : reg<test.i32 x32> -> reg<test.i32 x16>
  %second = slice %current[16] : reg<test.i32 x32> -> reg<test.i32 x16>
  %same = concat(%first, %second) : (reg<test.i32 x16>, reg<test.i32 x16>) -> reg<test.i32 x32>
  low.cond_br %condition, ^back, ^exit : reg<test.i32>
^back:
  low.br ^loop(%same: reg<test.i32 x32>)
^exit:
  return %current
}

// ----
value %current: test.i32 -> target_id[0:32]
value %alias: test.i32 -> target_id[0:32]
value %same: test.i32 -> target_id[0:32]

// ====
// The reconstructed edge payload and the still-observable header are identical.
// RUN: emit low-allocation-query @identity copy-count values=%current,%alias,%first,%forwarded,%second,%same copies=%forwarded

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @identity(%condition: reg<test.i32>, %seed: reg<test.i32 x2>) -> (reg<test.i32 x2>) asm {
  low.br ^loop(%seed: reg<test.i32 x2>)
^loop(%current: reg<test.i32 x2>):
  %alias = low.assume %current [range(%current, 0, 1024)] : reg<test.i32 x2>
  %first = slice %alias[0] : reg<test.i32 x2> -> reg<test.i32>
  %forwarded = copy %first : reg<test.i32> -> reg<test.i32>
  %second = slice %current[1] : reg<test.i32 x2> -> reg<test.i32>
  %same = concat(%forwarded, %second) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.cond_br %condition, ^back, ^exit : reg<test.i32>
^back:
  low.br ^loop(%same: reg<test.i32 x2>)
^exit:
  return %current
}

// ----
copies: coalesced=1 materialized=0
value %current: test.i32 -> target_id[0:2]
value %alias: test.i32 -> target_id[0:2]
value %first: test.i32 -> target_id[0:1]
value %forwarded: test.i32 -> target_id[0:1]
value %second: test.i32 -> target_id[1:1]
value %same: test.i32 -> target_id[0:2]
copy %first -> %forwarded: coalesced

// ====
// Nonconsecutive physical-register IDs preserve the same unit identities.
// RUN: emit low-allocation-query @explicit_identity values=%current,%alias,%first,%second,%same

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @explicit_identity(%condition: reg<test.i32>, %seed: reg<test.explicit32 x2>) -> (reg<test.explicit32 x2>) asm {
  low.br ^loop(%seed: reg<test.explicit32 x2>)
^loop(%current: reg<test.explicit32 x2>):
  %alias = low.assume %current [range(%current, 0, 1024)] : reg<test.explicit32 x2>
  %first = slice %alias[0] : reg<test.explicit32 x2> -> reg<test.explicit32>
  %second = slice %current[1] : reg<test.explicit32 x2> -> reg<test.explicit32>
  %same = concat(%first, %second) : (reg<test.explicit32>, reg<test.explicit32>) -> reg<test.explicit32 x2>
  low.cond_br %condition, ^back, ^exit : reg<test.i32>
^back:
  low.br ^loop(%same: reg<test.explicit32 x2>)
^exit:
  return %current
}

// ----
value %current: test.explicit32 -> physical_register[4:2]
value %alias: test.explicit32 -> physical_register[4:2]
value %first: test.explicit32 -> physical_register[0:1]
value %second: test.explicit32 -> physical_register[2:1]
value %same: test.explicit32 -> physical_register[4:2]

// ====
// A permutation must preserve the original header until the exit decision.
// RUN: emit low-allocation-query @permuted values=%current,%first,%second,%swapped

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @permuted(%condition: reg<test.i32>, %seed: reg<test.i32 x2>) -> (reg<test.i32 x2>) asm {
  low.br ^loop(%seed: reg<test.i32 x2>)
^loop(%current: reg<test.i32 x2>):
  %first = slice %current[0] : reg<test.i32 x2> -> reg<test.i32>
  %second = slice %current[1] : reg<test.i32 x2> -> reg<test.i32>
  %swapped = concat(%second, %first) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.cond_br %condition, ^back, ^exit : reg<test.i32>
^back:
  low.br ^loop(%swapped: reg<test.i32 x2>)
^exit:
  return %current
}

// ----
value %current: test.i32 -> target_id[0:2]
value %first: test.i32 -> target_id[3:1]
value %second: test.i32 -> target_id[1:1]
value %swapped: test.i32 -> target_id[2:2]

// ====
// Preserving one unit does not establish identity for the whole edge.
// RUN: emit low-allocation-query @partial values=%current,%first,%repeated

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @partial(%condition: reg<test.i32>, %seed: reg<test.i32 x2>) -> (reg<test.i32 x2>) asm {
  low.br ^loop(%seed: reg<test.i32 x2>)
^loop(%current: reg<test.i32 x2>):
  %first = slice %current[0] : reg<test.i32 x2> -> reg<test.i32>
  %repeated = concat(%first, %first) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.cond_br %condition, ^back, ^exit : reg<test.i32>
^back:
  low.br ^loop(%repeated: reg<test.i32 x2>)
^exit:
  return %current
}

// ----
value %current: test.i32 -> target_id[0:2]
value %first: test.i32 -> target_id[3:1]
value %repeated: test.i32 -> target_id[3:2]

// ====
// Required storage ties write new bits and cannot inherit copy identity.
// RUN: emit low-allocation-query @destructive copy-count values=%current,%copied,%changed,%first,%second,%reassembled copies=%copied

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @destructive(%condition: reg<test.i32>, %seed: reg<test.i32 x4>) -> (reg<test.i32 x4>) asm {
  low.br ^loop(%seed: reg<test.i32 x4>)
^loop(%current: reg<test.i32 x4>):
  %copied = copy %current : reg<test.i32 x4> -> reg<test.i32 x4>
  %changed = test.early_tied.v4i32 %copied
  %first = slice %changed[0] : reg<test.i32 x4> -> reg<test.i32 x2>
  %second = slice %changed[2] : reg<test.i32 x4> -> reg<test.i32 x2>
  %reassembled = concat(%first, %second) : (reg<test.i32 x2>, reg<test.i32 x2>) -> reg<test.i32 x4>
  low.cond_br %condition, ^back, ^exit : reg<test.i32>
^back:
  low.br ^loop(%reassembled: reg<test.i32 x4>)
^exit:
  return %current
}

// ----
copies: coalesced=0 materialized=1
value %current: test.i32 -> target_id[0:4]
value %copied: test.i32 -> target_id[5:4]
value %changed: test.i32 -> target_id[5:4]
value %first: test.i32 -> target_id[5:2]
value %second: test.i32 -> target_id[7:2]
value %reassembled: test.i32 -> target_id[0:4]
copy %current -> %copied: materialized
