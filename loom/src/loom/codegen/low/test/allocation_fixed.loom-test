// The fixed aggregate constrains concat reservation as well as its own tie.
// RUN: emit low-allocation-query @fixed_concat_continuation values=%left,%right,%packed,%last fixed=%last:target_id:4:4

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fixed_concat_continuation(%left: reg<test.i32 x2>, %right: reg<test.i32 x2>) -> (reg<test.i32 x4>) asm {
  %packed = concat(%left, %right) : (reg<test.i32 x2>, reg<test.i32 x2>) -> reg<test.i32 x4>
  %last = test.early_tied.v4i32 %packed
  return %last
}

// ----
value %left: test.i32 -> target_id[4:2]
value %right: test.i32 -> target_id[6:2]
value %packed: test.i32 -> target_id[4:4]
value %last: test.i32 -> target_id[4:4]
