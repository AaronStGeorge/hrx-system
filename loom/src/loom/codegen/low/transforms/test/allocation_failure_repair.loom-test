// Replaying the constant releases the needed register without extending the
// captured source. The input-bearing recipe remains shared across the branch.
// RUN: with-low-asm pass low-materialize-allocation{budgets=test.explicit32=2,spill-storage-spaces=none}

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @input_free_repair_first(%source: reg<test.i32>, %late: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %constant = test.const.explicit32 7
  %captured = test.rematerialize.explicit32 %source
  %needed = copy %late : reg<test.i32> -> reg<test.explicit32>
  low.br ^consume
^consume:
  %needed_value = copy %needed : reg<test.explicit32> -> reg<test.i32>
  %constant_value = copy %constant : reg<test.explicit32> -> reg<test.i32>
  %captured_value = copy %captured : reg<test.explicit32> -> reg<test.i32>
  return %needed_value, %constant_value, %captured_value
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @input_free_repair_first(%source: reg<test.i32>, %late: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %captured = test.rematerialize.explicit32 %source
  %needed = copy %late : reg<test.i32> -> reg<test.explicit32>
  low.br ^consume
^consume:
  %needed_value = copy %needed : reg<test.explicit32> -> reg<test.i32>
  %constant_remat = test.const.explicit32 7
  %constant_value = copy %constant_remat : reg<test.explicit32> -> reg<test.i32>
  %captured_value = copy %captured : reg<test.explicit32> -> reg<test.i32>
  return %needed_value, %constant_value, %captured_value
}

// ====

// Failure occurs at the first producer, before either tied result exists.
// Both later results extend that same physical lifetime. Replaying the final
// value's complete recipe after the blockers retire repairs the root failure.
// RUN: with-low-asm pass low-materialize-allocation{budgets=test.explicit32=2,spill-storage-spaces=none}

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @completed_tied_lifetime(%first: reg<test.explicit32>, %second: reg<test.explicit32>, %source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %producer = test.rematerialize.explicit32 %source
  %middle = test.rematerialize.tied.explicit32 %producer
  %completed = test.rematerialize.tied.explicit32 %middle
  %first_value = copy %first : reg<test.explicit32> -> reg<test.i32>
  %second_value = copy %second : reg<test.explicit32> -> reg<test.i32>
  %result = copy %completed : reg<test.explicit32> -> reg<test.i32>
  return %first_value, %second_value, %result
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @completed_tied_lifetime(%first: reg<test.explicit32>, %second: reg<test.explicit32>, %source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %first_value = copy %first : reg<test.explicit32> -> reg<test.i32>
  %second_value = copy %second : reg<test.explicit32> -> reg<test.i32>
  %producer_remat = test.rematerialize.explicit32 %source
  %middle_remat = test.rematerialize.tied.explicit32 %producer_remat
  %completed_remat = test.rematerialize.tied.explicit32 %middle_remat
  %result = copy %completed_remat : reg<test.explicit32> -> reg<test.i32>
  return %first_value, %second_value, %result
}

// ====

// Repacking the scalar and wide loop lifetimes avoids all spill traffic at
// this capacity. The allocation pass must leave the program unchanged.
// RUN: with-low-asm pass low-materialize-allocation{budgets=test.i32=52}

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @loop_fragmentation(%pointer: reg<test.ptr>, %condition: reg<test.i32>, %rhs0: reg<test.i32 x8>, %rhs1: reg<test.i32 x8>, %acc0: reg<test.i32 x8>, %acc1: reg<test.i32 x8>, %acc2: reg<test.i32 x8>) -> (reg<test.i32 x8>, reg<test.i32 x8>, reg<test.i32 x8>) asm {
  low.br ^loop(%acc0: reg<test.i32 x8>, %acc1: reg<test.i32 x8>, %acc2: reg<test.i32 x8>)
^loop(%carried0: reg<test.i32 x8>, %carried1: reg<test.i32 x8>, %carried2: reg<test.i32 x8>):
  %lhs0_low = test.load.v4i32 %pointer
  %lhs0_high = test.load.v4i32 %pointer
  %lhs0 = concat(%lhs0_low, %lhs0_high) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  %next0 = test.accumulate.v8i32 %lhs0, %rhs0, %carried0
  %lhs1_low = test.load.v4i32 %pointer
  %lhs1_high = test.load.v4i32 %pointer
  %lhs1 = concat(%lhs1_low, %lhs1_high) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  %next1 = test.accumulate.v8i32 %lhs1, %rhs1, %carried1
  %lhs2_low = test.load.v4i32 %pointer
  %lhs2_high = test.load.v4i32 %pointer
  %lhs2 = concat(%lhs2_low, %lhs2_high) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  %next2 = test.accumulate.v8i32 %lhs2, %rhs0, %carried2
  low.cond_br %condition, ^backedge, ^exit_edge : reg<test.i32>
^backedge:
  low.br ^loop(%next0: reg<test.i32 x8>, %next1: reg<test.i32 x8>, %next2: reg<test.i32 x8>)
^exit_edge:
  low.br ^exit(%next0: reg<test.i32 x8>, %next1: reg<test.i32 x8>, %next2: reg<test.i32 x8>)
^exit(%result0: reg<test.i32 x8>, %result1: reg<test.i32 x8>, %result2: reg<test.i32 x8>):
  return %result0, %result1, %result2
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @loop_fragmentation(%pointer: reg<test.ptr>, %condition: reg<test.i32>, %rhs0: reg<test.i32 x8>, %rhs1: reg<test.i32 x8>, %acc0: reg<test.i32 x8>, %acc1: reg<test.i32 x8>, %acc2: reg<test.i32 x8>) -> (reg<test.i32 x8>, reg<test.i32 x8>, reg<test.i32 x8>) asm {
  low.br ^loop(%acc0: reg<test.i32 x8>, %acc1: reg<test.i32 x8>, %acc2: reg<test.i32 x8>)
^loop(%carried0: reg<test.i32 x8>, %carried1: reg<test.i32 x8>, %carried2: reg<test.i32 x8>):
  %lhs0_low = test.load.v4i32 %pointer
  %lhs0_high = test.load.v4i32 %pointer
  %lhs0 = concat(%lhs0_low, %lhs0_high) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  %next0 = test.accumulate.v8i32 %lhs0, %rhs0, %carried0
  %lhs1_low = test.load.v4i32 %pointer
  %lhs1_high = test.load.v4i32 %pointer
  %lhs1 = concat(%lhs1_low, %lhs1_high) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  %next1 = test.accumulate.v8i32 %lhs1, %rhs1, %carried1
  %lhs2_low = test.load.v4i32 %pointer
  %lhs2_high = test.load.v4i32 %pointer
  %lhs2 = concat(%lhs2_low, %lhs2_high) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  %next2 = test.accumulate.v8i32 %lhs2, %rhs0, %carried2
  low.cond_br %condition, ^backedge, ^exit_edge : reg<test.i32>
^backedge:
  low.br ^loop(%next0: reg<test.i32 x8>, %next1: reg<test.i32 x8>, %next2: reg<test.i32 x8>)
^exit_edge:
  low.br ^exit(%next0: reg<test.i32 x8>, %next1: reg<test.i32 x8>, %next2: reg<test.i32 x8>)
^exit(%result0: reg<test.i32 x8>, %result1: reg<test.i32 x8>, %result2: reg<test.i32 x8>):
  return %result0, %result1, %result2
}
