// RUN: pass target-legalize{mode=eager,policy=reference-only}

// Dynamic packing uses the offset carrier, independently of index width.
test.target<low_core> @wide_offsets {index_bitwidth = 32, offset_bitwidth = 64}

test.target<low_core> @narrow_offsets {index_bitwidth = 64, offset_bitwidth = 32}

func.def target(@wide_offsets) @pack_wide(%header: offset, %payload: offset, %tail: offset) -> (offset, offset, offset, offset) {
  %total, %header_offset, %payload_offset, %tail_offset = buffer.pack [align(4) %header, align(16) %payload, align(1) %tail] : offset
  func.return %total, %header_offset, %payload_offset, %tail_offset : offset, offset, offset, offset
}

func.def target(@narrow_offsets) @pack_narrow(%length: offset) -> (offset, offset) {
  %total, %origin = buffer.pack [align(2147483648) %length] : offset
  func.return %total, %origin : offset, offset
}

// ----
test.target<low_core> @wide_offsets {index_bitwidth = 32, offset_bitwidth = 64}

test.target<low_core> @narrow_offsets {index_bitwidth = 64, offset_bitwidth = 32}

func.def target(@wide_offsets) @pack_wide(%header: offset, %payload: offset, %tail: offset) -> (offset, offset, offset, offset) {
  %header_offset = index.constant 0 : offset
  %17 = index.add %header_offset, %header : offset
  %18 = index.constant 15 : offset
  %19 = index.add %17, %18 : offset
  %20 = index.cast %19 : offset to i64
  %21 = scalar.constant -16 : i64
  %22 = scalar.andi %20, %21 : i64
  %payload_offset = index.cast %22 : i64 to offset
  %tail_offset = index.add %payload_offset, %payload : offset
  %25 = index.add %tail_offset, %tail : offset
  %26 = index.constant 15 : offset
  %27 = index.add %25, %26 : offset
  %28 = index.cast %27 : offset to i64
  %29 = scalar.constant -16 : i64
  %30 = scalar.andi %28, %29 : i64
  %total = index.cast %30 : i64 to offset
  func.return %total, %header_offset, %payload_offset, %tail_offset : offset, offset, offset, offset
}

func.def target(@narrow_offsets) @pack_narrow(%length: offset) -> (offset, offset) {
  %origin = index.constant 0 : offset
  %33 = index.add %origin, %length : offset
  %34 = index.constant 2147483647 : offset
  %35 = index.add %33, %34 : offset
  %36 = index.cast %35 : offset to i32
  %37 = scalar.constant -2147483648 : i32
  %38 = scalar.andi %36, %37 : i32
  %total = index.cast %38 : i32 to offset
  func.return %total, %origin : offset, offset
}

// ====

test.target<low_core> @test_target

func.def target(@test_target) @copy(%source: buffer, %source_offset: offset, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.copy %source[%source_offset], %target[%target_offset], %byte_length
  func.return
}

func.def target(@test_target) @fill_i8(%pattern: i8, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.fill %pattern, %target[%target_offset], %byte_length : i8
  func.return
}

func.def target(@test_target) @fill_i16(%pattern: i16, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.fill %pattern, %target[%target_offset], %byte_length : i16
  func.return
}

func.def target(@test_target) @fill_i32(%pattern: i32, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.fill %pattern, %target[%target_offset], %byte_length : i32
  func.return
}

func.def target(@test_target) @fill_f32(%pattern: f32, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.fill %pattern, %target[%target_offset], %byte_length : f32
  func.return
}

func.def target(@test_target) @fill_bf16(%pattern: bf16, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.fill %pattern, %target[%target_offset], %byte_length : bf16
  func.return
}

func.def target(@test_target) @compare(%lhs: buffer, %lhs_offset: offset, %rhs: buffer, %rhs_offset: offset, %byte_length: offset) -> (i32) {
  %order = buffer.compare %lhs[%lhs_offset], %rhs[%rhs_offset], %byte_length
  func.return %order : i32
}

// ----
test.target<low_core> @test_target

func.def target(@test_target) @copy(%source: buffer, %source_offset: offset, %target: buffer, %target_offset: offset, %byte_length: offset) {
  %32 = index.constant 0 : offset
  %33 = index.constant 1 : offset
  scf.for %34 = [%32 to %byte_length step %33] {
    %35 = index.add %source_offset, %34 : offset
    %36 = buffer.load.i8.u %source[%35]
    %37 = index.add %target_offset, %34 : offset
    buffer.store.i8 %36, %target[%37]
  }
  func.return
}

func.def target(@test_target) @fill_i8(%pattern: i8, %target: buffer, %target_offset: offset, %byte_length: offset) {
  %38 = index.constant 0 : offset
  %39 = scalar.extui %pattern : i8 to i32
  %40 = index.constant 1 : offset
  scf.for %41 = [%38 to %byte_length step %40] {
    %42 = index.add %target_offset, %41 : offset
    buffer.store.i8 %39, %target[%42]
  }
  func.return
}

func.def target(@test_target) @fill_i16(%pattern: i16, %target: buffer, %target_offset: offset, %byte_length: offset) {
  %43 = index.constant 0 : offset
  %44 = scalar.extui %pattern : i16 to i32
  %45 = scalar.constant 16 : i32
  %46 = scalar.shli %44, %45 : i32
  %47 = scalar.ori %44, %46 : i32
  %48 = index.constant 1 : offset
  %51 = scf.for %49 = [%43 to %byte_length step %48](%50 = %47 : i32) -> (i32) {
    %52 = index.add %target_offset, %49 : offset
    buffer.store.i8 %50, %target[%52]
    %53 = scalar.constant 8 : i32
    %54 = scalar.constant 24 : i32
    %55 = scalar.shrui %50, %53 : i32
    %56 = scalar.shli %50, %54 : i32
    %57 = scalar.ori %55, %56 : i32
    scf.yield %57 : i32
  }
  func.return
}

func.def target(@test_target) @fill_i32(%pattern: i32, %target: buffer, %target_offset: offset, %byte_length: offset) {
  %58 = index.constant 0 : offset
  %59 = index.constant 1 : offset
  %62 = scf.for %60 = [%58 to %byte_length step %59](%61 = %pattern : i32) -> (i32) {
    %63 = index.add %target_offset, %60 : offset
    buffer.store.i8 %61, %target[%63]
    %64 = scalar.constant 8 : i32
    %65 = scalar.constant 24 : i32
    %66 = scalar.shrui %61, %64 : i32
    %67 = scalar.shli %61, %65 : i32
    %68 = scalar.ori %66, %67 : i32
    scf.yield %68 : i32
  }
  func.return
}

func.def target(@test_target) @fill_f32(%pattern: f32, %target: buffer, %target_offset: offset, %byte_length: offset) {
  %69 = index.constant 0 : offset
  %70 = scalar.bitcast %pattern : f32 to i32
  %71 = index.constant 1 : offset
  %74 = scf.for %72 = [%69 to %byte_length step %71](%73 = %70 : i32) -> (i32) {
    %75 = index.add %target_offset, %72 : offset
    buffer.store.i8 %73, %target[%75]
    %76 = scalar.constant 8 : i32
    %77 = scalar.constant 24 : i32
    %78 = scalar.shrui %73, %76 : i32
    %79 = scalar.shli %73, %77 : i32
    %80 = scalar.ori %78, %79 : i32
    scf.yield %80 : i32
  }
  func.return
}

func.def target(@test_target) @fill_bf16(%pattern: bf16, %target: buffer, %target_offset: offset, %byte_length: offset) {
  %81 = index.constant 0 : offset
  %82 = scalar.bitcast %pattern : bf16 to i16
  %83 = scalar.extui %82 : i16 to i32
  %84 = scalar.constant 16 : i32
  %85 = scalar.shli %83, %84 : i32
  %86 = scalar.ori %83, %85 : i32
  %87 = index.constant 1 : offset
  %90 = scf.for %88 = [%81 to %byte_length step %87](%89 = %86 : i32) -> (i32) {
    %91 = index.add %target_offset, %88 : offset
    buffer.store.i8 %89, %target[%91]
    %92 = scalar.constant 8 : i32
    %93 = scalar.constant 24 : i32
    %94 = scalar.shrui %89, %92 : i32
    %95 = scalar.shli %89, %93 : i32
    %96 = scalar.ori %94, %95 : i32
    scf.yield %96 : i32
  }
  func.return
}

func.def target(@test_target) @compare(%lhs: buffer, %lhs_offset: offset, %rhs: buffer, %rhs_offset: offset, %byte_length: offset) -> (i32) {
  %97 = index.constant 0 : offset
  %98 = scalar.constant 0 : i32
  %99 = scalar.constant -1 : i32
  %100 = scalar.constant 1 : i32
  %101 = scalar.constant 0 : i32
  %108, %109, %110 = scf.while(%102 = %97 : offset, %103 = %101 : i32, %104 = %101 : i32) -> (offset, i32, i32) {
    %111 = index.cmp ult, %102, %byte_length : offset
    %112 = scalar.cmpi eq, %103, %104 : i32
    %113 = scalar.andi %111, %112 : i1
    scf.condition %113, %102, %103, %104 : i1, offset, i32, i32
  } do(%105: offset, %106: i32, %107: i32) {
    %114 = index.add %lhs_offset, %105 : offset
    %115 = buffer.load.i8.u %lhs[%114]
    %116 = index.add %rhs_offset, %105 : offset
    %117 = buffer.load.i8.u %rhs[%116]
    %118 = index.constant 1 : offset
    %119 = index.add %105, %118 : offset
    scf.yield %119, %115, %117 : offset, i32, i32
  }
  %120 = scalar.cmpi eq, %109, %110 : i32
  %121 = scalar.cmpi ult, %109, %110 : i32
  %122 = scf.select %121, %99, %100 : i32
  %order = scf.select %120, %98, %122 : i32
  func.return %order : i32
}
