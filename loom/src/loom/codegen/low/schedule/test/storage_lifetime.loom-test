block 0 order: 1, 0

// ====

// Destructive local updates extend the copied header's storage lifetime.
// Its last reader still precedes the next iteration's cursor definition.
// RUN: emit low-schedule-query @tied_header_read kind=storage-lifetime strategy=resource-stall consumer=4

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @tied_header_read(%seed: reg<test.i32>, %rhs: reg<test.i32>) asm {
  low.br ^loop(%seed: reg<test.i32>)
^loop(%cursor: reg<test.i32>):
  %view = copy %cursor : reg<test.i32> -> reg<test.i32>
  %advanced = test.tied.any %view
  %read = test.add.i32 %advanced, %rhs
  %next = test.mul.i32 %cursor, %rhs
  test.event.memory.write.i32 %read
  low.br ^loop(%next: reg<test.i32>)
}

// ----
node 4 <- 2, 3

// ====

// Projected lifetime reads supplement the original reads. The local tied
// write must still wait for its own source's reader before changing storage.
// RUN: emit low-schedule-query @original_tied_read kind=storage-lifetime strategy=resource-stall consumer=3,5

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @original_tied_read(%seed: reg<test.i32>, %rhs: reg<test.i32>) asm {
  low.br ^loop(%seed: reg<test.i32>)
^loop(%cursor: reg<test.i32>):
  %view = copy %cursor : reg<test.i32> -> reg<test.i32>
  %before = test.add.i32 %view, %rhs
  %advanced = test.tied.any %view
  %read = test.add.i32 %advanced, %before
  %next = test.mul.i32 %cursor, %rhs
  test.event.memory.write.i32 %read
  low.br ^loop(%next: reg<test.i32>)
}

// ----
node 3 <- 2
node 5 <- 2, 3, 4

// ====

// The backedge is in another block. Its source is established while the
// copied header's readers are available in the producer block.
// RUN: emit low-schedule-query @forwarded_header_read kind=storage-lifetime strategy=resource-stall consumer=3,5

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @forwarded_header_read(%condition: reg<test.i32>, %seed: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^loop(%seed: reg<test.i32>)
^loop(%cursor: reg<test.i32>):
  %view = copy %cursor : reg<test.i32> -> reg<test.i32>
  %read = test.add.i32 %view, %rhs
  %next = test.mul.i32 %cursor, %rhs
  low.cond_br %condition, ^forward, ^exit : reg<test.i32>
^forward:
  low.br ^loop(%next: reg<test.i32>)
^exit:
  return %read
}

