// ====

// The subtraction/cmov sequence still reads its original input after writing
// the result. With all sixteen GPRs live, that temporary overlap exceeds the
// physical bank even though the final live demand remains sixteen units.
// RUN: emit low-schedule-json @late_read_overlap strategy=resource-stall diagnostics=candidates output=none

x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @late_read_overlap(%held: reg<x86.gpr32 x15>, %source: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.xmm x15>) asm {
