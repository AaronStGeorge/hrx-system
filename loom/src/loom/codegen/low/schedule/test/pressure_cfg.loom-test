// The last local use does not release either loop-invariant input. Each
// temporary overlaps both inputs in the authored order.
// RUN: emit low-schedule-query @loop_live_out strategy=source scheduled-pressure=test.i32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @loop_live_out(%held: reg<test.i32>, %seed: reg<test.i32>) asm {
  low.br ^loop
^loop:
  test.event.memory.write.i32 %held
  %first = test.event.fast.i32 %seed, %seed
  test.event.memory.write.i32 %first
  %second = test.event.fast.i32 %seed, %seed
  test.event.memory.write.i32 %second
  low.br ^loop
}

// ----
scheduled pressure test.i32: peak-live-units=3 peak-live-values=3

// ====

// The held value has no local use, and the seed survives its final local use.
// Both occupy registers throughout the intermediate block.
// RUN: emit low-schedule-query @live_through strategy=resource-stall test.i32=3 order=1,2,3,4 scheduled-pressure=test.i32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @live_through(%held: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  low.br ^work
^work:
  %first = test.event.fast.i32 %seed, %seed
  test.event.memory.write.i32 %first
  %second = test.event.fast.i32 %seed, %seed
  test.event.memory.write.i32 %second
  low.br ^exit
^exit:
  return %held, %seed
}

// ----
block 1 order: 1, 2, 3, 4
scheduled pressure test.i32: peak-live-units=3 peak-live-values=3

// ====

// An alias's final local read cannot release the loop-invariant source. The
// alias still shares its source's pressure instead of allocating another unit.
// RUN: emit low-schedule-query @aliased_loop_live_out strategy=resource-stall test.i32=3 order=1,2,3,4,5,6

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @aliased_loop_live_out(%held: reg<test.i32>, %seed: reg<test.i32>) asm {
  low.br ^loop
^loop:
  %alias = copy %held : reg<test.i32> -> reg<test.i32>
  test.event.memory.write.i32 %alias
  %first = test.event.fast.i32 %seed, %seed
  test.event.memory.write.i32 %first
  %second = test.event.fast.i32 %seed, %seed
  test.event.memory.write.i32 %second
  low.br ^loop
}

// ----
block 1 order: 1, 2, 3, 4, 5, 6

// ====

// A result used only by a successor still produces live storage. Delay that
// result until the temporaries are consumed instead of treating it as dead.
// RUN: emit low-schedule-query @successor_only_result strategy=resource-stall test.i32=3 order=0,1,2,3,4 scheduled-pressure=test.i32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @successor_only_result(%seed: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %held = test.add.i32 %seed, %seed
  %first = test.event.fast.i32 %seed, %seed
  test.event.memory.write.i32 %first
  %second = test.event.fast.i32 %seed, %seed
  test.event.memory.write.i32 %second
  low.br ^exit
^exit:
  return %held, %seed
}

// ----
block 0 order: 1, 2, 3, 4, 0
scheduled pressure test.i32: peak-live-units=2 peak-live-values=2

// ====

// A value with no local uses still contributes its full width to pressure
// throughout the intermediate block.
// RUN: emit low-schedule-query @live_through_source_pressure strategy=source scheduled-pressure=test.i32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @live_through_source_pressure(%held: reg<test.i32 x8>, %ptr0: reg<test.ptr>, %ptr1: reg<test.ptr>, %lhs: reg<test.i32 x4>) -> (reg<test.i32 x8>, reg<test.i32 x4>) asm {
  low.br ^work
^work:
  %load0 = test.load.v4i32 %ptr0
  %use0 = test.add.v4i32 %load0, %lhs
  %load1 = test.load.v4i32 %ptr1
  %use1 = test.add.v4i32 %load1, %use0
  low.br ^exit
^exit:
  return %held, %use1
}

// ----
scheduled pressure test.i32: peak-live-units=16 peak-live-values=3

// ====

// Successor arguments begin at their definitions rather than overlapping the
// predecessor values passed to them.
// RUN: emit low-schedule-query @block_argument_source_pressure strategy=source scheduled-pressure=test.i32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @block_argument_source_pressure(%seed: reg<test.i32 x8>, %ptr0: reg<test.ptr>, %ptr1: reg<test.ptr>) -> (reg<test.i32 x8>, reg<test.i32>, reg<test.i32 x4>) asm {
  %load0 = test.load.v4i32 %ptr0
  %lane = test.extract_lane.i32 %load0, 0
  %load1 = test.load.v4i32 %ptr1
  low.br ^exit(%seed: reg<test.i32 x8>, %lane: reg<test.i32>, %load1: reg<test.i32 x4>)
^exit(%state: reg<test.i32 x8>, %result_lane: reg<test.i32>, %result_load: reg<test.i32 x4>):
  return %state, %result_lane, %result_load
}

// ----
scheduled pressure test.i32: peak-live-units=13 peak-live-values=3

// ====

// Aliases and forwarded block arguments retain their own SSA lifetimes. Block
// boundaries cannot extend predecessor values through successor definitions.
// RUN: emit low-schedule-query @alias_handoff_source_pressure strategy=source scheduled-pressure=test.i32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @alias_handoff_source_pressure(%held: reg<test.i32>, %source: reg<test.i32 x4>, %ptr: reg<test.ptr>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32 x4>) asm {
  low.br ^body(%held: reg<test.i32>, %source: reg<test.i32 x4>)
^body(%block_held: reg<test.i32>, %block_source: reg<test.i32 x4>):
  %copy = copy %block_source : reg<test.i32 x4> -> reg<test.i32 x4>
  %discarded = test.add.v4i32 %block_source, %copy
  %lane = test.extract_lane.i32 %copy, 0
  %load = test.load.v4i32 %ptr
  low.br ^exit(%block_held: reg<test.i32>, %lane: reg<test.i32>, %load: reg<test.i32 x4>)
^exit(%result_held: reg<test.i32>, %result_lane: reg<test.i32>, %result_load: reg<test.i32 x4>):
  return %result_held, %result_lane, %result_load
}

// ----
scheduled pressure test.i32: peak-live-units=9 peak-live-values=3

// ====

// A frame-owned handle survives the backedge without occupying a register.
// Its view/address SSA dependencies still order the local materialization.
// RUN: emit low-schedule-query @storage_handle_loop strategy=resource-stall kind=ssa consumer=3,4,5 order=* scheduled-pressure=test.i32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @storage_handle_loop(%seed: reg<test.i32>) asm {
  %slot = storage {byte_alignment = 8, byte_length = 16} : low.storage<private>
  low.br ^loop
^loop:
  %view = storage_view %slot {byte_length = 8, offset = 8} : low.storage<private> -> low.storage<private>
  %address = storage_address %view : low.storage<private> -> reg<test.i32>
  %value = test.add.i32 %seed, %address
  test.event.memory.write.i32 %value
  low.br ^loop
}

