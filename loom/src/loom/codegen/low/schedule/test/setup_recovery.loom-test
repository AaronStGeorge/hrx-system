// A later phase boundary orders both the private producer and its consumer.
// Recovery preserves those edges while delaying setup until the other input.
// RUN: emit low-schedule-query @phase_successor strategy=resource-stall kind=order consumer=* order=* per-user-placement-values=%private required-register-values=%private repair-private-setup

test.target<low_core> @target

low.func.def schedule(phased) target<test.low.core>(@target) @phase_successor(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %private = test.const.i32 42
  %dependency = test.mul.i32 %lhs, %rhs
  %result = test.add.i32 %private, %dependency
  low.schedule.phase
  return %result
}

// ----
block 0 order: 1, 0, 2, 3, 4
node 0 <- 1
node 3 <- 0, 1, 2
node 4 <- 3

// ====

// Repeated operands still name one consumer. Its data latency remains on the
// original edge after setup acquires an additional ordering prerequisite.
// RUN: emit low-schedule-query @repeated_operands strategy=resource-stall edge=ssa:0:2,ssa:1:2 order=* per-user-placement-values=%private required-register-values=%private repair-private-setup

test.target<low_core> @target

low.func.def schedule(phased) target<test.low.core>(@target) @repeated_operands(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %private = test.const.i32 42
  %dependency = test.mul.i32 %lhs, %rhs
  %result = test.mul_add.i32 %private, %private, %dependency
  low.schedule.phase
  return %result
}

// ----
block 0 order: 1, 0, 2, 3, 4
edge ssa 0 -> 2: separation=0 source=schedule-class quality=exact producer-event=<none> consumer-event=<none>
edge ssa 1 -> 2: separation=1 source=schedule-class quality=exact producer-event=<none> consumer-event=<none>

// ====

// Each member retains the same terminal consumer through structural setup.
// The shared boundary does not keep the constant lanes live independently.
// RUN: emit low-schedule-query @composition strategy=resource-stall kind=order consumer=* order=* per-user-placement-values=%low,%high,%private required-register-values=%low,%high,%private repair-private-setup

test.target<low_core> @target

low.func.def schedule(phased) target<test.low.core>(@target) @composition(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32 x3>) asm {
  %low = test.const.i32 7
  %high = test.const.i32 11
  %private = concat(%low, %high) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %dependency = test.mul.i32 %lhs, %rhs
  %result = concat(%private, %dependency) : (reg<test.i32 x2>, reg<test.i32>) -> reg<test.i32 x3>
  low.schedule.phase
  return %result
}

// ----
block 0 order: 3, 0, 1, 2, 4, 5, 6
node 0 <- 3
node 1 <- 0
node 5 <- 0, 1, 2, 3, 4
node 6 <- 5

// ====

// Two distinct consumers still prevent private ownership, even when both
// precede the same phase boundary.
// RUN: emit low-schedule-query @value_fanout strategy=resource-stall kind=order consumer=* per-user-placement-values=%private required-register-values=%private repair-private-setup

test.target<low_core> @target

low.func.def schedule(phased) target<test.low.core>(@target) @value_fanout(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %private = test.const.i32 42
  %dependency = test.mul.i32 %lhs, %rhs
  %first = test.add.i32 %private, %dependency
  %second = test.add.i32 %private, %lhs
  low.schedule.phase
  return %first, %second
}

// ----
node 4 <- 0, 1, 2, 3
node 5 <- 4

// ====

// A distinct state successor cannot be subsumed when the value consumer does
// not itself precede that successor.
// RUN: emit low-schedule-query @independent_state_successor strategy=resource-stall kind=order consumer=* per-user-placement-values=%private repair-private-setup

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @independent_state_successor(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %dependency = test.mul.i32 %lhs, %rhs
  %private = test.state.read.i32 %lhs
  %result = test.add.i32 %private, %dependency
  test.state.assign.i32.immediate 1
  return %result
}

// ----
none

// ====

// A phase between producer and consumer cannot be moved behind the consumer.
// RUN: emit low-schedule-query @intervening_phase strategy=resource-stall kind=order consumer=* per-user-placement-values=%private required-register-values=%private repair-private-setup

test.target<low_core> @target

low.func.def schedule(phased) target<test.low.core>(@target) @intervening_phase(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %private = test.const.i32 42
  low.schedule.phase
  %dependency = test.mul.i32 %lhs, %rhs
  %result = test.add.i32 %private, %dependency
  return %result
}

// ----
node 1 <- 0
node 2 <- 1
node 3 <- 1
node 4 <- 1
