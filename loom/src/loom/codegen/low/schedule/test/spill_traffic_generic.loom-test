
// Private setup can need two leaves before either makes a consumer ready.
// Both fit while the singleton transaction is pinned in this source range.
// Finish it before unrelated arithmetic rather than deferring both leaves.
// RUN: emit low-schedule-query @private_completion_leaves strategy=resource-stall per-user-placement-values=%left,%right order=*

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @private_completion_leaves(%initial: reg<test.fixed.r0>, %condition: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %fixed = test.fixed.update.i32 %initial, %condition
  %unrelated = test.add.i32 %lhs, %rhs
  %left = test.const.i32 1
  %right = test.const.i32 2
  %delta = test.add.i32 %left, %right
  %updated = test.fixed.update.i32 %fixed, %delta
  %result = copy %updated : reg<test.fixed.r0> -> reg<test.i32>
  return %result, %unrelated
}

// ----
block 0 order: 0, 2, 3, 4, 5, 6, 1, 7
