// A fixed register is a stricter placement of storage already available to
// its input class. Preserve the singleton's exclusion ordering.
// RUN: emit low-schedule-query @required_fixed_subset strategy=resource-stall kind=order consumer=0

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @required_fixed_subset(%source: reg<test.explicit32>, %other: reg<test.i32>) -> (reg<test.i32>) asm {
  %private = copy %source : reg<test.explicit32> -> reg<test.fixed.r0>
  %dependency = test.add.i32 %other, %other
  %result = test.fixed.select.i32 %dependency, %other, %private
  return %result
}

// ----
node 0 <- 1

// ====

// A singleton outside the source's candidate set cannot replace its captured
// storage. The destination's cardinality alone does not establish containment.
// RUN: emit low-schedule-query @required_fixed_disjoint strategy=resource-stall kind=order consumer=0

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @required_fixed_disjoint(%source: reg<test.coindexed.partner>, %other: reg<test.i32>) -> (reg<test.i32>) asm {
  %private = copy %source : reg<test.coindexed.partner> -> reg<test.fixed.r0>
  %dependency = test.add.i32 %other, %other
  %result = test.fixed.select.i32 %dependency, %other, %private
  return %result
}

// ----
node 0 <- none

// ====

// A sole SSA dependency cannot unlock a descriptor beyond a source boundary.
// Keep its private constant behind work in the currently admitted range.
// RUN: emit low-schedule-query @private_setup_after_boundary strategy=resource-stall per-user-placement-values=%private order=*

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @private_setup_after_boundary(%rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %private = test.const.i32 1
  %ordinary = test.const.zero.i32
  test.barrier
  %result = test.add.i32 %private, %rhs
  return %ordinary, %result
}

// ----
block 0 order: 1, 0, 2, 3, 4

// ====

// A later-range consumer remains blocked when an earlier producer reduces
// its dependency frontier to one group during scheduling.
// RUN: emit low-schedule-query @private_setup_after_boundary_incremental strategy=resource-stall per-user-placement-values=%private order=*

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @private_setup_after_boundary_incremental(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %private = test.const.i32 1
  %prepared = test.add.i32 %lhs, %rhs
  %ordinary = test.mul.i32 %prepared, %rhs
  test.barrier
  %result = test.add.i32 %private, %prepared
  return %ordinary, %result
}

// ----
block 0 order: 1, 2, 0, 3, 4, 5

// ====

// Entering a later range publishes its own sole-producer unlocks. The private
// constant can now expose a consumer instead of waiting behind ordinary work.
// RUN: emit low-schedule-query @private_setup_in_admitted_range strategy=resource-stall per-user-placement-values=%private order=*

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @private_setup_in_admitted_range(%rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  test.barrier
  %private = test.const.i32 1
  %ordinary = test.const.zero.i32
  %result = test.add.i32 %private, %rhs
  return %ordinary, %result
}

// ----
block 0 order: 0, 1, 3, 2, 4
