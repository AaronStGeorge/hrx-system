block 0 order: 0, 1, 2, 3, 4, 5, 6, 7
scheduled pressure test.i32: peak-live-units=8 peak-live-values=5

// ====

// Early writes need input and output storage simultaneously, even when the
// ordinary input/output widths are equal.
// RUN: emit low-schedule-query @early_write_overlap strategy=resource-stall test.i32=8 required-register-values=%source,%private,%first,%second,%third,%fourth per-user-placement-values=%private order=* scheduled-pressure=test.i32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @early_write_overlap(%source: reg<test.i32 x4>) -> (reg<test.i32 x4>) asm {
  %private = test.early_clobber.v4i32 %source
  %first = test.const.i32 1
  %second = test.const.i32 2
  %third = test.const.i32 3
  %fourth = test.const.i32 4
  %wide = concat(%first, %second, %third, %fourth) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  %result = test.add.v4i32 %private, %wide
  return %result
}

// ----
block 0 order: 0, 1, 2, 3, 4, 5, 6, 7
scheduled pressure test.i32: peak-live-units=8 peak-live-values=5

// ====

// A late read overlaps result writes just like an early-clobber result. Its
// captured input must remain available to ordinary pressure scheduling.
// RUN: emit low-schedule-query @required_late_input kind=order consumer=* per-user-placement-values=%private required-register-values=%source,%private

x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @required_late_input(%source: reg<x86.gpr32>, %other: reg<x86.xmm>) -> (reg<x86.gpr32 x2>) asm {
  %private = sub.if_uge.imm.gpr32 %source, 17
  %dependency = copy %other : reg<x86.xmm> -> reg<x86.gpr32>
  %result = concat(%private, %dependency) : (reg<x86.gpr32>, reg<x86.gpr32>) -> reg<x86.gpr32 x2>
  return %result
}

