// ====

// Delaying this contraction would hold both required inputs while the
// independent tuple grows in the same bank.
// RUN: emit low-schedule-query @same_bank_contraction strategy=resource-stall test.i32=8 required-register-values=%left,%right,%private,%first,%second,%third,%fourth per-user-placement-values=%private order=* scheduled-pressure=test.i32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @same_bank_contraction(%left: reg<test.i32 x4>, %right: reg<test.i32 x4>) -> (reg<test.i32 x4>) asm {
  %private = test.add.v4i32 %left, %right
  %first = test.const.i32 1
  %second = test.const.i32 2
  %third = test.const.i32 3
  %fourth = test.const.i32 4
  %wide = concat(%first, %second, %third, %fourth) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  %result = test.add.v4i32 %private, %wide
  return %result
}

