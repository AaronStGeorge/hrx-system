// Two of the four physical registers are held across a source-order fence.
// Their outer completion must not pin the new inner register chains.
// RUN: emit low-schedule-query @required_completion_after_fence strategy=resource-stall order=* scheduled-pressure=test.explicit32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @required_completion_after_fence(%seed: reg<test.i32 x2>) -> (reg<test.explicit32 x2>, reg<test.explicit32>) asm {
  %held = copy %seed : reg<test.i32 x2> -> reg<test.explicit32 x2>
  low.schedule.fence
  %first = test.const.explicit32 1
  %second = test.const.explicit32 2
  %third = test.const.explicit32 3
  %left = test.rematerialize.pair.explicit32 %first, %third
  %inner = test.rematerialize.pair.explicit32 %left, %second
  return %held, %inner
}

// ----
block 0 order: 0, 1, 2, 4, 5, 3, 6, 7
scheduled pressure test.explicit32: peak-live-units=4 peak-live-values=3

// ====

// The same later range has identical pressure when the held physical storage
// enters as a function argument.
// RUN: emit low-schedule-query @required_completion_from_argument strategy=resource-stall order=* scheduled-pressure=test.explicit32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @required_completion_from_argument(%held: reg<test.explicit32 x2>) -> (reg<test.explicit32 x2>, reg<test.explicit32>) asm {
  low.schedule.fence
  %first = test.const.explicit32 1
  %second = test.const.explicit32 2
  %third = test.const.explicit32 3
  %left = test.rematerialize.pair.explicit32 %first, %third
  %inner = test.rematerialize.pair.explicit32 %left, %second
  return %held, %inner
}

// ----
block 0 order: 0, 1, 3, 4, 2, 5, 6
scheduled pressure test.explicit32: peak-live-units=4 peak-live-values=3
