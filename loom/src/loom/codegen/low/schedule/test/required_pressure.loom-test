// Two of the four physical registers are held across a source-order fence.
// Their outer completion must not pin the new inner register chains.
// RUN: emit low-schedule-query @required_completion_after_fence strategy=resource-stall order=* scheduled-pressure=test.explicit32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @required_completion_after_fence(%seed: reg<test.i32 x2>) -> (reg<test.explicit32 x2>, reg<test.explicit32>) asm {
  %held = copy %seed : reg<test.i32 x2> -> reg<test.explicit32 x2>
  low.schedule.fence
  %first = test.const.explicit32 1
  %second = test.const.explicit32 2
  %third = test.const.explicit32 3
  %left = test.rematerialize.pair.explicit32 %first, %third
  %inner = test.rematerialize.pair.explicit32 %left, %second
  return %held, %inner
}

// ----
block 0 order: 0, 1, 2, 4, 5, 3, 6, 7
scheduled pressure test.explicit32: peak-live-units=4 peak-live-values=3

// ====

// The same later range has identical pressure when the held physical storage
// enters as a function argument.
// RUN: emit low-schedule-query @required_completion_from_argument strategy=resource-stall order=* scheduled-pressure=test.explicit32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @required_completion_from_argument(%held: reg<test.explicit32 x2>) -> (reg<test.explicit32 x2>, reg<test.explicit32>) asm {
  low.schedule.fence
  %first = test.const.explicit32 1
  %second = test.const.explicit32 2
  %third = test.const.explicit32 3
  %left = test.rematerialize.pair.explicit32 %first, %third
  %inner = test.rematerialize.pair.explicit32 %left, %second
  return %held, %inner
}

// ----
block 0 order: 0, 1, 3, 4, 2, 5, 6
scheduled pressure test.explicit32: peak-live-units=4 peak-live-values=3

// ====

// The held payload must survive to a later store. Once the second load issues,
// its arithmetic consumer is latency-stalled while the store can immediately
// retire another required owner in the same full bank. Fill that latency slot
// without increasing peak pressure.
// RUN: emit low-schedule-query @required_memory_completion_after_fence strategy=resource-stall test.i32=12 required-register-values=%payload,%first,%second order=* scheduled-pressure=test.i32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @required_memory_completion_after_fence(%address: reg<test.ptr>, %held: reg<test.i32 x4>, %seed: reg<test.i32 x4>) -> (reg<test.i32 x4>) asm {
  %payload = test.add.v4i32 %seed, %seed
  low.schedule.fence
  %first = test.load.v4i32 %address
  %released = test.add.v4i32 %first, %held
  %second = test.load.v4i32 %address
  test.store.v4i32 %address, %payload
  %result = test.add.v4i32 %second, %released
  return %result
}

// ----
block 0 order: 0, 1, 2, 3, 4, 5, 6, 7
scheduled pressure test.i32: peak-live-units=12 peak-live-values=3

// ====

// Equal capacities do not identify the same physical register domain. The
// float store cannot borrow readiness priority from the full integer domain;
// preserving its independent completion keeps integer pressure at 12 units.
// RUN: emit low-schedule-query @distinct_completion_domains strategy=resource-stall test.i32=12 test.f32=12 required-register-values=%payload,%first,%second,%f_payload,%f_held0,%f_held1 order=* scheduled-pressure=test.i32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @distinct_completion_domains(%address: reg<test.ptr>, %held: reg<test.i32 x4>, %seed: reg<test.i32 x4>, %f_payload: reg<test.f32 x4>, %f_held0: reg<test.f32 x4>, %f_held1: reg<test.f32 x4>) -> (reg<test.i32 x4>, reg<test.i32 x4>, reg<test.f32 x4>, reg<test.f32 x4>) asm {
  %payload = test.add.v4i32 %seed, %seed
  low.schedule.fence
  %first = test.load.v4i32 %address
  %released = test.add.v4i32 %first, %held
  %second = test.load.v4i32 %address
  test.store.v4f32 %address, %f_payload
  %result = test.add.v4i32 %second, %released
  return %result, %payload, %f_held0, %f_held1
}

// ----
block 0 order: 0, 1, 2, 3, 4, 6, 5, 7
scheduled pressure test.i32: peak-live-units=12 peak-live-values=3
