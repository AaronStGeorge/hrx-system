// RUN: roundtrip

// Function definition and call ops.
func.def @identity(%x: f32) -> (f32) {
  func.return %x : f32
}

func.def @call_identity(%x: f32) -> (f32) {
  %r = func.call @identity(%x) : (f32) -> (f32)
  func.return %r : f32
}

// ====

// Conditional exits retain their taken-path work and use the enclosing
// function-like body's native return terminator.
func.def @conditional_return(%done: i1, %value: i32) -> (i32) {
  func.exit %done : i1 {
    func.return %value : i32
  }
  func.return %value : i32
}

func.def @conditional_dependent_return(%done: i1, %width: index, %value: vector<[%width]xf32>) -> (vector<[%width]xf32>) {
  func.exit %done : i1 {
    func.return %value : vector<[%width]xf32>
  }
  func.return %value : vector<[%width]xf32>
}

kernel.def @conditional_kernel() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%done: i1) {
  func.exit %done : i1 {
    kernel.return
  }
  kernel.return
}

// A direct callable-body path may state that it cannot reach the ordinary
// result-bearing return. The same terminator is valid for runtime kernels.
func.def @never_returns() -> (i32) {
  func.unreachable
}

kernel.def @unreachable_kernel() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  func.unreachable
}

// ====

// Link-once definitions retain public source visibility while permitting
// repeated definitions to coalesce during module linking.
func.def public linkonce @header_identity(%x: f32) -> (f32) {
  func.return %x : f32
}

// ====

// Inline policy and temperature modifiers on function definitions and calls.
func.def hot inline @hot_inline_identity(%x: f32) -> (f32) {
  func.return %x : f32
}

func.def cold noinline @cold_serializer(%x: f32) -> (f32) {
  func.return %x : f32
}

func.def @call_with_edge_policy(%x: f32) -> (f32) {
  %r = func.call hot inline @hot_inline_identity(%x) : (f32) -> (f32)
  func.return %r : f32
}

// ====

// External function declaration with no body.
func.decl @extern_matmul(%a: f32, %b: f32) -> (f32)

// ====

// Compile-time family declarations own stable contracts without becoming
// ordinary callable symbols or naming provider-library paths.

template.decl @test.effect(%value: i32) -> (i32)

template.decl @test.constrained(%M: index, %value: tensor<[%M]xf32>) -> (tensor<[%M]xf32>) where [multiple_of(%M, 16)]

// ====

// Declaration contract carrying author inline policy for provider-backed import.
func.decl hot inline @extern_small_helper(%x: f32) -> (f32)

// ====

// Declaration with import source module.
func.decl import("linalg_lib") @matmul(%a: f32, %b: f32) -> (f32)

// ====

// Declaration with import source module and aliased symbol name.
func.decl import("math_lib", "matmul_v2") @my_matmul(%a: f32) -> (f32)

// ====

// Public re-exported import declaration.
func.decl public import("upstream") @relu(%x: f32) -> (f32)

// ====

// Retained private callable symbols remain ordinary private symbols but are
// preserved by symbol DCE.
template.decl @test.effect(%value: i32) -> (i32)

func.def retain @retained_identity(%x: f32) -> (f32) {
  func.return %x : f32
}

func.decl retain @retained_extern(%x: f32) -> (f32)

template.def<@test.effect> retain @retained_template(%value: i32) -> (i32) {
  template.return %value : i32
}

template.ukernel<@test.effect> retain @retained_ukernel(%value: i32) -> (i32)

// ====

// Multiple function definitions in a single module.
func.def @first(%a: i32, %b: i32) -> (i32) {
  func.return %a : i32
}

func.def @second(%x: f32) -> (f32) {
  func.return %x : f32
}

func.def @third() {
  func.return
}

// ====

// Initializer and deinitializer calling conventions with zero-operand return.
func.def initializer @setup() {
  func.return
}

func.def deinitializer @teardown() {
  func.return
}

// ====

// Template and ukernel temperature modifiers share the same author-facing
// spelling; template.apply names a family rather than a direct implementation.
template.decl @test.effect(%value: i32) -> (i32)

template.def<@test.effect> hot @pure_template(%value: i32) -> (i32) {
  template.return %value : i32
}

template.ukernel<@test.effect> cold @opaque_template(%value: i32) -> (i32)

func.def @apply_with_edge_policy(%value: i32) -> (i32) {
  %result = template.apply<@test.effect>(%value) cold : (i32) -> (i32)
  func.return %result : i32
}

// ====

// Providers state only the applicability constraints their implementations
// actually require. Identity and normalized target facts are independent.
test.target<low_core> @gfx1100

template.decl @test.effect(%value: i32) -> (i32)

template.def<@test.effect> target(@gfx1100) priority(10) @gfx11_template(%value: i32) -> (i32) {
  template.return %value : i32
}

template.def<@test.effect> requires [#target.subgroup.size<64>] priority(7) @subgroup_64_template(%value: i32) -> (i32) where [eq(%value, 7)] {
  template.return %value : i32
}

template.ukernel<@test.effect> requires [#target.subgroup.size<32>] priority(5) @subgroup_32_opaque(%value: i32) -> (i32)
