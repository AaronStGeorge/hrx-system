// RUN: pass canonicalize
func.def @scaling_f8E4M3() -> (f8E4M3, i32, f8E4M3) {
  %input = scalar.constant -1.5 : f8E4M3
  %power = scalar.constant -2 : i32
  %fraction, %exponent = scalar.frexpf %input : f8E4M3, i32
  %scaled = scalar.ldexpf %input, %power : f8E4M3, i32
  func.return %fraction, %exponent, %scaled : f8E4M3, i32, f8E4M3
}

// ----
func.def @scaling_f8E4M3() -> (f8E4M3, i32, f8E4M3) {
  %fraction = scalar.constant -0.75 : f8E4M3
  %exponent = scalar.constant 1 : i32
  %scaled = scalar.constant -0.375 : f8E4M3
  func.return %fraction, %exponent, %scaled : f8E4M3, i32, f8E4M3
}

