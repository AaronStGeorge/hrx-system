// RUN: pass canonicalize

// Any float rounding op applied to an already-rounded value is redundant.
func.def @rounding_chain(%x: f32) -> (f32, f32) {
  %floor = scalar.floorf %x : f32
  %ceil_floor = scalar.ceilf %floor : f32
  %round = scalar.roundf %x : f32
  %trunc_round = scalar.truncf %round : f32
  func.return %ceil_floor, %trunc_round : f32, f32
}
// ----
func.def @rounding_chain(%x: f32) -> (f32, f32) {
  %floor = scalar.floorf %x : f32
  %round = scalar.roundf %x : f32
  func.return %floor, %round : f32, f32
}

// ====

// powf handles structural exponent identities without requiring exact lhs.
func.def @powf_special_exponents(%x: f32) -> (f32, f32, f32) {
  %c0 = scalar.constant 0.0 : f32
  %c1 = scalar.constant 1.0 : f32
  %c2 = scalar.constant 2.0 : f32
  %pow0 = scalar.powf %x, %c0 : f32
  %pow1 = scalar.powf %x, %c1 : f32
  %pow2 = scalar.powf<nnan|ninf|nsz> %x, %c2 : f32
  func.return %pow0, %pow1, %pow2 : f32, f32, f32
}
// ----
func.def @powf_special_exponents(%x: f32) -> (f32, f32, f32) {
  %pow0 = scalar.constant 1.0 : f32
  %pow2 = scalar.mulf<nnan|ninf|nsz> %x, %x : f32
  func.return %pow0, %x, %pow2 : f32, f32, f32
}

// ====

// nnan alone does not prove log(exp(x)) is safe to cancel: exp can overflow.
func.def @log_exp_keeps_domain_and_overflow_semantics(%x: f32) -> (f32) {
  %exp = scalar.expf<nnan> %x : f32
  %log = scalar.logf<nnan> %exp : f32
  func.return %log : f32
}

// ====

// Semantic activation facts fold exact constants without erasing the named op
// surface for dynamic values.
func.def @activation_exact_zero() -> (f32, f32, f32, f32, f32, f32) {
  %c0 = scalar.constant 0.0 : f32
  %logistic = scalar.logisticf %c0 : f32
  %silu = scalar.siluf %c0 : f32
  %softplus = scalar.softplusf %c0 : f32
  %gelu_erf = scalar.geluf<erf> %c0 : f32
  %gelu_tanh = scalar.geluf<tanh> %c0 : f32
  %gelu_logistic = scalar.geluf<logistic> %c0 {scale = 1.702} : f32
  func.return %logistic, %silu, %softplus, %gelu_erf, %gelu_tanh, %gelu_logistic : f32, f32, f32, f32, f32, f32
}

// ----
func.def @activation_exact_zero() -> (f32, f32, f32, f32, f32, f32) {
  %logistic = scalar.constant 0.5 : f32
  %silu = scalar.constant 0.0 : f32
  %softplus = scalar.constant 0.69314718246459961 : f32
  %gelu_erf = scalar.constant 0.0 : f32
  %gelu_tanh = scalar.constant 0.0 : f32
  %gelu_logistic = scalar.constant 0.0 : f32
  func.return %logistic, %silu, %softplus, %gelu_erf, %gelu_tanh, %gelu_logistic : f32, f32, f32, f32, f32, f32
}

// ====

// Stable exact activation facts preserve representable negative tails instead
// of collapsing through an overflowing exp(-x) intermediate.
func.def @activation_negative_tail() -> (i1, i1, i1, i1, i1, i1) {
  %f32_input = scalar.constant -100.0 : f32
  %f32_sign_threshold = scalar.constant 0.0 : f32
  %f32_logistic = scalar.logisticf %f32_input : f32
  %f32_silu = scalar.siluf %f32_input : f32
  %f32_gelu = scalar.geluf<logistic> %f32_input {scale = 1.0} : f32
  %f32_logistic_positive = scalar.cmpf ogt, %f32_logistic, %f32_sign_threshold : f32
  %f32_silu_negative = scalar.cmpf olt, %f32_silu, %f32_sign_threshold : f32
  %f32_gelu_negative = scalar.cmpf olt, %f32_gelu, %f32_sign_threshold : f32

  %f64_input = scalar.constant -710.0 : f64
  %f64_sign_threshold = scalar.constant 0.0 : f64
  %f64_logistic = scalar.logisticf %f64_input : f64
  %f64_silu = scalar.siluf %f64_input : f64
  %f64_gelu = scalar.geluf<logistic> %f64_input {scale = 1.0} : f64
  %f64_logistic_positive = scalar.cmpf ogt, %f64_logistic, %f64_sign_threshold : f64
  %f64_silu_negative = scalar.cmpf olt, %f64_silu, %f64_sign_threshold : f64
  %f64_gelu_negative = scalar.cmpf olt, %f64_gelu, %f64_sign_threshold : f64
  func.return %f32_logistic_positive, %f32_silu_negative, %f32_gelu_negative, %f64_logistic_positive, %f64_silu_negative, %f64_gelu_negative : i1, i1, i1, i1, i1, i1
}
// ----
func.def @activation_negative_tail() -> (i1, i1, i1, i1, i1, i1) {
  %f32_logistic_positive = scalar.constant true : i1
  %f32_silu_negative = scalar.constant true : i1
  %f32_gelu_negative = scalar.constant true : i1
  %f64_logistic_positive = scalar.constant true : i1
  %f64_silu_negative = scalar.constant true : i1
  %f64_gelu_negative = scalar.constant true : i1
  func.return %f32_logistic_positive, %f32_silu_negative, %f32_gelu_negative, %f64_logistic_positive, %f64_silu_negative, %f64_gelu_negative : i1, i1, i1, i1, i1, i1
}

// ====

// Turn-domain trig facts fold exact turns directly.
func.def @turn_trig_exact_quadrants() -> (f32, f32, f32, f32) {
  %c0 = scalar.constant 0.0 : f32
  %quarter = scalar.constant 0.25 : f32
  %sin_zero = scalar.sinturnsf %c0 : f32
  %cos_zero = scalar.costurnsf %c0 : f32
  %sin_quarter = scalar.sinturnsf %quarter : f32
  %cos_quarter = scalar.costurnsf %quarter : f32
  func.return %sin_zero, %cos_zero, %sin_quarter, %cos_quarter : f32, f32, f32, f32
}
// ----
func.def @turn_trig_exact_quadrants() -> (f32, f32, f32, f32) {
  %sin_zero = scalar.constant 0.0 : f32
  %cos_zero = scalar.constant 1.0 : f32
  %sin_quarter = scalar.constant 1.0 : f32
  %cos_quarter = scalar.constant 0.0 : f32
  func.return %sin_zero, %cos_zero, %sin_quarter, %cos_quarter : f32, f32, f32, f32
}

// ====

// This non-cardinal f32 input fixes the shared turns result payload. A host
// libm evaluation differs by one f32 step and is not a valid folding oracle.
func.def @turn_trig_frozen_f32_mapping() -> (i32) {
  %input_bits = scalar.constant 1180433910 : i32
  %input = scalar.bitcast %input_bits : i32 to f32
  %result = scalar.sinturnsf %input : f32
  %result_bits = scalar.bitcast %result : f32 to i32
  func.return %result_bits : i32
}
// ----
func.def @turn_trig_frozen_f32_mapping() -> (i32) {
  %result_bits = scalar.constant 1031482228 : i32
  func.return %result_bits : i32
}

// ====

// The F64 input distinguishes the fixed unfused exponential from contraction.
// Ordinary roots and exp2 preserve subnormals instead of using the approximate
// leaf's flush-to-zero profile.
func.def @ordinary_math_mapping() -> (i64, f32, f64, f32) {
  %input = scalar.constant -2.7638700436113073 : f64
  %result = scalar.expf %input : f64
  %bits = scalar.bitcast %result : f64 to i64
  %minimum = scalar.constant 1.4012984643248171e-45 : f32
  %root = scalar.sqrtf %minimum : f32
  %exponent = scalar.constant -1074.0 : f64
  %subnormal = scalar.exp2f %exponent : f64
  %value = scalar.constant 7.9228181403112027e+28 : f32
  %inverse = scalar.rsqrtf %value : f32
  func.return %bits, %root, %subnormal, %inverse : i64, f32, f64, f32
}

// ----
func.def @ordinary_math_mapping() -> (i64, f32, f64, f32) {
  %bits = scalar.constant 4589207457398273482 : i64
  %root = scalar.constant 3.7433920665092162e-23 : f32
  %subnormal = scalar.constant 4.9406564584124654e-324 : f64
  %inverse = scalar.constant 3.5527132552840273e-15 : f32
  func.return %bits, %root, %subnormal, %inverse : i64, f32, f64, f32
}

// ====

func.def @cube_roots() -> (f8E4M3, f8E5M2, f16, bf16, f32, f64) {
  %input0 = scalar.constant 2.0 : f8E4M3
  %root0 = scalar.cbrtf %input0 : f8E4M3
  %input1 = scalar.constant 2.0 : f8E5M2
  %root1 = scalar.cbrtf %input1 : f8E5M2
  %input2 = scalar.constant 2.0 : f16
  %root2 = scalar.cbrtf %input2 : f16
  %input3 = scalar.constant 2.0 : bf16
  %root3 = scalar.cbrtf %input3 : bf16
  %input4 = scalar.constant 2.0 : f32
  %root4 = scalar.cbrtf %input4 : f32
  %input5 = scalar.constant 2.0 : f64
  %root5 = scalar.cbrtf %input5 : f64
  func.return %root0, %root1, %root2, %root3, %root4, %root5 : f8E4M3, f8E5M2, f16, bf16, f32, f64
}

// ----
func.def @cube_roots() -> (f8E4M3, f8E5M2, f16, bf16, f32, f64) {
  %root0 = scalar.constant 1.25 : f8E4M3
  %root1 = scalar.constant 1.25 : f8E5M2
  %root2 = scalar.constant 1.259765625 : f16
  %root3 = scalar.constant 1.2578125 : bf16
  %root4 = scalar.constant 1.2599210739135742 : f32
  %root5 = scalar.constant 1.2599210498948732 : f64
  func.return %root0, %root1, %root2, %root3, %root4, %root5 : f8E4M3, f8E5M2, f16, bf16, f32, f64
}

// ====
// Logarithms share numerical mappings across narrow and native carriers.
func.def @ordinary_logarithms() -> (f8E4M3, f8E5M2, f16, bf16, f32, f64) {
  %a = scalar.constant 2.0 : f8E4M3
  %b = scalar.constant 0.5 : f8E5M2
  %c = scalar.constant 10.0 : f16
  %d = scalar.constant 0.00390625 : bf16
  %minimum = scalar.constant 1.4012984643248171e-45 : f32
  %tiny = scalar.constant 4.9406564584124654e-324 : f64
  %natural = scalar.logf %a : f8E4M3
  %base_two = scalar.log2f %b : f8E5M2
  %base_ten = scalar.log10f %c : f16
  %increment = scalar.log1pf %d : bf16
  %subnormal = scalar.log2f %minimum : f32
  %cancellation = scalar.log1pf %tiny : f64
  func.return %natural, %base_two, %base_ten, %increment, %subnormal, %cancellation : f8E4M3, f8E5M2, f16, bf16, f32, f64
}

// ----
func.def @ordinary_logarithms() -> (f8E4M3, f8E5M2, f16, bf16, f32, f64) {
  %natural = scalar.constant 0.6875 : f8E4M3
  %base_two = scalar.constant -1.0 : f8E5M2
  %base_ten = scalar.constant 1.0 : f16
  %increment = scalar.constant 0.00390625 : bf16
  %subnormal = scalar.constant -149.0 : f32
  %cancellation = scalar.constant 4.9406564584124654e-324 : f64
  func.return %natural, %base_two, %base_ten, %increment, %subnormal, %cancellation : f8E4M3, f8E5M2, f16, bf16, f32, f64
}

// ====
func.def @exponential_difference() -> (f32, f64) {
  %tiny = scalar.constant 1.4012984643248171e-45 : f32
  %small = scalar.constant -0.00390625 : f64
  %single = scalar.expm1f %tiny : f32
  %wide = scalar.expm1f %small : f64
  func.return %single, %wide : f32, f64
}

// ----
func.def @exponential_difference() -> (f32, f64) {
  %single = scalar.constant 1.4012984643248171e-45 : f32
  %wide = scalar.constant -0.00389863052988251 : f64
  func.return %single, %wide : f32, f64
}

// ====

// A fractional power retains the full input exponent range and uses the
// shared mapping, including the selected one-step rounding at this boundary.
func.def @power_full_precision() -> (f32, f64) {
  %base32 = scalar.constant 1.0000325441360474 : f32
  %exponent32 = scalar.constant -2220941.75 : f32
  %base64 = scalar.constant 2.2250738585072009e-308 : f64
  %exponent64 = scalar.constant -0.5 : f64
  %single = scalar.powf %base32, %exponent32 : f32
  %wide = scalar.powf %base64, %exponent64 : f64
  func.return %single, %wide : f32, f64
}

// ----
func.def @power_full_precision() -> (f32, f64) {
  %single = scalar.constant 4.0766217554913857e-32 : f32
  %wide = scalar.constant 6.7039039649712985e+153 : f64
  func.return %single, %wide : f32, f64
}

// ====

func.def @scalar_hyperbolic_boundaries() -> (f32, f64, f64, f16, bf16, f64) {
  %tanh_input = scalar.constant 0.40029323101043701 : f32
  %tanh_result = scalar.tanhf %tanh_input : f32
  %sinh_input = scalar.constant 710.0 : f64
  %sinh_result = scalar.sinhf %sinh_input : f64
  %cosh_input = scalar.constant 710.0 : f64
  %cosh_result = scalar.coshf %cosh_input : f64
  %asinh_input = scalar.constant 6.103515625e-05 : f16
  %asinh_result = scalar.asinhf %asinh_input : f16
  %acosh_input = scalar.constant 1.0078125 : bf16
  %acosh_result = scalar.acoshf %acosh_input : bf16
  %atanh_input = scalar.constant 4.9406564584124654e-324 : f64
  %atanh_result = scalar.atanhf %atanh_input : f64
  func.return %tanh_result, %sinh_result, %cosh_result, %asinh_result, %acosh_result, %atanh_result : f32, f64, f64, f16, bf16, f64
}

// ----
func.def @scalar_hyperbolic_boundaries() -> (f32, f64, f64, f16, bf16, f64) {
  %tanh_result = scalar.constant 0.38019981980323792 : f32
  %sinh_result = scalar.constant 1.1169973830808557e+308 : f64
  %cosh_result = scalar.constant 1.1169973830808557e+308 : f64
  %asinh_result = scalar.constant 6.103515625e-05 : f16
  %acosh_result = scalar.constant 0.125 : bf16
  %atanh_result = scalar.constant 4.9406564584124654e-324 : f64
  func.return %tanh_result, %sinh_result, %cosh_result, %asinh_result, %acosh_result, %atanh_result : f32, f64, f64, f16, bf16, f64
}

// ====

func.def @scalar_inverse_trigonometry() -> (f32, f64, bf16, f8E5M2) {
  %asin_input = scalar.constant 0.99999994039535522 : f32
  %asin_result = scalar.asinf %asin_input : f32
  %acos_input = scalar.constant 0.99999999999999989 : f64
  %acos_result = scalar.acosf %acos_input : f64
  %atan_input = scalar.constant -1.0 : bf16
  %atan_result = scalar.atanf %atan_input : bf16
  %atan2_input = scalar.constant 0.5 : f8E5M2
  %negative_x = scalar.constant -0.5 : f8E5M2
  %atan2_result = scalar.atan2f %atan2_input, %negative_x : f8E5M2
  func.return %asin_result, %acos_result, %atan_result, %atan2_result : f32, f64, bf16, f8E5M2
}

// ----
func.def @scalar_inverse_trigonometry() -> (f32, f64, bf16, f8E5M2) {
  %asin_result = scalar.constant 1.570451021194458 : f32
  %acos_result = scalar.constant 1.4901161193847656e-08 : f64
  %atan_result = scalar.constant -0.78515625 : bf16
  %atan2_result = scalar.constant 2.5 : f8E5M2
  func.return %asin_result, %acos_result, %atan_result, %atan2_result : f32, f64, bf16, f8E5M2
}
