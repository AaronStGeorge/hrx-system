// Equal concurrent compositions flatten, but serial branches keep their joins.
// RUN: pass canonicalize

kernel.entry.decl @first()

kernel.entry.decl @second()

kernel.entry.decl @third()

kernel.entry.decl @fourth()

command.def @concurrent_composition() launch(%clock: view<1xi64>) {
  %dispatch_count = index.constant 1 : index
  command.concurrent {
    command.concurrent {
      command.serial {
        command.timestamp %clock : view<1xi64>
        kernel.dispatch @first[%dispatch_count]() : [index]()
      }
      kernel.launch.concurrent {
        kernel.launch.concurrent {
          kernel.dispatch @second[%dispatch_count]() : [index]()
        }
        kernel.launch.serial {
          kernel.dispatch @third[%dispatch_count]() : [index]()
          kernel.dispatch @fourth[%dispatch_count]() : [index]()
        }
      }
    }
  }
  command.return
}

