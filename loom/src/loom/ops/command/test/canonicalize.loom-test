// Both serial spellings compose with the implicit serial command body.
// Captured values and allocation definitions retain their original order.
// RUN: pass canonicalize

kernel.entry.decl @consume(%value: i32, %output: buffer)

command.def @serial_composition() launch(%input: view<1xi32>, %output: buffer, %clock: view<1xi64>) {
  %dispatch_count = index.constant 1 : index
  command.serial {
    command.timestamp %clock : view<1xi64>
    %value = view.load %input[0] : view<1xi32> -> i32
    command.serial {
      %bytes = index.constant 16 : offset
      %scratch = buffer.alloca<global> align(8) %bytes : buffer
      kernel.launch.serial {
        kernel.launch.serial {
          kernel.dispatch @consume[%dispatch_count](%value, %scratch) : [index](i32, buffer)
        }
        kernel.dispatch @consume[%dispatch_count](%value, %output) : [index](i32, buffer)
      }
    }
    command.timestamp %clock : view<1xi64>
  }
  command.return
}

