// ====

// An ordinary function does not promise implicit command composition.
// RUN: pass canonicalize

kernel.entry.decl @work()

func.def @explicit_launch_order() {
  %dispatch_count = index.constant 1 : index
  kernel.launch.serial {
    kernel.launch.serial {
      kernel.dispatch @work[%dispatch_count]() : [index]()
    }
    kernel.launch.concurrent {
      kernel.dispatch @work[%dispatch_count]() : [index]()
      kernel.dispatch @work[%dispatch_count]() : [index]()
    }
  }
  func.return
}

