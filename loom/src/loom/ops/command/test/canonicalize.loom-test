// ====

// The helper's serial scope is redundant at the root and necessary in a fork.
// RUN: pass inline-callables,canonicalize

kernel.entry.decl @step()

kernel.entry.decl @other()

command.def @pair() launch() {
  %dispatch_count = index.constant 1 : index
  kernel.dispatch @step[%dispatch_count]() : [index]()
  kernel.dispatch @step[%dispatch_count]() : [index]()
  command.return
}

command.def public @factored_program() launch() {
  %dispatch_count = index.constant 1 : index
  command.launch @pair() : ()
  command.concurrent {
    command.launch @pair() : ()
    kernel.dispatch @other[%dispatch_count]() : [index]()
  }
  command.return
}

