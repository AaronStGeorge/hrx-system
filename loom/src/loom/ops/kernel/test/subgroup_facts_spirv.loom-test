// ====

// Partial subgroups may leave holes among active lane IDs.
spirv.target<vulkan1_3> @device {abi = hal_kernel, subgroup_size = 32}

kernel.def target(@device) @partial_partition() {
  %unit = index.constant 1 : index
  %x = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %unit, %unit) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %subgroup = kernel.subgroup.id : index
  %count = kernel.subgroup.count : index
  %lane_hi = test.fact_range_hi %lane : index -> i64
  %subgroup_hi = test.fact_range_hi %subgroup : index -> i64
  %count_lo = test.fact_range_lo %count : index -> i64
  %count_hi = test.fact_range_hi %count : index -> i64
  test.use %lane_hi, %subgroup_hi, %count_lo, %count_hi : i64, i64, i64, i64
  kernel.return
}

// ----
spirv.target<vulkan1_3> @device {abi = hal_kernel, subgroup_size = 32}

kernel.def target(@device) @partial_partition() {
  %unit = index.constant 1 : index
  %x = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %unit, %unit) : index
} launch() {
  %lane_hi = scalar.constant 31 : i64
  %subgroup_hi = scalar.constant 2 : i64
  %count_lo = scalar.constant 1 : i64
  %count_hi = scalar.constant 3 : i64
  test.use %lane_hi, %subgroup_hi, %count_lo, %count_hi : i64, i64, i64, i64
  kernel.return
}

// ====

// An aligned total invocation count does not establish X alignment.
spirv.target<vulkan1_3> @device {abi = hal_kernel, subgroup_size = 32}

kernel.def target(@device) @unaligned_multidimensional_partition() {
  %unit = index.constant 1 : index
  %x = index.constant 16 : index
  %y = index.constant 4 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %y, %unit) : index
} launch() {
  %subgroup = kernel.subgroup.id : index
  %count = kernel.subgroup.count : index
  %subgroup_hi = test.fact_range_hi %subgroup : index -> i64
  %count_lo = test.fact_range_lo %count : index -> i64
  %count_hi = test.fact_range_hi %count : index -> i64
  test.use %count, %subgroup_hi, %count_lo, %count_hi : index, i64, i64, i64
  kernel.return
}

// ----
spirv.target<vulkan1_3> @device {abi = hal_kernel, subgroup_size = 32}

kernel.def target(@device) @unaligned_multidimensional_partition() {
  %unit = index.constant 1 : index
  %x = index.constant 16 : index
  %y = index.constant 4 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %y, %unit) : index
} launch() {
  %count = kernel.subgroup.count : index
  %subgroup_hi = scalar.constant 63 : i64
  %count_lo = scalar.constant 2 : i64
  %count_hi = scalar.constant 64 : i64
  test.use %count, %subgroup_hi, %count_lo, %count_hi : index, i64, i64, i64
  kernel.return
}

// ====

// A retained divisor proves alignment before the exact launch is specialized.
spirv.target<vulkan1_3> @device {abi = hal_kernel, max_flat_workgroup_size = 128, subgroup_size = 32}

kernel.def target(@device) @divisible_dynamic_partition(%groups: index) {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  %bounded = index.assume %groups [range(%groups, 1, 4)] : index
  %x = index.mul %bounded, %width : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %unit, %unit) : index
} launch() {
  %subgroup = kernel.subgroup.id : index
  %count = kernel.subgroup.count : index
  %subgroup_hi = test.fact_range_hi %subgroup : index -> i64
  %count_hi = test.fact_range_hi %count : index -> i64
  test.use %count, %subgroup_hi, %count_hi : index, i64, i64
  kernel.return
}

// ----
spirv.target<vulkan1_3> @device {abi = hal_kernel, max_flat_workgroup_size = 128, subgroup_size = 32}

kernel.def target(@device) @divisible_dynamic_partition(%groups: index) {
  %unit = index.constant 1 : index
  %bounded = index.assume %groups [range(%groups, 1, 4)] : index
  %9 = index.constant 5 : index
  %x = index.shli %bounded, %9 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %unit, %unit) : index
} launch() {
  %count = kernel.subgroup.count : index
  %subgroup_hi = scalar.constant 3 : i64
  %count_hi = scalar.constant 4 : i64
  test.use %count, %subgroup_hi, %count_hi : index, i64, i64
  kernel.return
}

