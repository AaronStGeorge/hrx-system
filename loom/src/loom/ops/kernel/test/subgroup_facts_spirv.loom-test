kernel.def target(@device) @unknown_width_partition() {
  %unit = index.constant 1 : index
  %x = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %unit, %unit) : index
} launch() {
  %width = kernel.subgroup.size : index
  %count = kernel.subgroup.count : index
  test.use %width, %count : index, index
  kernel.return
}
