// RUN: roundtrip

// Each body view refers to its carried extent and layout, while the binding
// annotations describe the initial operands in their enclosing scope.
func.def @changing_view(%input: buffer, %base: offset, %count: index, %initial_rows: index, %initial_layout: encoding<layout>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %initial = buffer.view %input[%base] : buffer -> view<[%initial_rows]x4xi32, %initial_layout>
  %rows, %layout, %view = scf.for %i = [%begin to %count step %step](%body_rows = %initial_rows : index, %body_layout = %initial_layout : encoding<layout>, %body_view = %initial : view<[%initial_rows]x4xi32, %initial_layout>) -> (index, encoding<layout>, view<[%rows]x4xi32, %layout>) {
    test.use %body_view : view<[%body_rows]x4xi32, %body_layout>
    %next_rows = index.sub %body_rows, %step : index
    %next = view.subview %body_view[1, 0] : view<[%body_rows]x4xi32, %body_layout> -> view<[%next_rows]x4xi32, %body_layout>
    scf.yield %next_rows, %body_layout, %next : index, encoding<layout>, view<[%next_rows]x4xi32, %body_layout>
  }
  test.use %view : view<[%rows]x4xi32, %layout>
  func.return
}

// ====

// Two extents initialized with the same value have independent recurring
// identities. A view may also precede the extent it depends on in the tuple.
func.def @duplicate_initial_values(%input: buffer, %base: offset, %count: index, %initial_size: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %right_step = index.constant 2 : index
  %initial = buffer.view %input[%base] : buffer -> view<[%initial_size]xi32>
  %left, %left_size, %right_size, %right = scf.for %i = [%begin to %count step %step](%left_view = %initial : view<[%initial_size]xi32>, %left_extent = %initial_size : index, %right_extent = %initial_size : index, %right_view = %initial : view<[%initial_size]xi32>) -> (view<[%left_size]xi32>, index, index, view<[%right_size]xi32>) {
    %left_next_size = index.sub %left_extent, %step : index
    %right_next_size = index.sub %right_extent, %right_step : index
    %left_next = view.subview %left_view[1] : view<[%left_extent]xi32> -> view<[%left_next_size]xi32>
    %right_next = view.subview %right_view[2] : view<[%right_extent]xi32> -> view<[%right_next_size]xi32>
    scf.yield %left_next, %left_next_size, %right_next_size, %right_next : view<[%left_next_size]xi32>, index, index, view<[%right_next_size]xi32>
  }
  test.use %left : view<[%left_size]xi32>
  test.use %right : view<[%right_size]xi32>
  func.return
}

// ====

// A dependency outside the result tuple stays invariant even when another
// occurrence of that same initial value is carried and changes.
func.def @invariant_dimension(%input: buffer, %base: offset, %count: index, %size: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %initial = buffer.view %input[%base] : buffer -> view<[%size]x[%size]xi32>
  %rows, %view = scf.for %i = [%begin to %count step %step](%body_rows = %size : index, %body_view = %initial : view<[%size]x[%size]xi32>) -> (index, view<[%rows]x[%size]xi32>) {
    %next_rows = index.sub %body_rows, %step : index
    %next = view.subview %body_view[1, 0] : view<[%body_rows]x[%size]xi32> -> view<[%next_rows]x[%size]xi32>
    scf.yield %next_rows, %next : index, view<[%next_rows]x[%size]xi32>
  }
  test.use %view : view<[%rows]x[%size]xi32>
  func.return
}

// ====

// RUN: with-checks pass canonicalize

// Removing an invariant layout column preserves the changing extent's scheme.
// Constant refinement cannot specialize only the initial side of the loop.
func.def @compact_invariant_layout(%input: buffer, %base: offset, %count: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %initial_rows = index.constant 8 : index
  %initial_layout = encoding.layout.strided [8, 1] : encoding<layout>
  %initial = buffer.view %input[%base] : buffer -> view<[%initial_rows]x4xi32, %initial_layout>
  %rows, %layout, %view = scf.for %i = [%begin to %count step %step](%body_rows = %initial_rows : index, %body_layout = %initial_layout : encoding<layout>, %body_view = %initial : view<[%initial_rows]x4xi32, %initial_layout>) -> (index, encoding<layout>, view<[%rows]x4xi32, %layout>) {
    test.use %body_view : view<[%body_rows]x4xi32, %body_layout>
    %next_rows = index.sub %body_rows, %step : index
    %next = view.subview %body_view[1, 0] : view<[%body_rows]x4xi32, %body_layout> -> view<[%next_rows]x4xi32, %body_layout>
    scf.yield %next_rows, %body_layout, %next : index, encoding<layout>, view<[%next_rows]x4xi32, %body_layout>
  }
  test.use %view : view<[%rows]x4xi32, %layout>
  func.return
}

// ----
CHECK: %rows, %view = scf.for * -> (index, view<[%rows]x4xi32, %initial_layout>) {
CHECK: test.use %body_view : view<[%body_rows]x4xi32, %initial_layout>
CHECK: test.use %view : view<[%rows]x4xi32, %initial_layout>
CHECK-NOT: *view<8x4xi32*

// ====

// RUN: verify

// Projecting the body types cannot hide an invalid input annotation.
func.def @wrong_binding_annotation(%input: buffer, %base: offset, %count: index, %size: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %initial = buffer.view %input[%base] : buffer -> view<[%size]xi32>
  // ERROR@+1: TYPE/001 "binding" "type annotation"
  %rows, %view = scf.for %i = [%begin to %count step %step](%body_rows = %size : index, %body_view = %initial : view<4xi32>) -> (index, view<[%rows]xi32>) {
    scf.yield %body_rows, %body_view : index, view<[%body_rows]xi32>
  }
  func.return
}

// ====

// RUN: verify

// Equal initial extents do not let a backedge exchange their distinct roles.
func.def @wrong_yield_dependency(%input: buffer, %base: offset, %count: index, %size: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %initial = buffer.view %input[%base] : buffer -> view<[%size]xi32>
  // ERROR@+1: TYPE/009
  %left_size, %right_size, %view = scf.for %i = [%begin to %count step %step](%left = %size : index, %right = %size : index, %body_view = %initial : view<[%size]xi32>) -> (index, index, view<[%left_size]xi32>) {
    scf.yield %right, %left, %body_view : index, index, view<[%left]xi32>
  }
  func.return
}

// ====

// RUN: pass canonicalize

// Encoding refinement closes over both independently typed state cycles of a
// condition loop. Dynamic dimensions remain bound to the corresponding tuple
// member as the explicit dense layout attachment folds away.
func.def @condition_loop_refines_both_state_schemes(%input: buffer, %base: offset, %initial_rows: index, %keep_going: i1) {
  %step = index.constant 1 : index
  %initial_layout = encoding.layout.dense : encoding<layout>
  %initial = buffer.view %input[%base] : buffer -> view<[%initial_rows]xi32, %initial_layout>
  %rows, %layout, %view = scf.while(%before_rows = %initial_rows : index, %before_layout = %initial_layout : encoding<layout>, %before_view = %initial : view<[%before_rows]xi32, %before_layout>) -> (index, encoding<layout>, view<[%rows]xi32, %layout>) {
    scf.condition %keep_going, %before_rows, %before_layout, %before_view : i1, index, encoding<layout>, view<[%before_rows]xi32, %before_layout>
  } do(%body_rows: index, %body_layout: encoding<layout>, %body_view: view<[%body_rows]xi32, %body_layout>) {
    %next_rows = index.sub %body_rows, %step : index
    %next_view = view.subview %body_view[1] : view<[%body_rows]xi32, %body_layout> -> view<[%next_rows]xi32, %body_layout>
    scf.yield %next_rows, %body_layout, %next_view : index, encoding<layout>, view<[%next_rows]xi32, %body_layout>
  }
  test.use %rows, %view : index, view<[%rows]xi32, %layout>
  func.return
}

// ----
func.def @condition_loop_refines_both_state_schemes(%input: buffer, %base: offset, %initial_rows: index, %keep_going: i1) {
  %step = index.constant 1 : index
  %initial_layout = encoding.layout.dense : encoding<layout>
  %initial = buffer.view %input[%base] : buffer -> view<[%initial_rows]xi32>
  %rows, %layout, %view = scf.while(%before_rows = %initial_rows : index, %before_layout = %initial_layout : encoding<layout>, %before_view = %initial : view<[%before_rows]xi32>) -> (index, encoding<layout>, view<[%rows]xi32>) {
    scf.condition %keep_going, %before_rows, %before_layout, %before_view : i1, index, encoding<layout>, view<[%before_rows]xi32>
  } do(%body_rows: index, %body_layout: encoding<layout>, %body_view: view<[%body_rows]xi32>) {
    %next_rows = index.sub %body_rows, %step : index
    %next_view = view.subview %body_view[1] : view<[%body_rows]xi32> -> view<[%next_rows]xi32>
    scf.yield %next_rows, %body_layout, %next_view : index, encoding<layout>, view<[%next_rows]xi32>
  }
  test.use %rows, %view : index, view<[%rows]xi32>
  func.return
}

// ====

// RUN: pass canonicalize

// A condition loop may carry header state without exposing any body arguments
// or results. Its header tuple still participates in collective refinement.
func.def @condition_loop_refines_header_only_state(%input: buffer, %base: offset, %initial_rows: index, %keep_going: i1) {
  %initial_layout = encoding.layout.dense : encoding<layout>
  %initial = buffer.view %input[%base] : buffer -> view<[%initial_rows]xi32, %initial_layout>
  scf.while(%before_rows = %initial_rows : index, %before_view = %initial : view<[%before_rows]xi32, %initial_layout>) {
    test.use %before_view : view<[%before_rows]xi32, %initial_layout>
    scf.condition %keep_going : i1
  } do {
    scf.yield %initial_rows, %initial : index, view<[%initial_rows]xi32, %initial_layout>
  }
  func.return
}

// ----
func.def @condition_loop_refines_header_only_state(%input: buffer, %base: offset, %initial_rows: index, %keep_going: i1) {
  %initial = buffer.view %input[%base] : buffer -> view<[%initial_rows]xi32>
  scf.while(%before_rows = %initial_rows : index, %before_view = %initial : view<[%before_rows]xi32>) {
    test.use %before_view : view<[%before_rows]xi32>
    scf.condition %keep_going : i1
  } do {
    scf.yield %initial_rows, %initial : index, view<[%initial_rows]xi32>
  }
  func.return
}
