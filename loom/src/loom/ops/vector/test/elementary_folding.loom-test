// RUN: pass canonicalize

func.def @ordinary_vector_math() -> (vector<2xf64>, vector<2xf32>, vector<2xbf16>) {
  %inputs = vector.constant 4.9406564584124654e-324 : vector<2xf64>
  %roots = vector.sqrtf %inputs : vector<2xf64>
  %exponents = vector.constant -149.0 : vector<2xf32>
  %powers = vector.exp2f %exponents : vector<2xf32>
  %narrow = vector.constant 1.0 : vector<2xbf16>
  %natural = vector.expf %narrow : vector<2xbf16>
  func.return %roots, %powers, %natural : vector<2xf64>, vector<2xf32>, vector<2xbf16>
}

// ----
func.def @ordinary_vector_math() -> (vector<2xf64>, vector<2xf32>, vector<2xbf16>) {
  %roots = vector.constant 2.2227587494850775e-162 : vector<2xf64>
  %powers = vector.constant 1.4012984643248171e-45 : vector<2xf32>
  %natural = vector.constant 2.71875 : vector<2xbf16>
  func.return %roots, %powers, %natural : vector<2xf64>, vector<2xf32>, vector<2xbf16>
}

// ====

func.def @vector_cube_roots() -> (vector<2xf16>, vector<2xf64>) {
  %narrow = vector.constant -8.0 : vector<2xf16>
  %wide = vector.constant 4.9406564584124654e-324 : vector<2xf64>
  %narrow_roots = vector.cbrtf %narrow : vector<2xf16>
  %wide_roots = vector.cbrtf %wide : vector<2xf64>
  func.return %narrow_roots, %wide_roots : vector<2xf16>, vector<2xf64>
}

// ----
func.def @vector_cube_roots() -> (vector<2xf16>, vector<2xf64>) {
  %narrow_roots = vector.constant -2.0 : vector<2xf16>
  %wide_roots = vector.constant 1.7031839360032603e-108 : vector<2xf64>
  func.return %narrow_roots, %wide_roots : vector<2xf16>, vector<2xf64>
}

// ====
func.def @vector_logarithms() -> (vector<2xf32>, vector<2xf64>, vector<2xf16>, vector<2xbf16>) {
  %a = vector.constant 2.0 : vector<2xf32>
  %b = vector.constant 4.9406564584124654e-324 : vector<2xf64>
  %c = vector.constant 10.0 : vector<2xf16>
  %d = vector.constant -0.00390625 : vector<2xbf16>
  %natural = vector.logf %a : vector<2xf32>
  %base_two = vector.log2f %b : vector<2xf64>
  %base_ten = vector.log10f %c : vector<2xf16>
  %increment = vector.log1pf %d : vector<2xbf16>
  func.return %natural, %base_two, %base_ten, %increment : vector<2xf32>, vector<2xf64>, vector<2xf16>, vector<2xbf16>
}

// ----
func.def @vector_logarithms() -> (vector<2xf32>, vector<2xf64>, vector<2xf16>, vector<2xbf16>) {
  %natural = vector.constant 0.69314718246459961 : vector<2xf32>
  %base_two = vector.constant -1074.0 : vector<2xf64>
  %base_ten = vector.constant 1.0 : vector<2xf16>
  %increment = vector.constant -0.00390625 : vector<2xbf16>
  func.return %natural, %base_two, %base_ten, %increment : vector<2xf32>, vector<2xf64>, vector<2xf16>, vector<2xbf16>
}

// ====
func.def @vector_exponential_difference() -> (vector<2xf16>, vector<2xf64>) {
  %small = vector.constant 0.00390625 : vector<2xf16>
  %tiny = vector.constant 4.9406564584124654e-324 : vector<2xf64>
  %narrow = vector.expm1f %small : vector<2xf16>
  %wide = vector.expm1f %tiny : vector<2xf64>
  func.return %narrow, %wide : vector<2xf16>, vector<2xf64>
}

// ----
func.def @vector_exponential_difference() -> (vector<2xf16>, vector<2xf64>) {
  %narrow = vector.constant 0.00391387939453125 : vector<2xf16>
  %wide = vector.constant 4.9406564584124654e-324 : vector<2xf64>
  func.return %narrow, %wide : vector<2xf16>, vector<2xf64>
}

// ====

func.def @vector_real_powers() -> (vector<2xbf16>, vector<2xf64>) {
  %narrow_base = vector.constant -2.0 : vector<2xbf16>
  %narrow_exponent = vector.constant -3.0 : vector<2xbf16>
  %wide_base = vector.constant 2.2250738585072009e-308 : vector<2xf64>
  %wide_exponent = vector.constant -0.5 : vector<2xf64>
  %narrow = vector.powf %narrow_base, %narrow_exponent : vector<2xbf16>
  %wide = vector.powf %wide_base, %wide_exponent : vector<2xf64>
  func.return %narrow, %wide : vector<2xbf16>, vector<2xf64>
}

// ----
func.def @vector_real_powers() -> (vector<2xbf16>, vector<2xf64>) {
  %narrow = vector.constant -0.125 : vector<2xbf16>
  %wide = vector.constant 6.7039039649712985e+153 : vector<2xf64>
  func.return %narrow, %wide : vector<2xbf16>, vector<2xf64>
}
