func.def @make_storage_crop(%input: buffer, %origin: offset, %columns: index) -> (%result_storage: encoding<storage>, view<2x3xf32, %result_storage>) {
  %layout = encoding.layout.strided [%columns, 1] : encoding<layout>
  %schema = encoding.define #encoding.f32 : encoding<schema>
  %storage = encoding.define #encoding.storage {layout = %layout : encoding<layout>, schema = %schema : encoding<schema>} : encoding<storage>
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %input_aligned[%origin] : buffer -> view<4x[%columns]xf32, %storage>
  %crop, %crop_storage = view.subview %source[1, 2] : view<4x[%columns]xf32, %storage> -> view<2x3xf32, %crop_storage>
  func.return %crop_storage, %crop : encoding<storage>, view<2x3xf32, %crop_storage>
}

func.def @read_storage_crop(%storage: encoding<storage>, %crop: view<2x3xf32, %storage>) -> (f32) {
  %value = view.load %crop[1, 1] : view<2x3xf32, %storage> -> f32
  func.return %value : f32
}

func.def inline @read_strided_f32_oracle(%input: buffer, %origin: offset, %row: index, %column: index, %row_stride: index, %column_stride: index) -> (f32) {
  %row_offset = index.mul %row, %row_stride : index
  %column_offset = index.mul %column, %column_stride : index
  %position = index.add %row_offset, %column_offset : index
  %element_byte_count = index.constant 4 : index
  %byte_position = index.mul %position, %element_byte_count : index
  %byte_offset = index.cast %byte_position : index to offset
  %address = index.add %origin, %byte_offset : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %input_aligned[%address] : buffer -> view<1xf32>
  %value = view.load %source[0] : view<1xf32> -> f32
  func.return %value : f32
}

kernel.def @subview_composed_helpers() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %width: index) {
  func.call @compute_subview_composed_helpers(%input, %output, %width) : (buffer, buffer, index)
  kernel.return
}

func.def device inline @compute_subview_composed_helpers(%input: buffer, %output: buffer, %width: index) {
  %columns = index.assume %width [range(%width, 8, 12)] : index
  %origin = index.constant 8 : offset
  %storage, %crop = func.call @make_storage_crop(%input, %origin, %columns) : (buffer, offset, index) -> (encoding<storage>, view<2x3xf32, %storage>)
  %value = func.call @read_storage_crop(%storage, %crop) : (encoding<storage>, view<2x3xf32, %storage>) -> (f32)
  %output_origin = index.constant 4 : offset
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %destination = buffer.view %output_aligned[%output_origin] : buffer -> view<1xf32>
  view.store %value, %destination[0] : f32, view<1xf32>
  func.return
}

func.def @subview_composed_helpers_oracle(%input: buffer, %output: buffer, %width: index) {
  %columns = index.assume %width [range(%width, 8, 12)] : index
  %origin = index.constant 8 : offset
  %row = index.constant 2 : index
  %column = index.constant 3 : index
  %column_stride = index.constant 1 : index
  %value = func.call @read_strided_f32_oracle(%input, %origin, %row, %column, %columns, %column_stride) : (buffer, offset, index, index, index, index) -> (f32)
  %output_origin = index.constant 4 : offset
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %destination = buffer.view %output_aligned[%output_origin] : buffer -> view<1xf32>
  view.store %value, %destination[0] : f32, view<1xf32>
  func.return
}

