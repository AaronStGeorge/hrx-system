kernel.def @subview_atomic_origins() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  func.call @compute_subview_atomic_origins(%input, %output) : (buffer, buffer)
  kernel.return
}

func.def device inline @compute_subview_atomic_origins(%input: buffer, %output: buffer) {
  %base = index.constant 8 : offset
  %output_base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %layout = encoding.layout.strided [8, 1] : encoding<layout>
  %view = buffer.view %aligned[%base] : buffer -> view<4x8xi32, %layout>
  %crop, %crop_layout = view.subview %view[1, 2] : view<4x8xi32, %layout> -> view<2x3xi32, %crop_layout>
  %increment = scalar.constant 1 : i32
  view.atomic.reduce<addi> %increment, %crop[1, 1] {ordering = relaxed, scope = device} : i32, view<2x3xi32, %crop_layout>
  %old = view.atomic.rmw<addi> %increment, %crop[1, 1] {ordering = relaxed, scope = device} : i32, view<2x3xi32, %crop_layout> -> i32
  %expected = scalar.addi %old, %increment : i32
  %replacement = scalar.constant 99 : i32
  %observed = view.atomic.cmpxchg %expected, %replacement, %crop[1, 1] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i32, view<2x3xi32, %crop_layout> -> i32
  %results = buffer.view %output[%output_base] : buffer -> view<2xi32>
  view.store %old, %results[0] : i32, view<2xi32>
  view.store %observed, %results[1] : i32, view<2xi32>
  func.return
}

func.def @subview_atomic_origins_oracle(%input: buffer, %output: buffer) {
  func.call @compute_subview_atomic_origins(%input, %output) : (buffer, buffer)
  func.return
}

