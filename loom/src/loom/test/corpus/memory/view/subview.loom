      check.expect.bitwise actual(%input) expected(%input) : tensor<52xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<52xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %base = check.literal value(16) : offset
    %row = check.literal value(1) : index
    %column = check.literal value(1) : index
    %input = check.generate.iota offset(100) step(1) : tensor<52xi32>
    %output = check.generate.fill value(-99) : tensor<52xi32>
    check.compare<@subview_nested_dynamic, @subview_nested_dynamic_oracle>(%input, %output, %base, %row, %column) : (tensor<52xi32>, tensor<52xi32>, offset, index, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<52xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<52xi32>
