// Narrow values retain their storage bank when uniform and lane-varying inputs
// cross sign and wrap boundaries before arithmetic and comparison consumers.
kernel.def @narrow_integer_consumers() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: i32, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %lane_value = index.cast %lane : index to i32
  %varying = scalar.addi %input, %lane_value : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %byte_sign_boundary = scalar.constant 0 : i8
  %halfword_sign_boundary = scalar.constant 0 : i16
  %base = index.constant 64 : offset
  %view = buffer.view %output[%base] : buffer -> view<12x32xi32>
  %input_i8 = scalar.trunci %input : i32 to i8
  %input_i8_unsigned = scalar.extui %input_i8 : i8 to i32
  %input_i8_signed = scalar.extsi %input_i8 : i8 to i32
  %input_i8_unsigned_sum = scalar.addi %input_i8_unsigned, %c1 : i32
  %input_i8_signed_sum = scalar.addi %input_i8_signed, %c1 : i32
  %input_i8_negative = scalar.cmpi slt, %input_i8, %byte_sign_boundary : i8
  %input_i8_comparison = scf.select %input_i8_negative, %c1, %c0 : i32
  view.store %input_i8_unsigned_sum, %view[0, %lane] : i32, view<12x32xi32>
  view.store %input_i8_signed_sum, %view[1, %lane] : i32, view<12x32xi32>
  view.store %input_i8_comparison, %view[8, %lane] : i32, view<12x32xi32>
  %input_i16 = scalar.trunci %input : i32 to i16
  %input_i16_unsigned = scalar.extui %input_i16 : i16 to i32
  %input_i16_signed = scalar.extsi %input_i16 : i16 to i32
  %input_i16_unsigned_sum = scalar.addi %input_i16_unsigned, %c1 : i32
  %input_i16_signed_sum = scalar.addi %input_i16_signed, %c1 : i32
  %input_i16_negative = scalar.cmpi slt, %input_i16, %halfword_sign_boundary : i16
  %input_i16_comparison = scf.select %input_i16_negative, %c1, %c0 : i32
  view.store %input_i16_unsigned_sum, %view[2, %lane] : i32, view<12x32xi32>
  view.store %input_i16_signed_sum, %view[3, %lane] : i32, view<12x32xi32>
  view.store %input_i16_comparison, %view[9, %lane] : i32, view<12x32xi32>
  %varying_i8 = scalar.trunci %varying : i32 to i8
  %varying_i8_unsigned = scalar.extui %varying_i8 : i8 to i32
  %varying_i8_signed = scalar.extsi %varying_i8 : i8 to i32
  %varying_i8_unsigned_sum = scalar.addi %varying_i8_unsigned, %c1 : i32
  %varying_i8_signed_sum = scalar.addi %varying_i8_signed, %c1 : i32
  %varying_i8_negative = scalar.cmpi slt, %varying_i8, %byte_sign_boundary : i8
  %varying_i8_comparison = scf.select %varying_i8_negative, %c1, %c0 : i32
  view.store %varying_i8_unsigned_sum, %view[4, %lane] : i32, view<12x32xi32>
  view.store %varying_i8_signed_sum, %view[5, %lane] : i32, view<12x32xi32>
  view.store %varying_i8_comparison, %view[10, %lane] : i32, view<12x32xi32>
  %varying_i16 = scalar.trunci %varying : i32 to i16
  %varying_i16_unsigned = scalar.extui %varying_i16 : i16 to i32
  %varying_i16_signed = scalar.extsi %varying_i16 : i16 to i32
  %varying_i16_unsigned_sum = scalar.addi %varying_i16_unsigned, %c1 : i32
  %varying_i16_signed_sum = scalar.addi %varying_i16_signed, %c1 : i32
  %varying_i16_negative = scalar.cmpi slt, %varying_i16, %halfword_sign_boundary : i16
  %varying_i16_comparison = scf.select %varying_i16_negative, %c1, %c0 : i32
  view.store %varying_i16_unsigned_sum, %view[6, %lane] : i32, view<12x32xi32>
  view.store %varying_i16_signed_sum, %view[7, %lane] : i32, view<12x32xi32>
  view.store %varying_i16_comparison, %view[11, %lane] : i32, view<12x32xi32>
  kernel.return
}

func.def @narrow_integer_consumers_oracle(%input: i32, %output: buffer) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %byte_sign_boundary = scalar.constant 0 : i8
  %halfword_sign_boundary = scalar.constant 0 : i16
  %base = index.constant 64 : offset
  %view = buffer.view %output[%base] : buffer -> view<12x32xi32>
  %input_i8 = scalar.trunci %input : i32 to i8
  %input_i8_unsigned = scalar.extui %input_i8 : i8 to i32
  %input_i8_signed = scalar.extsi %input_i8 : i8 to i32
  %input_i8_unsigned_sum = scalar.addi %input_i8_unsigned, %c1 : i32
  %input_i8_signed_sum = scalar.addi %input_i8_signed, %c1 : i32
  %input_i8_negative = scalar.cmpi slt, %input_i8, %byte_sign_boundary : i8
  %input_i8_comparison = scf.select %input_i8_negative, %c1, %c0 : i32
  %input_i16 = scalar.trunci %input : i32 to i16
  %input_i16_unsigned = scalar.extui %input_i16 : i16 to i32
  %input_i16_signed = scalar.extsi %input_i16 : i16 to i32
  %input_i16_unsigned_sum = scalar.addi %input_i16_unsigned, %c1 : i32
  %input_i16_signed_sum = scalar.addi %input_i16_signed, %c1 : i32
  %input_i16_negative = scalar.cmpi slt, %input_i16, %halfword_sign_boundary : i16
  %input_i16_comparison = scf.select %input_i16_negative, %c1, %c0 : i32
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %lane_value = index.cast %lane : index to i32
    %varying = scalar.addi %input, %lane_value : i32
    %varying_i8 = scalar.trunci %varying : i32 to i8
    %varying_i8_unsigned = scalar.extui %varying_i8 : i8 to i32
    %varying_i8_signed = scalar.extsi %varying_i8 : i8 to i32
    %varying_i8_unsigned_sum = scalar.addi %varying_i8_unsigned, %c1 : i32
    %varying_i8_signed_sum = scalar.addi %varying_i8_signed, %c1 : i32
    %varying_i8_negative = scalar.cmpi slt, %varying_i8, %byte_sign_boundary : i8
    %varying_i8_comparison = scf.select %varying_i8_negative, %c1, %c0 : i32
    %varying_i16 = scalar.trunci %varying : i32 to i16
    %varying_i16_unsigned = scalar.extui %varying_i16 : i16 to i32
    %varying_i16_signed = scalar.extsi %varying_i16 : i16 to i32
    %varying_i16_unsigned_sum = scalar.addi %varying_i16_unsigned, %c1 : i32
    %varying_i16_signed_sum = scalar.addi %varying_i16_signed, %c1 : i32
    %varying_i16_negative = scalar.cmpi slt, %varying_i16, %halfword_sign_boundary : i16
    %varying_i16_comparison = scf.select %varying_i16_negative, %c1, %c0 : i32
    view.store %input_i8_unsigned_sum, %view[0, %lane] : i32, view<12x32xi32>
    view.store %input_i8_signed_sum, %view[1, %lane] : i32, view<12x32xi32>
    view.store %input_i16_unsigned_sum, %view[2, %lane] : i32, view<12x32xi32>
    view.store %input_i16_signed_sum, %view[3, %lane] : i32, view<12x32xi32>
    view.store %varying_i8_unsigned_sum, %view[4, %lane] : i32, view<12x32xi32>
    view.store %varying_i8_signed_sum, %view[5, %lane] : i32, view<12x32xi32>
    view.store %varying_i16_unsigned_sum, %view[6, %lane] : i32, view<12x32xi32>
    view.store %varying_i16_signed_sum, %view[7, %lane] : i32, view<12x32xi32>
    view.store %input_i8_comparison, %view[8, %lane] : i32, view<12x32xi32>
    view.store %input_i16_comparison, %view[9, %lane] : i32, view<12x32xi32>
    view.store %varying_i8_comparison, %view[10, %lane] : i32, view<12x32xi32>
    view.store %varying_i16_comparison, %view[11, %lane] : i32, view<12x32xi32>
  }
  func.return
}

check.scenario @narrow_integer_consumer_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.literal value(112) : i32
    %output = check.generate.fill value(-7777) : tensor<416xi32>
    check.compare<@narrow_integer_consumers, @narrow_integer_consumers_oracle>(%input, %output) : (i32, tensor<416xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<416xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.literal value(32752) : i32
    %output = check.generate.fill value(-7777) : tensor<416xi32>
    check.compare<@narrow_integer_consumers, @narrow_integer_consumers_oracle>(%input, %output) : (i32, tensor<416xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<416xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.literal value(65520) : i32
    %output = check.generate.fill value(-7777) : tensor<416xi32>
    check.compare<@narrow_integer_consumers, @narrow_integer_consumers_oracle>(%input, %output) : (i32, tensor<416xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<416xi32>
    }
  }
  check.return
}

// Runtime selection crosses packed register boundaries. The same extracted
// value is observed as raw storage, signed arithmetic, and unsigned arithmetic;
// scalar loads establish an independent lane-selection oracle.
kernel.def @packed_integer_consumers() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%selector: index, %bytes: buffer, %halves: buffer, %output: buffer) where [range(%selector, 0, 31)] {
  %c4 = index.constant 4 : index
  %position = index.rem %selector, %c4 : index
  %origin = index.constant 0 : offset
  %raw_origin = index.constant 24 : offset
  %byte_input = buffer.view %bytes[%origin] : buffer -> view<4xi8>
  %half_input = buffer.view %halves[%origin] : buffer -> view<4xi16>
  %words = buffer.view %output[%origin] : buffer -> view<6xi32>
  %raw_bytes = buffer.view %output[%raw_origin] : buffer -> view<16xi8>
  %raw_halves = buffer.view %output[%raw_origin] : buffer -> view<8xi16>
  %byte_packet = vector.load %byte_input[0] : view<4xi8> -> vector<4xi8>
  %half_packet = vector.load %half_input[0] : view<4xi16> -> vector<4xi16>
  %byte = vector.extract %byte_packet[%position] : vector<4xi8> -> i8
  %half = vector.extract %half_packet[%position] : vector<4xi16> -> i16
  %static_byte = vector.extract %byte_packet[1] : vector<4xi8> -> i8
  %static_half = vector.extract %half_packet[3] : vector<4xi16> -> i16
  %raw_byte = view.load %byte_input[0] : view<4xi8> -> i8
  %raw_half = view.load %half_input[0] : view<4xi16> -> i16
  %byte_signed = scalar.extsi %byte : i8 to i32
  %byte_unsigned = scalar.extui %byte : i8 to i32
  %half_signed = scalar.extsi %half : i16 to i32
  %half_unsigned = scalar.extui %half : i16 to i32
  view.store %byte_signed, %words[0] : i32, view<6xi32>
  view.store %byte_unsigned, %words[1] : i32, view<6xi32>
  view.store %half_signed, %words[2] : i32, view<6xi32>
  view.store %half_unsigned, %words[3] : i32, view<6xi32>
  view.store %byte, %raw_bytes[0] : i8, view<16xi8>
  view.store %static_byte, %raw_bytes[2] : i8, view<16xi8>
  view.store %half, %raw_halves[2] : i16, view<8xi16>
  view.store %static_half, %raw_halves[3] : i16, view<8xi16>
  view.store %raw_byte, %raw_bytes[8] : i8, view<16xi8>
  view.store %raw_half, %raw_halves[5] : i16, view<8xi16>
  %global_byte = view.load %byte_input[%position] : view<4xi8> -> i8
  %global_half = view.load %half_input[%position] : view<4xi16> -> i16
  %global_byte_unsigned = scalar.extui %global_byte : i8 to i32
  %global_half_unsigned = scalar.extui %global_half : i16 to i32
  view.store %global_byte_unsigned, %words[4] : i32, view<6xi32>
  view.store %global_half_unsigned, %words[5] : i32, view<6xi32>
  kernel.return
}

func.def @packed_integer_consumers_oracle(%selector: index, %bytes: buffer, %halves: buffer, %output: buffer) where [range(%selector, 0, 31)] {
  %c4 = index.constant 4 : index
  %position = index.rem %selector, %c4 : index
  %origin = index.constant 0 : offset
  %raw_origin = index.constant 24 : offset
  %byte_input = buffer.view %bytes[%origin] : buffer -> view<4xi8>
  %half_input = buffer.view %halves[%origin] : buffer -> view<4xi16>
  %words = buffer.view %output[%origin] : buffer -> view<6xi32>
  %raw_bytes = buffer.view %output[%raw_origin] : buffer -> view<16xi8>
  %raw_halves = buffer.view %output[%raw_origin] : buffer -> view<8xi16>
  %byte = view.load %byte_input[%position] : view<4xi8> -> i8
  %half = view.load %half_input[%position] : view<4xi16> -> i16
  %static_byte = view.load %byte_input[1] : view<4xi8> -> i8
  %static_half = view.load %half_input[3] : view<4xi16> -> i16
  %raw_byte = view.load %byte_input[0] : view<4xi8> -> i8
  %raw_half = view.load %half_input[0] : view<4xi16> -> i16
  %byte_signed = scalar.extsi %byte : i8 to i32
  %byte_unsigned = scalar.extui %byte : i8 to i32
  %half_signed = scalar.extsi %half : i16 to i32
  %half_unsigned = scalar.extui %half : i16 to i32
  view.store %byte_signed, %words[0] : i32, view<6xi32>
  view.store %byte_unsigned, %words[1] : i32, view<6xi32>
  view.store %half_signed, %words[2] : i32, view<6xi32>
  view.store %half_unsigned, %words[3] : i32, view<6xi32>
  view.store %byte, %raw_bytes[0] : i8, view<16xi8>
  view.store %static_byte, %raw_bytes[2] : i8, view<16xi8>
  view.store %half, %raw_halves[2] : i16, view<8xi16>
  view.store %static_half, %raw_halves[3] : i16, view<8xi16>
  view.store %raw_byte, %raw_bytes[8] : i8, view<16xi8>
  view.store %raw_half, %raw_halves[5] : i16, view<8xi16>
  %global_byte = view.load %byte_input[%position] : view<4xi8> -> i8
  %global_half = view.load %half_input[%position] : view<4xi16> -> i16
  %global_byte_unsigned = scalar.extui %global_byte : i8 to i32
  %global_half_unsigned = scalar.extui %global_half : i16 to i32
  view.store %global_byte_unsigned, %words[4] : i32, view<6xi32>
  view.store %global_half_unsigned, %words[5] : i32, view<6xi32>
  func.return
}

check.scenario @packed_integer_carrier_values {
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %bytes = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<4xi8>
    %halves = check.generate.random.uniform seed(%seed) range(-32768 to 32767) : tensor<4xi16>
    %output = check.generate.fill value(-7777) : tensor<12xi32>
    check.compare<@packed_integer_consumers, @packed_integer_consumers_oracle>(%trial, %bytes, %halves, %output) : (index, tensor<4xi8>, tensor<4xi16>, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %bytes = check.generate.iota offset(-128) step(85) : tensor<4xi8>
    %halves = check.generate.iota offset(-32768) step(21845) : tensor<4xi16>
    %output = check.generate.fill value(-7777) : tensor<12xi32>
    check.compare<@packed_integer_consumers, @packed_integer_consumers_oracle>(%trial, %bytes, %halves, %output) : (index, tensor<4xi8>, tensor<4xi16>, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.return
}
