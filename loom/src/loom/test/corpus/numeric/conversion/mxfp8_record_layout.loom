// A BSHD padded-8 record stores 448 E4M3FN payload bytes followed by seven
// E8M0 scale bytes duplicated into adjacent pairs. Each 512-byte record keeps
// the remaining 50 bytes as padding.
func.def @generate_mxfp8_bpad8_records(%packed_buffer: buffer) {
  %base = index.constant 0 : offset
  %packed = buffer.view %packed_buffer[%base] : buffer -> view<2x512xi8>
  %begin = index.constant 0 : index
  %record_count = index.constant 2 : index
  %group_count = index.constant 7 : index
  %step = index.constant 1 : index
  %pair_size = index.constant 2 : index
  %payload_group_size = index.constant 64 : index
  %scale_base = index.constant 448 : index
  %c8_i32 = scalar.constant 8 : i32
  %payload_base = scalar.constant 56 : i32
  %scale_value_base = scalar.constant 124 : i32
  scf.for %record = [%begin to %record_count step %step] {
    %record_i32 = index.cast %record : index to i32
    scf.for %group = [%begin to %group_count step %step] {
      %group_i32 = index.cast %group : index to i32
      %group_and_record = scalar.addi %group_i32, %record_i32 : i32
      %payload_delta = scalar.muli %group_and_record, %c8_i32 : i32
      %payload_bits = scalar.addi %payload_base, %payload_delta : i32
      %payload_byte = scalar.trunci %payload_bits : i32 to i8
      %payload = vector.splat %payload_byte : vector<64xi8>
      %channel = index.mul %group, %payload_group_size : index
      vector.store %payload, %packed[%record, %channel] : vector<64xi8>, view<2x512xi8>

      %scale_bits = scalar.addi %scale_value_base, %group_and_record : i32
      %scale_byte = scalar.trunci %scale_bits : i32 to i8
      %pair_offset = index.mul %group, %pair_size : index
      %first_scale = index.add %scale_base, %pair_offset : index
      %second_scale = index.add %first_scale, %step : index
      view.store %scale_byte, %packed[%record, %first_scale] : i8, view<2x512xi8>
      view.store %scale_byte, %packed[%record, %second_scale] : i8, view<2x512xi8>
    }
  }
  func.return
}

func.def inline @decode_mxfp8_bpad8_record(%record: index, %packed_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %scale_base = index.constant 448 : offset
  %payload_layout = encoding.layout.strided [512, 1] : encoding<layout>
  %scale_layout = encoding.layout.strided [512, 2] : encoding<layout>
  %payload = buffer.view %packed_buffer[%base] : buffer -> view<2x448xi8, %payload_layout>
  %scales = buffer.view %packed_buffer[%scale_base] : buffer -> view<2x7xi8, %scale_layout>
  %output = buffer.view %output_buffer[%base] : buffer -> view<2x448xf32>
  %schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=64, scale_format=e8m0, scale_group_elements=64, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %begin = index.constant 0 : index
  %group_count = index.constant 7 : index
  %step = index.constant 1 : index
  %group_size = index.constant 64 : index
  scf.for %group = [%begin to %group_count step %step] {
    %channel = index.mul %group, %group_size : index
    %payload_bits = vector.load %payload[%record, %channel] : view<2x448xi8, %payload_layout> -> vector<64xi8>
    %payload_values = vector.bitcast %payload_bits : vector<64xi8> to vector<64xf8E4M3>
    %scale_byte = view.load %scales[%record, %group] : view<2x7xi8, %scale_layout> -> i8
    %scale_bits = scalar.extui %scale_byte : i8 to i32
    %scale = vector.from_elements %scale_bits : vector<1xi32>
    %decoded = vector.decode %payload_values using %schema {scale = %scale : vector<1xi32>} : vector<64xf8E4M3>, encoding<schema> -> vector<64xf32>
    vector.store %decoded, %output[%record, %channel] : vector<64xf32>, view<2x448xf32>
  }
  func.return
}

kernel.def @decode_mxfp8_bpad8_records() {
  %record_count = index.constant 2 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%record_count, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%packed: buffer, %output: buffer) {
  %record = kernel.workgroup.id<x> : index
  func.call @decode_mxfp8_bpad8_record(%record, %packed, %output) : (index, buffer, buffer)
  kernel.return
}

// Derive the expected powers of two from the raw record bytes. The oracle uses
// ordinary byte addressing instead of the target's strided scale view.
func.def @decode_mxfp8_bpad8_records_oracle(%packed_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %packed = buffer.view %packed_buffer[%base] : buffer -> view<2x512xi8>
  %output = buffer.view %output_buffer[%base] : buffer -> view<2x448xf32>
  %begin = index.constant 0 : index
  %record_count = index.constant 2 : index
  %group_count = index.constant 7 : index
  %step = index.constant 1 : index
  %pair_size = index.constant 2 : index
  %group_size = index.constant 64 : index
  %scale_base = index.constant 448 : index
  %exponent_shift = scalar.constant 3 : i32
  %exponent_mask = scalar.constant 15 : i32
  %payload_bias = scalar.constant 7 : i32
  %f32_exponent_shift = scalar.constant 23 : i32
  scf.for %record = [%begin to %record_count step %step] {
    scf.for %group = [%begin to %group_count step %step] {
      %channel = index.mul %group, %group_size : index
      %pair_offset = index.mul %group, %pair_size : index
      %scale_offset = index.add %scale_base, %pair_offset : index
      %payload_byte = view.load %packed[%record, %channel] : view<2x512xi8> -> i8
      %scale_byte = view.load %packed[%record, %scale_offset] : view<2x512xi8> -> i8
      %payload_bits = scalar.extui %payload_byte : i8 to i32
      %payload_shifted = scalar.shrui %payload_bits, %exponent_shift : i32
      %payload_exponent = scalar.andi %payload_shifted, %exponent_mask : i32
      %scale_exponent = scalar.extui %scale_byte : i8 to i32
      %combined_exponent = scalar.addi %payload_exponent, %scale_exponent : i32
      %f32_exponent = scalar.subi %combined_exponent, %payload_bias : i32
      %expected_bits = scalar.shli %f32_exponent, %f32_exponent_shift : i32
      %expected_value = scalar.bitcast %expected_bits : i32 to f32
      %expected = vector.splat %expected_value : vector<64xf32>
      vector.store %expected, %output[%record, %channel] : vector<64xf32>, view<2x448xf32>
    }
  }
  func.return
}

check.scenario @mxfp8_bpad8_record_decode_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %packed = check.generate.fill value(-1) : tensor<2x512xi8>
    check.generate<@generate_mxfp8_bpad8_records>(%packed) : (tensor<2x512xi8>) -> ()
    %output = check.generate.fill value(-123.0) : tensor<2x448xf32>
    check.compare<@decode_mxfp8_bpad8_records, @decode_mxfp8_bpad8_records_oracle>(%packed, %output) : (tensor<2x512xi8>, tensor<2x448xf32>) -> () {
      check.expect.bitwise actual(%packed) expected(%packed) : tensor<2x512xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<2x448xf32>
    }
  }
  check.return
}
