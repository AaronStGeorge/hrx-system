// Radian inverse trigonometry across every floating source format. The
// runtime coordinates exercise opposite signs and non-symmetric atan2 inputs.
// Narrow results must survive their own format rounding; F64 has a separate
// comparison so F32 tolerance cannot hide loss of double precision.

func.def @inverse_trigonometry_observations(%y: f64, %x: f64, %narrow_output: buffer, %wide_output: buffer) {
  %negative_y = scalar.negf %y : f64
  %negative_x = scalar.negf %x : f64
  %ys = vector.from_elements %y, %negative_y : vector<2xf64>
  %xs = vector.from_elements %x, %negative_x : vector<2xf64>
  %origin = index.constant 0 : offset
  %narrow_results = buffer.view %narrow_output[%origin] : buffer -> view<5x8xf64>
  %wide_results = buffer.view %wide_output[%origin] : buffer -> view<8xf64>
  %e4_ys = vector.fptrunc %ys : vector<2xf64> to vector<2xf8E4M3>
  %e4_xs = vector.fptrunc %xs : vector<2xf64> to vector<2xf8E4M3>
  %e4_asin = vector.asinf %e4_ys : vector<2xf8E4M3>
  %e4_acos = vector.acosf %e4_ys : vector<2xf8E4M3>
  %e4_atan = vector.atanf %e4_ys : vector<2xf8E4M3>
  %e4_atan2 = vector.atan2f %e4_ys, %e4_xs : vector<2xf8E4M3>
  %e4_values = vector.concat<0> %e4_asin, %e4_acos, %e4_atan, %e4_atan2 : vector<2xf8E4M3>, vector<2xf8E4M3>, vector<2xf8E4M3>, vector<2xf8E4M3> -> vector<8xf8E4M3>
  %e4_wide = vector.extf %e4_values : vector<8xf8E4M3> to vector<8xf64>
  vector.store %e4_wide, %narrow_results[0, 0] : vector<8xf64>, view<5x8xf64>
  %e5_ys = vector.fptrunc %ys : vector<2xf64> to vector<2xf8E5M2>
  %e5_xs = vector.fptrunc %xs : vector<2xf64> to vector<2xf8E5M2>
  %e5_asin = vector.asinf %e5_ys : vector<2xf8E5M2>
  %e5_acos = vector.acosf %e5_ys : vector<2xf8E5M2>
  %e5_atan = vector.atanf %e5_ys : vector<2xf8E5M2>
  %e5_atan2 = vector.atan2f %e5_ys, %e5_xs : vector<2xf8E5M2>
  %e5_values = vector.concat<0> %e5_asin, %e5_acos, %e5_atan, %e5_atan2 : vector<2xf8E5M2>, vector<2xf8E5M2>, vector<2xf8E5M2>, vector<2xf8E5M2> -> vector<8xf8E5M2>
  %e5_wide = vector.extf %e5_values : vector<8xf8E5M2> to vector<8xf64>
  vector.store %e5_wide, %narrow_results[1, 0] : vector<8xf64>, view<5x8xf64>
  %half_ys = vector.fptrunc %ys : vector<2xf64> to vector<2xf16>
  %half_xs = vector.fptrunc %xs : vector<2xf64> to vector<2xf16>
  %half_asin = vector.asinf %half_ys : vector<2xf16>
  %half_acos = vector.acosf %half_ys : vector<2xf16>
  %half_atan = vector.atanf %half_ys : vector<2xf16>
  %half_atan2 = vector.atan2f %half_ys, %half_xs : vector<2xf16>
  %half_values = vector.concat<0> %half_asin, %half_acos, %half_atan, %half_atan2 : vector<2xf16>, vector<2xf16>, vector<2xf16>, vector<2xf16> -> vector<8xf16>
  %half_wide = vector.extf %half_values : vector<8xf16> to vector<8xf64>
  vector.store %half_wide, %narrow_results[2, 0] : vector<8xf64>, view<5x8xf64>
  %brain_ys = vector.fptrunc %ys : vector<2xf64> to vector<2xbf16>
  %brain_xs = vector.fptrunc %xs : vector<2xf64> to vector<2xbf16>
  %brain_asin = vector.asinf %brain_ys : vector<2xbf16>
  %brain_acos = vector.acosf %brain_ys : vector<2xbf16>
  %brain_atan = vector.atanf %brain_ys : vector<2xbf16>
  %brain_atan2 = vector.atan2f %brain_ys, %brain_xs : vector<2xbf16>
  %brain_values = vector.concat<0> %brain_asin, %brain_acos, %brain_atan, %brain_atan2 : vector<2xbf16>, vector<2xbf16>, vector<2xbf16>, vector<2xbf16> -> vector<8xbf16>
  %brain_wide = vector.extf %brain_values : vector<8xbf16> to vector<8xf64>
  vector.store %brain_wide, %narrow_results[3, 0] : vector<8xf64>, view<5x8xf64>
  %single_ys = vector.fptrunc %ys : vector<2xf64> to vector<2xf32>
  %single_xs = vector.fptrunc %xs : vector<2xf64> to vector<2xf32>
  %single_asin = vector.asinf %single_ys : vector<2xf32>
  %single_acos = vector.acosf %single_ys : vector<2xf32>
  %single_atan = vector.atanf %single_ys : vector<2xf32>
  %single_atan2 = vector.atan2f %single_ys, %single_xs : vector<2xf32>
  %single_values = vector.concat<0> %single_asin, %single_acos, %single_atan, %single_atan2 : vector<2xf32>, vector<2xf32>, vector<2xf32>, vector<2xf32> -> vector<8xf32>
  %single_wide = vector.extf %single_values : vector<8xf32> to vector<8xf64>
  vector.store %single_wide, %narrow_results[4, 0] : vector<8xf64>, view<5x8xf64>
  %wide_asin = vector.asinf %ys : vector<2xf64>
  %wide_acos = vector.acosf %ys : vector<2xf64>
  %wide_atan = vector.atanf %ys : vector<2xf64>
  %wide_atan2 = vector.atan2f %ys, %xs : vector<2xf64>
  %wide_values = vector.concat<0> %wide_asin, %wide_acos, %wide_atan, %wide_atan2 : vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64> -> vector<8xf64>
  vector.store %wide_values, %wide_results[0] : vector<8xf64>, view<8xf64>
  func.return
}

// Directed MPFR 4.2.2 intervals round independently to these constants. The
// oracle contains no inverse-trigonometric operation, including on the VM.
func.def @inverse_trigonometry_oracle(%y: f64, %x: f64, %narrow_output: buffer, %wide_output: buffer) {
  %asin0 = scalar.constant 0.52359877559829893 : f64
  %asin1 = scalar.constant -0.52359877559829893 : f64
  %acos0 = scalar.constant 1.0471975511965979 : f64
  %acos1 = scalar.constant 2.0943951023931957 : f64
  %atan0 = scalar.constant 0.46364760900080609 : f64
  %atan1 = scalar.constant -0.46364760900080609 : f64
  %atan20 = scalar.constant 2.5535900500422257 : f64
  %atan21 = scalar.constant -0.5880026035475675 : f64
  %values = vector.from_elements %asin0, %asin1, %acos0, %acos1, %atan0, %atan1, %atan20, %atan21 : vector<8xf64>
  %origin = index.constant 0 : offset
  %narrow_results = buffer.view %narrow_output[%origin] : buffer -> view<5x8xf64>
  %wide_results = buffer.view %wide_output[%origin] : buffer -> view<8xf64>
  %e4 = vector.fptrunc %values : vector<8xf64> to vector<8xf8E4M3>
  %e4_wide = vector.extf %e4 : vector<8xf8E4M3> to vector<8xf64>
  vector.store %e4_wide, %narrow_results[0, 0] : vector<8xf64>, view<5x8xf64>
  %e5 = vector.fptrunc %values : vector<8xf64> to vector<8xf8E5M2>
  %e5_wide = vector.extf %e5 : vector<8xf8E5M2> to vector<8xf64>
  vector.store %e5_wide, %narrow_results[1, 0] : vector<8xf64>, view<5x8xf64>
  %half = vector.fptrunc %values : vector<8xf64> to vector<8xf16>
  %half_wide = vector.extf %half : vector<8xf16> to vector<8xf64>
  vector.store %half_wide, %narrow_results[2, 0] : vector<8xf64>, view<5x8xf64>
  %brain = vector.fptrunc %values : vector<8xf64> to vector<8xbf16>
  %brain_wide = vector.extf %brain : vector<8xbf16> to vector<8xf64>
  vector.store %brain_wide, %narrow_results[3, 0] : vector<8xf64>, view<5x8xf64>
  %single = vector.fptrunc %values : vector<8xf64> to vector<8xf32>
  %single_wide = vector.extf %single : vector<8xf32> to vector<8xf64>
  vector.store %single_wide, %narrow_results[4, 0] : vector<8xf64>, view<5x8xf64>
  vector.store %values, %wide_results[0] : vector<8xf64>, view<8xf64>
  func.return
}

check.scenario @ordinary_inverse_trigonometry {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %y = check.literal value(0.5) : f64
    %x = check.literal value(-0.75) : f64
    %narrow_output = check.generate.fill value(-1.0) : tensor<5x8xf64>
    %wide_output = check.generate.fill value(-1.0) : tensor<8xf64>
    check.compare<@inverse_trigonometry_observations, @inverse_trigonometry_oracle>(%y, %x, %narrow_output, %wide_output) : (f64, f64, tensor<5x8xf64>, tensor<8xf64>) -> () {
      check.expect.approximate actual(%narrow_output) expected(%narrow_output) atol(0.0) rtol(1.1999999999999999e-07) nan(different) : tensor<5x8xf64>, tensor<5x8xf64>
      check.expect.approximate actual(%wide_output) expected(%wide_output) atol(0.0) rtol(2.2999999999999999e-16) nan(different) : tensor<8xf64>, tensor<8xf64>
    }
  }
  check.return
}
