// Exercises scalar and vector logarithms across directed IEEE-754 boundaries
// and deterministic full-width entropy. Exact cases separately preserve the
// required result bits for one, signed zero, and positive infinity.

func.def @logarithm_observations(%first_bits: i32, %second_bits: i32, %output: buffer) {
  %first = scalar.bitcast %first_bits : i32 to f32
  %second = scalar.bitcast %second_bits : i32 to f32
  %scalar_log2 = scalar.log2f<afn> %first : f32
  %scalar_log = scalar.logf<afn> %first : f32
  %values = vector.from_elements %first, %second : vector<2xf32>
  %log2_values = vector.log2f<afn> %values : vector<2xf32>
  %log2_first = vector.extract %log2_values[0] : vector<2xf32> -> f32
  %log2_second = vector.extract %log2_values[1] : vector<2xf32> -> f32
  %log_values = vector.logf<afn> %values : vector<2xf32>
  %log_first = vector.extract %log_values[0] : vector<2xf32> -> f32
  %log_second = vector.extract %log_values[1] : vector<2xf32> -> f32
  %results = vector.from_elements %scalar_log2, %scalar_log, %log2_first, %log2_second, %log_first, %log_second : vector<6xf32>
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<6xf32>
  vector.store %results, %result_view[0] : vector<6xf32>, view<6xf32>
  func.return
}

func.def @logarithm_entropy_observations(%first_entropy: i64, %second_entropy: i64, %output: buffer) {
  %first_bits = scalar.trunci %first_entropy : i64 to i32
  %second_bits = scalar.trunci %second_entropy : i64 to i32
  func.call @logarithm_observations(%first_bits, %second_bits, %output) : (i32, i32, buffer)
  func.return
}

func.def @logarithm_boundary_observations(%ordinal: index, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c10 = index.constant 10 : index
  %c11 = index.constant 11 : index
  %c12 = index.constant 12 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %is5 = index.cmp eq, %ordinal, %c5 : index
  %is6 = index.cmp eq, %ordinal, %c6 : index
  %is7 = index.cmp eq, %ordinal, %c7 : index
  %is8 = index.cmp eq, %ordinal, %c8 : index
  %is9 = index.cmp eq, %ordinal, %c9 : index
  %is10 = index.cmp eq, %ordinal, %c10 : index
  %is11 = index.cmp eq, %ordinal, %c11 : index
  %is12 = index.cmp eq, %ordinal, %c12 : index
  %value0 = scalar.constant 1 : i32
  %value1 = scalar.constant 3 : i32
  %value2 = scalar.constant 8388607 : i32
  %value3 = scalar.constant 8388608 : i32
  %value4 = scalar.constant 8388609 : i32
  %value5 = scalar.constant 1065353215 : i32
  %value6 = scalar.constant 1065353217 : i32
  %value7 = scalar.constant 2139095039 : i32
  %value8 = scalar.constant -2147483647 : i32
  %value9 = scalar.constant -1082130432 : i32
  %value10 = scalar.constant 2143289344 : i32
  %value11 = scalar.constant -4194304 : i32
  %value12 = scalar.constant 2139095041 : i32
  %value13 = scalar.constant -8388607 : i32
  %bits0 = scf.select %is0, %value0, %value13 : i32
  %bits1 = scf.select %is1, %value1, %bits0 : i32
  %bits2 = scf.select %is2, %value2, %bits1 : i32
  %bits3 = scf.select %is3, %value3, %bits2 : i32
  %bits4 = scf.select %is4, %value4, %bits3 : i32
  %bits5 = scf.select %is5, %value5, %bits4 : i32
  %bits6 = scf.select %is6, %value6, %bits5 : i32
  %bits7 = scf.select %is7, %value7, %bits6 : i32
  %bits8 = scf.select %is8, %value8, %bits7 : i32
  %bits9 = scf.select %is9, %value9, %bits8 : i32
  %bits10 = scf.select %is10, %value10, %bits9 : i32
  %bits11 = scf.select %is11, %value11, %bits10 : i32
  %bits12 = scf.select %is12, %value12, %bits11 : i32
  %second_bits = scalar.constant 1073741824 : i32
  func.call @logarithm_observations(%bits12, %second_bits, %output) : (i32, i32, buffer)
  func.return
}

func.def @logarithm_exact_observations(%ordinal: index, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %value0 = scalar.constant 1065353216 : i32
  %value1 = scalar.constant 0 : i32
  %value2 = scalar.constant -2147483648 : i32
  %value3 = scalar.constant 2139095040 : i32
  %bits0 = scf.select %is0, %value0, %value3 : i32
  %bits1 = scf.select %is1, %value1, %bits0 : i32
  %bits2 = scf.select %is2, %value2, %bits1 : i32
  %input = scalar.bitcast %bits2 : i32 to f32
  %log2 = scalar.log2f<afn> %input : f32
  %log = scalar.logf<afn> %input : f32
  %log2_bits = scalar.bitcast %log2 : f32 to i32
  %log_bits = scalar.bitcast %log : f32 to i32
  %results = vector.from_elements %log2_bits, %log_bits : vector<2xi32>
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<2xi32>
  vector.store %results, %result_view[0] : vector<2xi32>, view<2xi32>
  func.return
}

check.scenario @logarithm_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(-1) : tensor<2xi32>
    check.compare<@logarithm_exact_observations>(%trial, %output) : (index, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.trial[14](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(0.0) : tensor<6xf32>
    check.compare<@logarithm_boundary_observations>(%trial, %output) : (index, tensor<6xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(1.0000000000000001e-05) nan(same) : tensor<6xf32>, tensor<6xf32>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %first_source = check.entropy.fork %entropy name("first") : check.entropy
    %second_source = check.entropy.fork %entropy name("second") : check.entropy
    %first_bits = check.entropy.read %first_source[%trial] : check.entropy -> i64
    %second_bits = check.entropy.read %second_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0.0) : tensor<6xf32>
    check.compare<@logarithm_entropy_observations>(%first_bits, %second_bits, %output) : (i64, i64, tensor<6xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(1.0000000000000001e-05) nan(same) : tensor<6xf32>, tensor<6xf32>
    }
  }
  check.return
}

// Powers of two provide independent exact identities for every logarithm.
// Native evaluation widths and all narrow carriers consume runtime values.
func.def @ordinary_logarithm_observations(%ordinal: index, %output: buffer) {
  %exponent = index.cast %ordinal : index to i32
  %c1 = scalar.constant 1 : i32
  %power = scalar.shli %c1, %exponent : i32
  %log_identity = scalar.constant 1.0 : f32
  %log1p_identity = scalar.constant 0.0 : f32
  %input = scalar.sitofp %power : i32 to f32
  %offset = scalar.subf %input, %log_identity : f32
  %values = vector.from_elements %input, %log_identity : vector<2xf32>
  %offsets = vector.from_elements %offset, %log1p_identity : vector<2xf32>
  %natural = vector.logf %values : vector<2xf32>
  %base_two = vector.log2f %values : vector<2xf32>
  %base_ten = vector.log10f %values : vector<2xf32>
  %increment = vector.log1pf %offsets : vector<2xf32>
  %natural_results = vector.extf %natural : vector<2xf32> to vector<2xf64>
  %base_two_results = vector.extf %base_two : vector<2xf32> to vector<2xf64>
  %base_ten_results = vector.extf %base_ten : vector<2xf32> to vector<2xf64>
  %increment_results = vector.extf %increment : vector<2xf32> to vector<2xf64>
  %wide = scalar.extf %input : f32 to f64
  %wide_offset = scalar.extf %offset : f32 to f64
  %wide_natural = scalar.logf %wide : f64
  %wide_base_two = scalar.log2f %wide : f64
  %wide_base_ten = scalar.log10f %wide : f64
  %wide_increment = scalar.log1pf %wide_offset : f64
  %wide_results = vector.from_elements %wide_natural, %wide_base_two, %wide_base_ten, %wide_increment : vector<4xf64>
  %e4_input = scalar.fptrunc %input : f32 to f8E4M3
  %e5_input = scalar.fptrunc %input : f32 to f8E5M2
  %half_input = scalar.fptrunc %input : f32 to f16
  %brain_offset = scalar.fptrunc %offset : f32 to bf16
  %e4_result = scalar.logf %e4_input : f8E4M3
  %e5_result = scalar.log2f %e5_input : f8E5M2
  %half_result = scalar.log10f %half_input : f16
  %brain_result = scalar.log1pf %brain_offset : bf16
  %e4 = scalar.extf %e4_result : f8E4M3 to f64
  %e5 = scalar.extf %e5_result : f8E5M2 to f64
  %half = scalar.extf %half_result : f16 to f64
  %brain = scalar.extf %brain_result : bf16 to f64
  %narrow_results = vector.from_elements %e4, %e5, %half, %brain : vector<4xf64>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<16xf64>
  vector.store %natural_results, %results[0] : vector<2xf64>, view<16xf64>
  vector.store %base_two_results, %results[2] : vector<2xf64>, view<16xf64>
  vector.store %base_ten_results, %results[4] : vector<2xf64>, view<16xf64>
  vector.store %increment_results, %results[6] : vector<2xf64>, view<16xf64>
  vector.store %wide_results, %results[8] : vector<4xf64>, view<16xf64>
  vector.store %narrow_results, %results[12] : vector<4xf64>, view<16xf64>
  func.return
}

func.def @ordinary_logarithm_oracle(%ordinal: index, %output: buffer) {
  %exponent = index.cast %ordinal : index to i32
  // Independently rounded ln(2) and log10(2); the exponent is zero or one.
  %ln2 = scalar.constant 0.69314718055994529 : f64
  %log10_2 = scalar.constant 0.3010299956639812 : f64
  %power = scalar.sitofp %exponent : i32 to f64
  %natural = scalar.mulf %power, %ln2 : f64
  %base_ten = scalar.mulf %power, %log10_2 : f64
  %natural_f32 = scalar.fptrunc %natural : f64 to f32
  %base_ten_f32 = scalar.fptrunc %base_ten : f64 to f32
  %rounded_natural = scalar.extf %natural_f32 : f32 to f64
  %rounded_base_ten = scalar.extf %base_ten_f32 : f32 to f64
  %identity_result = scalar.constant 0.0 : f64
  %natural_results = vector.from_elements %rounded_natural, %identity_result : vector<2xf64>
  %base_two_results = vector.from_elements %power, %identity_result : vector<2xf64>
  %base_ten_results = vector.from_elements %rounded_base_ten, %identity_result : vector<2xf64>
  %wide_results = vector.from_elements %natural, %power, %base_ten, %natural : vector<4xf64>
  %e4_result = scalar.fptrunc %natural_f32 : f32 to f8E4M3
  %half_result = scalar.fptrunc %base_ten_f32 : f32 to f16
  %brain_result = scalar.fptrunc %natural_f32 : f32 to bf16
  %e4 = scalar.extf %e4_result : f8E4M3 to f64
  %half = scalar.extf %half_result : f16 to f64
  %brain = scalar.extf %brain_result : bf16 to f64
  %narrow_results = vector.from_elements %e4, %power, %half, %brain : vector<4xf64>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<16xf64>
  vector.store %natural_results, %results[0] : vector<2xf64>, view<16xf64>
  vector.store %base_two_results, %results[2] : vector<2xf64>, view<16xf64>
  vector.store %base_ten_results, %results[4] : vector<2xf64>, view<16xf64>
  vector.store %natural_results, %results[6] : vector<2xf64>, view<16xf64>
  vector.store %wide_results, %results[8] : vector<4xf64>, view<16xf64>
  vector.store %narrow_results, %results[12] : vector<4xf64>, view<16xf64>
  func.return
}

check.scenario @ordinary_logarithm_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(-1.0) : tensor<16xf64>
    check.compare<@ordinary_logarithm_observations, @ordinary_logarithm_oracle>(%trial, %output) : (index, tensor<16xf64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xf64>
    }
  }
  check.return
}
