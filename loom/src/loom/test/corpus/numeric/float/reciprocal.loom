// Reciprocal permission retains signed zeros and IEEE exceptional classes.
// The host generator computes independent ordinary quotients. Subjects expose
// ULP-distance failures, including the finite/overflow boundary where a rounded
// reciprocal followed by multiplication is insufficient.
func.def inline @reciprocal_ulp_error(%actual: f64, %expected: f64) -> (i64) {
  %actual_bits = scalar.bitcast %actual : f64 to i64
  %expected_bits = scalar.bitcast %expected : f64 to i64
  %magnitude_mask = scalar.constant 9223372036854775807 : i64
  %infinity = scalar.constant 9218868437227405312 : i64
  %c0 = scalar.constant 0 : i64
  %limit = scalar.constant 2 : i64
  %actual_magnitude = scalar.andi %actual_bits, %magnitude_mask : i64
  %expected_magnitude = scalar.andi %expected_bits, %magnitude_mask : i64
  %actual_nan = scalar.cmpi ugt, %actual_magnitude, %infinity : i64
  %expected_nan = scalar.cmpi ugt, %expected_magnitude, %infinity : i64
  %both_nan = scalar.andi %actual_nan, %expected_nan : i1
  %forward = scalar.subi %actual_bits, %expected_bits : i64
  %reverse = scalar.subi %expected_bits, %actual_bits : i64
  %distance = scalar.minui %forward, %reverse : i64
  %close = scalar.cmpi ule, %distance, %limit : i64
  %actual_finite = scalar.cmpi ult, %actual_magnitude, %infinity : i64
  %expected_finite = scalar.cmpi ult, %expected_magnitude, %infinity : i64
  %finite = scalar.andi %actual_finite, %expected_finite : i1
  %expected_nonzero = scalar.cmpi ne, %expected_magnitude, %c0 : i64
  %finite_nonzero = scalar.andi %finite, %expected_nonzero : i1
  %finite_close = scalar.andi %finite_nonzero, %close : i1
  %same = scalar.cmpi eq, %actual_bits, %expected_bits : i64
  %same_class = scalar.ori %same, %both_nan : i1
  %accepted = scalar.ori %same_class, %finite_close : i1
  %error = scf.select %accepted, %c0, %distance : i64
  func.return %error : i64
}

func.def inline @reciprocal_boundary(%ordinal: i64) -> (i64) {
  %bits0 = scalar.constant 0 : i64
  %bits1 = scalar.constant 1 : i64
  %bits2 = scalar.constant 2 : i64
  %bits3 = scalar.constant 3 : i64
  %bits4 = scalar.constant 1125899906842623 : i64
  %bits5 = scalar.constant 1125899906842624 : i64
  %bits6 = scalar.constant 1125899906842625 : i64
  %bits7 = scalar.constant 2251799813685247 : i64
  %bits8 = scalar.constant 2251799813685248 : i64
  %bits9 = scalar.constant 2251799813685249 : i64
  %bits10 = scalar.constant 4503599627370494 : i64
  %bits11 = scalar.constant 4503599627370495 : i64
  %bits12 = scalar.constant 4503599627370496 : i64
  %bits13 = scalar.constant 4503599627370497 : i64
  %bits14 = scalar.constant 4602678819172646912 : i64
  %bits15 = scalar.constant 4607182418800017407 : i64
  %bits16 = scalar.constant 4607182418800017408 : i64
  %bits17 = scalar.constant 4607182418800017409 : i64
  %bits18 = scalar.constant 4611686018427387903 : i64
  %bits19 = scalar.constant 4611686018427387904 : i64
  %bits20 = scalar.constant 4611686018427387905 : i64
  %bits21 = scalar.constant 9205357638345293824 : i64
  %bits22 = scalar.constant 9209861237972664320 : i64
  %bits23 = scalar.constant 9214364837600034815 : i64
  %bits24 = scalar.constant 9214364837600034816 : i64
  %bits25 = scalar.constant 9214364837600034817 : i64
  %bits26 = scalar.constant 9218868437227405310 : i64
  %bits27 = scalar.constant 9218868437227405311 : i64
  %bits28 = scalar.constant 9218868437227405312 : i64
  %bits29 = scalar.constant 9218868437227405313 : i64
  %bits30 = scalar.constant 9221120237041090560 : i64
  %bits31 = scalar.constant 9221120237041090645 : i64
  %values = vector.from_elements %bits0, %bits1, %bits2, %bits3, %bits4, %bits5, %bits6, %bits7, %bits8, %bits9, %bits10, %bits11, %bits12, %bits13, %bits14, %bits15, %bits16, %bits17, %bits18, %bits19, %bits20, %bits21, %bits22, %bits23, %bits24, %bits25, %bits26, %bits27, %bits28, %bits29, %bits30, %bits31 : vector<32xi64>
  %magnitude_mask = scalar.constant 31 : i64
  %sign_mask = scalar.constant -9223372036854775808 : i64
  %magnitude_ordinal = scalar.andi %ordinal, %magnitude_mask : i64
  %position = index.cast %magnitude_ordinal : i64 to index
  %magnitude = vector.extract %values[%position] : vector<32xi64> -> i64
  %signed = scalar.cmpi ugt, %ordinal, %magnitude_mask : i64
  %c0 = scalar.constant 0 : i64
  %sign = scf.select %signed, %sign_mask, %c0 : i64
  %value = scalar.ori %magnitude, %sign : i64
  func.return %value : i64
}

func.def @generate_double_quotients(%seed: i64, %inputs: buffer) {
  %origin = index.constant 0 : offset
  %data = buffer.view %inputs[%origin] : buffer -> view<4x9216xf64>
  %begin = index.constant 0 : index
  %end = index.constant 9216 : index
  %step = index.constant 1 : index
  %fraction_mask = scalar.constant 4503599627370495 : i64
  %exponent_mask = scalar.constant 2047 : i64
  %sign_mask = scalar.constant -9223372036854775808 : i64
  %shift = scalar.constant 52 : i64
  %rotate = scalar.constant 17 : i64
  %multiplier = scalar.constant -7046029254386353131 : i64
  %unit_numerator = scalar.constant 1.0 : f64
  scf.for %row = [%begin to %end step %step] {
    %ordinal = index.cast %row : index to i64
    %ordinal_hash = scalar.muli %ordinal, %multiplier : i64
    %random = scalar.xori %ordinal_hash, %seed : i64
    %fraction = scalar.andi %random, %fraction_mask : i64
    %exponent = scalar.andi %ordinal, %exponent_mask : i64
    %encoded_exponent = scalar.shli %exponent, %shift : i64
    %sign = scalar.andi %random, %sign_mask : i64
    %magnitude = scalar.ori %fraction, %encoded_exponent : i64
    %denominator_bits = scalar.ori %magnitude, %sign : i64
    %numerator_bits = scalar.rotli %random, %rotate : i64
    %boundary_mask = scalar.constant 63 : i64
    %boundary_shift = scalar.constant 6 : i64
    %directed_start = scalar.constant 5120 : i64
    %directed = scalar.cmpi uge, %ordinal, %directed_start : i64
    %denominator_ordinal = scalar.andi %ordinal, %boundary_mask : i64
    %numerator_group = scalar.shrui %ordinal, %boundary_shift : i64
    %numerator_ordinal = scalar.andi %numerator_group, %boundary_mask : i64
    %boundary_numerator = func.call @reciprocal_boundary(%numerator_ordinal) : (i64) -> (i64)
    %boundary_denominator = func.call @reciprocal_boundary(%denominator_ordinal) : (i64) -> (i64)
    %selected_numerator = scf.select %directed, %boundary_numerator, %numerator_bits : i64
    %selected_denominator = scf.select %directed, %boundary_denominator, %denominator_bits : i64
    %denominator = scalar.bitcast %selected_denominator : i64 to f64
    %numerator = scalar.bitcast %selected_numerator : i64 to f64
    %reciprocal = scalar.divf %unit_numerator, %denominator : f64
    %quotient = scalar.divf %numerator, %denominator : f64
    view.store %numerator, %data[0, %row] : f64, view<4x9216xf64>
    view.store %denominator, %data[1, %row] : f64, view<4x9216xf64>
    view.store %reciprocal, %data[2, %row] : f64, view<4x9216xf64>
    view.store %quotient, %data[3, %row] : f64, view<4x9216xf64>
  }
  func.return
}

func.def @double_reciprocal_scalar(%inputs: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %data = buffer.view %inputs[%origin] : buffer -> view<4x9216xf64>
  %observations = buffer.view %output[%origin] : buffer -> view<2x9216xi64>
  %begin = index.constant 0 : index
  %end = index.constant 9216 : index
  %step = index.constant 1 : index
  %unit_numerator = scalar.constant 1.0 : f64
  scf.for %row = [%begin to %end step %step] {
    %numerator = view.load %data[0, %row] : view<4x9216xf64> -> f64
    %denominator = view.load %data[1, %row] : view<4x9216xf64> -> f64
    %reciprocal = scalar.divf<arcp> %unit_numerator, %denominator : f64
    %quotient = scalar.divf<arcp> %numerator, %denominator : f64
    %expected_reciprocal = view.load %data[2, %row] : view<4x9216xf64> -> f64
    %expected_quotient = view.load %data[3, %row] : view<4x9216xf64> -> f64
    %reciprocal_error = func.call @reciprocal_ulp_error(%reciprocal, %expected_reciprocal) : (f64, f64) -> (i64)
    %quotient_error = func.call @reciprocal_ulp_error(%quotient, %expected_quotient) : (f64, f64) -> (i64)
    view.store %reciprocal_error, %observations[0, %row] : i64, view<2x9216xi64>
    view.store %quotient_error, %observations[1, %row] : i64, view<2x9216xi64>
  }
  func.return
}

func.def @double_reciprocal_vector(%inputs: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %data = buffer.view %inputs[%origin] : buffer -> view<4x9216xf64>
  %observations = buffer.view %output[%origin] : buffer -> view<2x9216xi64>
  %begin = index.constant 0 : index
  %end = index.constant 9216 : index
  %step = index.constant 3 : index
  %unit_numerator = scalar.constant 1.0 : f64
  %unit_numerators = vector.splat %unit_numerator : vector<3xf64>
  scf.for %row = [%begin to %end step %step] {
    %numerators = vector.load %data[0, %row] : view<4x9216xf64> -> vector<3xf64>
    %denominators = vector.load %data[1, %row] : view<4x9216xf64> -> vector<3xf64>
    %reciprocals = vector.divf<arcp> %unit_numerators, %denominators : vector<3xf64>
    %quotients = vector.divf<arcp> %numerators, %denominators : vector<3xf64>
    %lane_begin = index.constant 0 : index
    %lane_end = index.constant 3 : index
    %lane_step = index.constant 1 : index
    scf.for %lane = [%lane_begin to %lane_end step %lane_step] {
      %position = index.add %row, %lane : index
      %reciprocal = vector.extract %reciprocals[%lane] : vector<3xf64> -> f64
      %quotient = vector.extract %quotients[%lane] : vector<3xf64> -> f64
      %expected_reciprocal = view.load %data[2, %position] : view<4x9216xf64> -> f64
      %expected_quotient = view.load %data[3, %position] : view<4x9216xf64> -> f64
      %reciprocal_error = func.call @reciprocal_ulp_error(%reciprocal, %expected_reciprocal) : (f64, f64) -> (i64)
      %quotient_error = func.call @reciprocal_ulp_error(%quotient, %expected_quotient) : (f64, f64) -> (i64)
      view.store %reciprocal_error, %observations[0, %position] : i64, view<2x9216xi64>
      view.store %quotient_error, %observations[1, %position] : i64, view<2x9216xi64>
    }
  }
  func.return
}

func.def @double_reciprocal_oracle(%inputs: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %observations = buffer.view %output[%origin] : buffer -> view<18432xi64>
  %begin = index.constant 0 : index
  %end = index.constant 18432 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i64
  scf.for %position = [%begin to %end step %step] {
    view.store %c0, %observations[%position] : i64, view<18432xi64>
  }
  func.return
}

check.scenario @double_reciprocal_scalar_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %inputs = check.generate.fill value(0.0) : tensor<4x9216xf64>
    %output = check.generate.fill value(-1) : tensor<2x9216xi64>
    check.generate<@generate_double_quotients>(%seed, %inputs) : (i64, tensor<4x9216xf64>) -> ()
    check.compare<@double_reciprocal_scalar, @double_reciprocal_oracle>(%inputs, %output) : (tensor<4x9216xf64>, tensor<2x9216xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2x9216xi64>
    }
  }
  check.return
}

check.scenario @double_reciprocal_vector_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %inputs = check.generate.fill value(0.0) : tensor<4x9216xf64>
    %output = check.generate.fill value(-1) : tensor<2x9216xi64>
    check.generate<@generate_double_quotients>(%seed, %inputs) : (i64, tensor<4x9216xf64>) -> ()
    check.compare<@double_reciprocal_vector, @double_reciprocal_oracle>(%inputs, %output) : (tensor<4x9216xf64>, tensor<2x9216xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2x9216xi64>
    }
  }
  check.return
}

// Normal-domain cases share scalar and odd-lane vector reciprocal permission.
// A wider ordinary-division oracle rounds once into each result format. Normal
// operands isolate arithmetic accuracy from each target's denormal mode.
func.def @reciprocal_f64(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %inputs = buffer.view %input[%origin] : buffer -> view<4xf64>
  %outputs = buffer.view %output[%origin] : buffer -> view<8xf64>
  %unit_numerator = scalar.constant 1.0 : f64
  %denominator = view.load %inputs[0] : view<4xf64> -> f64
  %numerator = view.load %inputs[1] : view<4xf64> -> f64
  %reciprocal = scalar.divf<arcp> %unit_numerator, %denominator : f64
  %quotient = scalar.divf<arcp> %numerator, %denominator : f64
  view.store %reciprocal, %outputs[0] : f64, view<8xf64>
  view.store %quotient, %outputs[1] : f64, view<8xf64>
  %denominators = vector.load %inputs[0] : view<4xf64> -> vector<3xf64>
  %numerators = vector.load %inputs[1] : view<4xf64> -> vector<3xf64>
  %unit_numerators = vector.splat %unit_numerator : vector<3xf64>
  %reciprocals = vector.divf<arcp> %unit_numerators, %denominators : vector<3xf64>
  %quotients = vector.divf<arcp> %numerators, %denominators : vector<3xf64>
  vector.store %reciprocals, %outputs[2] : vector<3xf64>, view<8xf64>
  vector.store %quotients, %outputs[5] : vector<3xf64>, view<8xf64>
  func.return
}

func.def @reciprocal_f64_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %inputs = buffer.view %input[%origin] : buffer -> view<4xf64>
  %outputs = buffer.view %output[%origin] : buffer -> view<8xf64>
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  %reciprocal_base = index.constant 2 : index
  %quotient_base = index.constant 5 : index
  %unit_numerator = scalar.constant 1.0 : f64
  scf.for %lane = [%begin to %end step %step] {
    %next = index.add %lane, %step : index
    %denominator = view.load %inputs[%lane] : view<4xf64> -> f64
    %numerator = view.load %inputs[%next] : view<4xf64> -> f64
    %reciprocal = scalar.divf %unit_numerator, %denominator : f64
    %quotient = scalar.divf %numerator, %denominator : f64
    %reciprocal_position = index.add %reciprocal_base, %lane : index
    %quotient_position = index.add %quotient_base, %lane : index
    view.store %reciprocal, %outputs[%reciprocal_position] : f64, view<8xf64>
    view.store %quotient, %outputs[%quotient_position] : f64, view<8xf64>
    %first = index.cmp eq, %lane, %begin : index
    scf.if %first {
      view.store %reciprocal, %outputs[0] : f64, view<8xf64>
      view.store %quotient, %outputs[1] : f64, view<8xf64>
    }
  }
  func.return
}

check.scenario @reciprocal_f64_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(0.5 to 2.0) : tensor<4xf64>
    %output = check.generate.fill value(0.0) : tensor<8xf64>
    check.compare<@reciprocal_f64, @reciprocal_f64_oracle>(%input, %output) : (tensor<4xf64>, tensor<8xf64>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(4.4408920985006262e-16) nan(same) : tensor<8xf64>, tensor<8xf64>
    }
  }
  check.return
}

func.def @reciprocal_f32(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %inputs = buffer.view %input[%origin] : buffer -> view<4xf32>
  %outputs = buffer.view %output[%origin] : buffer -> view<8xf32>
  %unit_numerator = scalar.constant 1.0 : f32
  %denominator = view.load %inputs[0] : view<4xf32> -> f32
  %numerator = view.load %inputs[1] : view<4xf32> -> f32
  %reciprocal = scalar.divf<arcp> %unit_numerator, %denominator : f32
  %quotient = scalar.divf<arcp> %numerator, %denominator : f32
  view.store %reciprocal, %outputs[0] : f32, view<8xf32>
  view.store %quotient, %outputs[1] : f32, view<8xf32>
  %denominators = vector.load %inputs[0] : view<4xf32> -> vector<3xf32>
  %numerators = vector.load %inputs[1] : view<4xf32> -> vector<3xf32>
  %unit_numerators = vector.splat %unit_numerator : vector<3xf32>
  %reciprocals = vector.divf<arcp> %unit_numerators, %denominators : vector<3xf32>
  %quotients = vector.divf<arcp> %numerators, %denominators : vector<3xf32>
  vector.store %reciprocals, %outputs[2] : vector<3xf32>, view<8xf32>
  vector.store %quotients, %outputs[5] : vector<3xf32>, view<8xf32>
  func.return
}

func.def @reciprocal_f32_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %inputs = buffer.view %input[%origin] : buffer -> view<4xf32>
  %outputs = buffer.view %output[%origin] : buffer -> view<8xf32>
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  %reciprocal_base = index.constant 2 : index
  %quotient_base = index.constant 5 : index
  %unit_numerator = scalar.constant 1.0 : f64
  scf.for %lane = [%begin to %end step %step] {
    %next = index.add %lane, %step : index
    %denominator = view.load %inputs[%lane] : view<4xf32> -> f32
    %numerator = view.load %inputs[%next] : view<4xf32> -> f32
    %wide_denominator = scalar.extf %denominator : f32 to f64
    %wide_numerator = scalar.extf %numerator : f32 to f64
    %wide_reciprocal = scalar.divf %unit_numerator, %wide_denominator : f64
    %wide_quotient = scalar.divf %wide_numerator, %wide_denominator : f64
    %reciprocal = scalar.fptrunc %wide_reciprocal : f64 to f32
    %quotient = scalar.fptrunc %wide_quotient : f64 to f32
    %reciprocal_position = index.add %reciprocal_base, %lane : index
    %quotient_position = index.add %quotient_base, %lane : index
    view.store %reciprocal, %outputs[%reciprocal_position] : f32, view<8xf32>
    view.store %quotient, %outputs[%quotient_position] : f32, view<8xf32>
    %first = index.cmp eq, %lane, %begin : index
    scf.if %first {
      view.store %reciprocal, %outputs[0] : f32, view<8xf32>
      view.store %quotient, %outputs[1] : f32, view<8xf32>
    }
  }
  func.return
}

