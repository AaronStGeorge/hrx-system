    %quotient_position = index.add %quotient_base, %lane : index
    view.store %reciprocal, %outputs[%reciprocal_position] : f16, view<8xf16>
    view.store %quotient, %outputs[%quotient_position] : f16, view<8xf16>
    %first = index.cmp eq, %lane, %begin : index
    scf.if %first {
      view.store %reciprocal, %outputs[0] : f16, view<8xf16>
      view.store %quotient, %outputs[1] : f16, view<8xf16>
    }
  }
  func.return
