func.def @reciprocal_f16_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %inputs = buffer.view %input[%origin] : buffer -> view<4xf16>
  %outputs = buffer.view %output[%origin] : buffer -> view<8xf16>
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
