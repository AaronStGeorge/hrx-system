    %wide_numerator = scalar.extf %numerator : f16 to f64
    %wide_reciprocal = scalar.divf %unit_numerator, %wide_denominator : f64
    %wide_quotient = scalar.divf %wide_numerator, %wide_denominator : f64
    %reciprocal = scalar.fptrunc %wide_reciprocal : f64 to f16
    %quotient = scalar.fptrunc %wide_quotient : f64 to f16
