func.def @exponent_f8e4m3(%seed: i64, %output: buffer) {
  %precision = scalar.constant 3 : i64
  %bias = scalar.constant 7 : i64
  %sign_mask = scalar.constant 128 : i64
  %infinity = scalar.constant 120 : i64
  %finite_only = scalar.constant true : i1
  %begin = index.constant 0 : index
  %end = index.constant 96 : index
  %step = index.constant 1 : index
  scf.for %row = [%begin to %end step %step] {
    %bits, %power = func.call @exponent_input(%row, %seed, %precision, %bias, %sign_mask, %finite_only) : (index, i64, i64, i64, i64, i1) -> (i64, i32)
    %narrow_bits = scalar.trunci %bits : i64 to i8
    %input = scalar.bitcast %narrow_bits : i8 to f8E4M3
    %fraction, %exponent = scalar.frexpf %input : f8E4M3, i32
    %scaled = scalar.ldexpf %input, %power : f8E4M3, i32
    %fraction_bits = scalar.bitcast %fraction : f8E4M3 to i8
    %scaled_bits = scalar.bitcast %scaled : f8E4M3 to i8
    %wide_fraction = scalar.extui %fraction_bits : i8 to i64
    %wide_scaled = scalar.extui %scaled_bits : i8 to i64
    %observed_fraction = func.call @observe_exponent_bits(%wide_fraction, %sign_mask, %infinity, %finite_only) : (i64, i64, i64, i1) -> (i64)
    %observed_scaled = func.call @observe_exponent_bits(%wide_scaled, %sign_mask, %infinity, %finite_only) : (i64, i64, i64, i1) -> (i64)
    %wide_exponent = scalar.extsi %exponent : i32 to i64
    func.call @store_exponent_observations(%output, %row, %observed_fraction, %wide_exponent, %observed_scaled) : (buffer, index, i64, i64, i64)
  }
