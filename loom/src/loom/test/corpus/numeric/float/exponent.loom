// Odd lane counts exercise packed tails and differently sized exponent lanes.
func.def @exponent_vector_f16(%seed: i64, %output: buffer) {
  %precision = scalar.constant 10 : i64
  %bias = scalar.constant 15 : i64
  %sign_mask = scalar.constant 32768 : i64
  %infinity = scalar.constant 31744 : i64
  %finite_only = scalar.constant false : i1
  %begin = index.constant 0 : index
  %end = index.constant 96 : index
  %lane_step = index.constant 1 : index
  %last_lane = index.constant 2 : index
  %step = index.constant 3 : index
  scf.for %row = [%begin to %end step %step] {
    %next = index.add %row, %lane_step : index
    %last = index.add %row, %last_lane : index
    %bits0, %power0 = func.call @exponent_input(%row, %seed, %precision, %bias, %sign_mask, %finite_only) : (index, i64, i64, i64, i64, i1) -> (i64, i32)
    %narrow0 = scalar.trunci %bits0 : i64 to i16
    %input0 = scalar.bitcast %narrow0 : i16 to f16
    %bits1, %power1 = func.call @exponent_input(%next, %seed, %precision, %bias, %sign_mask, %finite_only) : (index, i64, i64, i64, i64, i1) -> (i64, i32)
    %narrow1 = scalar.trunci %bits1 : i64 to i16
    %input1 = scalar.bitcast %narrow1 : i16 to f16
    %bits2, %power2 = func.call @exponent_input(%last, %seed, %precision, %bias, %sign_mask, %finite_only) : (index, i64, i64, i64, i64, i1) -> (i64, i32)
    %narrow2 = scalar.trunci %bits2 : i64 to i16
    %input2 = scalar.bitcast %narrow2 : i16 to f16
    %inputs = vector.from_elements %input0, %input1, %input2 : vector<3xf16>
    %powers = vector.from_elements %power0, %power1, %power2 : vector<3xi32>
    %fractions, %exponents = vector.frexpf %inputs : vector<3xf16>, vector<3xi32>
    %scaled = vector.ldexpf %inputs, %powers : vector<3xf16>, vector<3xi32>
    scf.for %lane = [%begin to %step step %lane_step] {
      %fraction = vector.extract %fractions[%lane] : vector<3xf16> -> f16
      %exponent = vector.extract %exponents[%lane] : vector<3xi32> -> i32
      %value = vector.extract %scaled[%lane] : vector<3xf16> -> f16
      %fraction_bits = scalar.bitcast %fraction : f16 to i16
      %scaled_bits = scalar.bitcast %value : f16 to i16
      %wide_fraction = scalar.extui %fraction_bits : i16 to i64
      %wide_scaled = scalar.extui %scaled_bits : i16 to i64
      %observed_fraction = func.call @observe_exponent_bits(%wide_fraction, %sign_mask, %infinity, %finite_only) : (i64, i64, i64, i1) -> (i64)
      %observed_scaled = func.call @observe_exponent_bits(%wide_scaled, %sign_mask, %infinity, %finite_only) : (i64, i64, i64, i1) -> (i64)
      %wide_exponent = scalar.extsi %exponent : i32 to i64
      %output_row = index.add %row, %lane : index
      func.call @store_exponent_observations(%output, %output_row, %observed_fraction, %wide_exponent, %observed_scaled) : (buffer, index, i64, i64, i64)
    }
  }
  func.return
}

check.scenario @exponent_vector_f16_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(-1) : tensor<96x3xi64>
    check.compare<@exponent_vector_f16, @exponent_f16_reference>(%seed, %output) : (i64, tensor<96x3xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<96x3xi64>
    }
  }
  check.return
}

