// Qualifies i64 ballot packing for every target-selected subgroup width up to
// 64 lanes. Exact masks, divergent active lanes, helpers, and loop calls must
// agree between native AMDGPU and shared SPIR-V lowering.
//
// Produces the exact low-bit lane mask for subgroup widths up to 64.
func.def device inline @low_bits_mask(%width: index) -> (i64) {
  %maximum_width = index.constant 64 : index
  %is_maximum_width = index.cmp eq, %width, %maximum_width : index
  %all_bits = scalar.constant -1 : i64
  %unit = scalar.constant 1 : i64
  %width_i64 = index.cast %width : index to i64
  %mask = scf.if %is_maximum_width -> (i64) {
    scf.yield %all_bits : i64
  } else {
    %limit = scalar.shli %unit, %width_i64 : i64
    %low_bits = scalar.subi %limit, %unit : i64
    scf.yield %low_bits : i64
  }
  func.return %mask : i64
}

kernel.def @subgroup_ballot_masks() {
  %unit = index.constant 1 : index
  %width = kernel.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %width = kernel.subgroup.size : index
  %lane = kernel.subgroup.lane.id : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<3xi32>
  %value = view.load %input_view[%lane] : view<64xi32> -> i32
  %c0_i32 = scalar.constant 0 : i32
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c2_index = index.constant 2 : index
  %parity = index.andi %lane, %c1_index : index
  %full_predicate = scalar.cmpi sge, %value, %c0_i32 : i32
  %empty_predicate = scalar.cmpi slt, %value, %c0_i32 : i32
  %alternating_predicate = index.cmp eq, %parity, %c0_index : index
  %full = kernel.subgroup.vote.ballot %full_predicate : i1 -> i64
  %empty = kernel.subgroup.vote.ballot %empty_predicate : i1 -> i64
  %alternating = kernel.subgroup.vote.ballot %alternating_predicate : i1 -> i64
  %expected_full = func.call @low_bits_mask(%width) : (index) -> (i64)
  %expected_empty = scalar.constant 0 : i64
  %alternating_bits = scalar.constant 6148914691236517205 : i64
  %expected_alternating = scalar.andi %expected_full, %alternating_bits : i64
  %full_matches = scalar.cmpi eq, %full, %expected_full : i64
  %empty_matches = scalar.cmpi eq, %empty, %expected_empty : i64
  %alternating_matches = scalar.cmpi eq, %alternating, %expected_alternating : i64
  %full_result = scalar.extui %full_matches : i1 to i32
  %empty_result = scalar.extui %empty_matches : i1 to i32
  %alternating_result = scalar.extui %alternating_matches : i1 to i32
  %leader = index.cmp eq, %lane, %c0_index : index
  scf.if %leader {
    view.store %full_result, %output_view[%c0_index] : i32, view<3xi32>
    view.store %empty_result, %output_view[%c1_index] : i32, view<3xi32>
    view.store %alternating_result, %output_view[%c2_index] : i32, view<3xi32>
  }
  kernel.return
}

kernel.def @subgroup_ballot_divergent() {
  %unit = index.constant 1 : index
  %width = kernel.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %width = kernel.subgroup.size : index
  %lane = kernel.subgroup.lane.id : index
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %parity = index.andi %lane, %c1_index : index
  %active = index.cmp eq, %parity, %c0_index : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<2xi32>
  %value = view.load %input_view[%lane] : view<64xi32> -> i32
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %value_parity = scalar.andi %value, %c1_i32 : i32
  %inactive_predicate = scalar.cmpi ne, %value_parity, %c0_i32 : i32
  %true_predicate = scalar.cmpi sge, %value, %c0_i32 : i32
  scf.if %active {
    %empty = kernel.subgroup.vote.ballot %inactive_predicate : i1 -> i64
    %active_mask = kernel.subgroup.vote.ballot %true_predicate : i1 -> i64
    %expected_full = func.call @low_bits_mask(%width) : (index) -> (i64)
    %expected_empty = scalar.constant 0 : i64
    %alternating_bits = scalar.constant 6148914691236517205 : i64
    %expected_active = scalar.andi %expected_full, %alternating_bits : i64
    %empty_matches = scalar.cmpi eq, %empty, %expected_empty : i64
    %active_matches = scalar.cmpi eq, %active_mask, %expected_active : i64
    %empty_result = scalar.extui %empty_matches : i1 to i32
    %active_result = scalar.extui %active_matches : i1 to i32
    %leader = index.cmp eq, %lane, %c0_index : index
    scf.if %leader {
      view.store %empty_result, %output_view[%c0_index] : i32, view<2xi32>
      view.store %active_result, %output_view[%c1_index] : i32, view<2xi32>
    }
  }
  kernel.return
}

func.def device inline @subgroup_ballot_helper(%predicate: i1) -> (i64) {
  %mask = kernel.subgroup.vote.ballot %predicate : i1 -> i64
  func.return %mask : i64
}

kernel.def @subgroup_ballot_helpers_and_loop() {
  %unit = index.constant 1 : index
  %width = kernel.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer) {
  %width = kernel.subgroup.size : index
  %lane = kernel.subgroup.lane.id : index
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c2_index = index.constant 2 : index
  %end = index.constant 3 : index
  %half = index.div %width, %c2_index : index
  %parity = index.andi %lane, %c1_index : index
  %even_predicate = index.cmp eq, %parity, %c0_index : index
  %upper_predicate = index.cmp uge, %lane, %half : index
  %even = func.call @subgroup_ballot_helper(%even_predicate) : (i1) -> (i64)
  %upper = func.call @subgroup_ballot_helper(%upper_predicate) : (i1) -> (i64)
  %zero_mask = scalar.constant 0 : i64
  %loop_mask = scf.for %iteration = [%c0_index to %end step %c1_index](%combined = %zero_mask : i64) -> (i64) {
    %iteration_mask = func.call @subgroup_ballot_helper(%even_predicate) : (i1) -> (i64)
    %next = scalar.ori %combined, %iteration_mask : i64
    scf.yield %next : i64
  }
  %expected_full = func.call @low_bits_mask(%width) : (index) -> (i64)
  %alternating_bits = scalar.constant 6148914691236517205 : i64
  %expected_even = scalar.andi %expected_full, %alternating_bits : i64
  %expected_lower = func.call @low_bits_mask(%half) : (index) -> (i64)
  %expected_upper = scalar.xori %expected_full, %expected_lower : i64
  %even_matches = scalar.cmpi eq, %even, %expected_even : i64
  %upper_matches = scalar.cmpi eq, %upper, %expected_upper : i64
  %loop_matches = scalar.cmpi eq, %loop_mask, %expected_even : i64
  %even_result = scalar.extui %even_matches : i1 to i32
  %upper_result = scalar.extui %upper_matches : i1 to i32
  %loop_result = scalar.extui %loop_matches : i1 to i32
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<3xi32>
  %leader = index.cmp eq, %lane, %c0_index : index
  scf.if %leader {
    view.store %even_result, %output_view[%c0_index] : i32, view<3xi32>
    view.store %upper_result, %output_view[%c1_index] : i32, view<3xi32>
    view.store %loop_result, %output_view[%c2_index] : i32, view<3xi32>
  }
  kernel.return
}

func.def @three_true_results_oracle(%output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  %true = scalar.constant 1 : i32
  %output_view = buffer.view %output[%base] : buffer -> view<3xi32>
  scf.for %position = [%begin to %end step %step] {
    view.store %true, %output_view[%position] : i32, view<3xi32>
  }
  func.return
}

func.def @three_true_input_results_oracle(%input: buffer, %output: buffer) {
  func.call @three_true_results_oracle(%output) : (buffer)
  func.return
}

func.def @two_true_results_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %true = scalar.constant 1 : i32
  %output_view = buffer.view %output[%base] : buffer -> view<2xi32>
  scf.for %position = [%begin to %end step %step] {
    view.store %true, %output_view[%position] : i32, view<2xi32>
  }
  func.return
}

check.scenario @subgroup_ballot_exact_masks {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(99) : tensor<11xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<11xi32> -> tensor<4xi32>
    %output = check.tensor.view %storage offset(16) : tensor<11xi32> -> tensor<3xi32>
    %suffix = check.tensor.view %storage offset(28) : tensor<11xi32> -> tensor<4xi32>
    check.compare<@subgroup_ballot_masks, @three_true_input_results_oracle>(%input, %output) : (tensor<64xi32>, tensor<3xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<3xi32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xi32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xi32>
    }
  }
  check.return
}

check.scenario @subgroup_ballot_active_lanes {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(98) : tensor<10xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<10xi32> -> tensor<4xi32>
    %output = check.tensor.view %storage offset(16) : tensor<10xi32> -> tensor<2xi32>
    %suffix = check.tensor.view %storage offset(24) : tensor<10xi32> -> tensor<4xi32>
    check.compare<@subgroup_ballot_divergent, @two_true_results_oracle>(%input, %output) : (tensor<64xi32>, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xi32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xi32>
    }
  }
  check.return
}

check.scenario @subgroup_ballot_helper_loop_results {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(97) : tensor<11xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<11xi32> -> tensor<4xi32>
    %output = check.tensor.view %storage offset(16) : tensor<11xi32> -> tensor<3xi32>
    %suffix = check.tensor.view %storage offset(28) : tensor<11xi32> -> tensor<4xi32>
    check.compare<@subgroup_ballot_helpers_and_loop, @three_true_results_oracle>(%output) : (tensor<3xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<3xi32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xi32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xi32>
    }
  }
  check.return
}

// Each lane leaves on a different iteration. Its integer masks must retain
// that iteration's bits after the entire subgroup reconverges. Runtime input
// supplies the exit order; this scenario uses ascending lane indices.
kernel.def @subgroup_mask_loop_observations() {
  %unit = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %lane = kernel.subgroup.lane.id : index
  %item = kernel.workitem.id<x> : index
  %width = kernel.subgroup.size : index
  %input_view = buffer.view %input[%base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<64xi32>
  %order = view.load %input_view[%lane] : view<64xi32> -> i32
  %exit_iteration = index.cast %order : i32 to index
  %parity = index.andi %lane, %step : index
  %even = index.cmp eq, %parity, %begin : index
  %end = index.add %exit_iteration, %step : index
  %zero_mask = scalar.constant 0 : i64
  %active, %ballot = scf.for %counter = [%begin to %end step %step](%last_active = %zero_mask : i64, %last_ballot = %zero_mask : i64) -> (i64, i64) {
    %observed_active = kernel.subgroup.active.mask : i64
    %observed_ballot = kernel.subgroup.vote.ballot %even : i1 -> i64
    scf.yield %observed_active, %observed_ballot : i64, i64
  }
  %maximum_width = scalar.constant 64 : i64
  %width_i64 = index.cast %width : index to i64
  %unused_bits = scalar.subi %maximum_width, %width_i64 : i64
  %all_bits = scalar.constant -1 : i64
  %full = scalar.shrui %all_bits, %unused_bits : i64
  %exit_shift = index.cast %exit_iteration : index to i64
  %lower_removed = scalar.shli %all_bits, %exit_shift : i64
  %expected_active = scalar.andi %full, %lower_removed : i64
  %alternating_bits = scalar.constant 6148914691236517205 : i64
  %expected_ballot = scalar.andi %expected_active, %alternating_bits : i64
  %active_matches = scalar.cmpi eq, %active, %expected_active : i64
  %ballot_matches = scalar.cmpi eq, %ballot, %expected_ballot : i64
  %matches = scalar.andi %active_matches, %ballot_matches : i1
  %result = scalar.extui %matches : i1 to i32
  view.store %result, %output_view[%item] : i32, view<64xi32>
  kernel.return
}

func.def @subgroup_mask_loop_observations_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  %true = scalar.constant 1 : i32
  %output_view = buffer.view %output[%base] : buffer -> view<64xi32>
  scf.for %position = [%begin to %end step %step] {
    view.store %true, %output_view[%position] : i32, view<64xi32>
  }
  func.return
}

check.scenario @subgroup_mask_temporal_results {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(95) : tensor<72xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<72xi32> -> tensor<4xi32>
    %output = check.tensor.view %storage offset(16) : tensor<72xi32> -> tensor<64xi32>
    %suffix = check.tensor.view %storage offset(272) : tensor<72xi32> -> tensor<4xi32>
    check.compare<@subgroup_mask_loop_observations, @subgroup_mask_loop_observations_oracle>(%input, %output) : (tensor<64xi32>, tensor<64xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<64xi32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xi32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xi32>
    }
  }
  check.return
}
