load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

py_binary(
    name = "shared_exports",
    srcs = ["shared_exports.py"],
    visibility = ["//loom/binding/c:__pkg__"],
)

py_test(
    name = "shared_exports_test",
    srcs = [
        "shared_exports.py",
        "shared_exports_test.py",
    ],
)

py_test(
    name = "presubmit_test",
    size = "small",
    srcs = [
        "presubmit.py",
        "presubmit_test.py",
    ],
    data = [
        "//loom/build_tools/bazel/test:roundtrip.loom-test",
        "//loom/src/loom/test/corpus/authoring/linking:checks.loom",
    ],
    tags = ["manual"],
    deps = [
        "//build_tools/devtools",
        "//loom/py/loom/build_tools:target_presets",
        "//loom/py/loom/gen:checked_in_artifacts",
        "//loom/py/loom/tools:source_inventory",
    ],
)

# Project policy tests run in the repository Presubmit lane when this
# build_tools subtree or its shared support changes.
test_suite(
    name = "presubmit_tests",
    tags = ["manual"],
    tests = [
        ":presubmit_test",
        "//loom/build_tools/bazel_to_cmake:config_test",
        "//loom/build_tools/hygiene:presubmit_tests",
        "//loom/build_tools/linters:loom_source_lint_self_test",
    ],
)
