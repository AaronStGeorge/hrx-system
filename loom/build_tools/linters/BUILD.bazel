load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

py_binary(
    name = "loom_source_lint",
    srcs = ["loom_source_lint.py"],
    deps = ["//loom/py/loom/tools:source_inventory"],
)

py_test(
    name = "loom_source_lint_self_test",
    size = "small",
    srcs = ["loom_source_lint.py"],
    args = ["--self-test"],
    main = "loom_source_lint.py",
    tags = ["manual"],
    deps = ["//loom/py/loom/tools:source_inventory"],
)
