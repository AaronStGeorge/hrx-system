load("//build_tools/bazel:cmake.bzl", "iree_cmake_extra_content")
load("//libhrx/build_tools/bazel:cc.bzl", "hrx_cc_shared_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

PASSTHROUGH_INCLUDES = [
    "..",
]

_LINUX_COMPATIBILITY = ["@platforms//os:linux"]

hrx_cc_shared_library(
    name = "hip_intercept",
    srcs = ["hip_intercept.c"],
    hdrs = ["hip_function_table.h"],
    includes = PASSTHROUGH_INCLUDES,
    target_compatible_with = _LINUX_COMPATIBILITY,
    deps = [
        "//build_tools/bazel:dl",
        "//build_tools/bazel:pthreads",
    ],
)

hrx_cc_shared_library(
    name = "hip_logging",
    srcs = ["hip_logging.c"],
    hdrs = ["hip_function_table.h"],
    includes = PASSTHROUGH_INCLUDES,
    target_compatible_with = _LINUX_COMPATIBILITY,
    deps = ["//build_tools/bazel:pthreads"],
)

hrx_cc_shared_library(
    name = "hip_noop",
    srcs = ["interceptors/passthrough_interceptor.c"],
    hdrs = ["hip_function_table.h"],
    includes = PASSTHROUGH_INCLUDES,
    target_compatible_with = _LINUX_COMPATIBILITY,
)

hrx_cc_shared_library(
    name = "hip_buffer_tracer",
    srcs = ["hip_buffer_tracer.c"],
    hdrs = ["hip_function_table.h"],
    includes = PASSTHROUGH_INCLUDES,
    target_compatible_with = _LINUX_COMPATIBILITY,
    deps = ["//build_tools/bazel:pthreads"],
)

iree_cmake_extra_content(
    content = """
include("${_IREE_PACKAGE_SOURCE_DIR}/passthrough.cmake")
""",
    inline = True,
)
